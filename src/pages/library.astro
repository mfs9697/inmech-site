---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const librarySections = [
  {
    title: 'Монографії співробітників Інституту',
    text: 'Каталог сучасних наукових монографій співробітників Інституту, присвячених актуальним напрямам механіки та прикладної математики.',
    href: '/library/monographs/',
    label: 'Переглянути монографії'
  },
  {
    title: 'Фундаментальні багатотомні видання',
    text: 'Колективні багатотомні праці наукових шкіл Інституту з механіки оболонок, композитів, руйнування та суміжних напрямів.',
    href: '/library/multivolume-editions/',
    label: 'Переглянути серії'
  },
  {
    title: 'Підручники та навчальні посібники',
    text: 'Навчальні видання, конспекти лекцій та навчально-наукові матеріали співробітників Інституту й пов’язаних наукових шкіл.',
    href: '/library/textbooks/',
    label: 'Переглянути видання'
  },
  {
    title: 'Історичні видання про Інститут',
    text: 'Ювілейні та історичні видання про розвиток Інституту, його структуру, наукові школи та інформаційну спадщину.',
    href: '/library/history-publications/',
    label: 'Переглянути видання'
  },
  {
    title: 'Наукові монографії та довідкові видання',
    text: 'Каталог окремих монографій, довідників, словників та фундаментальних видань з бібліографічного архіву Інституту.',
    href: '/library/scientific-books/',
    label: 'Перейти до каталогу'
  },
  {
    title: 'Каталог захищених дисертацій',
    text: 'Алфавітний каталог дисертацій, захищених в Інституті механіки ім. С. П. Тимошенка НАН України.',
    href: '/defended-dissertations/',
    label: 'Перейти до каталогу'
  },
  {
    title: 'Захист дисертацій',
    text: 'Матеріали захистів дисертацій: дисертації, автореферати, відгуки, відеозаписи та супровідні документи.',
    href: '/dissertations/',
    label: 'Переглянути захисти'
  },
  {
    title: 'Журнал «Прикладна механіка»',
    text: 'Офіційна інформація про журнал, правила подання рукописів, рецензування, архів і контакти редакції.',
    href: '/journal/',
    label: 'Перейти до сторінки журналу'
  }
];
---

<BaseLayout
  title={`Бібліотека | ${site.shortName}`}
  description="Бібліотечні та архівні ресурси Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="publications"
>
  <section class="library-hero">
    <div class="container library-hero-panel">
      <p class="eyebrow">Публікації та наукова спадщина</p>
      <h1>Бібліотека</h1>
      <p class="lead">
        Розділ об’єднує бібліографічні, архівні та довідкові матеріали Інституту механіки:
        монографії співробітників, фундаментальні багатотомні видання, навчальні матеріали,
        історичні видання про Інститут, каталоги книжкових видань і захищених дисертацій,
        матеріали захистів та пов’язані публікаційні ресурси.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Ресурси</p>
          <h2>Основні бібліотечні матеріали</h2>
        </div>
        <p>
          Матеріали згруповано за тематичними каталогами, щоб швидко перейти до монографій,
          багатотомних видань, навчальних матеріалів, історичних публікацій, дисертаційних
          матеріалів або ресурсу журналу «Прикладна механіка».
        </p>
      </div>

      <div class="library-grid">
        {librarySections.map((section) => (
          <article class="library-card">
            <h3>{section.title}</h3>
            <p>{section.text}</p>
            <a class="card-link" href={withBase(section.href)}>{section.label} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .library-hero {
    padding: 52px 0 18px;
  }

  .library-hero-panel,
  .library-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .library-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .library-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(184, 135, 47, 0.17), rgba(184, 135, 47, 0));
  }

  .library-hero-panel h1,
  .library-hero-panel .lead,
  .library-hero-panel .eyebrow {
    position: relative;
    z-index: 1;
  }

  .library-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
  }

  .library-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .library-card {
    padding: 22px;
    min-height: 218px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .library-card h3 {
    margin: 0 0 12px;
  }

  .library-card p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .library-card .card-link {
    margin-top: auto;
    font-weight: 850;
  }

  @media (max-width: 1200px) {
    .library-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1100px) {
    .library-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .section-heading,
    .library-grid {
      display: block;
    }

    .section-heading p:last-child,
    .library-card + .library-card {
      margin-top: 14px;
    }
  }
</style>
