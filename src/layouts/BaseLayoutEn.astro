---
import HeaderEn from '../components/HeaderEn.astro';
import FooterEn from '../components/FooterEn.astro';
import { getUkrainianPath, hasUkrainianAlternative, normalizeSitePath } from '../data/routes';
import '../styles/global.css';
import '../styles/overrides.css';
import '../styles/history-directors-en.css';
import '../styles/specialized-councils.css';
import '../styles/home-hero.css';
import '../styles/navigation.css';
import '../styles/dropdown-navigation.css';
import '../styles/block-colors.css';

interface Props {
  title: string;
  description: string;
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education' | 'publications';
}

const { title, description, activePage = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconPath = `${base}/favicon.png`;
const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID?.trim();

const siteBaseUrl = new URL(`${base || ''}/`, Astro.site).href.replace(/\/$/, '');

function absoluteUrl(pathname: string) {
  return `${siteBaseUrl}${pathname}`;
}

const currentPath = normalizeSitePath(Astro.url.pathname, base);
const canonicalUrl = absoluteUrl(currentPath);
const ukrainianAlternativePath = getUkrainianPath(Astro.url.pathname, base);
const hasAlternative = hasUkrainianAlternative(Astro.url.pathname, base);
const ukrainianAlternativeUrl = absoluteUrl(ukrainianAlternativePath);
const englishAlternativeUrl = absoluteUrl(currentPath);
const pageProvidesMainLandmark = currentPath.startsWith('/en/postgraduate/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hasAlternative && <link rel="alternate" hreflang="uk" href={ukrainianAlternativeUrl} />}
    {hasAlternative && <link rel="alternate" hreflang="en" href={englishAlternativeUrl} />}
    <link rel="sitemap" href={`${siteBaseUrl}/sitemap-index.xml`} />
    <link rel="icon" href={faviconPath} type="image/png" />
    {googleAnalyticsId ? (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', googleAnalyticsId);
        </script>
      </>
    ) : null}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <HeaderEn activePage={activePage} />
    {pageProvidesMainLandmark ? (
      <div id="main" tabindex="-1">
        <slot />
      </div>
    ) : (
      <main id="main">
        <slot />
      </main>
    )}
    <FooterEn />
    <script>
      import '../scripts/navigation';
    </script>
    <style is:global>
      .publication-details summary,
      .materials-details summary,
      .publication-toggle {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        margin-bottom: 10px;
        padding: 6px 10px;
        border: 0;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-dark);
        cursor: pointer;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 850;
        line-height: 1.2;
      }
    </style>
  </body>
</html>
