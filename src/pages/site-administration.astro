---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const reportTopics = [
  {
    title: 'Помилка або застаріла інформація',
    text: 'Повідомте, якщо на сторінці є неточність, застарілий текст, помилка в посаді, назві підрозділу, даті або контактних даних.'
  },
  {
    title: 'Непрацююче посилання чи документ',
    text: 'Напишіть, якщо посилання не відкривається, документ відсутній, завантажується неправильний файл або матеріал потребує заміни.'
  },
  {
    title: 'Розбіжність між мовними версіями',
    text: 'Зверніть увагу редакторів, якщо українська й англійська сторінки мають різні назви, структуру, зміст або посилання.'
  },
  {
    title: 'Проблема доступності',
    text: 'Повідомте про незручну навігацію, нечіткий текст, відсутній опис зображення або іншу проблему, що заважає користуванню сайтом.'
  }
];

const requestChecklist = [
  'адресу сторінки, де виявлено проблему;',
  'короткий опис того, що потрібно виправити або оновити;',
  'запропонований правильний текст, посилання або документ;',
  'мовну версію сторінки, якщо питання стосується тільки української або англійської версії;',
  'контакт для уточнення, якщо зміна потребує погодження.'
];

const updateSteps = [
  'Редактори перевіряють звернення та визначають, які сторінки потрібно оновити.',
  'Зміни готуються в локальній копії сайту або в GitHub, без прямого редагування опублікованих файлів на сервері.',
  'Для двомовних матеріалів українська та англійська версії звіряються між собою.',
  'Перед публікацією сайт проходить автоматичну збірку й перевірки.',
  'Після погодження готова статична версія публікується через GitHub Actions.'
];

const supportRoles = [
  {
    title: 'Зміст і структура',
    text: 'Підготовка текстів, узгодження матеріалів підрозділів, оновлення довідкової інформації та підтримання відповідності між мовними версіями.'
  },
  {
    title: 'Технічна підтримка',
    text: 'Підтримка коду сайту, локального середовища розробки, автоматичних перевірок, збірки та публікації статичної версії.'
  }
];

const technicalNotes = [
  'Сайт є статичним Astro-проєктом: сторінки збираються заздалегідь і швидко відкриваються у браузері.',
  'Вихідні файли сайту підтримуються в GitHub; GitHub є джерелом правди для змін і перевірок.',
  'Опубліковані файли на сервері не редагуються вручну: наступне розгортання замінює їх зібраною версією з репозиторію.'
];
---

<BaseLayout
  title={`Адміністрація сайту | ${site.shortName}`}
  description="Як повідомити про помилку на сайті Інституту механіки, запропонувати оновлення матеріалів і зрозуміти порядок публікації змін."
  activePage="home"
>
  <div class="site-admin-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/')}>Головна</a>
      <span>›</span>
      <span>Адміністрація сайту</span>
    </nav>

    <section class="admin-hero">
      <p class="eyebrow">Підтримка сайту</p>
      <h1>Адміністрація сайту</h1>
      <p class="lead">
        Ця сторінка пояснює, хто підтримує офіційний сайт Інституту, як повідомити
        про помилку або запропонувати оновлення матеріалів, і як зміни проходять
        перевірку перед публікацією.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`mailto:${site.email}`}>Написати до Інституту</a>
        <a class="button secondary" href={withBase('/accessibility/')}>Політика доступності</a>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Звернення</p>
          <h2>Коли варто повідомити адміністрацію сайту</h2>
        </div>
      </div>

      <div class="support-grid">
        {reportTopics.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block two-column">
      <article class="info-panel">
        <p class="eyebrow">Що вказати</p>
        <h2>Як підготувати звернення</h2>
        <p>
          Щоб редактори могли швидко перевірити й опрацювати запит, бажано
          додати до повідомлення кілька практичних деталей.
        </p>
        <ul class="check-list">
          {requestChecklist.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="info-panel">
        <p class="eyebrow">Порядок роботи</p>
        <h2>Як оновлюється сайт</h2>
        <ol class="step-list">
          {updateSteps.map((item) => <li>{item}</li>)}
        </ol>
      </article>
    </section>

    <section class="section-block two-column">
      <article class="info-panel">
        <p class="eyebrow">Відповідальність</p>
        <h2>Хто підтримує сайт</h2>
        <div class="role-list">
          {supportRoles.map((role) => (
            <div class="role-card">
              <strong>{role.title}</strong>
              <p>{role.text}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="info-panel">
        <p class="eyebrow">Технічна основа</p>
        <h2>Як сайт публікується</h2>
        <ul class="plain-list">
          {technicalNotes.map((note) => <li>{note}</li>)}
        </ul>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .site-admin-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 20px 72px;
  }

  .breadcrumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 22px;
    color: var(--muted);
    font-weight: 750;
  }

  .admin-hero,
  .info-card,
  .info-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .admin-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .admin-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 900px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .section-block {
    margin-top: 34px;
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card,
  .info-panel {
    padding: 24px;
  }

  .info-card h3,
  .info-panel h2 {
    margin-top: 0;
  }

  .info-card p,
  .info-panel p,
  .info-panel li {
    color: var(--muted);
    line-height: 1.65;
  }

  .two-column {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 18px;
  }

  .check-list,
  .plain-list,
  .step-list {
    margin: 18px 0 0;
    padding-left: 1.25rem;
  }

  .check-list li + li,
  .plain-list li + li,
  .step-list li + li {
    margin-top: 10px;
  }

  .role-list {
    display: grid;
    gap: 14px;
  }

  .role-card {
    padding: 16px;
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .role-card strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 1.05rem;
  }

  .role-card p {
    margin: 0;
  }

  @media (max-width: 1080px) {
    .support-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .support-grid,
    .two-column {
      grid-template-columns: 1fr;
    }
  }
</style>
