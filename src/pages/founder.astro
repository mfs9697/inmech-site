---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import FounderEarlyLife from '../components/founder/FounderEarlyLife.astro';
import FounderAcademy from '../components/founder/FounderAcademy.astro';
import FounderFirstYears from '../components/founder/FounderFirstYears.astro';
import FounderEmigration from '../components/founder/FounderEmigration.astro';
import FounderCommemoration from '../components/founder/FounderCommemoration.astro';
---

<BaseLayout
  title={`Засновник інституту | ${site.name}`}
  description="Сторінка про Степана Прокоповича Тимошенка — засновника і першого директора Інституту механіки НАН України."
  activePage="about"
>
  <section class="page-hero founder-hero">
    <div class="container founder-page-container">
      <div class="panel founder-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>С.П. Тимошенко — засновник Інституту механіки</h1>
        <p class="lead">
          Степан Прокопович Тимошенко — видатний учений-механік зі світовим ім’ям,
          один із фундаторів Української академії наук, засновник і перший директор
          Інституту механіки НАН України, який сьогодні носить його ім’я.
        </p>
      </div>
    </div>
  </section>

  <section class="section founder-section">
    <div class="container founder-page-container founder-container">
      <article class="panel founder-article">
        <FounderEarlyLife />
        <FounderAcademy />
        <FounderFirstYears />
        <FounderEmigration />
        <FounderCommemoration />

        <p class="founder-source">
          Текст сторінки подано за матеріалами статті академіка В.Л. Богданова
          «С.П. Тимошенко — засновник Інституту механіки».
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .founder-page-container {
    width: min(100% - 32px, 1080px);
    margin-inline: auto;
  }

  .founder-hero-panel {
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
    padding: clamp(28px, 4vw, 50px);
  }

  .founder-container {
    max-width: 1080px;
  }

  .founder-article {
    display: flex;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(30px, 4.6vw, 58px);
    flex-direction: column;
    align-items: stretch;
  }

  .founder-content-section {
    display: block;
    width: 100%;
    clear: both;
  }

  .founder-content-section + .founder-content-section {
    margin-top: clamp(34px, 5vw, 58px);
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--line);
  }

  .founder-article h2 {
    margin-top: 0;
    margin-bottom: 1.2rem;
    max-width: 820px;
  }

  .founder-article p {
    max-width: 850px;
    font-size: 1.04rem;
    line-height: 1.82;
  }

  .founder-article p + p {
    margin-top: 1.08rem;
  }

  .founder-source {
    margin-top: clamp(30px, 4vw, 46px);
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem !important;
    line-height: 1.55 !important;
  }

  @media (max-width: 760px) {
    .founder-page-container {
      width: min(100% - 24px, 1080px);
    }

    .founder-hero-panel,
    .founder-article {
      padding: 24px;
    }

    .founder-article p {
      font-size: 1rem;
      line-height: 1.72;
    }
  }
</style>
