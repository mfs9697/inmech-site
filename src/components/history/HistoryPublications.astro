---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const springerBooks = [
  {
    year: '2023',
    title: 'Advances in Mechanics',
    subtitle: 'Current Research Results of the NAS of Ukraine',
    editors: 'Aleksander N. Guz, Holm Altenbach, Viacheslav Bogdanov, Vladimir M. Nazarenko',
    description:
      'Колективна монографія узагальнює сучасні результати установ НАН України з механіки композитів, руйнування, міцності матеріалів і конструкцій, термов’язкопружності та пластичності, механіки оболонок, контактної механіки, поширення хвиль і динаміки механічних та гідромеханічних систем. Видання присвячене 145-річчю від дня народження С.П. Тимошенка.',
    series: 'Advanced Structured Materials, vol. 191',
    chapters: '30 розділів',
    pages: 'XXIX + 556 сторінок',
    illustrations: '191 чорно-біла та 80 кольорових ілюстрацій',
    doi: '10.1007/978-3-031-37313-8',
    href: 'https://link.springer.com/book/10.1007/978-3-031-37313-8',
    cover: 'https://link.springer.com/book/10.1007/978-3-031-37313-8/cover'
  },
  {
    year: '2024',
    title: 'Selected Problems of Solid Mechanics and Solving Methods',
    subtitle: '',
    editors:
      'Holm Altenbach, Viacheslav Bogdanov, Alexander Ya. Grigorenko, Roman M. Kushnir, Vladimir M. Nazarenko, Victor A. Eremeyev',
    description:
      'Монографія розглядає нові підходи до оцінювання похибок наближених теорій і методи побудови основних рівнянь у механіці. У книзі представлені аналітичні й чисельні підходи різних наукових шкіл, застосовні також у фізиці, математиці та будівельній інженерії. Окремі розділи присвячено руйнуванню, термопластичності, контактним задачам, оболонкам, коливанням і хвильовим процесам.',
    series: 'Advanced Structured Materials, vol. 204',
    chapters: '32 розділи',
    pages: 'XII + 532 сторінки',
    illustrations: '124 чорно-білі та 79 кольорових ілюстрацій',
    doi: '10.1007/978-3-031-54063-9',
    href: 'https://link.springer.com/book/10.1007/978-3-031-54063-9',
    cover: 'https://link.springer.com/book/10.1007/978-3-031-54063-9/cover'
  }
];
---

<section class="section history-content-section history-publications-section">
  <div class="container">
    <div class="section-header history-publications-header">
      <div>
        <p class="eyebrow">Наукові видання</p>
        <h2 class="section-title">Монографії та журнал «Прикладна механіка»</h2>
        <p class="section-text">
          Видавнича діяльність Інституту відображає розвиток його наукових шкіл —
          від фундаментальних багатотомних праць до сучасних міжнародних колективних монографій
          і фахового журналу з багаторічною історією.
        </p>
      </div>
    </div>

    <div class="history-publication-stats">
      <article class="panel history-publication-stat">
        <strong>≈500</strong>
        <span>монографій опублікували співробітники Інституту за роки його діяльності</span>
      </article>
      <article class="panel history-publication-stat">
        <strong>8</strong>
        <span>узагальнювальних багатотомних видань з основних напрямів механіки</span>
      </article>
      <article class="panel history-publication-stat">
        <strong>1955</strong>
        <span>рік заснування міжнародного наукового журналу «Прикладна механіка»</span>
      </article>
    </div>

    <article class="panel history-books-overview">
      <div>
        <p class="eyebrow">Книжкова спадщина</p>
        <h3>Багатотомні праці та сучасні монографії</h3>
        <p>
          Серед узагальнювальних видань — серії з методів розрахунку оболонок, механіки
          композитних матеріалів, просторових задач теорії пружності та пластичності,
          механіки зв’язаних полів, некласичних проблем механіки руйнування,
          а також багатотомні видання «Успіхи механіки» і «Сучасні проблеми механіки».
        </p>
      </div>
      <div class="history-card-actions">
        <a class="button secondary" href={withBase('/library/monographs/')}>Монографії</a>
        <a class="button secondary" href={withBase('/library/multivolume-editions/')}>Багатотомні видання</a>
      </div>
    </article>

    <div class="history-springer-heading">
      <p class="eyebrow">Міжнародні колективні видання</p>
      <h3>Книги Springer за участю науковців Інституту</h3>
    </div>

    <div class="history-springer-grid">
      {springerBooks.map((book) => (
        <article class="panel history-springer-card">
          <a class="history-book-cover-link" href={book.href} target="_blank" rel="noopener noreferrer">
            <img
              class="history-book-cover"
              src={book.cover}
              alt={`Обкладинка книги ${book.title}`}
              loading="lazy"
              width="180"
              height="271"
            />
          </a>

          <div class="history-book-details">
            <div class="history-book-kicker">
              <span>{book.year}</span>
              <span>{book.series}</span>
            </div>
            <h4>{book.title}</h4>
            {book.subtitle && <p class="history-book-subtitle">{book.subtitle}</p>}
            <p class="history-book-editors"><strong>Редактори:</strong> {book.editors}</p>
            <p>{book.description}</p>

            <dl class="history-book-meta">
              <div><dt>Обсяг</dt><dd>{book.pages}</dd></div>
              <div><dt>Зміст</dt><dd>{book.chapters}</dd></div>
              <div><dt>Ілюстрації</dt><dd>{book.illustrations}</dd></div>
              <div><dt>DOI</dt><dd>{book.doi}</dd></div>
            </dl>

            <a class="button secondary" href={book.href} target="_blank" rel="noopener noreferrer">
              Сторінка книги у Springer
            </a>
          </div>
        </article>
      ))}
    </div>

    <article class="panel history-upcoming-book">
      <div class="history-upcoming-year">2026</div>
      <div>
        <p class="eyebrow">Наступне видання</p>
        <h3>Fracture Mechanics and Adjacent Fields: Insights from Ukrainian Research</h3>
        <p>
          У вересні 2026 року у видавництві Springer заплановано опублікувати двотомну
          колективну монографію, присвячену механіці руйнування та суміжним напрямам
          українських механічних шкіл.
        </p>
      </div>
    </article>

    <article class="panel history-journal-card">
      <div class="history-journal-mark" aria-hidden="true">
        <span>1955</span>
        <strong>ПМ</strong>
      </div>

      <div>
        <p class="eyebrow">Наукова періодика</p>
        <h3>«Прикладна механіка» / International Applied Mechanics</h3>
        <p>
          Журнал видається в Інституті з 1955 року. З 1965 року його англомовний переклад
          виходив під назвою <em>Soviet Applied Mechanics</em>, а з 1992 року —
          <em>International Applied Mechanics</em>. З 2004 року англомовне видання публікує Springer.
        </p>
        <p>
          Журнал друкує оригінальні й оглядові статті з механіки деформівного твердого тіла,
          механіки елементів конструкцій та інженерної механіки.
        </p>
        <a class="button primary" href="https://pm.inmech.kyiv.ua/" target="_blank" rel="noopener noreferrer">
          Відкрити сайт журналу
        </a>
      </div>
    </article>

    <p class="history-publications-note">
      Докладні бібліографічні переліки й тематичні добірки представлені в розділі
      <a href={withBase('/library/')}>«Наукова бібліотека»</a>.
    </p>
  </div>
</section>

<style>
  .history-publications-header {
    max-width: 920px;
    margin-bottom: 28px;
  }

  .history-publication-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .history-publication-stat {
    display: flex;
    min-height: 155px;
    flex-direction: column;
    justify-content: center;
    padding: 24px;
    text-align: center;
  }

  .history-publication-stat strong {
    color: var(--accent-dark);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1;
  }

  .history-publication-stat span {
    margin-top: 11px;
    color: var(--heading);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .history-books-overview {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    padding: clamp(24px, 4vw, 38px);
    margin-bottom: 34px;
  }

  .history-books-overview > div:first-child {
    max-width: 760px;
  }

  .history-books-overview h3,
  .history-springer-heading h3,
  .history-upcoming-book h3,
  .history-journal-card h3 {
    margin-top: 0;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
  }

  .history-card-actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 10px;
  }

  .history-springer-heading {
    margin-bottom: 18px;
  }

  .history-springer-grid {
    display: grid;
    gap: 20px;
    margin-bottom: 24px;
  }

  .history-springer-card {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 40px);
    padding: clamp(22px, 4vw, 38px);
    align-items: start;
  }

  .history-book-cover-link {
    display: block;
    width: 180px;
    border-radius: 10px;
    box-shadow: 0 14px 28px rgba(15, 31, 52, 0.16);
    overflow: hidden;
  }

  .history-book-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 180 / 271;
    object-fit: cover;
  }

  .history-book-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .history-book-kicker span {
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.76rem;
    font-weight: 850;
  }

  .history-book-details h4 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    line-height: 1.15;
  }

  .history-book-subtitle {
    margin: 6px 0 0;
    color: var(--heading);
    font-size: 1.03rem;
    font-weight: 750;
  }

  .history-book-editors {
    margin-top: 16px;
    font-size: 0.9rem;
  }

  .history-book-details > p {
    color: var(--muted);
    line-height: 1.55;
  }

  .history-book-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 20px;
    margin: 18px 0 22px;
  }

  .history-book-meta div {
    padding-top: 9px;
    border-top: 1px solid var(--line);
  }

  .history-book-meta dt {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .history-book-meta dd {
    margin: 4px 0 0;
    color: var(--heading);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .history-upcoming-book {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 40px);
    align-items: center;
    padding: clamp(24px, 4vw, 38px);
    margin-bottom: 24px;
  }

  .history-upcoming-year {
    display: grid;
    min-height: 110px;
    place-items: center;
    border-radius: 22px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 2rem;
    font-weight: 900;
  }

  .history-upcoming-book p:last-child {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .history-journal-card {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 40px);
    align-items: center;
    padding: clamp(24px, 4vw, 40px);
  }

  .history-journal-mark {
    display: grid;
    min-height: 180px;
    place-items: center;
    align-content: center;
    gap: 6px;
    border-radius: 24px;
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .history-journal-mark span {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .history-journal-mark strong {
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1;
  }

  .history-journal-card p {
    color: var(--muted);
    line-height: 1.58;
  }

  .history-journal-card .button {
    margin-top: 8px;
  }

  .history-publications-note {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .history-publications-note a {
    font-weight: 800;
  }

  @media (max-width: 820px) {
    .history-publication-stats {
      grid-template-columns: 1fr;
    }

    .history-publication-stat {
      min-height: 125px;
    }

    .history-books-overview {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 680px) {
    .history-springer-card,
    .history-upcoming-book,
    .history-journal-card {
      grid-template-columns: 1fr;
    }

    .history-book-cover-link {
      margin-inline: auto;
    }

    .history-book-meta {
      grid-template-columns: 1fr;
    }

    .history-upcoming-year {
      min-height: 90px;
    }

    .history-journal-mark {
      min-height: 145px;
    }
  }
</style>
