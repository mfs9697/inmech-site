---
import { defendedDissertationsA } from '../data/defendedDissertationsA';
import { defendedDissertationsB } from '../data/defendedDissertationsB';
import { defendedDissertationsV } from '../data/defendedDissertationsV';
import { defendedDissertationsG } from '../data/defendedDissertationsG';
import { defendedDissertationsD } from '../data/defendedDissertationsD';
import { defendedDissertationsE } from '../data/defendedDissertationsE';
import { defendedDissertationsZh } from '../data/defendedDissertationsZh';
import { defendedDissertationsZ } from '../data/defendedDissertationsZ';
import { defendedDissertationsI } from '../data/defendedDissertationsI';
import { defendedDissertationsK } from '../data/defendedDissertationsK';
import { defendedDissertationsL } from '../data/defendedDissertationsL';
import { defendedDissertationsM } from '../data/defendedDissertationsM';
import { defendedDissertationsN } from '../data/defendedDissertationsN';
import { defendedDissertationsO } from '../data/defendedDissertationsO';
import { defendedDissertationsP } from '../data/defendedDissertationsP';
import { defenseMaterialsArchiveGroups } from '../data/defenseMaterialsArchive';

const catalog = [
  { letter: 'А', items: defendedDissertationsA },
  { letter: 'Б', items: defendedDissertationsB },
  { letter: 'В', items: defendedDissertationsV },
  { letter: 'Г', items: defendedDissertationsG },
  { letter: 'Д', items: defendedDissertationsD },
  { letter: 'Е', items: defendedDissertationsE },
  { letter: 'Ж', items: defendedDissertationsZh },
  { letter: 'З', items: defendedDissertationsZ },
  { letter: 'И', items: defendedDissertationsI },
  { letter: 'К', items: defendedDissertationsK },
  { letter: 'Л', items: defendedDissertationsL },
  { letter: 'М', items: defendedDissertationsM },
  { letter: 'Н', items: defendedDissertationsN },
  { letter: 'О', items: defendedDissertationsO },
  { letter: 'П', items: defendedDissertationsP }
];

const totalItems = catalog.reduce((sum, group) => sum + group.items.length, 0);
const totalArchiveItems = defenseMaterialsArchiveGroups.reduce((sum, [, items]) => sum + items.length, 0);
---

<section class="section" id="defended-catalog">
  <div class="container">
    <div class="section-heading compact-header">
      <div>
        <p class="eyebrow">Каталог</p>
        <h2>Захищені дисертації</h2>
      </div>
      <p>
        Перший фрагмент алфавітного каталогу подано для літер А–П. У ньому розміщено {totalItems}
        бібліографічних записів зі старого розділу бібліотеки.
      </p>
    </div>

    <nav class="diss-alpha-nav" aria-label="Алфавітна навігація каталогу захищених дисертацій">
      {catalog.map((group) => (
        <a href={`#catalog-${group.letter}`}>{group.letter}</a>
      ))}
      <a class="archive-anchor" href="#defense-materials-archive">Архів</a>
    </nav>

    <div class="diss-note">
      <strong>Примітка.</strong> Це перший перенесений фрагмент повного каталогу. Записи залишено
      максимально близькими до бібліографічного формату старої сторінки; далі за цим самим
      шаблоном можна додати наступні літери. Окремо нижче подано архів матеріалів захистів
      попередніх років.
    </div>

    <div class="diss-groups">
      {catalog.map((group) => (
        <section class="diss-letter-group" id={`catalog-${group.letter}`}>
          <div class="diss-letter-header">
            <h3>{group.letter}</h3>
            <span>{group.items.length} {group.items.length === 1 ? 'запис' : 'записів'}</span>
          </div>

          <div class="diss-card-grid">
            {group.items.map((item) => (
              <article class="diss-card">
                <h4>{item.name}</h4>
                <p class="diss-title">{item.title}</p>
                <p class="diss-details">{item.details}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<section class="section" id="defense-materials-archive">
  <div class="container">
    <div class="section-heading compact-header">
      <div>
        <p class="eyebrow">Архів</p>
        <h2>Матеріали попередніх захистів</h2>
      </div>
      <p>
        Архів матеріалів захистів за 2015–2021 роки перенесено до каталогу. Усього подано
        {totalArchiveItems} записів із посиланнями на автореферати, дисертації та відеозаписи, якщо вони є.
      </p>
    </div>

    <div class="archive-material-groups">
      {defenseMaterialsArchiveGroups.map(([year, items]) => (
        <section class="archive-material-group">
          <div class="diss-letter-header">
            <h3>{year}</h3>
            <span>{items.length} {items.length === 1 ? 'запис' : 'записів'}</span>
          </div>

          <div class="archive-material-grid">
            {items.map((item) => (
              <article class="archive-material-card">
                <h4>{item.name}</h4>
                <div class="archive-material-links">
                  {item.links.map(([label, href]) => (
                    <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .diss-alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }

  .diss-alpha-nav a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--accent-dark);
    font-weight: 950;
    box-shadow: var(--shadow);
  }

  .diss-alpha-nav a.archive-anchor {
    width: auto;
    padding: 0 14px;
  }

  .diss-alpha-nav a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  .diss-note {
    margin-bottom: 18px;
    padding: 16px 18px;
    border-left: 5px solid var(--accent);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--muted);
  }

  .diss-groups,
  .archive-material-groups {
    display: grid;
    gap: 18px;
  }

  .diss-letter-group,
  .diss-card,
  .archive-material-group,
  .archive-material-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .diss-letter-group,
  .archive-material-group {
    padding: clamp(18px, 3vw, 28px);
  }

  .diss-letter-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .diss-letter-header h3 {
    margin: 0;
    color: var(--accent-dark);
    font-size: 1.42rem;
  }

  .diss-letter-header span {
    color: var(--muted);
    font-weight: 850;
  }

  .diss-card-grid,
  .archive-material-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .diss-card,
  .archive-material-card {
    padding: 16px 18px;
    box-shadow: none;
    background: var(--surface-soft);
  }

  .diss-card h4,
  .archive-material-card h4 {
    margin: 0 0 10px;
    color: var(--accent-dark);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .diss-title {
    margin: 0 0 12px;
    color: var(--text);
    font-weight: 850;
    line-height: 1.35;
  }

  .diss-details {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .archive-material-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .archive-material-links a {
    display: inline-flex;
    padding: 7px 11px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent-dark);
    font-weight: 850;
  }

  .archive-material-links a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .diss-card-grid,
    .archive-material-grid {
      grid-template-columns: 1fr;
    }

    .diss-letter-header {
      display: block;
    }

    .diss-letter-header span {
      display: block;
      margin-top: 10px;
    }
  }
</style>
