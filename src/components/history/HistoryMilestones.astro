---
import { historyMilestones } from '../../data/history';
---

<section class="section history-content-section history-milestones-section">
  <div class="container">
    <div class="section-header history-milestones-header">
      <div>
        <p class="eyebrow">Назва установи</p>
        <h2 class="section-title">Як змінювалася назва Інституту</h2>
        <p class="section-text">
          Кожна зміна назви відображала розширення структури, завдань і наукового профілю установи.
        </p>
      </div>
    </div>

    <div class="history-milestones-grid">
      {historyMilestones.map((item) => (
        <article class="panel history-milestone-card">
          <div class="history-milestone-year">{item.year}</div>
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .history-milestones-header {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .history-milestones-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .history-milestone-card {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    min-height: 210px;
    padding: clamp(22px, 3vw, 32px);
  }

  .history-milestone-year {
    display: grid;
    min-height: 88px;
    place-items: center;
    padding: 12px;
    border-radius: 18px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.25;
    text-align: center;
  }

  .history-milestone-card h3 {
    margin: 0 0 10px;
    color: var(--heading);
    font-size: clamp(1.18rem, 2vw, 1.45rem);
    line-height: 1.3;
  }

  .history-milestone-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .history-milestones-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .history-milestone-card {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .history-milestone-year {
      min-height: 64px;
    }
  }
</style>
