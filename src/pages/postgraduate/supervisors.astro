const potentialSupervisors = [
  {
    name: 'Юрчук Василь Миколайович',
    degree: 'доктор фізико-математичних наук',
    area: 'хвильові процеси, механіка структурно неоднорідних матеріалів, математичне моделювання у механіці'
  },
  {
    name: 'Кіпніс Олександр Леонідович',
    degree: 'кандидат фізико-математичних наук',
    area: 'стійкість тонкоплівкових систем, механіка покриттів, контактні та міжфазні задачі'
  },
  {
    name: 'Борисенко Максим Юрійович',
    degree: 'доктор технічних наук',
    area: 'чисельний аналіз механічної поведінки оболонкових систем, педагогіка і методика викладання прикладної математики'
  },
  {
    name: 'Хорошун Анатолій Сергійович',
    degree: 'доктор фізико-математичних наук',
    area: 'прикладна математика, механіка деформівного твердого тіла, моделювання складних механічних систем'
  },
  {
    name: 'Григоренко Олександр Ярославович',
    degree: 'доктор фізико-математичних наук, професор, академік НАН України',
    area: 'механіка оболонок, чисельний аналіз напружено-деформованого стану, прикладна теорія оболонок'
  },
  {
    name: 'Селіванов Михайло Федорович',
    degree: 'доктор фізико-математичних наук, член-кореспондент НАН України',
    area: 'механіка руйнування, когезійні моделі тріщин, в’язкопружність, чисельне моделювання росту тріщин'
  }
];

const initials = (name: string) => name.split(' ').slice(0, 2).map((part) => part[0]).join('');
---

<BaseLayout
  title={`Викладачі і наукові керівники | ${site.shortName}`}
  description="Викладачі освітньо-наукової програми та потенційні наукові керівники аспірантів Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/postgraduate/')}>Аспірантура</a>
      <span>›</span>
      <span>Викладачі і наукові керівники</span>
    </nav>

    <section class="page-hero">
      <p class="eyebrow">Кадрове забезпечення ОНП</p>
      <h1>Викладачі і наукові керівники</h1>
      <p class="lead">
        На сторінці подано викладачів обов’язкових і вибіркових компонентів освітньо-наукової програми,
        а також потенційних наукових керівників аспірантів за спеціальністю прикладна математика.
      </p>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Обов’язкові компоненти</p>
          <h2>Викладачі обов’язкових дисциплін</h2>
        </div>
      </div>
      <div class="course-grid">
        {requiredCourseTeachers.map((item) => (
          <article class="course-card">
            <span>{item.code}</span>
            <h3>{item.course}</h3>
            <p>{item.teachers}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Вибіркові компоненти</p>
          <h2>Викладачі вибіркових дисциплін</h2>
        </div>
      </div>
      <div class="table-panel">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Код</th>
                <th>Назва дисципліни</th>
                <th>Викладачі</th>
              </tr>
            </thead>
            <tbody>
              {electiveCourseTeachers.map(([code, course, teachers]) => (
                <tr>
                  <td>{code}</td>
                  <td>{course}</td>
                  <td>{teachers}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Наукове керівництво</p>
          <h2>Потенційні наукові керівники аспірантів</h2>
        </div>
        <p>Цей перелік використовується на сторінці вступу, але тут подано його у зручнішому розгорнутому вигляді.</p>
      </div>
      <div class="supervisor-grid">
        {potentialSupervisors.map((person) => (
          <article class="supervisor-card">
            <div class="avatar" aria-hidden="true">{initials(person.name)}</div>
            <div>
              <h3>{person.name}</h3>
              <p class="degree">{person.degree}</p>
              <p>{person.area}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .postgraduate-page { max-width: 1180px; margin: 0 auto; padding: 46px 20px 72px; }
  .breadcrumbs { display: flex; gap: 10px; align-items: center; margin-bottom: 22px; color: var(--muted); font-weight: 750; }
  .page-hero, .course-card, .table-panel, .supervisor-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .page-hero { padding: clamp(28px, 5vw, 52px); }
  .page-hero h1 { margin: 0 0 18px; font-size: clamp(2.2rem, 4.8vw, 4.3rem); line-height: 1.04; letter-spacing: -0.04em; }
  .lead { max-width: 920px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .section-block { margin-top: 34px; }
  .course-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .course-card { padding: 22px; }
  .course-card span { display: inline-block; margin-bottom: 12px; padding: 6px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-dark); font-weight: 850; }
  .course-card h3 { margin: 0 0 12px; font-size: 1.15rem; }
  .course-card p, .supervisor-card p { color: var(--muted); line-height: 1.65; }
  .table-panel { overflow: hidden; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; min-width: 860px; border-collapse: collapse; }
  th, td { padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  th { background: var(--accent-dark); color: #fff; font-size: 0.9rem; }
  td { color: var(--muted); }
  td:first-child { color: var(--text); font-weight: 850; white-space: nowrap; }
  .supervisor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .supervisor-card { display: flex; gap: 18px; padding: 24px; }
  .avatar { display: grid; place-items: center; flex: 0 0 auto; width: 72px; height: 72px; border-radius: 24px; background: var(--accent-soft); color: var(--accent-dark); font-weight: 950; }
  .supervisor-card h3 { margin: 0 0 8px; font-size: 1.18rem; }
  .degree { margin: 0 0 10px; font-weight: 800; }
  @media (max-width: 920px) { .course-grid, .supervisor-grid { grid-template-columns: 1fr; } }
</style>
