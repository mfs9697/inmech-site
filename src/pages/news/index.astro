---
import { getCollection } from 'astro:content';
import YearArchive from '../../components/YearArchive.astro';
import { getInstituteNews, getInstituteNewsYears } from '../../utils/newsArchive';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { site } from '../../data/site';
import { allowedNewsTags, getVisibleNewsTags } from '../../utils/newsTags';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const allNews = await getCollection('news');
const news = getInstituteNews(allNews);
const years = getInstituteNewsYears(allNews);

const tags = allowedNewsTags.filter((tag) => news.some((entry) => getVisibleNewsTags(entry).includes(tag)));
---

<BaseLayout
  title={`Новини | ${site.name}`}
  description="Новини Інституту механіки ім. С. П. Тимошенка НАН України за всі доступні роки."
  activePage="news"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Новини</p>
        <h1>Новини Інституту</h1>
        <p class="lead">
          Усі опубліковані новини Інституту за роками. Оберіть потрібний рік або скористайтеся тегами.
        </p>

        <YearArchive years={years} lang="uk" />

        {tags.length > 0 && (
          <nav class="tag-nav" aria-label="Фільтр новин за тегами">
            <a class="tag-filter active" href={withBase('/news/')}>Усі новини</a>
            {tags.map((tag) => (
              <a class="tag-filter" href={withBase(`/news/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
            ))}
          </nav>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {news.length > 0 ? (
        <div class="news-list">
          {news.map((entry) => <NewsCard entry={entry} />)}
        </div>
      ) : (
        <div class="empty-news-panel">
          <h2>Новини Інституту поки що не додано</h2>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .tag-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .tag-filter {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 750;
    text-decoration: none;
  }

  .tag-filter:hover,
  .tag-filter.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    text-decoration: none;
  }

  .empty-news-panel {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .empty-news-panel h2 {
    margin-top: 0;
  }
</style>
