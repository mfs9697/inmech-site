---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/journal.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const submissionEmail = 'prikl@inmech.kyiv.ua';
const submissionSubject = encodeURIComponent('Подання рукопису до журналу «Прикладна механіка»');
---

<BaseLayout
  title="Підготовка рукопису | Журнал «Прикладна механіка»"
  description="Докладні вимоги до підготовки та подання україномовних рукописів до журналу «Прикладна механіка»."
  activePage="publications"
>
  <div class="journal-page">
    <section class="journal-hero journal-guidelines-hero">
      <div class="container journal-hero-panel">
        <div class="journal-hero-copy" data-block-tone="neutral">
          <a class="card-link journal-breadcrumb" href={withBase('/journal/')}>← Повернутися до сторінки журналу</a>
          <p class="eyebrow">Авторам</p>
          <h1>Підготовка рукопису</h1>
          <p class="lead">
            Послідовна інструкція щодо комплекту подання, структури тексту, формул,
            ілюстрацій, списку літератури та матеріалів після прийняття статті.
          </p>
          <aside class="journal-intro-note" aria-label="Важлива інформація про маршрут подання">
            <p>
              Ці вимоги стосуються україномовних рукописів, що подаються до редакції журналу
              «Прикладна механіка». Оригінальні англомовні рукописи подаються до{' '}
              <em>International Applied Mechanics</em> через редакційну платформу Springer Nature
              відповідно до вимог видавця.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <nav class="journal-local-nav journal-guidelines-nav" aria-label="Розділи вимог до рукопису">
      <div class="container">
        <a href="#general">Загальні умови</a>
        <a href="#initial-submission">Первинне подання</a>
        <a href="#structure">Структура</a>
        <a href="#equations">Формули</a>
        <a href="#figures">Рисунки</a>
        <a href="#tables">Таблиці</a>
        <a href="#units">Величини й одиниці</a>
        <a href="#references">Література</a>
        <a href="#declarations">Декларації</a>
        <a href="#after-acceptance">Після прийняття</a>
        <a href="#checklist">Контрольний список</a>
      </div>
    </nav>

    <section class="journal-section" id="general">
      <div class="container">
        <div class="journal-panel" data-block-tone="heritage">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 1</p>
              <h2>Загальні умови подання</h2>
            </div>
            <p>Перед підготовкою файлів переконайтеся, що рукопис відповідає профілю журналу й умовам оригінальності.</p>
          </div>
          <ul>
            <li>Приймаються оригінальні дослідницькі та оглядові статті, які раніше не публікувалися й одночасно не розглядаються іншим виданням.</li>
            <li>Оглядову статтю бажано попередньо погодити з редакцією.</li>
            <li>Рекомендований обсяг рукопису — до 20 сторінок. Обґрунтовані винятки можливі за погодженням із редакцією.</li>
            <li>Ця інструкція регулює український редакційний маршрут. Оригінальні англомовні рукописи подаються через Springer Nature за вимогами видавця.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="journal-section" id="initial-submission">
      <div class="container">
        <div class="journal-panel" data-block-tone="information">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 2</p>
              <h2>Комплект первинного подання</h2>
            </div>
            <p>Для первинного рецензування надішліть один повний, придатний до редагування файл рукопису.</p>
          </div>
          <div class="journal-grid">
            <article class="journal-card">
              <h3>Файл і склад матеріалів</h3>
              <ul>
                <li>рекомендований формат — <code>.docx</code>; файли <code>.doc</code> також приймаються;</li>
                <li>текст, таблиці, редаговані формули та рисунки, вставлені біля першого посилання на них;</li>
                <li>LaTeX для українського редакційного маршруту поки не приймається.</li>
              </ul>
            </article>
            <article class="journal-card">
              <h3>Двомовні відомості</h3>
              <ul>
                <li>назва, відомості про авторів та установи — українською й англійською мовами;</li>
                <li>анотація обсягом 150–250 слів кожною мовою;</li>
                <li>4–6 ключових слів кожною мовою.</li>
              </ul>
            </article>
          </div>
          <div class="journal-subsection">
            <h3>Відомості про авторів</h3>
            <ul>
              <li>Зазначте контактного автора та електронні адреси авторів.</li>
              <li>Наведіть ORCID для всіх авторів, які його мають. Відсутність ORCID не блокує первинне рецензування.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="journal-section" id="structure">
      <div class="container">
        <div class="journal-panel" data-block-tone="neutral">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 3</p>
              <h2>Структура й оформлення рукопису</h2>
            </div>
            <p>Структура має давати змогу простежити постановку задачі, метод, результати та висновки.</p>
          </div>
          <div class="journal-grid">
            <article class="journal-card">
              <h3>Послідовність матеріалу</h3>
              <ol>
                <li>назва статті;</li>
                <li>автори, установи й контактні відомості;</li>
                <li>анотація та ключові слова;</li>
                <li>основний текст із логічними заголовками розділів;</li>
                <li>висновки;</li>
                <li>декларації;</li>
                <li>список літератури.</li>
              </ol>
            </article>
            <article class="journal-card">
              <h3>Основний текст</h3>
              <ul>
                <li>Times New Roman, 10 pt;</li>
                <li>одинарний міжрядковий інтервал;</li>
                <li>послідовна ієрархія заголовків і однакове оформлення однотипних елементів;</li>
                <li>усі частини рукопису мають залишатися доступними для редакційного опрацювання у Word.</li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="journal-section" id="equations">
      <div class="container">
        <div class="journal-panel" data-block-tone="information">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 4</p>
              <h2>Формули та математичні позначення</h2>
            </div>
            <p>Математичний матеріал повинен залишатися редагованим і використовувати послідовну систему позначень.</p>
          </div>
          <ul>
            <li>Створюйте формули засобами Word або MathType; не вставляйте формули як растрові зображення.</li>
            <li>Формули, на які є посилання в тексті, нумеруйте за розділами, наприклад <code>(2.13)</code>.</li>
            <li>Формули, на які немає посилань, можна не нумерувати.</li>
            <li>Використовуйте однакові позначення у формулах, тексті, таблицях і рисунках та пояснюйте їх під час першої появи.</li>
            <li>Змінні й позначення фізичних величин набирайте похилим шрифтом, а одиниці вимірювання, числа та назви функцій — прямим.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="journal-section" id="figures">
      <div class="container">
        <div class="journal-panel" data-block-tone="heritage">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 5</p>
              <h2>Рисунки і графіки</h2>
            </div>
            <p>Готуйте кожний рисунок для безпосереднього відтворення після приведення до остаточного розміру у статті.</p>
          </div>

          <div class="journal-subsection">
            <h3>Якість і читабельність</h3>
            <p>
              Усі лінії, маркери, написи, легенди та числові значення мають залишатися чіткими.
              Рисунки нумерують у порядку першого згадування та розміщують із підписами біля першого посилання в тексті.
            </p>
          </div>

          <div class="journal-grid">
            <article class="journal-card">
              <h3>Графіки</h3>
              <ul>
                <li>підписуйте всі осі та біля позначення фізичної величини зазначайте одиницю вимірювання;</li>
                <li>однозначно ідентифікуйте всі криві;</li>
                <li>розрізняйте криві не лише кольором, а й типом лінії, маркерами або іншими графічними засобами;</li>
                <li>не використовуйте декоративні фони, градієнти, тривимірні ефекти та надмірно густі координатні сітки;</li>
                <li>не розміщуйте написи поверх кривих або інших важливих елементів.</li>
              </ul>
            </article>
            <article class="journal-card">
              <h3>Шрифти та позначення</h3>
              <ul>
                <li>Times New Roman — для латиниці й кирилиці; Symbol — для грецької абетки;</li>
                <li>змінні та позначення фізичних величин — похилим шрифтом;</li>
                <li>одиниці вимірювання, числа, назви функцій і пояснювальний текст — прямим шрифтом;</li>
                <li>стиль позначень має відповідати формулам і тексту статті.</li>
              </ul>
            </article>
          </div>

          <div class="journal-subsection">
            <h3>Остаточний розмір і єдиний стиль</h3>
            <p>
              У межах одного рисунка розмір шрифту підписів осей, числових значень, легенд і пояснювальних
              написів має бути практично однаковим. Менший розмір допускається лише для індексів і допоміжних
              позначень. Після масштабування текст усередині рисунка має візуально відповідати основному тексту
              статті, тобто бути приблизно 10 pt.
            </p>
            <p>
              Для кількох рисунків однієї статті зберігайте однакові шрифти, розміри написів, товщини ліній,
              маркери й загальний стиль.
            </p>
          </div>

          <div class="journal-grid">
            <article class="journal-card">
              <h3>Файли та розміщення</h3>
              <p>
                Під час первинного подання вставте рисунки в рукопис біля першого посилання на них.
                Після прийняття редакція може попросити надати окремі файли. Бажані векторні формати.
              </p>
            </article>
            <article class="journal-card">
              <h3>Растрові матеріали</h3>
              <p>Рекомендована роздільна здатність за остаточного розміру:</p>
              <ul>
                <li>1200 dpi — штрихові рисунки;</li>
                <li>600 dpi — комбіновані зображення;</li>
                <li>300 dpi — фотографії.</li>
              </ul>
            </article>
          </div>

          <div class="journal-subsection">
            <h3>Колір</h3>
            <p>Колір дозволений, однак зміст рисунка не повинен передаватися виключно кольором.</p>
          </div>

          <aside class="journal-warning" aria-label="Важлива вимога до готовності рисунків">
            <p>
              <strong>Редакція не виконує перемальовування, технічного редагування або виправлення написів у рисунках.</strong>
            </p>
            <p>
              Якщо рисунки не відповідають установленим вимогам, авторам буде запропоновано переробити їх і
              повторно подати у придатному для публікації вигляді.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="journal-section" id="tables">
      <div class="container">
        <div class="journal-panel" data-block-tone="neutral">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 6</p>
              <h2>Таблиці</h2>
            </div>
            <p>Таблиці мають бути зрозумілими без дублювання тих самих даних у тексті або на графіках.</p>
          </div>
          <ul>
            <li>Створюйте таблиці редагованими засобами Word, а не як зображення.</li>
            <li>Нумеруйте таблиці в порядку першого згадування та додавайте коротку інформативну назву.</li>
            <li>Пояснюйте скорочення й позначення та наводьте одиниці вимірювання в заголовках відповідних стовпців або рядків.</li>
            <li>Розміщуйте таблицю після першого посилання на неї й перевіряйте, що вона читається в межах ширини сторінки.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="journal-section" id="units">
      <div class="container">
        <div class="journal-panel" data-block-tone="information">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 7</p>
              <h2>Фізичні величини й одиниці</h2>
            </div>
            <p>У всіх частинах рукопису використовуйте узгоджені позначення та одиниці SI.</p>
          </div>
          <ul>
            <li>Наводьте фізичні величини в одиницях SI.</li>
            <li>Подавайте одиниці вимірювання прямим шрифтом і однаково оформлюйте їх у тексті, формулах, таблицях та рисунках.</li>
            <li>Уникайте зміни позначення тієї самої величини в різних частинах статті.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="journal-section" id="references">
      <div class="container">
        <div class="journal-panel" data-block-tone="heritage">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 8</p>
              <h2>Список літератури</h2>
            </div>
            <p>Посилання мають однозначно пов’язувати цитування в тексті з повним бібліографічним описом.</p>
          </div>
          <ul>
            <li>Складіть один нумерований список у порядку першого цитування джерел.</li>
            <li>Оформлюйте посилання в тексті у квадратних дужках, наприклад <code>[1]</code> або <code>[2, 3]</code>.</li>
            <li>Перевірте повноту й точність бібліографічних відомостей для кожного джерела.</li>
            <li>Якщо джерело має DOI, подайте його як активне посилання у форматі <code>https://doi.org/...</code>.</li>
            <li>Відсоткового обмеження на самоцитування немає: редакція оцінює наукову доречність кожного джерела.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="journal-section" id="declarations">
      <div class="container">
        <div class="journal-panel" data-block-tone="neutral">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 9</p>
              <h2>Декларації та публікаційна етика</h2>
            </div>
            <p>Наприкінці рукопису наведіть усі обов’язкові декларації, навіть якщо для окремої з них інформація відсутня.</p>
          </div>
          <div class="journal-grid">
            <article class="journal-card">
              <h3>Внесок авторів (Author Contributions)</h3>
              <p>
                Вкажіть внесок кожного автора в постановку задачі, розроблення методики, виконання розрахунків
                або експериментів, аналіз результатів і підготовку чи редагування тексту.
              </p>
            </article>
            <article class="journal-card">
              <h3>Фінансування (Funding)</h3>
              <p>
                Назвіть установи або організації, які фінансували дослідження, та наведіть номери грантів або
                проєктів. Якщо спеціального фінансування не було, зазначте це.
              </p>
            </article>
            <article class="journal-card">
              <h3>Конфлікт інтересів (Conflict of Interest / Competing Interests)</h3>
              <p>
                Розкрийте фінансові чи нефінансові інтереси, які могли вплинути на результати або їх
                інтерпретацію. Якщо конфлікту інтересів немає, прямо зазначте його відсутність.
              </p>
            </article>
            <article class="journal-card">
              <h3>Доступність даних (Data Availability)</h3>
              <p>
                Зазначте, де і на яких умовах доступні дані, програмні матеріали або інші результати, на яких
                ґрунтується дослідження. Якщо ця декларація до роботи не застосовується, зазначте це.
              </p>
            </article>
          </div>
          <div class="journal-subsection">
            <h3>Використання штучного інтелекту</h3>
            <p>
              Штучний інтелект не може бути зазначений автором статті. Змістове використання інструментів
              штучного інтелекту під час дослідження або підготовки рукопису потрібно розкрити. Звичайне мовне
              редагування окремо декларувати не потрібно.
            </p>
          </div>
          <div class="journal-note">
            <p>
              Подання рукопису підтверджує його оригінальність, відсутність одночасного розгляду іншим виданням,
              коректність авторства та правдивість поданих декларацій.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="journal-section" id="after-acceptance">
      <div class="container">
        <div class="journal-panel" data-block-tone="information">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 10</p>
              <h2>Матеріали після прийняття</h2>
            </div>
            <p>Після рішення про прийняття редакція повідомить, які фінальні матеріали потрібно надати.</p>
          </div>
          <ul>
            <li>Надішліть остаточний виправлений файл Word і перевірені двомовні відомості про статтю та авторів.</li>
            <li>На запит редакції надайте рисунки окремими файлами у придатному для публікації форматі та роздільній здатності.</li>
            <li>Переконайтеся, що фінальні формули, таблиці, посилання й декларації відповідають прийнятій версії.</li>
            <li>Документи щодо авторських прав оформлюються лише після прийняття статті; застарілий договір про передачу авторських прав не використовується.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="journal-section" id="checklist">
      <div class="container">
        <div class="journal-panel" data-block-tone="emphasis">
          <div class="journal-section-heading">
            <div>
              <p class="eyebrow">Крок 11</p>
              <h2>Контрольний список перед поданням</h2>
            </div>
            <p>Перевірте комплект перед надсиланням до редакції.</p>
          </div>
          <ul class="journal-checklist">
            <li>Рукопис оригінальний і не розглядається іншим виданням.</li>
            <li>Файл підготовлено у форматі <code>.docx</code> або <code>.doc</code>.</li>
            <li>Обсяг не перевищує рекомендованих 20 сторінок або виняток обґрунтовано.</li>
            <li>Основний текст набрано Times New Roman, 10 pt, з одинарним інтервалом.</li>
            <li>Назву, авторські відомості, установи, анотацію та ключові слова подано двома мовами.</li>
            <li>Кожна анотація має 150–250 слів, а кожний перелік — 4–6 ключових слів.</li>
            <li>Визначено контактного автора й наведено електронні адреси та наявні ORCID.</li>
            <li>Формули редаговані та правильно пронумеровані.</li>
            <li>Рисунки читабельні в остаточному розмірі, а графіки не залежать лише від кольору.</li>
            <li>Таблиці редаговані, позначення узгоджені, використано одиниці SI.</li>
            <li>Список літератури один, нумерований за першим цитуванням; DOI подано активними посиланнями.</li>
            <li>Додано всі обов’язкові декларації та розкрито змістове використання ШІ.</li>
          </ul>
          <div class="journal-actions journal-guidelines-link">
            <a class="button primary" href={`mailto:${submissionEmail}?subject=${submissionSubject}`}>Подати рукопис електронною поштою</a>
            <a class="button secondary" href={withBase('/journal/')}>Повернутися до сторінки журналу</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
