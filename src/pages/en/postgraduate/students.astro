        supervisor: 'Volodymyr A. Maksymiuk, Doctor of Physical and Mathematical Sciences',
        publications: [],
        materials: 1
      },
      {
        name: 'Yurii Nazarchuk',
        photo: `${photoBase}nazarchuk.png`,
