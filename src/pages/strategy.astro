---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const strategyPdf = 'https://inmech.kyiv.ua/doc/doc/strategy.pdf';

const values = [
  'високий професіоналізм',
  'академічна доброчесність і наукова етика',
  'креативність і командний дух',
  'відкритість, взаємодія та відповідальність',
  'академічна свобода і саморозвиток',
  'внесок у світову науку та міжнародне співробітництво'
];

const researchDirections = [
  {
    title: 'Механіка композитних та неоднорідних середовищ',
    text: 'Дослідження композитних та нанокомпозитних матеріалів, некласичної механіки руйнування, ауксетичних матеріалів, хвильових процесів та високопродуктивних обчислень.'
  },
  {
    title: 'Механіка оболонкових систем',
    text: 'Розроблення чисельних і чисельно-аналітичних підходів до аналізу структурно та конструктивно неоднорідних оболонок, шаруватих систем і складних оболонкових елементів.'
  },
  {
    title: 'Механіка зв’язних полів у матеріалах та елементах конструкцій',
    text: 'Дослідження термомеханічної поведінки, довговічності та взаємодії механічних, температурних, електромагнітних полів у матеріалах та елементах конструкцій.'
  },
  {
    title: 'Механіка руйнування та втома',
    text: 'Побудова моделей довготривалого руйнування, аналіз кінетики поширення тріщин, розрахунок довговічності та дослідження відтермінованого руйнування полімерів і композитів.'
  },
  {
    title: 'Динаміка та стійкість руху механічних систем',
    text: 'Розроблення якісних і аналітичних методів дослідження динаміки, стійкості, контактної взаємодії, гідропружних систем і керування рухом аерокосмічних систем.'
  }
];

const strategicTasks = [
  {
    title: 'Кадрова наступність',
    text: 'Збереження й ефективне відтворення кадрового складу, формування наукової спадкоємності та передавання досвіду молодим ученим.'
  },
  {
    title: 'Аспірантура та якість освіти',
    text: 'Удосконалення освітньо-наукової програми зі спеціальності «113 Прикладна математика», розвиток академічної мобільності та посилення практичної складової підготовки.'
  },
  {
    title: 'Міжнародна співпраця',
    text: 'Розвиток партнерств із закордонними установами, участь у міжнародних проєктах, конференціях, спільних публікаціях і редакційних колегіях.'
  },
  {
    title: 'Публікації та конференції',
    text: 'Підтримка міжнародного журналу «Прикладна механіка», проведення наукових конференцій і підвищення видимості результатів досліджень.'
  },
  {
    title: 'Інфраструктура та фінансування',
    text: 'Зміцнення матеріально-технічної бази, розвиток Центру колективного користування приладами та розширення доступу до наукових видань і баз даних.'
  }
];
---

<BaseLayout
  title={`Стратегія розвитку | ${site.name}`}
  description="Стратегія розвитку та перспективні напрями наукової діяльності Інституту механіки ім. С.П. Тимошенка НАН України."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel strategy-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>Стратегія розвитку</h1>
        <p class="lead">
          Стратегія розвитку Інституту механіки ім. С. П. Тимошенка НАН України на 2021–2025 роки
          визначає місію, візію, цінності, перспективні напрями наукової діяльності та основні
          завдання установи.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={strategyPdf} target="_blank" rel="noopener">
            Відкрити повний документ PDF
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container strategy-grid two-columns">
      <article class="panel strategy-card highlight-card">
        <p class="eyebrow">Місія</p>
        <h2>Нові знання для науки й практики</h2>
        <p>
          Місія Інституту полягає у проведенні досліджень для одержання нових фундаментальних
          знань у сфері механіки та їх використання для практичних цілей, підготовці
          висококваліфікованих наукових кадрів і сприянні інноваційному розвитку України.
        </p>
      </article>

      <article class="panel strategy-card highlight-card">
        <p class="eyebrow">Візія</p>
        <h2>Провідна установа в галузі механіки</h2>
        <p>
          Візія Інституту полягає у зміцненні позицій провідної установи України в галузі
          механіки та прикладної математики, із розвитком сильних наукових шкіл і сучасних
          дослідницьких напрямів.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Цінності</p>
          <h2 class="section-title">Принципи діяльності Інституту</h2>
          <p class="section-text">
            У документі наголошено на поєднанні професіоналізму, академічної доброчесності,
            відкритості, відповідальності та міжнародної інтеграції.
          </p>
        </div>
      </div>

      <div class="value-grid">
        {values.map((value) => <div class="value-card">{value}</div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Перспективні напрями</p>
          <h2 class="section-title">Наукова діяльність</h2>
          <p class="section-text">
            Пріоритетні напрями сформульовано відповідно до наукового профілю Інституту та
            його статутних завдань.
          </p>
        </div>
      </div>

      <div class="strategy-grid">
        {researchDirections.map((item) => (
          <article class="panel strategy-card">
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Стратегічні завдання</p>
          <h2 class="section-title">Розвиток Інституту</h2>
          <p class="section-text">
            Окрему увагу приділено кадровій політиці, освітньо-науковій діяльності,
            міжнародній співпраці, публікаційній активності та зміцненню матеріальної бази.
          </p>
        </div>
      </div>

      <div class="strategy-grid">
        {strategicTasks.map((item) => (
          <article class="panel strategy-card">
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel strategy-note">
        <p class="eyebrow">Документ</p>
        <h2>Повний текст стратегії</h2>
        <p>
          Повний документ містить детальний перелік наукових завдань за кожним напрямом,
          опис заходів з розвитку аспірантури, міжнародної співпраці, журналу «Прикладна механіка»,
          конференційної діяльності, грантового фінансування та матеріально-технічної бази.
        </p>
        <a class="button secondary" href={strategyPdf} target="_blank" rel="noopener">
          Завантажити або відкрити PDF
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
