---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DissertationArchiveGallery from '../../../../components/DissertationArchiveGallery.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (url: string) => `${base}/${url.replace(/^\/+/, '')}`;
---

<BaseLayout
  title="Дисертації архівної папки 2021 | Інститут механіки"
  description="Дисертації з архівної папки 2021 року: автори, назви робіт, ступені та посилання на збережені оригінали документів."
  activePage="education"
>
  <div class="archive-page">
    <div class="archive-container">
      <nav class="archive-breadcrumbs" aria-label="Навігаційний шлях">
        <a href={withBase('/dissertations/')}>Захист дисертацій</a>
        <span aria-hidden="true">›</span>
        <a href={withBase('/dissertations/archive/')}>Історичний архів</a>
        <span aria-hidden="true">›</span>
        <span>2021</span>
      </nav>
      <header class="archive-hero">
        <p class="archive-eyebrow">Історичний архів дисертацій</p>
        <h1>Дисертації з архівної папки 2021 року</h1>
        <p>Імена здобувачів, назви робіт, ступені та спеціальності наведено за титульними сторінками наявних оригінальних документів. Рік архівної папки не обов’язково є датою захисту.</p>
        <p class="archive-disclaimer">Там, де оригінал не вдалося безпечно дослідити або відповідність документів не підтверджено, у картці наведено застереження. Для DOC, ZIP і RAR з обмеженим доступом немає посилань на завантаження.</p>
      </header>
      <DissertationArchiveGallery lang="uk" archiveYear={2021} />
      <p class="return-link"><a href={withBase('/dissertations/archive/')}>← Усі картки історичного архіву</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .archive-page { padding: 34px 0 72px; }
  .archive-container { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }
  .archive-breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--muted); font-size: .9rem; margin-bottom: 24px; }
  .archive-hero { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(25px, 4.5vw, 48px); margin-bottom: 26px; box-shadow: var(--shadow); }
  .archive-eyebrow { color: var(--accent-dark); font-weight: 900; text-transform: uppercase; letter-spacing: .07em; font-size: .78rem; }
  .archive-hero h1 { font-size: clamp(2rem, 4vw, 3.3rem); line-height: 1.1; letter-spacing: -.03em; margin: 10px 0 18px; }
  .archive-hero p { max-width: 83ch; line-height: 1.65; color: var(--muted); }
  .archive-hero .archive-disclaimer { font-size: .9rem; }
  .return-link { margin-top: 28px; font-weight: 800; }
</style>
