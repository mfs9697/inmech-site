---
import { archiveYears } from '../data/site';

interface Props {
  activeYear?: number;
}

const { activeYear = 2026 } = Astro.props;
---

<nav class="year-nav" aria-label="Архів за роками">
  {archiveYears.map((year) => (
    <a class={year === activeYear ? 'active' : ''} href="#">{year}</a>
  ))}
</nav>
