---
import { siteEn } from '../data/site-en';

interface Props {
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { activePage = 'home' } = Astro.props;
const isActive = (page: Props['activePage']) => activePage === page ? 'active' : '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const englishSlugs = new Set([
  'history',
  'regulations',
  'strategy',
  'scientific-cooperation',
  'tender',
  'management',
  'departments',
  'scientific-council',
  'specialized-councils',
  'young-scientists',
  'services',
  'education',
  'postgraduate',
  'postgraduate/students',
  'doctoral',
  'dissertations',
  'defended-dissertations',
  'license-and-regulations',
  'trust-box',
  'nmr',
  'news',
  'library',
  'search',
  'sitemap',
  'accessibility',
  'site-administration'
]);

const enToUkFallbacks: Record<string, string> = {
  '/en/': '/'
};

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

function normalizePath(pathname: string) {
  let path = pathname;

  if (base && path === base) {
    path = '/';
  } else if (base && path.startsWith(`${base}/`)) {
    path = path.slice(base.length);
  }

  if (!path.startsWith('/')) {
    path = `/${path}`;
  }

  path = path.replace(/\/index\.html$/, '/');

  if (!path.endsWith('/')) {
    path = `${path}/`;
  }

  return path;
}

function getUkrainianPath(pathname: string) {
  const path = normalizePath(pathname);

  if (enToUkFallbacks[path]) {
    return enToUkFallbacks[path];
  }

  if (/^\/en\/departments\/[^/]+\/$/.test(path) || /^\/en\/people\/[^/]+\/$/.test(path)) {
    return path.replace(/^\/en/, '');
  }

  if (!path.startsWith('/en/')) {
    return '/';
  }

  const slug = path.replace(/^\/en\//, '').replace(/\/$/, '');

  if (englishSlugs.has(slug)) {
    return `/${slug}/`;
  }

  return '/';
}

const currentPath = normalizePath(Astro.url.pathname);
const ukrainianPath = getUkrainianPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="topbar">
    <div class="container">
      <span>{siteEn.officialLabel}</span>
      <div class="lang-switch" aria-label="Language selection">
        <a href={withBase(ukrainianPath)}>Українська</a>
        <a class="active" href={withBase(currentPath)} aria-current="page">English</a>
      </div>
    </div>
  </div>

  <div class="container header-main brand-main">
    <a class="brand" href={withBase('/en/')} aria-label="Home page">
      <img src={withBase('/assets/img/ImechLogo.svg?v=20260615-png-final')} alt="Logo of the Institute of Mechanics" />
      <span class="brand-text">
        <strong class="brand-title">{siteEn.name}</strong>
        <span class="brand-subtitle">{siteEn.subtitle}</span>
      </span>
    </a>
  </div>
</header>

<div class="nav-shell">
  <div class="container nav-row">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      Menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Main menu">
      <ul>
        <li><a class={isActive('home')} href={withBase('/en/')}>Home</a></li>
        <li><a class={isActive('about')} href={withBase('/en/history/')}>About</a></li>
        <li><a class={isActive('departments')} href={withBase('/en/departments/')}>Departments</a></li>
        <li><a class={isActive('education')} href={withBase('/en/education/')}>Education</a></li>
        <li><a class={isActive('news')} href={withBase('/en/news/')}>News</a></li>
        <li><a href={withBase('/en/#contacts')}>Contacts</a></li>
        <li><a class="search-nav-link" href={withBase('/en/search/')} aria-label="Search the site">Search</a></li>
      </ul>
    </nav>
  </div>
</div>