---
import { getCollection } from 'astro:content';
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';
import '../../../styles/profile.css';

export async function getStaticPaths() {
  const people = await getCollection('people');

  return people.map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const person = entry.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(url: string) {
  if (url.startsWith('http') || url.startsWith('mailto:') || url.startsWith('#')) {
    return url;
  }

  return `${base}${url.startsWith('/') ? url : `/${url}`}`;
}

function toEnglishPath(url?: string) {
  if (!url) return '';

  if (url.startsWith('/departments/') || url.startsWith('/people/')) {
    return `/en${url}`;
  }

  return url;
}

function getHIndex(value?: string) {
  if (!value) return '';

  const match = value.match(/h-index\s*:\s*\d+/i);
  return match ? match[0] : '';
}

const displayName = person.nameEn ?? person.name;
const originalName = person.nameEn ? person.name : '';
const position = person.positionEn ?? person.position;
const department = person.departmentEn ?? person.department;
const departmentUrl = toEnglishPath(person.departmentUrl);
const degree = person.degreeEn ?? person.degree;
const academicTitle = person.academicTitleEn ?? person.academicTitle;
const researchAreas = person.researchAreasEn.length > 0 ? person.researchAreasEn : person.researchAreas;
const professionalActivity = person.professionalActivityEn ?? person.professionalActivity;
const publicationGroups = person.publications
  .map((group) => ({
    title: group.titleEn ?? group.title,
    type: group.type,
    items: group.itemsEn ?? group.items
  }))
  .filter((group) => group.items.length > 0);

const hasEnglishFields = Boolean(
  person.nameEn ||
  person.positionEn ||
  person.departmentEn ||
  person.degreeEn ||
  person.academicTitleEn ||
  person.researchAreasEn.length > 0 ||
  person.professionalActivityEn ||
  person.publications.some((group) => group.titleEn || group.itemsEn?.length)
);

const initials = displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();

const keyProfiles = person.profiles.filter((profile) => profile.url);
const pageTitle = `${displayName} | ${siteEn.name}`;
const pageDescription = position
  ? `${displayName} — ${position}`
  : `${displayName} — staff profile at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine.`;
---

<BaseLayoutEn title={pageTitle} description={pageDescription} activePage="departments">
  <section class="profile-shell">
    <div class="container">
      <nav class="profile-breadcrumb" aria-label="Breadcrumb">
        <a href={withBase('/en/')}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/en/departments/')}>Research departments</a>
        {departmentUrl && (
          <>
            <span aria-hidden="true">/</span>
            <a href={withBase(departmentUrl)}>{department ?? 'Department'}</a>
          </>
        )}
      </nav>

      <article class="profile-hero-wow">
        <div class="profile-portrait-card">
          {person.photo ? (
            <img src={withBase(person.photo)} alt={`Photo: ${displayName}`} class="profile-photo-wow" loading="eager" />
          ) : (
            <div class="profile-photo-placeholder" aria-hidden="true">{initials}</div>
          )}
        </div>

        <div class="profile-intro-card">
          <p class="eyebrow">Staff profile</p>
          <h1>{displayName}</h1>
          {originalName && <p class="profile-name-en">{originalName}</p>}

          <div class="profile-role-stack">
            {position && <p><strong>Position:</strong> {position}</p>}
            {department && <p><strong>Department:</strong> {department}</p>}
            {degree && <p><strong>Academic degree:</strong> {degree}</p>}
            {academicTitle && <p><strong>Academic title:</strong> {academicTitle}</p>}
          </div>

          <div class="profile-actions">
            {person.email && <a class="profile-button primary" href={`mailto:${person.email}`}>Write an email</a>}
            {departmentUrl && <a class="profile-button secondary" href={withBase(departmentUrl)}>Department page</a>}
          </div>
        </div>
      </article>

      <section class="profile-layout">
        <aside class="profile-sidebar">
          {(person.email || person.phone || person.office) && (
            <section class="profile-panel compact">
              <h2>Contacts</h2>
              <dl class="profile-contact-list">
                {person.email && (
                  <>
                    <dt>E-mail</dt>
                    <dd><a href={`mailto:${person.email}`}>{person.email}</a></dd>
                  </>
                )}
                {person.phone && (
                  <>
                    <dt>Phone</dt>
                    <dd>{person.phone}</dd>
                  </>
                )}
                {person.office && (
                  <>
                    <dt>Office</dt>
                    <dd>{person.office}</dd>
                  </>
                )}
              </dl>
            </section>
          )}

          {keyProfiles.length > 0 && (
            <section class="profile-panel compact">
              <h2>Scientometric profiles</h2>
              <div class="metric-stack">
                {keyProfiles.map((profile) => {
                  const hIndex = getHIndex(profile.value);

                  return (
                    <article class={`metric-card metric-${profile.kind}`}>
                      <span>{profile.label}</span>
                      {hIndex && <strong>{hIndex}</strong>}
                      <a href={profile.url} target="_blank" rel="noopener">View profile →</a>
                    </article>
                  );
                })}
              </div>
            </section>
          )}
        </aside>

        <main class="profile-main">
          {!hasEnglishFields && (
            <section class="profile-panel">
              <div class="section-kicker">English profile</div>
              <h2>English version is being prepared</h2>
              <p>
                This page has been generated from the Institute staff database. A detailed English profile will be added gradually.
              </p>
              <p>
                <a href={withBase(`/people/${entry.id}/`)}>Open the Ukrainian profile →</a>
              </p>
            </section>
          )}

          {researchAreas.length > 0 && (
            <section class="profile-panel">
              <div class="section-kicker">Research profile</div>
              <h2>Research areas</h2>
              <ul class="research-list-wow">
                {researchAreas.map((area) => <li>{area}</li>)}
              </ul>
            </section>
          )}

          {professionalActivity && (
            <section class="profile-panel">
              <div class="section-kicker">Academic activity</div>
              <h2>Professional activity</h2>
              <p>{professionalActivity}</p>
            </section>
          )}

          {publicationGroups.length > 0 && (
            <section class="profile-panel">
              <div class="section-kicker">Selected publications</div>
              <h2>Publications</h2>
              <div class="publication-groups">
                {publicationGroups.map((group) => (
                  <section class="publication-group">
                    <h3>{group.title}</h3>
                    {group.type === 'ordered' ? (
                      <ol class="publication-list">
                        {group.items.map((item) => <li>{item}</li>)}
                      </ol>
                    ) : (
                      <ul class="publication-list unordered">
                        {group.items.map((item) => <li>{item}</li>)}
                      </ul>
                    )}
                  </section>
                ))}
              </div>
            </section>
          )}
        </main>
      </section>
    </div>
  </section>
</BaseLayoutEn>
