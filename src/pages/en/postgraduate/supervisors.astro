---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  return `${base}/${path.replace(/^\/+/, '')}`;
}
const photoBase = '/people/';

const requiredCourseTeachers = [
  { code: 'OC1', course: 'Philosophy of Science and Culture', teachers: 'S. V. Vilchynska, Candidate of Philosophical Sciences, Associate Professor; I. I. Litus, Candidate of Philosophical Sciences' },
  { code: 'OC2', course: 'Foreign Language for Professional Purposes for PhD Training to C1 Level', teachers: 'L. M. Rubashova, Candidate of Philological Sciences' },
  { code: 'OC3', course: 'Methodology, Organisation and Technology of Scientific Research in Mechanics', teachers: 'Ya. O. Zhuk, Doctor of Physical and Mathematical Sciences, Corresponding Member of the NAS of Ukraine; N. V. Vasylieva, Candidate of Physical and Mathematical Sciences' },
  { code: 'OC4', course: 'Advanced Course in Theoretical Mechanics', teachers: 'I. L. Ivanov, Candidate of Physical and Mathematical Sciences' },
  { code: 'OC5', course: 'Mechanics of Deformable Solids', teachers: 'M. F. Selivanov, Doctor of Physical and Mathematical Sciences, Corresponding Member of the NAS of Ukraine' },
  { code: 'OC6', course: 'Numerical Methods for Solving Problems of Applied Mathematics', teachers: 'I. V. Yanchevskyi, Doctor of Physical and Mathematical Sciences' },
  { code: 'OC7', course: 'Pedagogy and Methods of Teaching Applied Mathematics', teachers: 'M. Yu. Borysenko, Doctor of Technical Sciences' },
  { code: 'OC8', course: 'Teaching Practice', teachers: 'M. Yu. Borysenko, Doctor of Technical Sciences' }
];

const electiveCourseTeachers = [
  ['EC1', 'Nonlinear Theory of Shells with Openings', 'Ye. A. Storozhuk; V. A. Maksymyuk'],
  ['EC2', 'Analytical and Numerical Study of Stability and Fracture of Coated and Reinforced Composite Materials Using High-Performance Computing', 'V. A. Dekret; O. L. Kipnis'],
  ['EC3', 'Wave Propagation with Account of Structural Material Levels and Basic Deformation Properties', 'V. M. Yurchuk'],
  ['EC4', 'Fracture Mechanics of Viscoelastic Materials', 'Yu. O. Chornoivan'],
  ['EC5', 'Mathematical Models of Thermomechanics of Continua', 'Ya. O. Zhuk'],
  ['EC6', 'Dynamics of Structurally Heterogeneous Shells', 'A. S. Kolyadiuk'],
  ['EC7', 'Numerical Analysis of the Mechanical Behaviour of Shell Systems', 'M. Yu. Borysenko'],
  ['EC8', 'Stability and Motion Control of Complex Systems', 'I. L. Ivanov'],
  ['EC9', 'Methods for Determining Functions and Rheological Parameters in Nonlinear Viscoelasticity', 'B. P. Maslov'],
  ['EC10', 'Modern Numerical Methods for Applied Problems of Deformable Solid Mechanics', 'I. V. Yanchevskyi']
];

const potentialSupervisors = [
  { name: 'Vasyl M. Yurchuk', nameUk: 'Юрчук Василь Миколайович', degree: 'Doctor of Physical and Mathematical Sciences', photo: `${photoBase}yurchuk.png`, area: 'wave processes, mechanics of structurally heterogeneous materials, mathematical modelling in mechanics' },
  { name: 'Oleksandr L. Kipnis', nameUk: 'Кіпніс Олександр Леонідович', degree: 'Doctor of Physical and Mathematical Sciences', photo: `${photoBase}kipnis.png`, area: 'stability of thin-film systems, mechanics of coatings, contact and interface problems' },
  { name: 'Maksym Yu. Borysenko', nameUk: 'Борисенко Максим Юрійович', degree: 'Doctor of Technical Sciences', photo: `${photoBase}borysenko.png`, area: 'numerical analysis of shell systems; pedagogy and methods of teaching applied mathematics' },
  { name: 'Anatolii S. Khoroshun', nameUk: 'Хорошун Анатолій Сергійович', degree: 'Doctor of Physical and Mathematical Sciences', photo: `${photoBase}khoroshun.png`, area: 'applied mathematics, deformable solid mechanics, modelling of complex mechanical systems' },
  { name: 'Oleksandr Ya. Grygorenko', nameUk: 'Григоренко Олександр Ярославович', degree: 'Doctor of Physical and Mathematical Sciences, Professor, Academician of the NAS of Ukraine', photo: `${photoBase}grygorenko.png`, area: 'shell mechanics, numerical analysis of stress-strain state, applied theory of shells' },
  { name: 'Mykhailo F. Selivanov', nameUk: 'Селіванов Михайло Федорович', degree: 'Doctor of Physical and Mathematical Sciences, Corresponding Member of the NAS of Ukraine', photo: `${photoBase}selivanov.png`, area: 'fracture mechanics, cohesive crack models, viscoelasticity, numerical modelling of crack growth' }
];

const initials = (name: string) => name.split(/\s+/).slice(0, 2).map((part) => part[0]).join('');
---

<BaseLayoutEn
  title={`Teachers and research supervisors | ${siteEn.shortName}`}
  description="Teachers of the postgraduate educational and scientific programme and potential research supervisors at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href={withBase('/en/postgraduate/')}>Postgraduate studies</a><span>›</span><span>Teachers and supervisors</span></nav>
    <section class="page-hero"><p class="eyebrow">Academic staffing of the PhD programme</p><h1>Teachers and research supervisors</h1><p class="lead">This page lists teachers of compulsory and elective components of the educational and scientific programme, as well as potential research supervisors for postgraduate students in Applied Mathematics.</p><p><a href={withBase('/postgraduate/supervisors/')}>Ukrainian version</a></p></section>
    <section class="section-block"><div class="section-heading compact-header"><div><p class="eyebrow">Compulsory components</p><h2>Teachers of compulsory courses</h2></div></div><div class="course-grid">{requiredCourseTeachers.map((item) => (<article class="course-card"><span>{item.code}</span><h3>{item.course}</h3><p>{item.teachers}</p></article>))}</div></section>
    <section class="section-block"><div class="section-heading compact-header"><div><p class="eyebrow">Elective components</p><h2>Teachers of elective courses</h2></div></div><div class="table-panel"><div class="table-scroll"><table><thead><tr><th>Code</th><th>Course</th><th>Teachers</th></tr></thead><tbody>{electiveCourseTeachers.map(([code, course, teachers]) => (<tr><td>{code}</td><td>{course}</td><td>{teachers}</td></tr>))}</tbody></table></div></div></section>
    <section class="section-block"><div class="section-heading compact-header"><div><p class="eyebrow">Research supervision</p><h2>Potential research supervisors</h2></div><p>The same list is used on the admission page; here it is presented in expanded form.</p></div><div class="supervisor-grid">{potentialSupervisors.map((person) => (<article class="supervisor-card"><div class="supervisor-photo-frame">{person.photo && (<img src={withBase(person.photo)} alt={`Photo: ${person.name}`} loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />)}<div class={`avatar ${person.photo ? 'avatar-fallback' : ''}`} aria-hidden="true">{initials(person.name)}</div></div><div><h3>{person.name}</h3><p class="uk-name">{person.nameUk}</p><p class="degree">{person.degree}</p><p>{person.area}</p></div></article>))}</div></section>
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page{max-width:1180px;margin:0 auto;padding:46px 20px 72px}.breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:22px;color:var(--muted);font-weight:750}.page-hero,.course-card,.table-panel,.supervisor-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}.page-hero{padding:clamp(28px,5vw,52px)}.page-hero h1{margin:0 0 18px;font-size:clamp(2.2rem,4.8vw,4.3rem);line-height:1.04;letter-spacing:-.04em}.lead{max-width:920px;color:var(--muted);font-size:1.08rem;line-height:1.7}.section-block{margin-top:34px}.course-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.course-card{padding:22px}.course-card span{display:inline-block;margin-bottom:12px;padding:6px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent-dark);font-size:.78rem;font-weight:850}.course-card p,.supervisor-card p{color:var(--muted);line-height:1.6}.table-panel{overflow:hidden}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{padding:14px 16px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{background:var(--surface-soft);font-weight:850}.supervisor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.supervisor-card{display:grid;grid-template-columns:96px 1fr;gap:18px;padding:22px}.supervisor-photo-frame,.supervisor-photo-frame img,.avatar{width:96px;height:112px;border-radius:22px}.supervisor-photo-frame{border:1px solid var(--line);overflow:hidden;background:var(--surface-soft)}.supervisor-photo-frame img{display:block;object-fit:cover}.avatar{display:grid;place-items:center;color:var(--accent-dark);font-weight:850}.avatar-fallback{display:none}.uk-name{font-size:.92rem}.degree{font-weight:750}@media(max-width:860px){.course-grid,.supervisor-grid{grid-template-columns:1fr}.supervisor-card{grid-template-columns:1fr}}
</style>
