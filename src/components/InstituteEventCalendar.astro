---
import { instituteCalendarEmbedUrl, instituteGoogleCalendars } from '../data/instituteGoogleCalendars';

interface Props { lang?: 'uk' | 'en'; }
const { lang = 'uk' } = Astro.props;
const isEn = lang === 'en';
const monthUrl = instituteCalendarEmbedUrl('MONTH');
const agendaUrl = instituteCalendarEmbedUrl('AGENDA');
const originalUrl = 'https://old.inmech.kyiv.ua/l/ua/calendar_g/';
---

<section class="events-panel" data-institute-calendar data-month-url={monthUrl} data-agenda-url={agendaUrl} aria-label={isEn ? 'Institute events calendar' : 'Календар подій Інституту'}>
  <div class="events-topbar">
    <div class="events-heading">
      <p class="events-kicker">{isEn ? 'Institute schedule' : 'Розклад заходів'}</p>
      <h2>{isEn ? 'Explore events' : 'Перегляньте події'}</h2>
      <p>{isEn ? 'Browse all seven original Institute calendars in a single view.' : 'Усі сім календарів зі старого сайту Інституту — в одному місці.'}</p>
    </div>
    <div class="events-switch" role="group" aria-label={isEn ? 'Calendar display mode' : 'Вигляд календаря'}>
      <button type="button" data-calendar-mode="MONTH" aria-pressed="true">
        <span aria-hidden="true">▦</span> {isEn ? 'Month' : 'Місяць'}
      </button>
      <button type="button" data-calendar-mode="AGENDA" aria-pressed="false">
        <span aria-hidden="true">☷</span> {isEn ? 'Agenda' : 'Список'}
      </button>
    </div>
  </div>

  <div class="calendar-embed-frame" data-calendar-shell data-view="MONTH">
    <iframe
      data-calendar-iframe
      src={monthUrl}
      title={isEn ? 'Google Calendar of events at the Institute of Mechanics' : 'Google Календар подій Інституту механіки'}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>

  <div class="events-bottombar">
    <div class="events-source-indicator">
      <span class="events-live-dot" aria-hidden="true"></span>
      <span>{isEn ? `${instituteGoogleCalendars.length} original Google Calendars` : `${instituteGoogleCalendars.length} початкових Google-календарів`}</span>
      <span class="events-timezone">{isEn ? 'Kyiv time' : 'Час Києва'}</span>
    </div>
    <div class="events-links">
      <a href={monthUrl} target="_blank" rel="noopener noreferrer">{isEn ? 'Open in Google Calendar ↗' : 'Відкрити в Google Календарі ↗'}</a>
      <a href={originalUrl} target="_blank" rel="noopener noreferrer">{isEn ? 'Legacy page ↗' : 'Стара сторінка ↗'}</a>
    </div>
  </div>
  <p class="events-note">{isEn ? 'Event listings are loaded from Google Calendar. If the embedded view is blocked, use the external link above. Availability without signing into Google should be checked before publication.' : 'Події завантажуються безпосередньо з Google Календаря. Якщо вбудований календар не відображається, скористайтеся посиланням вище. Перед публікацією слід перевірити відображення без входу в Google.'}</p>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-institute-calendar]');
    if (!root) return;
    const frame = root.querySelector('[data-calendar-iframe]');
    const shell = root.querySelector('[data-calendar-shell]');
    const buttons = [...root.querySelectorAll('[data-calendar-mode]')];
    const mobile = window.matchMedia('(max-width: 680px)');
    let manualSelection = false;
    let currentMode = 'MONTH';

    function setMode(mode) {
      if (currentMode !== mode) {
        frame.src = mode === 'AGENDA' ? root.dataset.agendaUrl : root.dataset.monthUrl;
        currentMode = mode;
      }
      shell.dataset.view = mode;
      buttons.forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.calendarMode === mode));
      });
    }
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        manualSelection = true;
        setMode(button.dataset.calendarMode);
      });
    });

    if (mobile.matches) setMode('AGENDA');
    mobile.addEventListener('change', event => {
      if (!manualSelection) setMode(event.matches ? 'AGENDA' : 'MONTH');
    });
  })();
</script>

<style>
  .events-panel {
    background: var(--surface); border: 1px solid var(--line); border-radius: 22px;
    box-shadow: var(--shadow); padding: clamp(18px, 3vw, 32px); overflow: hidden;
  }
  .events-topbar { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 22px; margin-bottom: 22px; }
  .events-heading h2 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); letter-spacing: -.035em; margin: 0 0 6px; }
  .events-heading p:last-child { margin: 0; color: var(--muted); max-width: 650px; }
  .events-kicker { margin: 0 0 5px; color: var(--accent-dark); font-weight: 800; font-size: .73rem; letter-spacing: .1em; text-transform: uppercase; }
  .events-switch { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 13px; padding: 4px; gap: 3px; background: #f1f5fa; }
  .events-switch button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 42px; min-width: 110px; border: 0; background: transparent; border-radius: 9px; padding: 9px 15px; color: var(--text); font: inherit; font-weight: 750; cursor: pointer; }
  .events-switch button[aria-pressed="true"] { background: var(--accent); color: #fff; box-shadow: 0 3px 9px rgba(29,79,145,.15); }
  .events-switch button:not([aria-pressed="true"]):hover { background: #ddeafa; }
  .events-switch button:focus-visible, .events-links a:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .calendar-embed-frame { border: 1px solid var(--line); border-radius: 16px; background: #f8fbff; overflow: hidden; }
  .calendar-embed-frame iframe { display: block; width: 100%; height: 710px; border: 0; background: #fff; }
  .calendar-embed-frame[data-view="AGENDA"] iframe { height: 625px; }
  .events-bottombar { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 16px; padding: 20px 0 10px; }
  .events-source-indicator, .events-links { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .events-source-indicator { font-size: .82rem; font-weight: 750; color: var(--text); }
  .events-live-dot { width: 9px; height: 9px; border-radius: 50%; background: #159c83; flex: 0 0 auto; }
  .events-timezone { border-left: 1px solid var(--line); padding-left: 12px; color: var(--muted); font-weight: 550; }
  .events-links a { font-size: .84rem; font-weight: 750; }
  .events-note { color: var(--muted); font-size: .83rem; margin: 6px 0 0; }
  @media (max-width: 680px) {
    .events-panel { padding: 17px 13px; }
    .events-topbar { gap: 16px; margin-bottom: 16px; }
    .events-switch { width: 100%; }
    .events-switch button { flex: 1; }
    .calendar-embed-frame iframe { height: 610px; }
    .calendar-embed-frame[data-view="AGENDA"] iframe { height: 570px; }
    .events-bottombar { align-items: flex-start; flex-direction: column; }
  }
</style>
