---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const principles = [
  {
    title: 'Сприйнятність',
    text: 'Інформація на сайті подається у текстовій формі, із логічними заголовками, зрозумілою структурою сторінок і текстовими альтернативами для важливих зображень.'
  },
  {
    title: 'Керованість',
    text: 'Навігаційні елементи, посилання і кнопки мають бути зрозумілими та доступними для використання на різних пристроях, зокрема з клавіатури.'
  },
  {
    title: 'Зрозумілість',
    text: 'Матеріали сайту структуруються так, щоб користувач міг швидко знайти потрібний розділ, документ або контактну інформацію.'
  },
  {
    title: 'Надійність',
    text: 'Сторінки створюються на основі стандартних вебтехнологій, що сприяє сумісності з сучасними браузерами та допоміжними технологіями.'
  }
];

const measures = [
  'семантична HTML-структура сторінок;',
  'логічна ієрархія заголовків;',
  'адаптивний дизайн для комп’ютерів, планшетів і мобільних пристроїв;',
  'текстові альтернативи для важливих зображень;',
  'зрозумілі текстові посилання;',
  'достатній контраст основних текстових і навігаційних елементів;',
  'можливість масштабування сторінок засобами браузера;',
  'структуровані списки, таблиці та картки для великих інформаційних розділів.'
];
---

<BaseLayout
  title={`Політика доступності | ${site.shortName}`}
  description="Політика доступності вебсайту Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="home"
>
  <div class="accessibility-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/')}>Головна</a>
      <span>›</span>
      <span>Політика доступності</span>
    </nav>

    <section class="accessibility-hero">
      <p class="eyebrow">Доступність вебсайту</p>
      <h1>Політика доступності</h1>
      <p class="lead">
        Інститут механіки ім. С. П. Тимошенка НАН України прагне забезпечити зручний доступ
        до матеріалів вебсайту для всіх користувачів незалежно від технічних засобів,
        умов перегляду або індивідуальних потреб.
      </p>
    </section>

    <section class="section-block two-column">
      <article class="info-panel">
        <p class="eyebrow">Загальна заява</p>
        <h2>Наш підхід</h2>
        <p>
          Під час розвитку сайту враховуються базові принципи вебдоступності: зрозуміла
          структура сторінок, послідовна навігація, читабельний текст, адаптивність для
          різних екранів і сумісність із сучасними браузерами та допоміжними технологіями.
        </p>
        <p>
          Сайт розробляється як статичний вебресурс із використанням стандартних вебтехнологій,
          що дає змогу підтримувати швидке завантаження сторінок і передбачувану структуру матеріалів.
        </p>
      </article>

      <article class="info-panel accent-panel">
        <p class="eyebrow">Орієнтир</p>
        <h2>Принципи WCAG</h2>
        <p>
          У роботі над сайтом враховуються основні принципи WCAG: контент має бути
          сприйнятним, керованим, зрозумілим і надійним. Ці принципи використовуються як
          практичний орієнтир для поліпшення доступності вебсторінок.
        </p>
      </article>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Принципи</p>
          <h2>Що враховується під час розроблення сайту</h2>
        </div>
      </div>

      <div class="principles-grid">
        {principles.map((principle) => (
          <article class="principle-card">
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block two-column">
      <article class="info-panel">
        <p class="eyebrow">Практичні рішення</p>
        <h2>Що вже враховано</h2>
        <ul class="check-list">
          {measures.map((measure) => <li>{measure}</li>)}
        </ul>
      </article>

      <article class="info-panel">
        <p class="eyebrow">Обмеження</p>
        <h2>Архівні матеріали та зовнішні документи</h2>
        <p>
          Деякі PDF-документи, архівні матеріали або зовнішні ресурси можуть мати різний
          рівень доступності, особливо якщо вони були створені раніше або розміщені на
          сторонніх вебресурсах.
        </p>
        <p>
          Під час оновлення сайту такі матеріали по можливості структуруються, перевіряються
          та доповнюються зрозумілими назвами посилань.
        </p>
      </article>
    </section>

    <section class="section-block feedback-panel">
      <div>
        <p class="eyebrow">Зворотний зв’язок</p>
        <h2>Повідомлення про проблему доступності</h2>
        <p>
          Якщо під час користування сайтом ви виявили проблему доступності, неробоче посилання,
          складність із переглядом документа або іншу технічну перешкоду, будь ласка,
          повідомте про це на офіційну електронну адресу Інституту.
        </p>
      </div>
      <a class="mail-card" href={`mailto:${site.email}`}>
        <span>E-mail</span>
        <strong>{site.email}</strong>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .accessibility-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 20px 72px;
  }

  .breadcrumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 22px;
    color: var(--muted);
    font-weight: 750;
  }

  .accessibility-hero,
  .info-panel,
  .principle-card,
  .feedback-panel,
  .mail-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .accessibility-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .accessibility-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 900px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .section-block {
    margin-top: 34px;
  }

  .two-column {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 18px;
  }

  .info-panel,
  .principle-card,
  .feedback-panel {
    padding: 24px;
  }

  .info-panel h2,
  .principle-card h3,
  .feedback-panel h2 {
    margin-top: 0;
  }

  .info-panel p,
  .principle-card p,
  .feedback-panel p,
  .check-list {
    color: var(--muted);
    line-height: 1.65;
  }

  .accent-panel {
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .accent-panel .eyebrow,
  .accent-panel p {
    color: rgba(255, 255, 255, 0.86);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .check-list {
    margin: 0;
    padding-left: 20px;
  }

  .check-list li {
    margin-bottom: 9px;
  }

  .feedback-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px;
    align-items: center;
  }

  .mail-card {
    display: flex;
    min-height: 140px;
    flex-direction: column;
    justify-content: center;
    padding: 22px;
    color: var(--text);
    text-decoration: none;
  }

  .mail-card:hover {
    text-decoration: none;
  }

  .mail-card span {
    margin-bottom: 8px;
    color: var(--accent-dark);
    font-weight: 850;
  }

  .mail-card strong {
    overflow-wrap: anywhere;
    font-size: 1.1rem;
  }

  @media (max-width: 1080px) {
    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .two-column,
    .principles-grid,
    .feedback-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
