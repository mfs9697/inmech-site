                <th>Тема дисертаційного дослідження 2025</th>
                <th>ПІБ наукового керівника, посада 2025</th>
                <th>Публікації наукового керівника</th>
              </tr>
            </thead>
            <tbody>
              {topicGroups.map((group) => (
                <>
                  <tr class="year-row"><td colspan="4">{group.year}</td></tr>
                  {group.rows.map((item) => (
                    <tr>
                      <td><strong>{item.student}</strong><span>{item.studyYears}</span></td>
                      <td>{item.topic}</td>
                      <td>{item.supervisor}</td>
                      <td>
                        <ol class="publication-list">
                          {item.publications.map(([label, href]) => (
                            <li>{href ? <a href={href} target="_blank" rel="noopener noreferrer">{label}</a> : <span>{label}</span>}</li>
                          ))}
                        </ol>
                      </td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-block note-card">
      <p class="eyebrow">Примітка</p>
      <h2>Публікації наукових керівників</h2>
      <p>
        У таблиці наведено вибрані публікації керівників відповідно до тем аспірантів. За потреби цей блок можна доповнити повними персональними списками публікацій або залишити як компактне підтвердження відповідності для акредитаційних матеріалів.
      </p>
      <div class="links-row">
        <a href={withBase('/postgraduate/students/')}>Аспіранти →</a>
        <a href={withBase('/postgraduate/supervisors/')}>Керівники →</a>
      </div>
    </section>
  </main>
</BaseLayout>

