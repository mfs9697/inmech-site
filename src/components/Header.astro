---
import { site } from '../data/site';
import { getEnglishPath, normalizeSitePath } from '../data/routes';

interface Props {
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { activePage = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const currentPath = normalizeSitePath(Astro.url.pathname, base);
const englishPath = getEnglishPath(Astro.url.pathname, base);
const isSectionActive = (page: Props['activePage']) => activePage === page ? 'active' : '';
const isPathActive = (path: string) => currentPath === normalizeSitePath(path) ? 'active' : '';
const isPathPrefixActive = (path: string) => currentPath.startsWith(normalizeSitePath(path)) ? 'active' : '';
---

<header class="site-header">
  <div class="topbar">
    <div class="container">
      <span>{site.officialLabel}</span>
      <div class="lang-switch" aria-label="Вибір мови">
        <a class="active" href={withBase(currentPath)} aria-current="page">Українська</a>
        <a href={withBase(englishPath)}>English</a>
      </div>
    </div>
  </div>

  <div class="container header-main brand-main">
    <a class="brand" href={withBase('/')} aria-label="Головна сторінка">
      <img src={withBase('/assets/img/ImechLogo.svg?v=20260615-png-final')} alt="Логотип Інституту механіки" />
      <span class="brand-text">
        <strong class="brand-title">{site.name}</strong>
        <span class="brand-subtitle">{site.subtitle}</span>
      </span>
    </a>
  </div>
</header>

<div class="nav-shell">
  <div class="container nav-row">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      Меню
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Головне меню">
      <ul>
        <li><a class={isPathActive('/')} href={withBase('/')}>Головна</a></li>

        <li>
          <button class={`nav-label ${isSectionActive('about')}`} type="button" aria-expanded="false" aria-controls="submenu-about">
            <span>Про інститут</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-about">
            <li><a class={isPathActive('/history/')} href={withBase('/history/')}>Історія і сучасність</a></li>
            <li><a class={isPathActive('/founder/')} href={withBase('/founder/')}>Засновник інституту</a></li>
            <li><a class={isPathActive('/regulations/')} href={withBase('/regulations/')}>Статут</a></li>
            <li><a class={isPathActive('/strategy/')} href={withBase('/strategy/')}>Стратегія розвитку</a></li>
            <li><a class={isPathActive('/scientific-cooperation/')} href={withBase('/scientific-cooperation/')}>Наукова співпраця</a></li>
            <li><a class={isPathActive('/tender/')} href={withBase('/tender/')}>Закупівлі та тендери</a></li>
          </ul>
        </li>

        <li>
          <button class={`nav-label ${isSectionActive('departments')}`} type="button" aria-expanded="false" aria-controls="submenu-structure">
            <span>Структура</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-structure">
            <li><a class={isPathActive('/management/')} href={withBase('/management/')}>Дирекція</a></li>
            <li><a class={isPathActive('/departments/')} href={withBase('/departments/')}>Наукові відділи</a></li>
            <li><a class={isPathActive('/scientific-council/')} href={withBase('/scientific-council/')}>Вчена рада</a></li>
            <li><a class={isPathActive('/specialized-councils/')} href={withBase('/specialized-councils/')}>Спеціалізовані ради</a></li>
            <li><a class={isPathActive('/young-scientists/')} href={withBase('/young-scientists/')}>Рада молодих вчених</a></li>
            <li><a class={isPathActive('/services/')} href={withBase('/services/')}>Служби інституту</a></li>
          </ul>
        </li>

        <li>
          <button class={`nav-label ${isSectionActive('education')}`} type="button" aria-expanded="false" aria-controls="submenu-education">
            <span>Освітньо-наукова діяльність</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-education">
            <li><a class={isPathActive('/education/')} href={withBase('/education/')}>Огляд розділу</a></li>
            <li><a class={isPathActive('/postgraduate/')} href={withBase('/postgraduate/')}>Аспірантура</a></li>
            <li><a class={isPathActive('/doctoral/')} href={withBase('/doctoral/')}>Докторантура</a></li>
            <li><a class={isPathActive('/dissertations/')} href={withBase('/dissertations/')}>Захист дисертацій</a></li>
            <li><a class={isPathActive('/license-and-regulations/')} href={withBase('/license-and-regulations/')}>Ліцензії та Положення</a></li>
            <li><a class={isPathActive('/trust-box/')} href={withBase('/trust-box/')}>Скринька довіри</a></li>
            <li><a class={isPathActive('/nmr/')} href={withBase('/nmr/')}>Науково-методична рада</a></li>
          </ul>
        </li>

        <li><a class={isPathPrefixActive('/library/')} href={withBase('/library/')}>Бібліотека</a></li>
        <li><a class={isSectionActive('news')} href={withBase('/news/')}>Новини</a></li>
        <li><a href={withBase('/#contacts')}>Контакти</a></li>
        <li><a class={`search-nav-link ${isPathActive('/search/')}`} href={withBase('/search/')} aria-label="Пошук по сайту">Пошук</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: #0f1f34;
    border-bottom: 0;
    color: #fff;
    backdrop-filter: none;
  }

  .topbar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.84);
  }

  .lang-switch a,
  .lang-switch .active {
    color: #ffffff;
  }

  .header-main.brand-main {
    justify-content: flex-start;
    align-items: center;
  }

  .site-header .brand-title {
    color: #ffffff;
  }

  .site-header .brand-subtitle {
    color: rgba(255, 255, 255, 0.86);
  }

  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 28px rgba(15, 31, 52, 0.08);
    backdrop-filter: blur(12px);
  }

  .nav-row {
    min-height: 54px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    position: relative;
  }

  .primary-nav .submenu {
    z-index: 1100;
  }
</style>
