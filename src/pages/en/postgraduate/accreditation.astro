---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  return `${base}/${path.replace(/^\/+/, '')}`;
}

const accreditationDocuments = [
  {
    title: 'Accreditation certificate No. 22459',
    description: 'Official certificate issued by the National Agency for Higher Education Quality Assurance on 23 June 2026. Valid until 1 July 2031.',
    href: '/documents/postgraduate/accreditation/2026/accreditation-certificate-22459.pdf'
  },
  {
    title: 'Expert group work programme',
    description: 'Work programme of the expert group during the accreditation review at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine on 6–8 May 2026.',
    href: '/documents/postgraduate/accreditation/2026/expert-group-program-2026.pdf'
  },
  {
    title: 'Self-assessment report',
    description: 'Self-assessment materials for the educational and scientific programme at the third level of higher education.',
    href: '/documents/postgraduate/accreditation/2026/self-assessment-2026.pdf'
  }
];
---

<BaseLayoutEn
  title={`PhD programme accreditation | ${siteEn.shortName}`}
  description="Accreditation status and materials for the educational and scientific postgraduate programme of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href={withBase('/en/postgraduate/')}>Postgraduate studies</a><span>›</span><span>Accreditation</span></nav>
    <section class="page-hero">
      <p class="eyebrow">Accreditation</p>
      <h1>Accreditation of the educational and scientific programme</h1>
      <p class="lead">The educational programme <strong>“Mechanics of Deformable Solids and Theoretical Mechanics”</strong> in specialty <strong>113 Applied Mathematics</strong> is accredited at the third level of higher education.</p>
    </section>

    <section class="certificate-panel">
      <div>
        <p class="eyebrow">Programme status</p>
        <h2>The educational and scientific programme is accredited</h2>
        <p>
          Accreditation certificate <strong>No. 22459</strong> was issued on
          <strong>23 June 2026</strong> and is valid <strong>until 1 July 2031</strong>.
          The official certificate is provided in Ukrainian.
        </p>
        <div class="status-meta" aria-label="Accreditation certificate details">
          <span>No. 22459</span>
          <span>23 June 2026</span>
          <span>valid until 1 July 2031</span>
        </div>
      </div>
      <a class="certificate-link" href={withBase('/documents/postgraduate/accreditation/2026/accreditation-certificate-22459.pdf')} target="_blank" rel="noopener noreferrer">Open certificate →</a>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header"><div><p class="eyebrow">Accreditation procedure</p><h2>Accreditation review</h2></div></div>
      <div class="info-grid">
        <article class="info-card accent-card"><span>Review period</span><h3>6–8 May 2026</h3><p>The accreditation review was conducted at the Institute for the educational programme with EDEBO programme ID 22305.</p></article>
        <article class="info-card"><span>Educational programme</span><h3>Mechanics of Deformable Solids and Theoretical Mechanics</h3><p>Third educational and scientific level of higher education, specialty 113 Applied Mathematics.</p></article>
      </div>
    </section>
    <section class="section-block">
      <div class="section-heading compact-header"><div><p class="eyebrow">Documents</p><h2>Accreditation materials</h2></div><p>The PDF files are official source documents and are provided in Ukrainian.</p></div>
      <div class="document-grid">
        {accreditationDocuments.map((document) => (
          <a class="document-card" href={withBase(document.href)} target="_blank" rel="noopener noreferrer"><span>PDF</span><h3>{document.title}</h3><p>{document.description}</p><strong>Open document →</strong></a>
        ))}
      </div>
    </section>
    <section class="section-block meeting-panel"><div><p class="eyebrow">Open meeting</p><h2>Meeting with the expert group</h2><p>The open meeting with the expert group on EDEBO educational programme 22305 took place on <strong>7 May 2026</strong>, from <strong>12:30</strong> to <strong>13:15</strong>.</p></div></section>
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page{max-width:1180px;margin:0 auto;padding:46px 20px 72px}.breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:22px;color:var(--muted);font-weight:750}.page-hero,.certificate-panel,.info-card,.document-card,.meeting-panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}.page-hero{padding:clamp(28px,5vw,52px)}.page-hero h1{margin:0 0 18px;font-size:clamp(2.2rem,4.8vw,4.3rem);line-height:1.04;letter-spacing:-.04em}.lead{max-width:920px;color:var(--muted);font-size:1.08rem;line-height:1.7}.certificate-panel{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:center;margin-top:22px;padding:clamp(24px,4vw,36px);border-color:rgba(29,79,145,.22);background:linear-gradient(145deg,var(--surface),var(--accent-soft))}.certificate-panel h2{margin:0 0 10px}.certificate-panel p:not(.eyebrow){max-width:820px;margin-bottom:0;color:var(--muted);line-height:1.65}.status-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.status-meta span{padding:6px 10px;border-radius:999px;background:var(--surface);color:var(--accent-dark);font-size:.82rem;font-weight:850}.certificate-link{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;border-radius:14px;background:var(--accent-dark);color:#fff;font-weight:850;text-decoration:none;white-space:nowrap}.certificate-link:hover{text-decoration:none;transform:translateY(-1px)}.section-block{margin-top:34px}.info-grid,.document-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.info-card,.document-card{padding:24px}.info-card span,.document-card span{display:inline-block;margin-bottom:12px;padding:6px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent-dark);font-size:.78rem;font-weight:850}.info-card p,.document-card p,.meeting-panel p{color:var(--muted);line-height:1.65}.accent-card{background:linear-gradient(145deg,var(--accent-dark),var(--accent));color:#fff}.accent-card span{background:rgba(255,255,255,.16);color:#fff}.accent-card p{color:rgba(255,255,255,.86)}.document-card{display:flex;min-height:260px;flex-direction:column;color:var(--text);text-decoration:none;transition:transform .22s ease}.document-card:hover{transform:translateY(-4px);text-decoration:none}.document-card strong{margin-top:auto;color:var(--accent-dark)}.meeting-panel{padding:28px}@media(max-width:860px){.certificate-panel,.info-grid,.document-grid{grid-template-columns:1fr}.certificate-link{width:fit-content;white-space:normal}}
</style>
