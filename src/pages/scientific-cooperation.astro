    href: 'https://natcommmech.inmech.kyiv.ua/'
  },
  {
    title: 'Гранти та конкурси',
    description: 'Інформаційний ресурс з оголошеннями про грантові програми, конкурси та можливості фінансування досліджень.',
    href: 'https://grants.inmech.kyiv.ua/'
  },
  {
    title: 'Вибори директора Інституту 2026',
    description: 'Окремий інформаційний ресурс, присвячений виборам директора Інституту.',
    href: 'https://election.inmech.kyiv.ua/'
  }
];
---

<BaseLayout
  title={`Наукова співпраця | ${site.name}`}
  description="Наукова співпраця Інституту механіки ім. С.П. Тимошенка НАН України: договори, угоди, партнерські установи та пов’язані ресурси."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel cooperation-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>Наукова співпраця</h1>
        <p class="lead">
          На цій сторінці подано встановлені відносини Інституту з науковими,
          освітніми та іншими партнерськими установами. Кожна картка містить
          назву установи, тип документа, дату та посилання на PDF.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Договори та угоди</p>
          <h2 class="section-title">Встановлені партнерські відносини</h2>
          <p class="section-text">
            Перелік сформовано на основі документів, оприлюднених у розділі
            «Наукова співпраця» попередньої версії сайту Інституту.
          </p>
        </div>
      </div>

      <div class="agreement-grid">
        {agreements.map((agreement) => (
          <article class="agreement-card">
            <div class="agreement-meta">{agreement.date}</div>
            <h2>{agreement.institution}</h2>
            <p>{agreement.type}</p>
            <a class="button secondary" href={agreement.href} target="_blank" rel="noopener">
              Відкрити PDF
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Пов’язані ресурси</p>
          <h2 class="section-title">Інформаційні сайти та платформи</h2>
          <p class="section-text">
            Нижче подано ресурси, пов’язані з публікаційною, конференційною,
            організаційною та грантовою діяльністю Інституту.
          </p>
        </div>
      </div>

      <div class="resource-grid">
        {resourceLinks.map((item) => (
          <article class="resource-card">
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            <a class="button secondary" href={item.href} target="_blank" rel="noopener">
              Перейти на сайт
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
