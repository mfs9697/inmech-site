---
import { siteEn } from '../data/site-en';
import { getUkrainianPath, normalizeSitePath } from '../data/routes';

interface Props {
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { activePage = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const currentPath = normalizeSitePath(Astro.url.pathname, base);
const ukrainianPath = getUkrainianPath(Astro.url.pathname, base);
const isSectionActive = (page: Props['activePage']) => activePage === page ? 'active' : '';
const isPathActive = (path: string) => currentPath === normalizeSitePath(path) ? 'active' : '';
const isPathPrefixActive = (path: string) => currentPath.startsWith(normalizeSitePath(path)) ? 'active' : '';
---

<header class="site-header">
  <div class="topbar">
    <div class="container">
      <span>{siteEn.officialLabel}</span>
      <div class="lang-switch" aria-label="Language selection">
        <a href={withBase(ukrainianPath)}>Українська</a>
        <a class="active" href={withBase(currentPath)} aria-current="page">English</a>
      </div>
    </div>
  </div>

  <div class="container header-main brand-main">
    <a class="brand" href={withBase('/en/')} aria-label="Home page">
      <img src={withBase('/assets/img/ImechLogo.svg?v=20260615-png-final')} alt="Logo of the Institute of Mechanics" />
      <span class="brand-text">
        <strong class="brand-title">{siteEn.name}</strong>
        <span class="brand-subtitle">{siteEn.subtitle}</span>
      </span>
    </a>
  </div>
</header>

<div class="nav-shell">
  <div class="container nav-row">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      Menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Main menu">
      <ul>
        <li><a class={isPathActive('/en/')} href={withBase('/en/')}>Home</a></li>
        <li>
          <button class={`nav-label ${isSectionActive('about')}`} type="button" aria-expanded="false" aria-controls="submenu-about">
            <span>About the Institute</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-about">
            <li><a class={isPathActive('/en/history/')} href={withBase('/en/history/')}>History and present</a></li>
            <li><a class={isPathActive('/en/founder/')} href={withBase('/en/founder/')}>Founder of the Institute</a></li>
            <li><a class={isPathActive('/en/regulations/')} href={withBase('/en/regulations/')}>Statute</a></li>
            <li><a class={isPathActive('/en/strategy/')} href={withBase('/en/strategy/')}>Development strategy</a></li>
            <li><a class={isPathActive('/en/scientific-cooperation/')} href={withBase('/en/scientific-cooperation/')}>Scientific cooperation</a></li>
            <li><a class={isPathActive('/en/tender/')} href={withBase('/en/tender/')}>Procurement and tenders</a></li>
          </ul>
        </li>
        <li>
          <button class={`nav-label ${isSectionActive('departments')}`} type="button" aria-expanded="false" aria-controls="submenu-structure">
            <span>Structure</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-structure">
            <li><a class={isPathActive('/en/management/')} href={withBase('/en/management/')}>Management</a></li>
            <li><a class={isPathActive('/en/departments/')} href={withBase('/en/departments/')}>Research departments</a></li>
            <li><a class={isPathActive('/en/scientific-council/')} href={withBase('/en/scientific-council/')}>Scientific Council</a></li>
            <li><a class={isPathActive('/en/specialized-councils/')} href={withBase('/en/specialized-councils/')}>Specialized Academic Councils</a></li>
            <li><a class={isPathActive('/en/young-scientists/')} href={withBase('/en/young-scientists/')}>Council of Young Scientists</a></li>
            <li><a class={isPathActive('/en/services/')} href={withBase('/en/services/')}>Institute services</a></li>
          </ul>
        </li>
        <li>
          <button class={`nav-label ${isSectionActive('education')}`} type="button" aria-expanded="false" aria-controls="submenu-education">
            <span>Education and research training</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-education">
            <li><a class={isPathActive('/en/education/')} href={withBase('/en/education/')}>Section overview</a></li>
            <li><a class={isPathActive('/en/postgraduate/')} href={withBase('/en/postgraduate/')}>Postgraduate studies</a></li>
            <li><a class={isPathActive('/en/doctoral/')} href={withBase('/en/doctoral/')}>Doctoral studies</a></li>
            <li><a class={isPathActive('/en/dissertations/')} href={withBase('/en/dissertations/')}>Dissertation defences</a></li>
            <li><a class={isPathActive('/en/license-and-regulations/')} href={withBase('/en/license-and-regulations/')}>Licences and regulations</a></li>
            <li><a class={isPathActive('/en/trust-box/')} href={withBase('/en/trust-box/')}>Trust box</a></li>
            <li><a class={isPathActive('/en/nmr/')} href={withBase('/en/nmr/')}>Scientific and Methodological Council</a></li>
          </ul>
        </li>
        <li><a class={isPathPrefixActive('/en/library/')} href={withBase('/en/library/')}>Library</a></li>
        <li><a class={isSectionActive('news')} href={withBase('/en/news/')}>News</a></li>
        <li><a href={withBase('/en/#contacts')}>Contacts</a></li>
        <li><a class={`search-nav-link ${isPathActive('/en/search/')}`} href={withBase('/en/search/')} aria-label="Search the website">Search</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: #0f1f34;
    border-bottom: 0;
    color: #fff;
    backdrop-filter: none;
  }

  .topbar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.84);
  }

  .lang-switch a,
  .lang-switch .active {
    color: #ffffff;
  }

  .header-main.brand-main {
    justify-content: flex-start;
    align-items: center;
  }

  .site-header .brand-title {
    color: #ffffff;
  }

  .site-header .brand-subtitle {
    color: rgba(255, 255, 255, 0.86);
  }

  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 28px rgba(15, 31, 52, 0.08);
    backdrop-filter: blur(12px);
  }

  .nav-row {
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>
