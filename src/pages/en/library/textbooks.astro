---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';
import {
  textbooks,
  textbookCategories,
  textbookYears,
  textbookLibraryOfCongressCount
} from '../../../data/textbooks';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}
---

<BaseLayoutEn
  title={`Textbooks and teaching aids | ${siteEn.shortName}`}
  description="Textbooks, teaching aids and educational materials by researchers of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine."
  activePage="home"
>
  <section class="textbooks-hero">
    <div class="container textbooks-hero-panel">
      <div>
        <p class="eyebrow">Library</p>
        <h1>Textbooks and teaching aids</h1>
        <p class="lead">
          Educational publications, lecture courses and teaching materials in mechanics,
          mathematics, shell theory, thermoelasticity, stability, numerical methods and related
          areas. Bibliographic records are shown in their source language.
        </p>
      </div>
      <div class="textbooks-stats" aria-label="Teaching publication statistics">
        <strong>{textbooks.length}</strong>
        <span>records</span>
        <small>{textbookYears.at(-1)}-{textbookYears[0]}</small>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Catalogue</p>
          <h2>Teaching publications</h2>
        </div>
        <p>
          Records are grouped by publication year. The Library of Congress badge indicates entries
          that were marked as present in that catalogue in the source bibliography.
        </p>
      </div>

      <div class="textbooks-toolbar">
        <a href={withBase('/en/library/')}>Back to Library</a>
        <span>{textbookCategories.length} thematic areas · {textbookLibraryOfCongressCount} in the Library of Congress</span>
      </div>

      <div class="year-groups">
        {textbookYears.map((year) => {
          const items = textbooks.filter((item) => item.year === year);
          return (
            <section class="year-group" id={`year-${year}`}>
              <div class="year-header">
                <h3>{year}</h3>
                <span>{items.length} record{items.length === 1 ? '' : 's'}</span>
              </div>

              <div class="textbook-grid">
                {items.map((item) => (
                  <article class="textbook-card">
                    <div class="textbook-card-topline">
                      <span>{item.category}</span>
                      <strong>{item.type}</strong>
                    </div>
                    <h4>{item.title}</h4>
                    <p class="authors">{item.authors}</p>
                    <p class="details">
                      {item.publisher}{item.pages ? `, ${item.pages}` : ''}{'isbn' in item && item.isbn ? `; ISBN ${item.isbn}` : ''}.
                    </p>
                    {item.inLibraryOfCongress && (
                      <p class="loc-badge">Library of Congress</p>
                    )}
                    {item.url && (
                      <a class="card-link" href={item.url} target="_blank" rel="noopener noreferrer">Electronic resource</a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayoutEn>

<style>
  .textbooks-hero {
    padding: 52px 0 18px;
  }

  .textbooks-hero-panel,
  .textbook-card,
  .year-group {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .textbooks-hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 5vw, 54px);
    overflow: hidden;
    position: relative;
  }

  .textbooks-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 300px;
    height: 300px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.14), rgba(29, 79, 145, 0));
  }

  .textbooks-hero-panel > * {
    position: relative;
    z-index: 1;
  }

  .textbooks-hero-panel h1 {
    margin: 0 0 18px;
    max-width: 900px;
    font-size: clamp(2rem, 4.2vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .textbooks-stats {
    display: grid;
    place-items: center;
    min-width: 158px;
    min-height: 158px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(29, 79, 145, 0.10), rgba(184, 135, 47, 0.16));
    border: 1px solid var(--line);
    text-align: center;
  }

  .textbooks-stats strong {
    display: block;
    color: var(--accent-dark);
    font-size: 3rem;
    line-height: 1;
  }

  .textbooks-stats span,
  .textbooks-stats small {
    color: var(--muted);
    font-weight: 850;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .textbooks-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    margin-bottom: 20px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .textbooks-toolbar a,
  .textbooks-toolbar span {
    font-weight: 850;
  }

  .textbooks-toolbar span {
    color: var(--muted);
  }

  .year-groups {
    display: grid;
    gap: 18px;
  }

  .year-group {
    padding: clamp(18px, 3vw, 28px);
  }

  .year-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .year-header h3 {
    margin: 0;
    color: var(--accent-dark);
    font-size: 1.5rem;
  }

  .year-header span {
    color: var(--muted);
    font-weight: 850;
  }

  .textbook-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .textbook-card {
    display: flex;
    min-height: 260px;
    flex-direction: column;
    padding: 18px;
    box-shadow: none;
    background: var(--surface-soft);
  }

  .textbook-card-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .textbook-card-topline span,
  .textbook-card-topline strong,
  .loc-badge {
    display: inline-flex;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 850;
    line-height: 1.2;
  }

  .textbook-card-topline span {
    background: var(--surface);
    color: var(--accent-dark);
  }

  .textbook-card-topline strong,
  .loc-badge {
    background: var(--accent-soft);
    color: var(--accent-dark);
  }

  .textbook-card h4 {
    margin: 0 0 10px;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .textbook-card .authors {
    margin: 0 0 10px;
    color: var(--accent-dark);
    font-weight: 850;
    line-height: 1.45;
  }

  .textbook-card .details {
    margin: 0 0 14px;
    color: var(--muted);
    line-height: 1.5;
  }

  .loc-badge {
    margin: auto 0 12px;
  }

  .textbook-card .card-link {
    margin-top: auto;
  }

  @media (max-width: 1180px) {
    .textbook-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .textbooks-hero-panel,
    .section-heading,
    .year-header {
      display: block;
    }

    .textbooks-stats {
      width: 158px;
      margin-top: 22px;
    }

    .section-heading p:last-child,
    .year-header span {
      display: block;
      margin-top: 12px;
    }

    .textbook-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
