---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => base + path;
---


<BaseLayoutEn
  title={`Search | ${siteEn.shortName}`}
  description="Search page of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine website."
  activePage="home"
>
  <div class="search-page" data-site-search data-search-lang="en" data-search-index={withBase('/en/search-index.json')}>
    <section class="search-hero">
      <p class="eyebrow">Navigation</p>
      <h1>Search the website</h1>
      <p class="lead">
        Enter a surname, document name, competition, research topic or keyword. Results also cover the director-election archive, educational documents and NCUTAM.
      </p>
    </section>

    <section class="search-panel" aria-label="Website search">
      <label for="site-search">Search query</label>
      <div class="search-row">
        <input id="site-search" type="search" placeholder="For example: postgraduate, SCADAS, fracture, Selivanov" autocomplete="off" />
        <button type="button" data-clear-search>Clear</button>
      </div>
      <p class="search-help">Search page titles, summaries and document metadata. PDF full text is not indexed.</p>
      <noscript><p class="search-help">Search requires JavaScript. Browse the <a href={withBase('/en/sitemap/')}>sitemap</a> instead.</p></noscript>
    </section>

    <section class="search-results-section" aria-live="polite">
      <div class="results-heading">
        <h2>Results</h2>
        <span data-results-count>Start typing a query</span>
      </div>
      <div class="search-results" data-search-results></div>
    </section>
  </div>
</BaseLayoutEn>

<script>
  import '../../scripts/site-search';
</script>

<style>
  .search-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 20px 72px;
  }

  .search-hero,
  .search-panel,
  :global(.result-card) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .search-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .search-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 900px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .search-panel {
    margin-top: 28px;
    padding: 24px;
  }

  .search-panel label {
    display: block;
    margin-bottom: 10px;
    font-weight: 850;
  }

  .search-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  .search-row input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    font: inherit;
  }

  .search-row button {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--accent-dark);
    color: #fff;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }

  .search-help {
    margin: 12px 0 0;
    color: var(--muted);
  }

  .search-results-section {
    margin-top: 30px;
  }

  .results-heading {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-bottom: 16px;
  }

  .results-heading h2 {
    margin: 0;
  }

  .results-heading span {
    color: var(--muted);
    font-weight: 850;
  }

  .search-results {
    display: grid;
    gap: 12px;
  }

  :global(.result-card) {
    padding: 18px 20px;
  }

  :global(.result-card span) {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 8px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 850;
  }

  :global(.result-card h3) {
    margin: 0 0 8px;
    font-size: 1.16rem;
  }

  :global(.result-card p),
  :global(.empty-results) {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 680px) {
    .search-row,
    .results-heading {
      display: block;
    }

    .search-row button,
    .results-heading span {
      display: block;
      margin-top: 10px;
    }
  }
</style>
