---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const priorities = [
  {
    title: 'Розвиток фундаментальних досліджень',
    text: 'Підтримка наукових шкіл Інституту та посилення досліджень у ключових напрямах теоретичної й прикладної механіки.'
  },
  {
    title: 'Оновлення дослідницької інфраструктури',
    text: 'Поступове оновлення обладнання, цифрових інструментів, програмних засобів і внутрішніх інформаційних ресурсів.'
  },
  {
    title: 'Міжнародна співпраця',
    text: 'Розширення участі в міжнародних проєктах, конференціях, спільних публікаціях і партнерських дослідницьких програмах.'
  },
  {
    title: 'Підготовка наукових кадрів',
    text: 'Підтримка аспірантів, докторантів, молодих учених і розвиток наукового середовища для професійного зростання.'
  }
];
---

<BaseLayout
  title={`Стратегія розвитку | ${site.name}`}
  description="Стратегія розвитку Інституту механіки ім. С.П. Тимошенка НАН України."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel strategy-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>Стратегія розвитку</h1>
        <p class="lead">
          Сторінка призначена для представлення стратегічних орієнтирів розвитку Інституту механіки
          ім. С. П. Тимошенка НАН України, його наукових пріоритетів, кадрової політики,
          дослідницької інфраструктури та міжнародної співпраці.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container strategy-grid">
      {priorities.map((item) => (
        <article class="panel strategy-card">
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel strategy-note">
        <p class="eyebrow">Матеріал готується</p>
        <h2>Оновлення сторінки</h2>
        <p>
          Цей розділ можна доповнити офіційним текстом стратегії, програмними документами,
          рішеннями Вченої ради, планами розвитку наукових напрямів та посиланнями на відповідні PDF-файли.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
