---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const sections = [
  {
    title: 'Головна',
    links: [
      ['Головна сторінка', '/'],
      ['Новини', '/news/'],
      ['Контакти', '/#contacts']
    ]
  },
  {
    title: 'Про інститут',
    links: [
      ['Історія та місія', '/history/'],
      ['Статут', '/regulations/'],
      ['Стратегія розвитку', '/strategy/'],
      ['Наукова співпраця', '/scientific-cooperation/'],
      ['Закупівлі та тендери', '/tender/']
    ]
  },
  {
    title: 'Структура',
    links: [
      ['Дирекція', '/management/'],
      ['Наукові відділи', '/departments/'],
      ['Вчена рада', '/scientific-council/'],
      ['Спеціалізовані ради', '/specialized-councils/'],
      ['Рада молодих вчених', '/young-scientists/'],
      ['Служби інституту', '/services/']
    ]
  },
  {
    title: 'Освітньо-наукова діяльність',
    links: [
      ['Огляд розділу', '/education/'],
      ['Аспірантура', '/postgraduate/'],
      ['Докторантура', '/doctoral/'],
      ['Захист дисертацій', '/dissertations/'],
      ['Ліцензії та Положення', '/license-and-regulations/'],
      ['Скринька довіри', '/trust-box/'],
      ['Науково-методична рада', '/nmr/']
    ]
  },
  {
    title: 'Аспірантура',
    links: [
      ['Аспірантура', '/postgraduate/'],
      ['Вступникам до аспірантури', '/postgraduate/admission/'],
      ['Освітньо-наукова програма', '/postgraduate/program/'],
      ['Акредитація', '/postgraduate/accreditation/'],
      ['Розклад занять аспірантів', '/postgraduate/schedule/'],
      ['Аспіранти', '/postgraduate/students/'],
      ['Викладачі і наукові керівники', '/postgraduate/supervisors/'],
      ['Відповідність тем аспірантів науковій діяльності керівників', '/postgraduate/research-topics/']
    ]
  }
];
---

<BaseLayout
  title={`Карта сайту | ${site.shortName}`}
  description="Карта сайту Інституту механіки ім. С. П. Тимошенка НАН України з посиланнями на основні розділи і сторінки."
  activePage="home"
>
  <main class="sitemap-page">
    <section class="sitemap-hero">
      <p class="eyebrow">Навігація</p>
      <h1>Карта сайту</h1>
      <p class="lead">
        На цій сторінці зібрано основні розділи сайту Інституту механіки ім. С. П. Тимошенка НАН України.
      </p>
    </section>

    <section class="sitemap-grid" aria-label="Розділи карти сайту">
      {sections.map((section) => (
        <article class="sitemap-card">
          <h2>{section.title}</h2>
          <ul>
            {section.links.map(([label, href]) => (
              <li><a href={withBase(href)}>{label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .sitemap-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 52px 20px 72px;
  }

  .sitemap-hero,
  .sitemap-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .sitemap-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .sitemap-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 820px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 30px;
  }

  .sitemap-card {
    padding: 26px;
  }

  .sitemap-card h2 {
    margin: 0 0 16px;
    font-size: 1.35rem;
  }

  .sitemap-card ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
  }

  .sitemap-card a {
    font-weight: 750;
  }

  @media (max-width: 860px) {
    .sitemap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
