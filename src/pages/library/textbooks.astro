---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import {
  textbooks,
  textbookCategories,
  textbookYears,
  textbookLibraryOfCongressCount
} from '../../data/textbooks';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}
---

<BaseLayout
  title={`Підручники та навчальні посібники | ${site.shortName}`}
  description="Підручники, навчальні посібники та навчально-наукові матеріали співробітників Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="home"
>
  <section class="textbooks-hero">
    <div class="container textbooks-hero-panel">
      <div>
        <p class="eyebrow">Бібліотека</p>
        <h1>Підручники та навчальні посібники</h1>
        <p class="lead">
          Навчальні видання, курси лекцій і посібники з механіки, математики,
          теорії оболонок, термопружності, стійкості, чисельних методів та суміжних напрямів,
          підготовлені співробітниками Інституту або пов’язані з його науковими школами.
        </p>
      </div>
      <div class="textbooks-stats" aria-label="Статистика навчальних видань">
        <strong>{textbooks.length}</strong>
        <span>видань</span>
        <small>{textbookYears.at(-1)}–{textbookYears[0]}</small>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Каталог</p>
          <h2>Навчальні видання</h2>
        </div>
        <p>
          Записи подано у стислому бібліографічному форматі та згруповано за роками видання.
          Позначка «Бібліотека Конгресу США» вказує на наявність відповідного видання у каталозі
          Бібліотеки Конгресу США.
        </p>
      </div>

      <div class="textbooks-toolbar">
        <a href={withBase('/library/')}>← До бібліотеки</a>
        <span>{textbookCategories.length} тематичних напрямів · {textbookLibraryOfCongressCount} у Бібліотеці Конгресу США</span>
      </div>

      <div class="year-groups">
        {textbookYears.map((year) => {
          const items = textbooks.filter((item) => item.year === year);
          return (
            <section class="year-group" id={`year-${year}`}>
              <div class="year-header">
                <h3>{year}</h3>
                <span>{items.length} {items.length === 1 ? 'видання' : 'видань'}</span>
              </div>

              <div class="textbook-grid">
                {items.map((item) => (
                  <article class="textbook-card">
                    <div class="textbook-card-topline">
                      <span>{item.category}</span>
                      <strong>{item.type}</strong>
                    </div>
                    <h4>{item.title}</h4>
                    <p class="authors">{item.authors}</p>
                    <p class="details">
                      {item.publisher}{item.pages ? `, ${item.pages}` : ''}{'isbn' in item && item.isbn ? `; ISBN ${item.isbn}` : ''}.
                    </p>
                    {item.inLibraryOfCongress && (
                      <p class="loc-badge">Бібліотека Конгресу США</p>
                    )}
                    {item.url && (
                      <a class="card-link" href={item.url} target="_blank" rel="noopener noreferrer">Електронний ресурс →</a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .textbooks-hero {
    padding: 52px 0 18px;
  }

  .textbooks-hero-panel,
  .textbook-card,
  .year-group {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .textbooks-hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 5vw, 54px);
    overflow: hidden;
    position: relative;
  }

  .textbooks-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 300px;
    height: 300px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.14), rgba(29, 79, 145, 0));
  }

  .textbooks-hero-panel > * {
    position: relative;
    z-index: 1;
  }

  .textbooks-hero-panel h1 {
    margin: 0 0 18px;
    max-width: 900px;
    font-size: clamp(2rem, 4.2vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .textbooks-stats {
    display: grid;
    place-items: center;
    min-width: 158px;
    min-height: 158px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(29, 79, 145, 0.10), rgba(184, 135, 47, 0.16));
    border: 1px solid var(--line);
    text-align: center;
  }

  .textbooks-stats strong {
    display: block;
    color: var(--accent-dark);
    font-size: 3rem;
    line-height: 1;
  }

  .textbooks-stats span,
  .textbooks-stats small {
    color: var(--muted);
    font-weight: 850;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
  }
</style>
