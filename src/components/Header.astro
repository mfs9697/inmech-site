---
import { site } from '../data/site';

interface Props {
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { activePage = 'home' } = Astro.props;
const isActive = (page: Props['activePage']) => activePage === page ? 'active' : '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}
---

<header class="site-header">
  <div class="topbar">
    <div class="container">
      <span>{site.officialLabel}</span>
      <div class="lang-switch" aria-label="Вибір мови">
        <a class="active" href={Astro.url.pathname}>Українська</a>
        <a href="#" aria-disabled="true">English</a>
      </div>
    </div>
  </div>

  <div class="container header-main brand-main">
    <a class="brand" href={withBase('/')} aria-label="Головна сторінка">
      <img src={withBase('/assets/img/IMechLogo-upload.svg')} alt="Логотип Інституту механіки" />
      <span class="brand-text">
        <strong class="brand-title">{site.name}</strong>
        <span class="brand-subtitle">{site.subtitle}</span>
      </span>
    </a>
  </div>
</header>

<div class="nav-shell">
  <div class="container nav-row">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      Меню
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Головне меню">
      <ul>
        <li><a class={isActive('home')} href={withBase('/')}>Головна</a></li>

        <li>
          <span class={`nav-label ${isActive('about')}`}>Про інститут ▾</span>
          <ul class="submenu">
            <li><a class={isActive('about')} href={withBase('/history/')}>Історія та місія</a></li>
            <li><a class={isActive('about')} href={withBase('/regulations/')}>Статут</a></li>
            <li><a class={isActive('about')} href={withBase('/strategy/')}>Стратегія розвитку</a></li>
            <li><a class={isActive('about')} href={withBase('/scientific-cooperation/')}>Наукова співпраця</a></li>
            <li><a class={isActive('about')} href={withBase('/tender/')}>Закупівлі та тендери</a></li>
          </ul>
        </li>

        <li>
          <span class={`nav-label ${isActive('departments')}`}>Структура ▾</span>
          <ul class="submenu">
            <li><a class={isActive('departments')} href={withBase('/management/')}>Дирекція</a></li>
            <li><a class={isActive('departments')} href={withBase('/departments/')}>Наукові відділи</a></li>
            <li><a class={isActive('departments')} href={withBase('/scientific-council/')}>Вчена рада</a></li>
            <li><a class={isActive('departments')} href={withBase('/specialized-councils/')}>Спеціалізовані ради</a></li>
            <li><a class={isActive('departments')} href={withBase('/young-scientists/')}>Рада молодих вчених</a></li>
            <li><a class={isActive('departments')} href={withBase('/services/')}>Служби інституту</a></li>
          </ul>
        </li>

        <li>
          <span class={`nav-label ${isActive('education')}`}>Освітньо-наукова діяльність ▾</span>
          <ul class="submenu">
            <li><a class={isActive('education')} href={withBase('/education/')}>Огляд розділу</a></li>
            <li><a class={isActive('education')} href={withBase('/postgraduate/')}>Аспірантура</a></li>
            <li><a class={isActive('education')} href={withBase('/doctoral/')}>Докторантура</a></li>
            <li><a class={isActive('education')} href={withBase('/dissertations/')}>Захист дисертацій</a></li>
            <li><a class={isActive('education')} href={withBase('/license-and-regulations/')}>Ліцензії та Положення</a></li>
            <li><a class={isActive('education')} href={withBase('/trust-box/')}>Скринька довіри</a></li>
            <li><a class={isActive('education')} href={withBase('/nmr/')}>Науково-методична рада</a></li>
          </ul>
        </li>

        <li><a class={isActive('news')} href={withBase('/news/')}>Новини</a></li>
        <li><a href={withBase('/#contacts')}>Контакти</a></li>
        <li><a class="search-nav-link" href={withBase('/search/')} aria-label="Пошук по сайту">Пошук</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    top: auto;
    z-index: 20;
    background: #0f1f34;
    border-bottom: 0;
    color: #fff;
    backdrop-filter: none;
  }

  .topbar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.74);
  }

  .lang-switch a,
  .lang-switch .active {
    color: #cce3ff;
  }

  .header-main.brand-main {
    justify-content: flex-start;
    align-items: center;
  }
</style>
