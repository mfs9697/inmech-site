---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const members = [
  'Кобзар Петро Юрійович, аспірант',
  'Лесик Олексій Іванович, аспірант',
  'Ольховський Антон Стефанович, аспірант',
  'Онищенко Денис Романович, аспірант',
  'Орленко Сергій Петрович, доктор філософії, відділ будівельної механіки тонкостінних конструкцій',
  'Остос Олександр Хосейович, доктор філософії, відділ теорії коливань',
  'Селіванов Данило Михайлович, аспірант',
  'Чернієнко Валерій Олександрович, аспірант',
  'Юрчук Василь Миколайович, кандидат фізико-математичних наук, відділ реології'
];

const directions = [
  'Підтримка наукової діяльності, професійного розвитку та кар’єрного зростання молодих учених.',
  'Інформаційна підтримка щодо грантів, стипендій, конференцій, шкіл, конкурсів та інших можливостей.',
  'Сприяння участі молодих науковців у конференціях, семінарах, школах та науково-освітніх заходах.',
  'Представлення інтересів молодих учених у межах Інституту, НАН України та ширшої наукової спільноти.'
];

const documents = [
  {
    title: 'Положення про Раду молодих вчених НАН України',
    href: 'https://inmech.kyiv.ua/doc/young_scientists/doc1.pdf'
  },
  {
    title: 'Положення про Раду молодих вчених Інституту механіки ім. С. П. Тимошенка НАН України',
    href: 'https://inmech.kyiv.ua/doc/young_scientists/doc2.pdf'
  },
  {
    title: 'Закон України «Про наукову і науково-технічну діяльність»',
    href: 'https://inmech.kyiv.ua/doc/young_scientists/doc3.pdf'
  }
];
---

<BaseLayout
  title={`Рада молодих вчених | ${site.shortName}`}
  description="Рада молодих вчених Інституту механіки ім. С. П. Тимошенка НАН України: керівництво, склад, напрями діяльності та документи."
  activePage="departments"
>
  <section class="young-hero">
    <div class="container young-hero-grid">
      <div class="young-hero-card">
        <p class="eyebrow">Структура Інституту</p>
        <h1>Рада молодих вчених</h1>
        <p class="lead">
          Рада молодих вчених Інституту механіки ім. С. П. Тимошенка НАН України сприяє
          професійному розвитку молодих науковців, аспірантів і докторів філософії,
          підтримує їхню участь у науковій, освітній та організаційній діяльності Інституту.
        </p>
      </div>

      <aside class="young-contact-card" aria-labelledby="young-contact-title">
        <h2 id="young-contact-title">Контактна інформація</h2>
        <p class="contact-name">Остос Олександр Хосейович</p>
        <p class="contact-role">Голова Ради, доктор філософії за спеціальністю 113 «Прикладна математика»</p>
        <ul class="contact-list">
          <li><span>Тел.:</span> <a href="tel:+380661694517">066 169 45 17</a></li>
          <li><span>Тел.:</span> <a href="tel:+380987737426">098 773 74 26</a></li>
          <li><span>Email:</span> <a href="mailto:ostos.alexander1994@gmail.com">ostos.alexander1994@gmail.com</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="young-section">
    <div class="container young-layout">
      <article class="young-panel">
        <h2>Основні напрями діяльності</h2>
        <p>
          Рада сприяє залученню молодих учених до активної дослідницької роботи,
          розвитку професійних контактів, поширенню інформації про наукові події,
          гранти, конкурси, стипендії та можливості для академічного зростання.
        </p>

        <div class="direction-grid">
          {directions.map((item) => (
            <div class="direction-card">{item}</div>
          ))}
        </div>
      </article>

      <article class="young-panel">
        <div class="section-heading-row">
          <div>
            <h2>Склад Ради</h2>
            <p class="section-note">Станом на січень 2024 р. до складу Ради входять 9 осіб.</p>
          </div>
        </div>

        <ol class="member-list">
          {members.map((member) => (
            <li>{member}</li>
          ))}
        </ol>
      </article>

      <article class="young-panel">
        <h2>Нормативна основа діяльності</h2>
        <p>
          Рада у своїй діяльності керується чинним законодавством України, Статутом НАН України
          та Інституту, постановами і розпорядженнями Президії НАН України, наказами директора
          та рішеннями Вченої ради, Положенням про Раду молодих вчених НАН України і
          Положенням про Раду молодих вчених Інституту.
        </p>
      </article>

      <article class="young-panel">
        <h2>Документи</h2>
        <ul class="document-list">
          {documents.map((document) => (
            <li>
              <a href={document.href} target="_blank" rel="noopener noreferrer">
                {document.title}
              </a>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .young-hero {
    padding: 52px 0 26px;
  }

  .young-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.55fr);
    gap: 24px;
    align-items: stretch;
  }

  .young-hero-card,
  .young-contact-card,
  .young-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .young-hero-card {
    padding: clamp(28px, 4vw, 46px);
  }

  .young-hero-card h1 {
    margin: 0 0 18px;
    font-size: clamp(2.05rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .young-contact-card {
    padding: 26px;
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .young-contact-card h2 {
    margin: 0 0 16px;
    font-size: 1.25rem;
  }

  .contact-name {
    margin: 0;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .contact-role {
    margin: 8px 0 18px;
    color: rgba(255, 255, 255, 0.84);
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 9px;
  }

  .contact-list span {
    font-weight: 800;
  }

  .contact-list a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .young-section {
    padding: 22px 0 64px;
  }

  .young-layout {
    display: grid;
    gap: 22px;
  }

  .young-panel {
    padding: clamp(22px, 3vw, 32px);
  }

  .young-panel h2 {
    margin: 0 0 14px;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    letter-spacing: -0.02em;
  }

  .young-panel p {
    margin: 0;
    color: var(--muted);
  }

  .direction-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 22px;
  }

  .direction-card {
    min-height: 100%;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: 14px;
    background: var(--surface-soft);
    color: var(--text);
    font-weight: 600;
  }

  .section-heading-row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  .section-note {
    margin-top: 4px !important;
  }

  .member-list {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 10px;
  }

  .member-list li {
    padding-left: 4px;
  }

  .document-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .document-list a {
    display: block;
    padding: 15px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-soft);
    font-weight: 750;
  }

  .document-list a:hover {
    text-decoration: none;
    background: var(--accent-soft);
  }

  @media (max-width: 860px) {
    .young-hero-grid,
    .direction-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
