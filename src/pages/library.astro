---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const librarySections = [
  {
    title: 'Каталог захищених дисертацій',
    text: 'Алфавітний каталог дисертацій, захищених в Інституті механіки, перенесений зі старої сторінки бібліотеки.',
    href: '/defended-dissertations/',
    label: 'Перейти до каталогу'
  },
  {
    title: 'Захист дисертацій',
    text: 'Матеріали захистів поточного та попереднього року: дисертації, автореферати, відгуки, відеозаписи та супровідні документи.',
    href: '/dissertations/',
    label: 'Переглянути захисти'
  },
  {
    title: 'Журнал «Прикладна механіка»',
    text: 'Інформаційний ресурс періодичного видання Інституту механіки ім. С. П. Тимошенка НАН України.',
    href: 'https://applied-mechanics.inmech.kyiv.ua/',
    label: 'Відкрити сайт журналу'
  }
];
---

<BaseLayout
  title={`Бібліотека | ${site.shortName}`}
  description="Бібліотечні та архівні ресурси Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="home"
>
  <section class="library-hero">
    <div class="container library-hero-panel">
      <p class="eyebrow">Публікації та співпраця</p>
      <h1>Бібліотека</h1>
      <p class="lead">
        Розділ об’єднує бібліографічні, архівні та довідкові матеріали Інституту механіки:
        каталог захищених дисертацій, матеріали останніх захистів і пов’язані публікаційні ресурси.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Ресурси</p>
          <h2>Основні бібліотечні матеріали</h2>
        </div>
        <p>
          На першому етапі до розділу винесено ті матеріали, які вже перенесено або структуровано
          для нового сайту. Надалі сюди можна додати електронні видання, покажчики праць і архівні добірки.
        </p>
      </div>

      <div class="library-grid">
        {librarySections.map((section) => (
          <article class="library-card">
            <h3>{section.title}</h3>
            <p>{section.text}</p>
            <a class="card-link" href={withBase(section.href)}>{section.label} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section library-note-section">
    <div class="container">
      <div class="library-note-panel">
        <p class="eyebrow">Наступний крок</p>
        <h2>Місце розділу в меню</h2>
        <p>
          Поки розділ «Бібліотека» доцільно показати на головній сторінці в блоці
          «Публікації та співпраця». Після наповнення можна винести його в головне меню або
          додати до підменю відповідного тематичного розділу.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .library-hero {
    padding: 52px 0 18px;
  }

  .library-hero-panel,
  .library-card,
  .library-note-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .library-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .library-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(184, 135, 47, 0.17), rgba(184, 135, 47, 0));
  }

  .library-hero-panel h1,
  .library-hero-panel .lead,
  .library-hero-panel .eyebrow {
    position: relative;
    z-index: 1;
  }

  .library-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
  }

  .library-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .library-card {
    padding: 22px;
    min-height: 218px;
  }

  .library-card h3 {
    margin: 0 0 12px;
  }

  .library-card p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .library-note-section {
    padding-top: 18px;
  }

  .library-note-panel {
    padding: clamp(24px, 4vw, 42px);
    background: linear-gradient(135deg, rgba(29, 79, 145, 0.08), rgba(184, 135, 47, 0.12));
  }

  .library-note-panel h2 {
    margin: 0 0 12px;
  }

  .library-note-panel p:last-child {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .section-heading,
    .library-grid {
      display: block;
    }

    .section-heading p:last-child,
    .library-card + .library-card {
      margin-top: 14px;
    }
  }
</style>
