---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<BaseLayout
  title={`Логотип і візуальна ідентичність | ${site.name}`}
  description="Офіційний логотип Інституту механіки ім. С.П. Тимошенка НАН України, відомості про його затвердження та правила використання."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel identity-hero">
        <div class="identity-copy">
          <p class="eyebrow">Про інститут</p>
          <h1>Логотип і візуальна ідентичність</h1>
          <p class="lead">
            Офіційний логотип Інституту механіки ім. С. П. Тимошенка НАН України
            затверджено рішенням Вченої ради від 15 вересня 2026 року та наказом директора
            від 15 вересня 2026 року.
          </p>
          <div class="identity-actions">
            <a class="button primary" href="#order">Текст наказу</a>
            <a class="button secondary" href={withBase('/assets/img/institute-logo-hero-2026.svg')} target="_blank" rel="noopener">
              Відкрити еталонне зображення
            </a>
          </div>
        </div>
        <figure class="identity-logo">
          <img src={withBase('/assets/img/institute-logo-hero-2026.svg')} alt="Офіційний логотип Інституту механіки ім. С.П. Тимошенка НАН України" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container identity-grid">
      <article class="panel identity-panel">
        <p class="eyebrow">Офіційна символіка</p>
        <h2>Затверджена редакція</h2>
        <p>
          Логотип має форму горизонтально орієнтованої овальної емблеми у темно-синій,
          золотистій та світлій нейтральній кольоровій гамі. У центральній частині
          розміщено стилізований графічний портрет Степана Прокоповича Тимошенка,
          позначення <strong>KYIV / КИЇВ</strong> і <strong>EST. 1918</strong>.
        </p>
        <p>
          На темно-синій овальній смузі розміщено назву Інституту українською мовою
          та англомовний напис
          <strong>“S.P. TIMOSHENKO INSTITUTE OF MECHANICS, NAS OF UKRAINE”</strong>.
          Написи, композиція, пропорції та основна кольорова гама відтворюються відповідно
          до еталонного зображення.
        </p>
      </article>

      <aside class="panel identity-panel status-panel">
        <p class="eyebrow">Статус документа</p>
        <h2>Реєстраційні реквізити уточнюються</h2>
        <p>
          На цій сторінці оприлюднено зміст наказу від 15 вересня 2026 року.
          Номер наказу та номер протоколу Вченої ради наразі уточнюються у зв’язку
          з реєстраційною плутаниною.
        </p>
        <p class="small-note">
          Після остаточного уточнення реквізитів сторінку буде оновлено, а зареєстрований
          PDF-документ буде додано без зміни адреси цієї сторінки.
        </p>
      </aside>
    </div>
  </section>

  <section class="section" id="order">
    <div class="container">
      <article class="panel order-panel">
        <p class="eyebrow">Наказ директора</p>
        <div class="order-heading">
          <div>
            <p class="order-date">15 вересня 2026 р. · м. Київ · № уточнюється</p>
            <h2>Про затвердження логотипу Інституту механіки ім. С. П. Тимошенка НАН України</h2>
          </div>
        </div>

        <p>
          З метою формування єдиного візуального стилю Інституту механіки ім. С. П. Тимошенка
          НАН України, упорядкування використання його офіційної візуальної символіки,
          забезпечення впізнаваного представлення Інституту в інформаційному просторі
          та на виконання рішення Вченої ради Інституту від 15 вересня 2026 р.
          (номер протоколу уточнюється):
        </p>

        <p class="order-command">НАКАЗУЮ:</p>
        <ol class="order-list">
          <li>Затвердити логотип Інституту механіки ім. С. П. Тимошенка НАН України та його опис згідно з додатком 1 до цього наказу.</li>
          <li>Визначити затверджений логотип офіційним елементом візуальної ідентичності Інституту механіки ім. С. П. Тимошенка НАН України.</li>
          <li>Використовувати затверджений логотип на офіційному вебсайті та інших офіційних електронних ресурсах Інституту, в інформаційних, презентаційних, видавничих і рекламно-інформаційних матеріалах, під час оформлення наукових та організаційних заходів, а також на інших носіях, що представляють Інститут.</li>
          <li>Для відтворення логотипу використовувати затверджені електронні оригінали. Не допускаються довільна зміна композиції, пропорцій, написів, взаємного розташування елементів та основної кольорової гами логотипу. Масштабування допускається лише зі збереженням пропорцій.</li>
          <li>Використання монохромних або інших спеціальних версій логотипу допускається у випадках, зумовлених технологією відтворення, за умови збереження основних композиційних елементів і впізнаваності затвердженого логотипу.</li>
          <li>Контроль за виконанням цього наказу залишаю за собою.</li>
        </ol>

        <p class="order-signature">
          <strong>Директор Інституту, академік НАН України</strong><br />
          Володимир НАЗАРЕНКО
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel appendix-panel">
        <div>
          <p class="eyebrow">Додаток 1</p>
          <h2>Опис логотипу</h2>
          <p>
            Основу композиції становить темно-синя овальна смуга із золотистим обрамленням.
            У верхній частині смуги золотистим кольором розміщено назву Інституту українською
            мовою, у нижній — англомовний напис. У центральній світлій частині розміщено
            стилізований портрет С. П. Тимошенка; ліворуч — «KYIV / КИЇВ», праворуч —
            «EST. 1918».
          </p>
          <p>
            Еталонним є зображення логотипу, наведене на цій сторінці. Під час використання
            не допускаються деформація зображення, зміна змісту написів, порушення
            співвідношення сторін, довільна зміна кольорової гами або взаємного розташування
            графічних елементів.
          </p>
        </div>
        <img src={withBase('/assets/img/institute-logo-hero-2026.svg')} alt="" aria-hidden="true" />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .identity-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 430px);
    gap: clamp(24px, 4vw, 44px);
    align-items: center;
    padding: clamp(24px, 4vw, 42px);
  }

  .identity-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .identity-logo {
    margin: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fff;
  }

  .identity-logo img,
  .appendix-panel img {
    display: block;
    width: 100%;
    height: auto;
  }

  .identity-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 18px;
  }

  .identity-panel,
  .order-panel,
  .appendix-panel {
    padding: clamp(22px, 3.5vw, 34px);
  }

  .identity-panel h2,
  .order-panel h2,
  .appendix-panel h2 {
    margin-top: 0;
  }

  .status-panel {
    border-color: rgba(184, 135, 47, 0.42);
    background: linear-gradient(145deg, #fff, rgba(184, 135, 47, 0.08));
  }

  .order-date {
    margin: 0 0 10px;
    color: var(--muted);
    font-weight: 750;
  }

  .order-command {
    margin: 26px 0 14px;
    text-align: center;
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .order-list {
    padding-left: 1.4rem;
  }

  .order-list li {
    margin: 0 0 12px;
    padding-left: 0.35rem;
  }

  .order-signature {
    margin: 34px 0 0;
  }

  .appendix-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 390px);
    gap: clamp(24px, 4vw, 44px);
    align-items: center;
  }

  @media (max-width: 820px) {
    .identity-hero,
    .identity-grid,
    .appendix-panel {
      grid-template-columns: 1fr;
    }

    .identity-logo,
    .appendix-panel img {
      max-width: 560px;
    }
  }
</style>
