---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const resourceLinks = [
  {
    title: 'Журнал «Прикладна механіка»',
    description: 'Міжнародний науковий журнал Інституту, присвячений актуальним проблемам теоретичної та прикладної механіки.',
    href: 'https://pm.inmech.kyiv.ua/'
  },
  {
    title: 'Календар подій',
    description: 'Анонси наукових заходів, семінарів, конференцій та інших подій Інституту.',
    href: 'https://events.inmech.kyiv.ua/'
  },
  {
    title: 'Конференції',
    description: 'Інформація про наукові конференції, організовані або підтримані Інститутом.',
    href: 'https://conf.inmech.kyiv.ua/'
  },
  {
    title: 'Національний комітет України з теоретичної і прикладної механіки',
    description: 'Сайт Національного комітету України з теоретичної і прикладної механіки, пов’язаного з міжнародною механічною спільнотою.',
    href: 'https://natcommmech.inmech.kyiv.ua/'
  },
  {
    title: 'Гранти та конкурси',
    description: 'Інформаційний ресурс з оголошеннями про грантові програми, конкурси та можливості фінансування досліджень.',
    href: 'https://grants.inmech.kyiv.ua/'
  }
];

const cooperationAreas = [
  {
    title: 'Міжнародні наукові контакти',
    text: 'Інститут підтримує наукові зв’язки з університетами, дослідницькими центрами та професійними спільнотами в галузі механіки, прикладної математики, матеріалознавства й інженерних наук.'
  },
  {
    title: 'Спільні дослідження та публікації',
    text: 'Одним із важливих напрямів співпраці є підготовка спільних статей, участь у міжнародних дослідницьких проєктах, обмін результатами та розвиток міждисциплінарних підходів.'
  },
  {
    title: 'Конференції та наукові заходи',
    text: 'Інститут організовує та підтримує конференції, семінари й робочі зустрічі, які сприяють науковому обміну та залученню українських учених до міжнародної дослідницької спільноти.'
  },
  {
    title: 'Гранти, конкурси та проєкти',
    text: 'Науковці Інституту беруть участь у грантових конкурсах, програмах підтримки досліджень і спільних ініціативах, спрямованих на розвиток фундаментальної та прикладної науки.'
  }
];
---

<BaseLayout
  title={`Наукова співпраця | ${site.name}`}
  description="Наукова співпраця Інституту механіки ім. С.П. Тимошенка НАН України: міжнародні контакти, конференції, журнали, комітети, гранти та конкурси."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel cooperation-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>Наукова співпраця</h1>
        <p class="lead">
          Наукова співпраця Інституту охоплює міжнародні контакти, спільні дослідження,
          конференційну діяльність, публікації, участь у професійних комітетах, грантових
          програмах і конкурсах.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cooperation-grid">
      {cooperationAreas.map((item) => (
        <article class="panel cooperation-card">
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Пов’язані ресурси</p>
          <h2 class="section-title">Інформаційні сайти та платформи</h2>
          <p class="section-text">
            Нижче подано ресурси, пов’язані з публікаційною, конференційною,
            організаційною та грантовою діяльністю Інституту.
          </p>
        </div>
      </div>

      <div class="resource-grid">
        {resourceLinks.map((item) => (
          <article class="resource-card">
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            <a class="button secondary" href={item.href} target="_blank" rel="noopener">
              Перейти на сайт
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel cooperation-note">
        <p class="eyebrow">Оновлення розділу</p>
        <h2>Матеріали для наповнення</h2>
        <p>
          Цю сторінку можна доповнити переліком міжнародних угод, партнерських установ,
          спільних проєктів, меморандумів, програм академічної мобільності та результатів
          міжнародної співпраці наукових відділів.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
