---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const documents = [
  {
    year: '2023',
    title: 'Statute of the Institute, 2023',
    description:
      'The current version of the Statute of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine.',
    href: '/documents/institute/statute/statute-2023.pdf',
    current: true
  },
  {
    year: '2016',
    title: 'Statute of the Institute, 2016',
    description: 'A previous version of the Institute Statute, retained for archival access.',
    href: '/documents/institute/statute/statute-2016.pdf',
    current: false
  },
  {
    year: '2003',
    title: 'Statute of the Institute, 2003',
    description: 'An archival version of the Institute Statute.',
    href: '/documents/institute/statute/statute-2003.pdf',
    current: false
  }
];
---

<BaseLayoutEn
  title={`Statute | ${siteEn.shortName}`}
  description="Statutory documents of the S.P. Timoshenko Institute of Mechanics of the National Academy of Sciences of Ukraine."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel statute-hero-panel">
        <p class="eyebrow">About the Institute</p>
        <h1>Statute of the Institute</h1>
        <p class="lead">
          This page provides access to the current and archival versions of the Statute of the
          S.P. Timoshenko Institute of Mechanics of the National Academy of Sciences of Ukraine.
          The documents are available in PDF format.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="history-grid">
        <article class="panel">
          <p class="eyebrow">Institutional framework</p>
          <h2>Purpose of the Statute</h2>
          <p>
            The Statute is the principal institutional document that defines the legal status,
            mission, governance principles and core areas of activity of the Institute. It is used
            as the official reference for institutional organisation and operation.
          </p>
          <p>
            For official use, the current 2023 version should be consulted. Earlier versions are
            retained below for archival reference and comparison.
          </p>
        </article>

        <article class="panel">
          <p class="eyebrow">Official documents</p>
          <h2>Available versions</h2>
          <ul class="history-list">
            <li>Current version of the Statute approved in 2023.</li>
            <li>Previous version of the Statute from 2016.</li>
            <li>Archival version of the Statute from 2003.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Statutory documents</p>
          <h2 class="section-title">Versions of the Statute</h2>
          <p class="section-text">
            The 2023 version is the current document. Previous versions are provided for archival
            access and for tracing changes in the Institute’s structure and legal status.
          </p>
        </div>
      </div>

      <div class="statute-grid">
        {documents.map((doc) => (
          <article class={`statute-card ${doc.current ? 'current' : ''}`}>
            <div class="statute-year">{doc.year}</div>
            <div class="statute-card-body">
              {doc.current && <p class="statute-badge">Current version</p>}
              <h2>{doc.title}</h2>
              <p>{doc.description}</p>
              <a class="button secondary" href={withBase(doc.href)} target="_blank" rel="noopener">
                Open PDF
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel statute-note">
        <p class="eyebrow">Note</p>
        <h2>Use of documents</h2>
        <p>
          The PDF documents are provided in Ukrainian as official materials. For formal or legal
          purposes, the current version of the Statute and the responsible administrative units of
          the Institute should be consulted.
        </p>
        <p>
          <a href={withBase('/regulations/')}>Open the Ukrainian Statute page</a>
        </p>
      </article>
    </div>
  </section>
</BaseLayoutEn>
