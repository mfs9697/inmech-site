---
import BaseLayoutEn from '../../../../../layouts/BaseLayoutEn.astro';
import NcutamNav from '../../../../../components/NcutamNav.astro';
import { ncutamSite } from '../../../../../data/ncutam/site';
import { siteEn } from '../../../../../data/site-en';
---

<BaseLayoutEn title={`Annual reports | ${ncutamSite.acronymEn} | ${siteEn.shortName}`} description="Archive of annual reports of the National Committee of Ukraine for Theoretical and Applied Mechanics." activePage="ncutam">
  <NcutamNav language="en" active="documents" />
  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{ncutamSite.acronymEn} · Documents</p>
        <h1>Annual reports</h1>
        <p class="lead">Official annual reports on the activities of the Committee.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="panel">
        <h2>Verified reports are being prepared for publication</h2>
        <p>Final PDFs for 2023, 2024 and 2025 have already been identified in the source repository. Links will be enabled after the files themselves have been migrated to stable <code>/documents/ncutam/reports/…</code> paths.</p>
      </div>
    </div>
  </section>
</BaseLayoutEn>
