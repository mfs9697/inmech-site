---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

function initials(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}

const serviceGroups = [
  {
    title: 'Планово-економічний відділ',
    icon: '📊',
    description: 'Планово-економічний супровід діяльності Інституту.',
    staff: [
      {
        name: 'Макарова Людмила Миколаївна',
        position: 'начальник відділу'
      },
      {
        name: 'Хромцова Тетяна Валентинівна',
        position: 'провідний економіст'
      },
      {
        name: 'Сапсай Катерина Петрівна',
        position: 'провідний економіст'
      }
    ]
  },
  {
    title: 'Відділ кадрів',
    icon: '👥',
    description: 'Кадровий облік, супровід кадрових процедур і робота з персоналом.',
    staff: [
      {
        name: 'Деревінська Наталія Миколаївна',
        position: 'начальник відділу кадрів'
      },
      {
        name: 'Демчук Марина Іванівна',
        position: 'старший інспектор'
      }
    ]
  },
  {
    title: 'Відділ бухгалтерського обліку та звітності',
    icon: '🧾',
    description: 'Бухгалтерський облік, фінансова звітність і супровід фінансово-господарських процедур.',
    staff: [
      {
        name: 'Бек Надія Миколаївна',
        position: 'головний бухгалтер'
      },
      {
        name: 'Грибова Олена Венидіктівна',
        position: 'заступник головного бухгалтера'
      },
      {
        name: 'Остапчук Світлана Юріївна',
        position: 'провідний бухгалтер'
      },
      {
        name: 'Овсінська Тетяна Анатоліївна',
        position: 'провідний бухгалтер'
      }
    ]
  },
  {
    title: 'Канцелярія',
    icon: '📁',
    description: 'Службовий документообіг, канцелярська робота та архів.',
    staff: [
      {
        name: 'Сидорова Тетяна Сергіївна',
        position: 'завідувач канцелярії'
      },
      {
        name: 'Бондарчук Людмила В’ячеславівна',
        position: 'інженер 1 категорії, архів'
      }
    ]
  }
];

const totalStaff = serviceGroups.reduce((sum, group) => sum + group.staff.length, 0);

const relatedLinks = [
  ['Дирекція', '/management/'],
  ['Наукові відділи', '/departments/'],
  ['Вчена рада', '/scientific-council/'],
  ['Рада молодих вчених', '/young-scientists/']
];
---

<BaseLayout
  title={`Служби інституту | ${site.shortName}`}
  description="Служби Інституту механіки ім. С. П. Тимошенка НАН України: планово-економічний відділ, відділ кадрів, відділ бухгалтерського обліку та звітності, канцелярія."
  activePage="departments"
>
  <section class="services-hero">
    <div class="container services-hero-grid">
      <div class="services-hero-panel">
        <p class="eyebrow">Структура Інституту</p>
        <h1>Служби інституту</h1>
        <p class="lead">
          Служби Інституту забезпечують планово-економічний, кадровий,
          бухгалтерський та канцелярський супровід роботи установи, підтримуючи
          щоденну діяльність наукових підрозділів і адміністрації.
        </p>
        <div class="services-hero-actions">
          <a class="button primary" href="#services-list">Структура служб</a>
          <a class="button secondary" href="#contacts">Контакти</a>
        </div>
      </div>

      <aside class="services-mark-card">
        <span>{serviceGroups.length}</span>
        <h2>служби</h2>
        <p>
          На сторінці подано структуру та склад служб Інституту: {totalStaff} працівників
          у чотирьох адміністративно-господарських підрозділах.
        </p>
      </aside>
    </div>
  </section>

  <section class="section services-summary-section">
    <div class="container services-summary-grid">
      <article class="services-summary-card">
        <span>Планування</span>
        <p>планово-економічний супровід діяльності</p>
      </article>
      <article class="services-summary-card">
        <span>Персонал</span>
        <p>кадрові процедури та облік працівників</p>
      </article>
      <article class="services-summary-card">
        <span>Документи</span>
        <p>бухгалтерія, звітність, канцелярія та архів</p>
      </article>
    </div>
  </section>

  <section class="section" id="services-list">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Структура та склад</p>
          <h2>Служби Інституту</h2>
        </div>
        <p>
          Нижче подано службові підрозділи Інституту та їхній персональний склад.
          Кожну службу оформлено окремою карткою з працівниками та посадами.
        </p>
      </div>

      <div class="service-group-grid">
        {serviceGroups.map((group) => (
          <section class="service-group-card">
            <div class="service-group-header">
              <span>{group.icon}</span>
              <div>
                <h3>{group.title}</h3>
                <p>{group.description}</p>
              </div>
            </div>

            <div class="staff-card-grid">
              {group.staff.map((person) => (
                <article class="staff-card">
                  <div class="staff-avatar" aria-hidden="true">{initials(person.name)}</div>
                  <div>
                    <h4>{person.name}</h4>
                    <p>{person.position}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="contacts">
    <div class="container services-two-column">
      <article class="services-contact-panel">
        <p class="eyebrow">Загальні контакти</p>
        <h2>Контактна інформація Інституту</h2>
        <p>
          Для звернень до служб Інституту можна використовувати загальні контакти установи
          або звертатися безпосередньо до відповідного структурного підрозділу.
        </p>
        <div class="services-contact-list">
          <div>
            <strong>Адреса</strong>
            <span>{site.address}</span>
          </div>
          <div>
            <strong>Телефон</strong>
            <a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a>
          </div>
          <div>
            <strong>Email</strong>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
      </article>

      <aside class="services-note-panel">
        <p class="eyebrow">Примітка</p>
        <h2>Актуалізація інформації</h2>
        <p>
          За потреби сторінку можна доповнити кабінетами, службовими телефонами,
          графіком прийому, внутрішніми регламентами та типовими формами документів.
        </p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="related-panel">
        <div>
          <p class="eyebrow">Пов’язані розділи</p>
          <h2>Структура Інституту</h2>
        </div>
        <div class="related-link-grid">
          {relatedLinks.map(([title, href]) => (
            <a href={withBase(href)}>{title} →</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero {
    padding: 52px 0 18px;
  }

  .services-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }

  .services-hero-panel,
  .services-mark-card,
  .services-summary-card,
  .service-group-card,
  .staff-card,
  .services-contact-panel,
  .services-note-panel,
  .related-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .services-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .services-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.17), rgba(29, 79, 145, 0));
  }

  .services-hero-panel h1,
  .services-hero-panel .lead,
  .services-hero-panel .eyebrow,
  .services-hero-actions {
    position: relative;
    z-index: 1;
  }

  .services-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .services-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .services-mark-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .services-mark-card span {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 2.4rem;
    font-weight: 950;
  }

  .services-mark-card h2 {
    margin: 0 0 12px;
    font-size: 1.65rem;
  }

  .services-mark-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .services-summary-section {
    padding-top: 16px;
  }

  .services-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .services-summary-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: clamp(20px, 3vw, 30px);
  }

  .services-summary-card span {
    display: grid;
    place-items: center;
    min-width: 118px;
    height: 70px;
    border-radius: 22px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-weight: 950;
  }

  .services-summary-card p {
    margin: 0;
    color: var(--muted);
    font-weight: 750;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
  }

  .service-group-grid {
    display: grid;
    gap: 18px;
  }

  .service-group-card {
    padding: clamp(22px, 3vw, 34px);
  }

  .service-group-header {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    margin-bottom: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }

  .service-group-header > span {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 22px;
    background: var(--surface-soft);
    font-size: 1.6rem;
  }

  .service-group-header h3 {
    margin: 0 0 8px;
    font-size: clamp(1.32rem, 2vw, 1.8rem);
    line-height: 1.15;
  }

  .service-group-header p {
    margin: 0;
    color: var(--muted);
  }

  .staff-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .staff-card {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 16px;
    box-shadow: none;
    background: var(--surface-soft);
  }

  .staff-avatar {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--accent-soft), rgba(184, 135, 47, 0.16));
    color: var(--accent-dark);
    font-weight: 950;
  }

  .staff-card h4 {
    margin: 0 0 4px;
    font-size: 1rem;
    line-height: 1.25;
  }

  .staff-card p {
    margin: 0;
    color: var(--muted);
    font-weight: 700;
  }

  .services-two-column {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 18px;
    align-items: start;
  }

  .services-contact-panel,
  .services-note-panel,
  .related-panel {
    padding: clamp(22px, 3vw, 34px);
  }

  .services-contact-panel h2,
  .services-note-panel h2,
  .related-panel h2 {
    margin: 0 0 12px;
    font-size: clamp(1.45rem, 2.4vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .services-contact-panel p,
  .services-note-panel p {
    color: var(--muted);
  }

  .services-contact-list {
    display: grid;
    gap: 12px;
    margin-top: 18px;
  }

  .services-contact-list div {
    display: grid;
    gap: 5px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
  }

  .services-contact-list strong {
    color: var(--accent-dark);
  }

  .services-note-panel {
    background: linear-gradient(135deg, rgba(184, 135, 47, 0.12), rgba(29, 79, 145, 0.08));
    border-color: rgba(184, 135, 47, 0.35);
  }

  .related-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: center;
  }

  .related-link-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .related-link-grid a {
    display: block;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-soft);
    color: var(--accent-dark);
    font-weight: 850;
  }

  .related-link-grid a:hover {
    text-decoration: none;
    background: var(--accent-soft);
  }

  @media (max-width: 1040px) {
    .staff-card-grid,
    .related-link-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .services-hero-grid,
    .services-summary-grid,
    .services-two-column,
    .related-panel {
      grid-template-columns: 1fr;
    }

    .section-heading {
      display: block;
    }

    .section-heading p:last-child {
      margin-top: 10px;
    }
  }

  @media (max-width: 620px) {
    .staff-card-grid,
    .related-link-grid,
    .service-group-header,
    .staff-card {
      grid-template-columns: 1fr;
    }
  }
</style>
