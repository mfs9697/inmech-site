---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const principles = [
  {
    title: 'Confidentiality',
    icon: '🔒',
    text: 'Messages are reviewed with respect for the privacy of the sender and the content of the appeal.'
  },
  {
    title: 'Constructive communication',
    icon: '🤝',
    text: 'The trust box is intended for constructive appeals, proposals and messages related to the educational and research environment.'
  },
  {
    title: 'Feedback',
    icon: '✉️',
    text: 'If you would like to receive a reply, please include contact information at the end of your message.'
  }
];

const topics = [
  'proposals for improving the educational and research process',
  'reports about problematic situations in the educational environment',
  'issues of academic integrity and ethics in academic relations',
  'comments on the organisation of study, communication or access to information',
  'other appeals related to educational and research activities of the Institute'
];

const relatedLinks = [
  ['Postgraduate studies', '/en/postgraduate/'],
  ['Licenses and regulations', '/en/license-and-regulations/'],
  ['Scientific and Methodological Council', '/en/nmr/'],
  ['Education and research training', '/en/education/']
];
---

<BaseLayoutEn
  title={`Trust box | ${siteEn.shortName}`}
  description="Trust box of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine for appeals, messages and proposals related to the educational and research environment."
  activePage="education"
>
  <section class="trust-hero">
    <div class="container trust-hero-grid">
      <div class="trust-hero-panel">
        <p class="eyebrow">Education and research training</p>
        <h1>Trust box</h1>
        <p class="lead">
          The trust box is intended for appeals, messages and proposals related to the educational
          and research environment of the Institute. If you would like to receive a reply, please
          include contact information at the end of your message.
        </p>
        <div class="trust-hero-actions">
          <a class="button primary" href="#trust-form">Send an appeal</a>
          <a class="button secondary" href="#principles">Working principles</a>
        </div>
      </div>

      <aside class="trust-mark-card">
        <span>✉️</span>
        <h2>Open communication</h2>
        <p>
          A channel for calm and responsible messages about issues that require attention in the
          educational and research process.
        </p>
      </aside>
    </div>
  </section>

  <section class="section trust-summary-section" id="principles">
    <div class="container trust-summary-grid">
      {principles.map((principle) => (
        <article class="trust-summary-card">
          <span>{principle.icon}</span>
          <h2>{principle.title}</h2>
          <p>{principle.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="trust-form">
    <div class="container trust-two-column">
      <article class="trust-form-panel">
        <div class="section-heading compact-header">
          <div>
            <p class="eyebrow">Appeal</p>
            <h2>Write to the trust box</h2>
          </div>
        </div>

        <form class="trust-form" id="trustForm">
          <label for="trustMessage">Message text</label>
          <textarea
            id="trustMessage"
            name="message"
            rows="10"
            placeholder="Enter the text of your appeal. If you would like to receive a reply, please include contact information at the end of the message."
          ></textarea>

          <p class="form-note">
            This form is used on a static website: after pressing the button, your email application
            will open with a prepared message addressed to the Institute.
          </p>

          <div class="trust-form-actions">
            <button class="button primary" type="submit">Prepare email</button>
            <a class="button secondary" href={`mailto:${siteEn.email}?subject=Trust box`}>Write via email</a>
          </div>
        </form>
      </article>

      <aside class="trust-topics-panel">
        <p class="eyebrow">What can be reported</p>
        <h2>Topics of appeals</h2>
        <ul>
          {topics.map((topic) => <li>{topic}</li>)}
        </ul>
        <div class="trust-email-card">
          <strong>Institute email</strong>
          <a href={`mailto:${siteEn.email}`}>{siteEn.email}</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="trust-note-panel">
        <p class="eyebrow">Important</p>
        <h2>How to prepare an appeal</h2>
        <p>
          Describe the situation briefly and clearly: what happened, when it happened, whom or what
          process the appeal concerns, and what action or clarification you expect. To receive a reply,
          please add an email address or another convenient contact at the end of the message.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="related-panel">
        <div>
          <p class="eyebrow">Related sections</p>
          <h2>Education and research training</h2>
        </div>
        <div class="related-link-grid">
          {relatedLinks.map(([title, href]) => (
            <a href={withBase(href)}>{title} →</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('trustForm');
    const textarea = document.getElementById('trustMessage');
    const email = 'inst_mech@inmech.kyiv.ua';

    if (form && textarea instanceof HTMLTextAreaElement) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const message = textarea.value.trim();
        const subject = encodeURIComponent('Trust box');
        const body = encodeURIComponent(message || '');
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      });
    }
  </script>
</BaseLayoutEn>

<style>
  .trust-hero {
    padding: 52px 0 18px;
  }

  .trust-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }

  .trust-hero-panel,
  .trust-mark-card,
  .trust-summary-card,
  .trust-form-panel,
  .trust-topics-panel,
  .trust-note-panel,
  .related-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .trust-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .trust-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.17), rgba(29, 79, 145, 0));
  }

  .trust-hero-panel h1,
  .trust-hero-panel .lead,
  .trust-hero-panel .eyebrow,
  .trust-hero-actions {
    position: relative;
    z-index: 1;
  }

  .trust-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .trust-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .trust-mark-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .trust-mark-card span {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 2rem;
  }

  .trust-mark-card h2 {
    margin: 0 0 12px;
    font-size: 1.65rem;
  }

  .trust-mark-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .trust-summary-section {
    padding-top: 16px;
  }

  .trust-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .trust-summary-card {
    padding: clamp(20px, 3vw, 30px);
  }

  .trust-summary-card > span {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    margin-bottom: 18px;
    border-radius: 20px;
    background: var(--surface-soft);
    font-size: 1.45rem;
  }

  .trust-summary-card h2 {
    margin: 0 0 10px;
    font-size: 1.25rem;
  }

  .trust-summary-card p {
    margin: 0;
    color: var(--muted);
  }

  .trust-two-column {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 18px;
    align-items: start;
  }

  .trust-form-panel,
  .trust-topics-panel,
  .trust-note-panel,
  .related-panel {
    padding: clamp(22px, 3vw, 34px);
  }

  .section-heading {
    margin-bottom: 18px;
  }

  .section-heading h2,
  .trust-topics-panel h2,
  .trust-note-panel h2,
  .related-panel h2 {
    margin: 0 0 12px;
    font-size: clamp(1.45rem, 2.4vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .trust-form {
    display: grid;
    gap: 14px;
  }

  .trust-form label {
    color: var(--accent-dark);
    font-weight: 900;
  }

  .trust-form textarea {
    width: 100%;
    min-height: 260px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--text);
    font: inherit;
    resize: vertical;
  }

  .trust-form textarea:focus {
    outline: 3px solid rgba(29, 79, 145, 0.18);
    border-color: rgba(29, 79, 145, 0.45);
  }

  .form-note,
  .trust-note-panel p,
  .trust-topics-panel li {
    color: var(--muted);
  }

  .form-note {
    margin: 0;
    padding: 14px 16px;
    border-left: 5px solid var(--accent);
    border-radius: 14px;
    background: var(--surface-soft);
  }

  .trust-form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .trust-form-actions button {
    cursor: pointer;
    font: inherit;
  }

  .trust-topics-panel ul {
    margin: 0;
    padding-left: 20px;
  }

  .trust-topics-panel li {
    margin-bottom: 10px;
  }

  .trust-email-card {
    margin-top: 22px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
  }

  .trust-email-card strong {
    display: block;
    margin-bottom: 6px;
    color: var(--accent-dark);
  }

  .trust-note-panel {
    background: linear-gradient(135deg, rgba(184, 135, 47, 0.12), rgba(29, 79, 145, 0.08));
    border-color: rgba(184, 135, 47, 0.35);
  }

  .trust-note-panel p:last-child {
    margin-bottom: 0;
  }

  .related-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: center;
  }

  .related-link-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .related-link-grid a {
    display: block;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-soft);
    color: var(--accent-dark);
    font-weight: 850;
  }

  .related-link-grid a:hover {
    text-decoration: none;
    background: var(--accent-soft);
  }

  @media (max-width: 1020px) {
    .related-link-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .trust-hero-grid,
    .trust-summary-grid,
    .trust-two-column,
    .related-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .related-link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
