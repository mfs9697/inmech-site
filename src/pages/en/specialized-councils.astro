---

<BaseLayoutEn
  title={`Specialized Academic Councils | ${siteEn.shortName}`}
  description="Specialized academic councils of the S. P. Timoshenko Institute of Mechanics of the NAS of Ukraine."
  activePage="departments"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel specialized-hero-panel">
        <p class="eyebrow">Structure</p>
        <h1>Specialized Academic Councils</h1>
        <p class="lead">
          The S. P. Timoshenko Institute of Mechanics of the NAS of Ukraine has specialized
          academic councils for awarding the scientific degree of Doctor of Sciences in
          mechanics-related specialties.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="specialized-summary-grid">
        <article class="specialized-summary-card">
          <span>{councils.length}</span>
          <p>specialized academic councils</p>
        </article>
        <article class="specialized-summary-card">
          <span>{totalMembers}</span>
          <p>council members</p>
        </article>
      </div>
    </div>
  </section>

  {councils.map((council) => (
    <section class="section">
      <div class="container">
        <article class="specialized-council-panel">
          <div class="specialized-council-header">
            <div>
              <p class="eyebrow">{council.field}</p>
              <h2>{council.code}</h2>
              <p class="specialized-profile"><strong>Council profile:</strong> {council.profile}</p>
              <p class="specialized-order">{council.order}</p>
            </div>
          </div>

          <div class="specialized-people-grid">
            {council.people.map((person) => (
              <article class={`specialized-person-card ${person.councilRole ? 'has-role' : ''}`}>
                {person.councilRole && <p class="specialized-role-badge">{person.councilRole}</p>}
                <h3>{person.name}</h3>

                <dl class="specialized-person-details">
                  <div>
                    <dt>Scientific degree</dt>
                    <dd>{person.degree}</dd>
                  </div>
                  {person.academicTitle && (
                    <div>
                      <dt>Academic title</dt>
                      <dd>{person.academicTitle}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Position</dt>
                    <dd>{person.position}</dd>
                  </div>
                  {person.institution && (
                    <div>
                      <dt>Institution</dt>
                      <dd>{person.institution}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Specialty</dt>
                    <dd>{person.specialty}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>
        </article>
      </div>
    </section>
  ))}
</BaseLayoutEn>
