---
import { getCollection } from 'astro:content';
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';
import { getVisibleNewsTagsEn } from '../../../utils/newsTags';
import { getEnglishNewsBody, renderNewsMarkdown } from '../../../utils/newsBody';

export async function getStaticPaths() {
  const news = (await getCollection('news')).filter((entry) => !entry.data.externalUrl);
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const date = entry.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const title = entry.data.titleEn ?? entry.data.title;
const description = entry.data.descriptionEn ?? entry.data.description;
const category = entry.data.categoryEn ?? entry.data.category;
const tags = getVisibleNewsTagsEn(entry);
const image = entry.data.image ? withBase(entry.data.image) : undefined;
const imageAlt = entry.data.imageAltEn ?? entry.data.imageAlt ?? '';
const imageSecondary = entry.data.imageSecondary ? withBase(entry.data.imageSecondary) : undefined;
const imageSecondaryAlt = entry.data.imageSecondaryAltEn ?? entry.data.imageSecondaryAlt ?? '';
const usesBookCover = entry.data.image?.includes('/assets/img/history/books/') ?? false;
const englishBody = getEnglishNewsBody(entry.body ?? '');
const hasEnglishBody = englishBody.length > 0;
const englishBodyHtml = hasEnglishBody ? renderNewsMarkdown(englishBody, base) : '';
const ukrainianNewsUrl = withBase(`/news/${entry.id}/`);
---
<BaseLayoutEn title={`${title} | ${siteEn.name}`} description={description} activePage="news">
<section class="page-hero news-detail-hero"><div class="container"><div class="panel"><p class="eyebrow">{category}</p><h1>{title}</h1><div class="meta-line"><time datetime={entry.data.date.toISOString()}>{date}</time>{tags.length > 0 && (<span>{tags.join(' · ')}</span>)}</div><p class="lead">{description}</p></div></div></section>
<section class="section"><div class="container news-detail-container"><article class="panel news-detail-panel">{image && (imageSecondary ? (
  <div class="news-book-cover-pair" role="group" aria-label="Covers of both volumes">
    <figure>
      <img src={image} alt={imageAlt} loading="eager" decoding="async" width="240" height="360" />
      <figcaption>Volume 1</figcaption>
    </figure>
    <figure>
      <img src={imageSecondary} alt={imageSecondaryAlt} loading="eager" decoding="async" width="240" height="360" />
      <figcaption>Volume 2</figcaption>
    </figure>
  </div>
) : (<figure class:list={["news-detail-image", { "news-detail-image-book": usesBookCover }]}><img src={image} alt={imageAlt} loading="eager" decoding="async" /></figure>))}{hasEnglishBody ? (<div class="content-body news-content" set:html={englishBodyHtml} />) : (<p class="translation-note">The English text of this news item is being prepared. Please use the <a href={ukrainianNewsUrl}>Ukrainian version</a> for the full text.</p>)}<p class="back-link"><a href={withBase('/en/news/')}>← Back to all news</a></p></article></div></section>
</BaseLayoutEn>
<style>
.news-detail-hero .lead{margin-top:18px}.news-detail-container{max-width:900px}.news-detail-panel{padding:clamp(24px,4vw,42px)}.news-detail-image{margin:0 0 clamp(22px,3vw,34px);overflow:hidden;border:1px solid var(--line);border-radius:calc(var(--radius) - 6px);background:var(--surface-soft);display:flex;justify-content:center}.news-detail-image img{display:block;max-height:420px;width:auto;max-width:100%}.news-detail-image-book{width:min(100%,300px);margin-left:auto;margin-right:auto;padding:12px;box-shadow:0 12px 28px rgba(15,31,52,.12)}.news-detail-image-book img{max-height:none;width:100%;height:auto}.translation-note{padding:14px 16px;border:1px solid var(--line);border-radius:14px;background:var(--surface-soft);color:var(--muted);font-weight:650}.translation-note a{font-weight:800}.news-content{color:var(--text);font-size:1.06rem;line-height:1.78}.news-content :global(p){margin:0 0 1.15rem}.back-link{margin:28px 0 0;font-weight:750}

.news-book-cover-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  justify-items: center;
  align-items: start;
  gap: clamp(12px, 4vw, 28px);
  max-width: 620px;
  margin: 0 auto clamp(22px, 3vw, 34px);
}
.news-book-cover-pair figure {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-width: 0;
  margin: 0;
}
.news-book-cover-pair img {
  display: block;
  width: 100%;
  max-width: 240px;
  height: auto;
  border-radius: 8px;
  box-shadow: 0 12px 26px rgba(15, 31, 52, 0.16);
}
.news-book-cover-pair figcaption {
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 750;
  text-align: center;
}
@media (max-width: 480px) {
  .news-book-cover-pair { gap: 12px; }
  .news-book-cover-pair figcaption { font-size: 0.82rem; }
}
</style>