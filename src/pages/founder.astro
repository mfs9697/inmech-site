---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import FounderEarlyLife from '../components/founder/FounderEarlyLife.astro';
import FounderAcademy from '../components/founder/FounderAcademy.astro';
import FounderFirstYears from '../components/founder/FounderFirstYears.astro';
import FounderEmigration from '../components/founder/FounderEmigration.astro';
import FounderCommemoration from '../components/founder/FounderCommemoration.astro';
import FounderBibliography from '../components/founder/FounderBibliography.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<BaseLayout
  title={`Засновник інституту | ${site.name}`}
  description="Сторінка про Степана Прокоповича Тимошенка — засновника і першого директора Інституту механіки НАН України."
  activePage="about"
>
  <section class="page-hero founder-hero">
    <div class="container founder-page-container">
      <div class="panel founder-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>С.П. Тимошенко — засновник Інституту механіки</h1>
        <p class="lead">
          Степан Прокопович Тимошенко — видатний учений-механік зі світовим ім’ям,
          один із фундаторів Української академії наук, засновник і перший директор
          Інституту механіки НАН України, який сьогодні носить його ім’я.
        </p>
        <p class="founder-language-note">
          <a href={withBase('/en/founder/')}>English version</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section founder-section">
    <div class="container founder-page-container founder-container">
      <article class="panel founder-article">
        <FounderEarlyLife />
        <FounderAcademy />
        <FounderFirstYears />
        <FounderEmigration />
        <FounderCommemoration />
        <FounderBibliography />

        <p class="founder-source">
          Текст сторінки подано за матеріалами статті академіка В.Л. Богданова
          «С.П. Тимошенко — засновник Інституту механіки».
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .founder-page-container {
    width: min(100% - 32px, 1080px);
    margin-inline: auto;
  }

  .founder-hero-panel {
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
    padding: clamp(28px, 4vw, 50px);
  }

  .founder-language-note {
    margin-top: 1rem;
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .founder-language-note a {
    font-weight: 800;
  }

  .founder-container {
    max-width: 1080px;
  }

  .founder-article {
    display: flex;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(30px, 4.6vw, 58px);
    flex-direction: column;
    align-items: stretch;
  }

  .founder-content-section {
    display: block;
    width: 100%;
    clear: both;
  }

  .founder-content-section + .founder-content-section {
    margin-top: clamp(34px, 5vw, 58px);
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--line);
  }

  .founder-article h2 {
    margin-top: 0;
    margin-bottom: 1.2rem;
    max-width: 820px;
  }

  .founder-article h3 {
    margin-top: clamp(28px, 4vw, 42px);
    margin-bottom: 1rem;
  }

  .founder-article p {
    max-width: 850px;
    font-size: 1.04rem;
    line-height: 1.82;
  }

  .founder-article p + p {
    margin-top: 1.08rem;
  }

  .founder-figure {
    margin: clamp(22px, 4vw, 34px) 0;
    max-width: 850px;
  }

  .founder-figure img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: 0 14px 34px rgba(20, 33, 61, 0.10);
    background: var(--surface-soft);
  }

  .founder-figure figcaption {
    margin: 10px auto 0;
    max-width: 760px;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    text-align: center;
  }

  .founder-figure-portrait img,
  .founder-figure-document img {
    max-height: 520px;
  }

  .founder-figure-wide img {
    width: min(100%, 760px);
  }

  .founder-reference-list {
    margin: 18px 0 0;
    padding-left: 1.45rem;
    display: grid;
    gap: 0.72rem;
    max-width: 880px;
    color: var(--text);
    font-size: 0.96rem;
    line-height: 1.58;
  }

  .founder-reference-list li::marker {
    color: var(--gold);
    font-weight: 800;
  }

  .founder-source-list {
    color: var(--muted);
  }

  .founder-source {
    margin-top: clamp(30px, 4vw, 46px);
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem !important;
    line-height: 1.55 !important;
  }

  @media (max-width: 760px) {
    .founder-page-container {
      width: min(100% - 24px, 1080px);
    }

    .founder-hero-panel,
    .founder-article {
      padding: 24px;
    }

    .founder-article p {
      font-size: 1rem;
      line-height: 1.72;
    }

    .founder-reference-list {
      padding-left: 1.15rem;
      font-size: 0.92rem;
    }
  }
</style>
