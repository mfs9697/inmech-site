---
import { getCollection } from 'astro:content';
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';
import { getVisibleNewsTagsEn } from '../../../utils/newsTags';
import { getEnglishNewsBody, renderNewsMarkdown } from '../../../utils/newsBody';

export async function getStaticPaths() {
  const news = (await getCollection('news')).filter((entry) => !entry.data.externalUrl);

  return news.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const date = entry.data.date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
const title = entry.data.titleEn ?? entry.data.title;
const description = entry.data.descriptionEn ?? entry.data.description;
const category = entry.data.categoryEn ?? entry.data.category;
const tags = getVisibleNewsTagsEn(entry);
const image = entry.data.image ? withBase(entry.data.image) : undefined;
const imageAlt = entry.data.imageAltEn ?? entry.data.imageAlt ?? '';
const englishBody = getEnglishNewsBody(entry.body ?? '');
const hasEnglishBody = englishBody.length > 0;
const englishBodyHtml = hasEnglishBody ? renderNewsMarkdown(englishBody, base) : '';
const ukrainianNewsUrl = withBase(`/news/${entry.id}/`);
---

<BaseLayoutEn
  title={`${title} | ${siteEn.name}`}
  description={description}
  activePage="news"
>
  <section class="page-hero news-detail-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <div class="meta-line">
          <time datetime={entry.data.date.toISOString()}>{date}</time>
          {tags.length > 0 && (
            <span>{tags.join(' · ')}</span>
          )}
        </div>
        <p class="lead">{description}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container news-detail-container">
      <article class="panel news-detail-panel">
        {image && (
          <figure class="news-detail-image">
            <img src={image} alt={imageAlt} loading="eager" decoding="async" />
          </figure>
        )}

        {hasEnglishBody ? (
          <div class="content-body news-content" set:html={englishBodyHtml} />
        ) : (
          <p class="translation-note">
            The English text of this news item is being prepared. Please use the <a href={ukrainianNewsUrl}>Ukrainian version</a> for the full text.
          </p>
        )}

        <p class="back-link">
          <a href={withBase('/en/news/')}>← Back to all news</a>
        </p>
      </article>
    </div>
  </section>
</BaseLayoutEn>

<style>
  .news-detail-hero .lead {
    margin-top: 18px;
  }

  .news-detail-container {
    max-width: 900px;
  }

  .news-detail-panel {
    padding: clamp(24px, 4vw, 42px);
  }

  .news-detail-image {
    margin: 0 0 clamp(22px, 3vw, 34px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 6px);
    background: var(--surface-soft);
  }

  .news-detail-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }

  .translation-note {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-soft);
    color: var(--muted);
    font-weight: 650;
  }

  .translation-note a {
    font-weight: 800;
  }

  .news-content {
    color: var(--text);
    font-size: 1.06rem;
    line-height: 1.78;
  }

  .news-content :global(p) {
    margin: 0 0 1.15rem;
  }

  .back-link {
    margin: 28px 0 0;
    font-weight: 750;
  }

  @media (max-width: 640px) {
    .news-detail-image img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
