---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const targetPath = '/en/specialized-councils/';
const targetUrl = `${base}${targetPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to Specialized Academic Councils</title>
    <meta http-equiv="refresh" content={`0; url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
  </head>
  <body>
    <main>
      <p>
        Redirecting to <a href={targetUrl}>Specialized Academic Councils</a>.
      </p>
    </main>
    <script is:inline>
      window.location.replace(document.querySelector('a')?.href || '/en/specialized-councils/');
    </script>
  </body>
</html>
