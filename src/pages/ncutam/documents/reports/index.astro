---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NcutamNav from '../../../../components/NcutamNav.astro';
import { ncutamSite } from '../../../../data/ncutam/site';
import { site } from '../../../../data/site';
---

<BaseLayout title={`Річні звіти | ${ncutamSite.acronym} | ${site.shortName}`} description="Архів річних звітів Національного комітету України з теоретичної і прикладної механіки." activePage="ncutam">
  <NcutamNav language="uk" active="documents" />
  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{ncutamSite.acronym} · Документи</p>
        <h1>Річні звіти</h1>
        <p class="lead">Офіційні річні звіти про діяльність Комітету.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="panel">
        <h2>Перевірені звіти готуються до публікації</h2>
        <p>Фінальні PDF за 2023, 2024 і 2025 роки вже ідентифіковано у джерельному сховищі. Посилання з’являться після перенесення самих файлів до стабільних шляхів <code>/documents/ncutam/reports/…</code>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
