---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';
import { groupRoutesBySection } from '../../data/routes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const sections = groupRoutesBySection('en');
---

<BaseLayoutEn
  title={`Sitemap | ${siteEn.shortName}`}
  description="Sitemap of the English section of the website of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine."
  activePage="home"
>
  <main class="sitemap-page">
    <section class="sitemap-hero">
      <p class="eyebrow">Navigation</p>
      <h1>Sitemap</h1>
      <p class="lead">
        This page brings together the main sections of the English version of the website of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine.
      </p>
    </section>

    <section class="sitemap-grid" aria-label="Sitemap sections">
      {sections.map((section) => (
        <article class="sitemap-card">
          <h2>{section.title}</h2>
          <ul>
            {section.links.map(([label, href]) => (
              <li><a href={withBase(href)}>{label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  </main>
</BaseLayoutEn>

<style>
  .sitemap-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 52px 20px 72px;
  }

  .sitemap-hero,
  .sitemap-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .sitemap-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .sitemap-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 820px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 30px;
  }

  .sitemap-card {
    padding: 26px;
  }

  .sitemap-card h2 {
    margin: 0 0 16px;
    font-size: 1.35rem;
  }

  .sitemap-card ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
  }

  .sitemap-card a {
    font-weight: 750;
  }

  @media (max-width: 860px) {
    .sitemap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
