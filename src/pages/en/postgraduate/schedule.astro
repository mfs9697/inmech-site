---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  return `${base}/${path.replace(/^\/+/, '')}`;
}

const scheduleLinks = [
  { title: 'First-year postgraduate students', year: '2025–2026', href: '/documents/postgraduate/schedule/2025-2026/year-1.pdf' },
  { title: 'Second-year postgraduate students', year: '2025–2026', href: '/documents/postgraduate/schedule/2025-2026/year-2.pdf' },
  { title: 'Third-year postgraduate students', year: '2025–2026', href: '/documents/postgraduate/schedule/2025-2026/year-3.pdf' }
];
---

<BaseLayoutEn
  title={`Postgraduate class schedule | ${siteEn.shortName}`}
  description="Class schedules for postgraduate students of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href={withBase('/en/postgraduate/')}>Postgraduate studies</a><span>›</span><span>Schedule</span></nav>
    <section class="page-hero">
      <p class="eyebrow">Postgraduate class schedule</p>
      <h1>Class schedule for the 2025–2026 academic year</h1>
      <p class="lead">This page contains class schedules for postgraduate students by year of study. The documents open as PDF files from the Institute’s official archive.</p>
      <p><a href={withBase('/postgraduate/schedule/')}>Ukrainian version</a></p>
    </section>
    <section class="section-block">
      <div class="section-heading compact-header"><div><p class="eyebrow">PDF documents</p><h2>Schedules by year of study</h2></div><p>Select the relevant year of study to open the schedule in a new tab.</p></div>
      <div class="schedule-grid">
        {scheduleLinks.map((schedule, index) => (
          <a class="schedule-card" href={withBase(schedule.href)} target="_blank" rel="noopener noreferrer">
            <span>{schedule.year}</span><strong>{index + 1}</strong><h3>{schedule.title}</h3><p>Open the class schedule in PDF format.</p><b>Open PDF →</b>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page{max-width:1180px;margin:0 auto;padding:46px 20px 72px}.breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:22px;color:var(--muted);font-weight:750}.page-hero,.schedule-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}.page-hero{padding:clamp(28px,5vw,52px)}.page-hero h1{margin:0 0 18px;font-size:clamp(2.2rem,4.8vw,4.3rem);line-height:1.04;letter-spacing:-.04em}.lead{max-width:860px;color:var(--muted);font-size:1.08rem;line-height:1.7}.section-block{margin-top:34px}.schedule-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.schedule-card{display:flex;min-height:300px;flex-direction:column;padding:26px;color:var(--text);text-decoration:none;transition:transform .22s ease}.schedule-card:hover{transform:translateY(-4px);text-decoration:none}.schedule-card span{width:fit-content;margin-bottom:20px;padding:6px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent-dark);font-size:.78rem;font-weight:850}.schedule-card strong{display:grid;place-items:center;width:82px;height:82px;margin-bottom:20px;border-radius:28px;background:linear-gradient(145deg,var(--accent-dark),var(--accent));color:#fff;font-size:2.4rem;line-height:1}.schedule-card h3{margin:0 0 10px;font-size:1.25rem}.schedule-card p{color:var(--muted);line-height:1.6}.schedule-card b{margin-top:auto;color:var(--accent-dark)}@media(max-width:920px){.schedule-grid{grid-template-columns:1fr}}
</style>
