---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const prozorroSearchUrl = 'https://prozorro.gov.ua/uk/search/tender?text=%D0%86%D0%BD%D1%81%D1%82%D0%B8%D1%82%D1%83%D1%82%20%D0%BC%D0%B5%D1%85%D0%B0%D0%BD%D1%96%D0%BA%D0%B8%20%D1%96%D0%BC.%20%D0%A1.%D0%9F.%20%D0%A2%D0%B8%D0%BC%D0%BE%D1%88%D0%B5%D0%BD%D0%BA%D0%B0';

const tenderResources = [
  {
    title: 'Закупівлі Інституту в системі Prozorro',
    description: 'Перейти до пошуку закупівель Інституту механіки ім. С. П. Тимошенка НАН України в електронній системі публічних закупівель Prozorro.',
    href: prozorroSearchUrl,
    button: 'Перейти до Prozorro'
  }
];
---

<BaseLayout
  title={`Закупівлі та тендери | ${site.name}`}
  description="Закупівлі та тендери Інституту механіки ім. С.П. Тимошенка НАН України. Посилання на електронну систему публічних закупівель Prozorro."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel tender-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>Закупівлі та тендери</h1>
        <p class="lead">
          Інформація про публічні закупівлі Інституту доступна через електронну систему
          публічних закупівель Prozorro. Посилання нижче відкриває пошук закупівель за назвою установи.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="tender-grid">
        {tenderResources.map((item) => (
          <article class="tender-card">
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            <a class="button primary" href={item.href} target="_blank" rel="noopener">
              {item.button}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel tender-note">
        <p class="eyebrow">Примітка</p>
        <h2>Як користуватися посиланням</h2>
        <p>
          Після переходу до Prozorro можна уточнити пошук за назвою замовника,
          кодом ЄДРПОУ, роком, статусом закупівлі або ключовими словами.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
