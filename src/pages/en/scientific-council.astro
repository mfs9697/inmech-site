    councilRole: 'Deputy Director for Research',
    elected: false
  },
  {
    name: 'Yurii V. Skosarenko',
    title: 'Doctor of Technical Sciences',
    councilRole: 'Scientific Secretary of the Institute',
    elected: false
  },
  {
    name: 'Viacheslav L. Bogdanov',
    title: 'Academician of the NAS of Ukraine, Doctor of Physical and Mathematical Sciences',
    councilRole: '',
