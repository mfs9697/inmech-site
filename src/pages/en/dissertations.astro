---

<BaseLayoutEn
  title={`Dissertation defenses | ${siteEn.shortName}`}
  description="Dissertation defenses at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine: current announcements, recent materials and the historical catalogue of defended dissertations."
  activePage="education"
>
  <section class="defense-hero">
    <div class="container defense-hero-grid">
      <div class="defense-hero-panel">
        <p class="eyebrow">Education and research training</p>
        <h1>Dissertation defenses</h1>
        <p class="lead">
          This page presents defense materials for the current and previous year. Older records are available
          in the separate catalogue of dissertations defended at the Institute of Mechanics.
        </p>
        <div class="defense-hero-actions">
          <a class="button primary" href="#announcements">Current and previous year</a>
          <a class="button secondary" href={withBase('/en/defended-dissertations/')}>Catalogue of defended dissertations</a>
          <a class="button secondary" href={withBase('/dissertations/')}>Ukrainian version</a>
        </div>
      </div>

      <aside class="defense-stat-card">
        <span>{featuredDefenses.length}</span>
        <h2>defenses in 2026–2025</h2>
        <p>Detailed cards with documents, opponents and video materials where available.</p>
      </aside>
    </div>
  </section>

  <section class="section defense-summary-section">
    <div class="container defense-summary-grid">
      <article class="defense-summary-card">
        <span>2026</span>
        <p>current-year materials</p>
      </article>
      <article class="defense-summary-card">
        <span>2025</span>
        <p>previous-year materials</p>
      </article>
      <article class="defense-summary-card">
        <span>Catalogue</span>
        <p>historical catalogue and older archive materials</p>
      </article>
    </div>
  </section>

  <section class="section" id="announcements">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Current and previous year</p>
          <h2>Defense materials</h2>
        </div>
        <p>
          For dissertation defenses of the current and previous year, this section provides key information,
          available files and official opponent reviews where available. The source documents are official materials
          and may be provided in Ukrainian.
        </p>
      </div>

      <div class="featured-defense-list">
        {featuredDefenses.map((defense) => (
          <article class="featured-defense-card">
            <div class="featured-defense-header">
              <div>
                <span class="defense-status">{defense.status}</span>
                <h3>{defense.name}</h3>
                <p class="original-name">{defense.nameUk}</p>
              </div>
              <span class="defense-year">{defense.year}</span>
            </div>

            <p class="defense-title">{defense.title}</p>

            <dl class="defense-meta-grid">
              <div>
                <dt>Defense date</dt>
                <dd>{defense.date}</dd>
              </div>
              <div>
                <dt>Venue</dt>
                <dd>{defense.place}</dd>
              </div>
              <div>
                <dt>Academic degree</dt>
                <dd>{defense.degree}</dd>
              </div>
              <div>
                <dt>Specialty</dt>
                <dd>{defense.specialty}</dd>
              </div>
            </dl>

            {defense.consultant && (
              <p class="consultant-line"><strong>Scientific consultant:</strong> {defense.consultant}</p>
            )}

            {defense.links.length > 0 && (
              <div class="defense-links">
                {defense.links.map(([label, href]) => (
                  <a href={withBase(href)} target="_blank" rel="noopener noreferrer">{label}</a>
                ))}
              </div>
            )}

            <details class="opponents-details">
              <summary>Official opponents</summary>
              {defense.opponents.length > 0 ? (
                <div class="opponents-grid">
                  {defense.opponents.map(([name, degree, href]) => (
                    <a class="opponent-card" href={withBase(href)} target="_blank" rel="noopener noreferrer">
                      <strong>{name}</strong>
                      <span>{degree}</span>
                      <em>View review →</em>
                    </a>
                  ))}
                </div>
              ) : (
                <p class="opponents-empty">Official opponent reviews will be added after they are received.</p>
              )}
            </details>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section catalog-cta-section">
    <div class="container">
      <div class="catalog-cta-panel">
        <div>
          <p class="eyebrow">Full archive</p>
          <h2>Catalogue of dissertations defended at the Institute of Mechanics</h2>
          <p>
            Older defense materials and the bibliographic catalogue of dissertations are available on a separate page.
            It contains historical records, an alphabetical catalogue and archive materials from previous years.
          </p>
        </div>
        <a class="button primary" href={withBase('/en/defended-dissertations/')}>Open catalogue</a>
      </div>
    </div>
  </section>
</BaseLayoutEn>

<style>
  .defense-hero {
    padding: 52px 0 18px;
  }

  .defense-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }

  .defense-hero-panel,
  .defense-stat-card,
  .defense-summary-card,
  .featured-defense-card,
  .catalog-cta-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .defense-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .defense-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.17), rgba(29, 79, 145, 0));
  }

  .defense-hero-panel h1,
  .defense-hero-panel .lead,
  .defense-hero-panel .eyebrow,
  .defense-hero-actions {
    position: relative;
    z-index: 1;
  }

  .defense-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .defense-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .defense-stat-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .defense-stat-card span {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 2.2rem;
    font-weight: 950;
  }

  .defense-stat-card h2 {
    margin: 0 0 12px;
    font-size: 1.65rem;
  }

  .defense-stat-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .defense-summary-section {
    padding-top: 16px;
  }

  .defense-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .defense-summary-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: clamp(20px, 3vw, 30px);
  }

  .defense-summary-card span {
    display: grid;
    place-items: center;
    min-width: 92px;
    height: 72px;
    border-radius: 22px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-weight: 950;
    font-size: 1.1rem;
  }

  .defense-summary-card p {
    margin: 0;
    color: var(--muted);
    font-weight: 750;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 540px;
    margin: 0;
    color: var(--muted);
  }

  .featured-defense-list {
    display: grid;
    gap: 18px;
  }

  .featured-defense-card {
    padding: clamp(22px, 3.5vw, 36px);
  }

  .featured-defense-header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .defense-status,
  .defense-year {
    display: inline-flex;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .defense-year {
    min-width: 68px;
    justify-content: center;
    background: rgba(184, 135, 47, 0.16);
    color: var(--gold);
  }

  .featured-defense-card h3 {
    margin: 12px 0 4px;
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.15;
  }

  .original-name {
    margin: 0;
    color: var(--muted);
    font-weight: 650;
  }

  .defense-title {
    margin: 0 0 18px;
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 800;
  }

  .defense-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0 0 18px;
  }

  .defense-meta-grid div {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
  }

  .defense-meta-grid dt {
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .defense-meta-grid dd {
    margin: 0;
    color: var(--text);
    font-weight: 750;
  }

  .consultant-line {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .defense-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .defense-links a {
    display: inline-flex;
    padding: 7px 11px;
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--accent-dark);
    font-weight: 850;
  }

  .defense-links a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  .opponents-details {
    margin-top: 18px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(238, 244, 251, 0.62);
  }

  .opponents-details summary {
    cursor: pointer;
    color: var(--accent-dark);
    font-weight: 900;
  }

  .opponents-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 14px;
  }

  .opponents-empty {
    margin: 12px 0 0;
    color: var(--muted);
    font-weight: 750;
  }

  .opponent-card {
    display: grid;
    gap: 6px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    color: var(--text);
  }

  .opponent-card:hover {
    text-decoration: none;
    background: var(--accent-soft);
  }

  .opponent-card span {
    color: var(--muted);
  }

  .opponent-card em {
    color: var(--accent-dark);
    font-style: normal;
    font-weight: 850;
  }

  .catalog-cta-section {
    padding-top: 18px;
  }

  .catalog-cta-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: clamp(24px, 4vw, 42px);
    background: linear-gradient(135deg, rgba(184, 135, 47, 0.12), rgba(29, 79, 145, 0.08));
    border-color: rgba(184, 135, 47, 0.35);
  }

  .catalog-cta-panel h2 {
    margin: 0 0 12px;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .catalog-cta-panel p:last-child {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .defense-hero-grid,
    .defense-summary-grid,
    .defense-meta-grid,
    .opponents-grid,
    .catalog-cta-panel {
      grid-template-columns: 1fr;
    }

    .section-heading,
    .featured-defense-header {
      display: block;
    }

    .section-heading p:last-child,
    .defense-year {
      margin-top: 10px;
    }
  }
</style>
