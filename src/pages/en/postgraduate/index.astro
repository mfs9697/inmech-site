---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  const cleanPath = path.replace(/^\/inmech-site(?=\/)/, '');
  return `${base}${cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`}`;
}

const cards = [
  {
    title: 'Admission to postgraduate studies',
    label: 'Admission 2026',
    text: 'Admission timeline, entrance requirements, official documents, required application materials and potential research supervisors.',
    href: '/en/postgraduate/admission/'
  },
  {
    title: 'Educational and scientific programme',
    label: 'PhD programme',
    text: 'Educational programmes, curricula, courses, syllabi, stakeholder reviews and survey results.',
    href: '/en/postgraduate/program/'
  },
  {
    title: 'Accreditation',
    label: 'Programme quality',
    text: 'Accreditation materials, self-assessment documents and information on the expert-group visit.',
    href: '/en/postgraduate/accreditation/'
  },
  {
    title: 'Postgraduate class schedule',
    label: '2025–2026',
    text: 'Class schedules for first-, second- and third-year postgraduate students in PDF format.',
    href: '/en/postgraduate/schedule/'
  },
  {
    title: 'Postgraduate students',
    label: 'PhD candidates',
    text: 'Postgraduate student groups by year of admission, dissertation topics, supervisors, publications and available materials.',
    href: '/en/postgraduate/students/'
  },
  {
    title: 'Teachers and research supervisors',
    label: 'Academic staff',
    text: 'Teachers of compulsory and elective programme components and potential supervisors of postgraduate students.',
    href: '/en/postgraduate/supervisors/'
  },
  {
    title: 'Alignment of research topics',
    label: 'Research themes',
    text: 'Alignment between postgraduate dissertation topics and the research areas of their supervisors.',
    href: '/en/postgraduate/research-topics/'
  }
];
---

<BaseLayoutEn
  title={`Postgraduate studies | ${siteEn.shortName}`}
  description="Postgraduate studies at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine: admission, PhD programme, schedules, accreditation, students, supervisors and research topics."
  activePage="education"
>
  <main class="postgraduate-page">
    <section class="postgraduate-hero">
      <div>
        <p class="eyebrow">Education and research training</p>
        <h1>Postgraduate studies</h1>
        <p class="lead">
          The postgraduate school of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine
          trains PhD students in <strong>F1 Applied Mathematics</strong> / <strong>113 Applied Mathematics</strong>
          according to the current educational and scientific programme.
        </p>
        <p>
          This section provides information for applicants, postgraduate students, research supervisors and all
          interested users on admission, training, the PhD programme, accreditation, class schedules and research topics.
        </p>
        <div class="hero-actions">
          <a class="button-link" href={withBase('/postgraduate/')}>Ukrainian version</a>
        </div>
      </div>
      <aside class="hero-badge">
        <span>PhD</span>
        <strong>F1</strong>
        <p>Applied Mathematics</p>
      </aside>
    </section>

    <section class="notice-panel">
      <div>
        <strong>Current admission:</strong> the 2026 admission campaign is conducted for
        <strong>F1 Applied Mathematics</strong>.
      </div>
      <a href={withBase('/en/postgraduate/admission/')}>Admission requirements →</a>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Navigation</p>
          <h2>Main pages</h2>
        </div>
      </div>

      <div class="card-grid">
        {cards.map((card) => (
          <a class="nav-card" href={withBase(card.href)}>
            <span>{card.label}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
            <strong>Open page →</strong>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page { max-width: 1180px; margin: 0 auto; padding: 52px 20px 72px; }
  .postgraduate-hero { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 24px; align-items: stretch; padding: clamp(28px, 5vw, 54px); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .postgraduate-hero h1 { margin: 0 0 18px; font-size: clamp(2.3rem, 5vw, 4.5rem); line-height: 1.02; letter-spacing: -0.04em; }
  .lead { max-width: 880px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .hero-actions { margin-top: 22px; }
  .hero-badge { display: grid; place-items: center; gap: 8px; padding: 26px; border-radius: 28px; background: linear-gradient(145deg, var(--accent-dark), var(--accent)); color: #fff; text-align: center; }
  .hero-badge span { font-weight: 850; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.82; }
  .hero-badge strong { font-size: 4rem; line-height: 1; }
  .hero-badge p { margin: 0; color: rgba(255, 255, 255, 0.86); font-weight: 750; }
  .notice-panel { display: flex; justify-content: space-between; gap: 18px; align-items: center; margin: 22px 0; padding: 18px 20px; border: 1px solid rgba(29, 79, 145, 0.18); border-radius: 20px; background: var(--accent-soft); }
  .notice-panel a { white-space: nowrap; font-weight: 850; }
  .section-block { margin-top: 34px; }
  .card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .nav-card { display: flex; min-height: 220px; flex-direction: column; padding: 26px; border: 1px solid var(--line); border-radius: 24px; background: var(--surface); color: var(--text); text-decoration: none; box-shadow: var(--shadow); transition: transform 0.22s ease; }
  .nav-card:hover { transform: translateY(-4px); text-decoration: none; }
  .nav-card span { width: fit-content; margin-bottom: 14px; padding: 6px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-dark); font-size: 0.78rem; font-weight: 850; }
  .nav-card h3 { margin: 0 0 10px; font-size: 1.35rem; }
  .nav-card p { color: var(--muted); }
  .nav-card strong { margin-top: auto; color: var(--accent-dark); }
  @media (max-width: 860px) { .postgraduate-hero, .card-grid { grid-template-columns: 1fr; } .notice-panel { align-items: flex-start; flex-direction: column; } }
</style>
