---
import { getCollection } from 'astro:content';
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const departments = (await getCollection('departments'))
  .sort((a, b) => a.data.order - b.data.order);

const groupedDepartments = [...departments.reduce((acc, entry) => {
  const group = entry.data.group;
  if (!acc.has(group)) acc.set(group, []);
  acc.get(group)?.push(entry);
  return acc;
}, new Map<string, typeof departments>())].map(([group, entries], index) => {
  const departmentCount = entries.filter((entry) => entry.id !== 'lms-scadas-mobile-center').length;

  return {
    group,
    entries,
    departmentCount,
    id: `home-department-group-${index + 1}`
  };
});

const groupNamesEn: Record<string, string> = {
  'Механіка композитних та неоднорідних середовищ': 'Mechanics of composite and heterogeneous media',
  'Механіка оболонкових систем': 'Mechanics of shell systems',
  "Механіка зв'язних полів у матеріалах та елементах конструкцій": 'Mechanics of coupled fields in materials and structural elements',
  'Механіка руйнування та втома': 'Fracture mechanics and fatigue',
  'Динаміка та стійкість руху механічних систем': 'Dynamics and stability of mechanical systems'
};

const departmentTextEn: Record<string, { title: string; summary: string }> = {
  '01-dynamics-stability': {
    title: 'Department of Dynamics and Stability of Continua',
    summary: 'Three-dimensional stability theory, wave propagation and diffraction, non-classical problems of fracture mechanics, composite materials and thin-walled structural elements.'
  },
  '02-rheology': {
    title: 'Department of Rheology',
    summary: 'Modern problems of rheology, macro-, micro- and nanomechanics of composite materials, mechanics of auxetic materials, and linear and nonlinear waves in materials.'
  },
  'lms-scadas-mobile-center': {
    title: 'Shared-Use Centre “Dynamic Process Analyser”',
    summary: 'A shared-use centre based on LMS SCADAS Mobile equipment for measurement, recording and analysis of vibration, acoustic and strain-gauge signals.'
  },
  '03-computational-mechanics-engineering': {
    title: 'Department of Computational Mechanics and Engineering',
    summary: 'Numerical studies of edge effects, three-dimensional stability of composites, fracture of reinforced materials, interfacial cracks and software for computational mechanics.'
  },
  '04-computational-methods': {
    title: 'Department of Computational Methods',
    summary: 'Computational methods for shell systems, statics, dynamics, stability and vibrations of layered, anisotropic and heterogeneous shells.'
  },
  '05-thin-walled-structures': {
    title: 'Department of Structural Mechanics of Thin-Walled Structures',
    summary: 'Stress-strain analysis, strength, stability and dynamics of thin-walled elements and structures of complex geometry, including shells and plates.'
  },
  '06-thermoplasticity': {
    title: 'Department of Thermoplasticity',
    summary: 'Thermoviscoelastoplastic deformation and fracture of structural elements under complex non-isothermal loading, heat conduction, material damage and numerical methods.'
  },
  '07-thermoelasticity': {
    title: 'Department of Thermoelasticity',
    summary: 'Thermomechanics of inelastic materials and bodies, coupled thermoelectromechanical problems, dissipative heating and dynamic thermomechanical processes.'
  },
  '08-creep': {
    title: 'Department of Mechanics of Creep',
    summary: 'Nonlinear three-dimensional viscoelasticity, long-term creep fracture, damage accumulation, fatigue life prediction and experimental validation of creep and fatigue models.'
  },
  '09-fracture-mechanics': {
    title: 'Department of Fracture Mechanics of Materials',
    summary: 'Long-term fracture, slow subcritical crack growth, crack resistance and fracture mechanics of elastic-plastic, viscoelastic and composite materials.'
  },
  '10-stability-processes': {
    title: 'Department of Stability of Processes',
    summary: 'Lyapunov matrix-valued functions for uncertain dynamic systems, stability of systems with fuzzy parameters, fractional-type derivatives and time-scale systems.'
  },
  '11-vibrations': {
    title: 'Department of Theory of Vibrations',
    summary: 'Diffraction problems of acoustics and elasticity, hydroelectroelasticity, interaction of structural elements with fluids and elastic media, and optimal motion control.'
  }
};

function departmentNumber(entry: typeof departments[number]) {
  return entry.id === 'lms-scadas-mobile-center' ? '01C' : String(entry.data.number).padStart(2, '0');
}
---

<BaseLayoutEn
  title={`${siteEn.name}`}
  description="The English homepage of the S.P. Timoshenko Institute of Mechanics of the National Academy of Sciences of Ukraine."
  activePage="home"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card hero-card-visual">
        <div class="hero-text">
          <p class="eyebrow">National Academy of Sciences of Ukraine</p>
          <h1>S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine</h1>
          <p class="lead">
            A leading research institution of the National Academy of Sciences of Ukraine carrying out
            fundamental and applied studies in solid mechanics, dynamics, stability, thermoelasticity,
            creep, fracture mechanics and mechanics of composite materials.
          </p>
        </div>

        <figure class="hero-image-card">
          <img src={withBase('/assets/img/logo-jacket.png?v=20260615-2')} alt="Badge of the S.P. Timoshenko Institute of Mechanics" loading="eager" />
          <div class="hero-actions hero-image-actions">
            <a class="button primary" href={withBase('/en/departments/')}>Research departments</a>
            <a class="button secondary" href={withBase('/en/news/')}>Latest news</a>
          </div>
        </figure>
      </div>

      <aside class="aside-card" aria-labelledby="institute-sites-title">
        <h2 id="institute-sites-title">Institute websites</h2>
        <p>
          Separate information resources of the Institute for specialised projects, events and institutional announcements.
        </p>
        <ul class="aside-list">
          <li>
            <a href="https://natcommmech.inmech.kyiv.ua/" target="_blank" rel="noopener">
              National Committee of Ukraine for Theoretical and Applied Mechanics
            </a>
          </li>
          <li>
            <a href="https://election.inmech.kyiv.ua/" target="_blank" rel="noopener">
              Election of the Director of the Institute, 2026
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">About the Institute</p>
          <h2 class="section-title">Scientific schools, research and engineering applications</h2>
          <p class="section-text">
            The Institute conducts research in key areas of theoretical and applied mechanics,
            combining the development of mathematical models, experimental studies, numerical
            simulation and the implementation of scientific results in practice.
          </p>
        </div>
      </div>

      <div class="cards-grid">
        <article class="card">
          <h3>Research</h3>
          <p>
            Fundamental and applied problems of continuum mechanics, material science, strength,
            durability and structural reliability.
          </p>
          <a class="card-link" href={withBase('/en/departments/')}>View research areas →</a>
        </article>

        <article class="card">
          <h3>Education and research training</h3>
          <p>
            Postgraduate and doctoral studies, specialised academic councils, scientific seminars and
            the involvement of young scientists in research projects.
          </p>
          <a class="card-link" href={withBase('/en/education/')}>Postgraduate and doctoral studies →</a>
        </article>

        <article class="card">
          <h3>Publications and cooperation</h3>
          <p>
            Scientific journals, international cooperation, conferences, library resources and the dissemination
            of research results in the international scientific community.
          </p>
          <div class="card-links-stack">
            <a class="card-link" href="https://applied-mechanics.inmech.kyiv.ua/" target="_blank" rel="noopener">Applied Mechanics journal →</a>
            <a class="card-link" href={withBase('/en/library/')}>Library →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Scientific activity</p>
          <h2 class="section-title">Research areas and departments</h2>
          <p class="section-text">
            The main areas of the Institute’s work are presented through groups of research departments.
            This structure mirrors the Ukrainian version and keeps both language versions easy to maintain.
          </p>
        </div>
        <a class="button secondary" href={withBase('/en/departments/')}>All departments</a>
      </div>

      <div class="home-department-groups">
        {groupedDepartments.map(({ group, entries, departmentCount, id }) => (
          <section class="home-department-group" aria-labelledby={id}>
            <div class="home-department-group-header">
              <h3 id={id}>{groupNamesEn[group] ?? group}</h3>
              <span>{departmentCount} {departmentCount === 1 ? 'department' : 'departments'}</span>
            </div>
            <div class="department-grid">
              {entries.map((entry) => {
                const department = departmentTextEn[entry.id] ?? {
                  title: entry.data.title,
                  summary: entry.data.summary
                };

                return (
                  <article class="department-card">
                    <div class="department-number" aria-hidden="true">{departmentNumber(entry)}</div>
                    <div>
                      <h3>
                        <a href={withBase('/en/departments/')}>{department.title}</a>
                      </h3>
                      <p>{department.summary}</p>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Latest announcements</p>
          <h2 class="section-title">News and announcements</h2>
          <p class="section-text">
            The English news archive is being prepared. Current institutional announcements are available
            in the Ukrainian version of the website.
          </p>
        </div>
        <a class="button secondary" href={withBase('/news/')}>Ukrainian news archive</a>
      </div>
    </div>
  </section>
</BaseLayoutEn>
