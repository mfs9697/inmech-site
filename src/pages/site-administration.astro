---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const technologies = [
  {
    title: 'Astro',
    text: 'Сайт створено як статичний вебпроєкт на основі Astro. Такий підхід забезпечує швидке завантаження сторінок, зручну структуру файлів і просте розгортання на сервері без окремої серверної частини.'
  },
  {
    title: 'HTML, CSS і TypeScript',
    text: 'Сторінки побудовано з використанням компонентної структури Astro, стандартної розмітки HTML, каскадних таблиць стилів CSS і допоміжних TypeScript-конструкцій.'
  },
  {
    title: 'Статична архітектура',
    text: 'Сайт не потребує бази даних або окремого серверного застосунку. Текстові матеріали, зображення, документи та сторінки зберігаються у структурі проєкту.'
  },
  {
    title: 'Розміщення на сервері Інституту',
    text: 'Публічна версія сайту передбачена для розміщення на сервері Інституту механіки ім. С. П. Тимошенка НАН України з подальшим оновленням підготовлених статичних файлів.'
  }
];

const developers = [
  {
    name: 'Михайло Селіванов',
    role: 'структура сайту, наукове та інформаційне наповнення, редагування матеріалів, координація оновлення розділів'
  },
  {
    name: 'Михайло Довжик',
    role: 'технічна підтримка, веброзробка, робота з локальним середовищем, підготовка матеріалів до розміщення на сервері Інституту'
  }
];
---

<BaseLayout
  title={`Адміністрація сайту | ${site.shortName}`}
  description="Адміністрація сайту Інституту механіки ім. С. П. Тимошенка НАН України: використані вебтехнології, структура підтримки та виконавці робіт."
  activePage="home"
>
  <div class="site-admin-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/')}>Головна</a>
      <span>›</span>
      <span>Адміністрація сайту</span>
    </nav>

    <section class="admin-hero">
      <p class="eyebrow">Службова інформація</p>
      <h1>Адміністрація сайту</h1>
      <p class="lead">
        Офіційний вебсайт Інституту механіки ім. С. П. Тимошенка НАН України створено як
        сучасний статичний ресурс для представлення структури Інституту, наукової діяльності,
        освітньо-наукових програм, новин, документів і довідкових матеріалів.
      </p>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Технології</p>
          <h2>Використана технологія</h2>
        </div>
      </div>

      <div class="technology-grid">
        {technologies.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block two-column">
      <article class="info-panel">
        <p class="eyebrow">Підтримка сайту</p>
        <h2>Принцип організації</h2>
        <p>
          Підготовку та оновлення матеріалів організовано через локальне середовище розробки,
          перевірку сторінок у режимі попереднього перегляду та подальше розміщення сформованої
          статичної версії на сервері Інституту.
        </p>
        <p>
          Така схема зручна для поступового перенесення матеріалів зі старої версії сайту,
          створення окремих сторінок для великих розділів і підтримання впорядкованої структури
          інформаційного наповнення.
        </p>
      </article>

      <article class="info-panel">
        <p class="eyebrow">Виконавці</p>
        <h2>Виконавці робіт</h2>
        <div class="developer-list">
          {developers.map((developer) => (
            <div class="developer-card">
              <strong>{developer.name}</strong>
              <p>{developer.role}</p>
            </div>
          ))}
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .site-admin-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 20px 72px;
  }

  .breadcrumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 22px;
    color: var(--muted);
    font-weight: 750;
  }

  .admin-hero,
  .info-card,
  .info-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .admin-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .admin-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 900px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .section-block {
    margin-top: 34px;
  }

  .technology-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card,
  .info-panel {
    padding: 24px;
  }

  .info-card h3,
  .info-panel h2 {
    margin-top: 0;
  }

  .info-card p,
  .info-panel p {
    color: var(--muted);
    line-height: 1.65;
  }

  .two-column {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 18px;
  }

  .developer-list {
    display: grid;
    gap: 14px;
  }

  .developer-card {
    padding: 16px;
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .developer-card strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 1.05rem;
  }

  .developer-card p {
    margin: 0;
  }

  @media (max-width: 1080px) {
    .technology-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .technology-grid,
    .two-column {
      grid-template-columns: 1fr;
    }
  }
</style>
