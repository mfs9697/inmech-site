---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCalendar from '../../components/InstituteEventCalendar.astro';
import { site } from '../../data/site';
---
<BaseLayout title={`Календар подій | ${site.shortName}`} description="Календар наукових заходів, семінарів, конференцій і подій Інституту механіки ім. С.П. Тимошенка НАН України.">
  <section class="page-hero">
    <div class="container">
      <div class="panel event-hero-panel">
        <p class="eyebrow">Наукове життя Інституту</p>
        <h1>Календар подій</h1>
        <p class="lead">Наукові семінари, конференції, засідання та інші події Інституту — в одному місці. Обирайте місяць або дату та переглядайте анонси у зручному форматі.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container"><EventCalendar lang="uk" /></div>
  </section>
</BaseLayout>
<style>
  .event-hero-panel { padding: clamp(25px, 4vw, 43px); }
  .event-hero-panel h1 { margin: 0 0 12px; font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: -.035em; }
  .event-hero-panel .lead { max-width: 840px; }
</style>
