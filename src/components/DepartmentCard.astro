---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'departments'>;
}

const { entry } = Astro.props;
const isSharedUseCenter = entry.id === 'lms-scadas-mobile-center';
const number = isSharedUseCenter ? '01Ц' : String(entry.data.number).padStart(2, '0');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const departmentUrl = `${base}/departments/${entry.id}/`;
---

<article class="department-card">
  <div class="department-number" aria-hidden="true">{number}</div>
  <div>
    <h3>
      <a href={departmentUrl}>{entry.data.title}</a>
    </h3>
    <p>{entry.data.summary}</p>
    {entry.data.head && <p class="department-head">Керівник: {entry.data.head}</p>}
  </div>
</article>
