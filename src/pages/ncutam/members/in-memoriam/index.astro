---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NcutamNav from '../../../../components/NcutamNav.astro';
import { ncutamSite } from '../../../../data/ncutam/site';
import { site } from '../../../../data/site';
---

<BaseLayout title={`Пам’ять | ${ncutamSite.acronym} | ${site.shortName}`} description="Архів пам’яті членів Національного комітету України з теоретичної і прикладної механіки." activePage="ncutam">
  <NcutamNav language="uk" active="members" />
  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{ncutamSite.acronym} · Члени</p>
        <h1>Пам’ять</h1>
        <p class="lead">Архів пам’яті членів Комітету, які пішли з життя.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="panel">
        <h2>Архів готується до перенесення</h2>
        <p>Історичний список legacy-сайту буде перенесено після звірки персональних записів і статусів у спільному наборі даних членів Комітету.</p>
      </div>
    </div>
  </section>
</BaseLayout>
