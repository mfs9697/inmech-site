---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostgraduateSchedule from '../../components/PostgraduateSchedule.astro';
import { site } from '../../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`Розклад занять аспірантів 2026–2027 | ${site.shortName}`}
  description="Розклад занять аспірантів 1-го, 2-го та 3-го курсів на 2026–2027 навчальний рік: дати, години, дисципліни та викладачі."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Навігація">
      <a href={base + '/postgraduate/'}>Аспірантура</a><span>›</span><span>Розклад занять</span>
    </nav>
    <header class="page-hero">
      <p class="eyebrow">Навчання в аспірантурі</p>
      <h1>Розклад занять 2026–2027</h1>
      <p class="lead">Оберіть курс і місяць, щоб переглянути дати та час занять. На картках зазначено повні імена викладачів із посиланнями на їхні профілі.</p>
    </header>
    <PostgraduateSchedule lang="uk" />
  </main>
</BaseLayout>

<style>
  .postgraduate-page { max-width: 1180px; margin: 0 auto; padding: 46px 20px 72px; }
  .breadcrumbs { display: flex; gap: 10px; align-items: center; margin-bottom: 22px; color: var(--muted); font-weight: 750; }
  .page-hero { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); padding: clamp(26px, 5vw, 48px); }
  .page-hero h1 { margin: 0 0 15px; font-size: clamp(2rem, 4.5vw, 3.8rem); line-height: 1.09; letter-spacing: -.035em; }
  .lead { max-width: 860px; color: var(--muted); font-size: 1.06rem; line-height: 1.65; margin-bottom: 0; }
  @media (max-width: 540px) { .postgraduate-page { padding: 24px 14px 55px; } }
</style>
