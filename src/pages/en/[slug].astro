const { page } = Astro.props as { page: PageData };
---

<BaseLayoutEn
  title={`${page.title} | ${siteEn.shortName}`}
  description={page.description}
  activePage={page.activePage}
>
  <section class="section page-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">{page.eyebrow}</p>
          <h1 class="section-title">{page.heading}</h1>
          <p class="section-text">{page.lead}</p>
        </div>
      </div>

      {page.sections?.map((section) => (
        <article class="card prose-card">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </article>
      ))}

      {page.cards && (
        <div class="cards-grid">
          {page.cards.map((card) => (
            <article class="card">
              <h2>{card.title}</h2>
              <p>{card.text}</p>
              {card.href && <a class="card-link" href={withBase(card.href)}>Open section →</a>}
            </article>
          ))}
        </div>
      )}

      {page.links && (
        <div class="card prose-card">
          <h2>Links</h2>
          <ul>
            {page.links.map((link) => (
              <li>
                <a href={withBase(link.href)} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayoutEn>
