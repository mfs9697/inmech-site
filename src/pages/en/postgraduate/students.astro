function initials(name: string) {
  return name.split(/\s+/).slice(0, 2).map((part) => part[0]).join('');
}
---

<BaseLayoutEn
  title={`Postgraduate students | ${siteEn.shortName}`}
  description="Postgraduate students of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine: years of admission, dissertation topics, research supervisors and publication lists."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href={withBase('/en/postgraduate/')}>Postgraduate studies</a><span>›</span><span>Students</span></nav>
    <section class="page-hero"><p class="eyebrow">Postgraduate students</p><h1>PhD candidates by year of admission</h1><p class="lead">This page presents postgraduate students, dissertation topics, research supervisors and expandable publication lists.</p></section>
    {studentGroups.map((group) => (
      <section class="section-block"><div class="section-heading compact-header"><div><p class="eyebrow">{group.badge}</p><h2>{group.year}</h2></div></div><div class="student-grid">{group.students.map((student) => (<article class="student-card"><div class="student-photo-frame">{student.photo && (<img src={withBase(student.photo)} alt={`Photo: ${student.name}`} loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />)}<div class="avatar avatar-fallback" aria-hidden="true">{initials(student.name)}</div></div><div><h3>{student.name}</h3><p class="label">Dissertation topic</p><p>{student.topic}</p><p class="label">Research supervisor</p><p>{student.supervisor}</p><details class="publication-details"><summary>Publications ({student.publications.length})</summary>{student.publications.length > 0 ? (<ol class="publication-list">{student.publications.map(([label, href]) => (<li>{href ? <a href={href} target="_blank" rel="noopener noreferrer">{label}</a> : <span>{label}</span>}</li>))}</ol>) : (<p class="no-materials">Publications may be added after the list is clarified.</p>)}</details><div class="meta-row"><span>{student.materials} material{student.materials === 1 ? '' : 's'}</span></div></div></article>))}</div></section>
    ))}
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page{max-width:1180px;margin:0 auto;padding:46px 20px 72px}.breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:22px;color:var(--muted);font-weight:750}.page-hero,.student-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}.page-hero{padding:clamp(28px,5vw,52px)}.page-hero h1{margin:0 0 18px;font-size:clamp(2.2rem,4.8vw,4.3rem);line-height:1.04;letter-spacing:-.04em}.lead{max-width:920px;color:var(--muted);font-size:1.08rem;line-height:1.7}.section-block{margin-top:34px}.student-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.student-card{display:grid;grid-template-columns:100px 1fr;gap:18px;padding:22px}.student-photo-frame,.student-photo-frame img,.avatar{width:100px;height:120px;border-radius:22px}.student-photo-frame{border:1px solid var(--line);overflow:hidden;background:var(--surface-soft)}.student-photo-frame img{display:block;object-fit:cover}.avatar{display:grid;place-items:center;color:var(--accent-dark);font-weight:850}.avatar-fallback{display:none}.student-card p{color:var(--muted);line-height:1.55}.label{margin:12px 0 4px!important;color:var(--text)!important;font-weight:850}.publication-details{margin-top:14px}.publication-details summary{width:fit-content;margin-bottom:10px;padding:6px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent-dark);cursor:pointer;font-size:.8rem;font-weight:850}.publication-list{margin:0;padding-left:22px;color:var(--muted)}.publication-list li{margin-bottom:9px;line-height:1.55}.publication-list span{color:var(--muted)}.meta-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.meta-row span{padding:6px 10px;border-radius:999px;background:var(--surface-soft);color:var(--muted);font-size:.8rem;font-weight:800}.no-materials{margin:0;color:var(--muted)}@media(max-width:860px){.student-grid{grid-template-columns:1fr}.student-card{grid-template-columns:1fr}}
</style>
