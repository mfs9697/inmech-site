---
import { getCollection } from 'astro:content';
import BaseLayoutEn from '../../../../layouts/BaseLayoutEn.astro';
import NcutamNav from '../../../../components/NcutamNav.astro';
import NcutamActivityAssets from '../../../../components/ncutam/NcutamActivityAssets.astro';
import { ncutamSite } from '../../../../data/ncutam/site';
import { siteEn } from '../../../../data/site-en';
import { getEnglishBody, renderBilingualMarkdown } from '../../../../utils/bilingualBody';

export async function getStaticPaths() {
  const activities = await getCollection('ncutamActivities');
  return activities.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const body = getEnglishBody(entry.body ?? '');
const html = renderBilingualMarkdown(body, base);
const date = entry.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const endDate = entry.data.endDate?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const typeLabels = {
  meeting: 'General Meeting',
  conference: 'Conference',
  initiative: 'Initiative',
  international: 'International activity'
} as const;
---

<BaseLayoutEn title={`${entry.data.titleEn} | ${ncutamSite.acronymEn} | ${siteEn.shortName}`} description={entry.data.summaryEn} activePage="ncutam">
  <NcutamNav language="en" active="activity" />

  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{typeLabels[entry.data.type]}</p>
        <h1>{entry.data.titleEn}</h1>
        <p class="lead">{entry.data.summaryEn}</p>
        <p class="activity-detail-meta">
          <time datetime={entry.data.date.toISOString()}>{date}</time>
          {endDate && <> — {endDate}</>}
          {entry.data.locationEn && <> · {entry.data.locationEn}</>}
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel content-body activity-detail-body" set:html={html} />
      <NcutamActivityAssets language="en" gallery={entry.data.gallery} documents={entry.data.documents} video={entry.data.video} />
    </div>
  </section>
</BaseLayoutEn>

<style>
  .activity-detail-meta { margin: 14px 0 0; color: var(--muted); }
  .activity-detail-body { max-width: 980px; }
</style>
