---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import {
  scientificBooks,
  scientificBookCategories,
  scientificBookLibraryOfCongressCount,
  scientificBookPlannedCategories,
  scientificBookYears
} from '../../data/scientificBooks';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const hasBooks = scientificBooks.length > 0;
---

<BaseLayout
  title={`Наукові монографії та довідкові видання | ${site.shortName}`}
  description="Великий каталог окремих наукових монографій, довідників і словників з бібліотеки Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="home"
>
  <section class="books-hero">
    <div class="container books-hero-panel">
      <div>
        <p class="eyebrow">Бібліотека</p>
        <h1>Великий каталог окремих монографій</h1>
        <p class="lead">
          Розділ призначено для великого бібліографічного каталогу окремих наукових монографій,
          довідників, словників та інших фундаментальних видань, пов’язаних із науковими школами
          Інституту механіки.
        </p>
      </div>
      <div class="books-stats" aria-label="Статистика каталогу окремих монографій">
        <strong>{scientificBooks.length}</strong>
        <span>записів</span>
        <small>{hasBooks ? `${scientificBookYears.at(-1)}–${scientificBookYears[0]}` : 'підготовка'}</small>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Структура</p>
          <h2>{hasBooks ? 'Каталог видань' : 'Підготовка каталогу'}</h2>
        </div>
        <p>
          На першому етапі закладено структуру розділу та тематичні групи. Далі записи зі старої
          бібліотечної сторінки можна переносити порціями до файлу даних без зміни дизайну сторінки.
        </p>
      </div>

      <div class="books-toolbar">
        <a href={withBase('/library/')}>← До бібліотеки</a>
        <span>
          {hasBooks
            ? `${scientificBookCategories.length} тематичних напрямів · ${scientificBookLibraryOfCongressCount} у Бібліотеці Конгресу США`
            : 'Каталог готовий до наповнення'}
        </span>
      </div>

      {hasBooks ? (
        <div class="year-groups">
          {scientificBookYears.map((year) => {
            const items = scientificBooks.filter((item) => item.year === year);
            return (
              <section class="year-group" id={`year-${year}`}>
                <div class="year-header">
                  <h3>{year}</h3>
                  <span>{items.length} {items.length === 1 ? 'видання' : 'видань'}</span>
                </div>

                <div class="book-grid">
                  {items.map((item) => (
                    <article class="book-card">
                      <div class="book-card-topline">
                        <span>{item.category}</span>
                        {item.year && <strong>{item.year}</strong>}
                      </div>
                      <h4>{item.title}</h4>
                      <p class="authors">{item.authors}</p>
                      <p class="details">
                        {item.publisher}{item.pages ? `, ${item.pages}` : ''}{item.isbn ? `; ISBN ${item.isbn}` : ''}.
                      </p>
                      {item.note && <p class="note">{item.note}</p>}
                      {item.inLibraryOfCongress && <p class="loc-badge">Бібліотека Конгресу США</p>}
                      {item.url && (
                        <a class="card-link" href={item.url} target="_blank" rel="noopener noreferrer">Електронний ресурс →</a>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      ) : (
        <div class="planned-grid">
          {scientificBookPlannedCategories.map((item) => (
            <article class="planned-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .books-hero {
    padding: 52px 0 18px;
  }

  .books-hero-panel,
  .book-card,
  .planned-card,
  .year-group {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .books-hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 5vw, 54px);
    overflow: hidden;
    position: relative;
  }

  .books-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 300px;
    height: 300px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.14), rgba(29, 79, 145, 0));
  }

  .books-hero-panel > * {
    position: relative;
    z-index: 1;
  }

  .books-hero-panel h1 {
    margin: 0 0 18px;
    max-width: 900px;
    font-size: clamp(2rem, 4.2vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .books-stats {
    display: grid;
    place-items: center;
    min-width: 158px;
    min-height: 158px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(29, 79, 145, 0.10), rgba(184, 135, 47, 0.16));
    border: 1px solid var(--line);
    text-align: center;
  }

  .books-stats strong {
    display: block;
    color: var(--accent-dark);
    font-size: 3rem;
    line-height: 1;
  }

  .books-stats span,
  .books-stats small {
    color: var(--muted);
    font-weight: 850;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 20px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 590px;
    margin: 0;
    color: var(--muted);
  }

  .books-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 18px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .books-toolbar a {
    color: var(--accent-dark);
    font-weight: 900;
  }

  .books-toolbar span {
    color: var(--muted);
    font-weight: 850;
  }

  .planned-grid,
  .book-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .planned-card,
  .book-card {
    padding: 20px;
    background: var(--surface-soft);
  }

  .planned-card h3,
  .book-card h4 {
    margin: 0 0 10px;
    color: var(--accent-dark);
    line-height: 1.25;
  }

  .planned-card p,
  .details,
  .note {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .year-groups {
    display: grid;
    gap: 18px;
  }

  .year-group {
    padding: clamp(18px, 3vw, 28px);
  }

  .year-header,
  .book-card-topline {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }

  .year-header {
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .year-header h3 {
    margin: 0;
    color: var(--accent-dark);
    font-size: 1.45rem;
  }

  .year-header span,
  .book-card-topline strong {
    color: var(--muted);
    font-weight: 850;
  }

  .book-card-topline {
    margin-bottom: 12px;
  }

  .book-card-topline span {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .authors {
    margin: 0 0 10px;
    color: var(--text);
    font-weight: 850;
  }

  .details {
    margin-bottom: 14px;
  }

  .note {
    margin-bottom: 14px;
  }

  .loc-badge {
    display: inline-flex;
    width: fit-content;
    margin: 0 0 14px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(184, 135, 47, 0.14);
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .book-card .card-link {
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .books-hero-panel,
    .section-heading,
    .books-toolbar,
    .year-header {
      display: block;
    }

    .books-stats,
    .section-heading p:last-child,
    .books-toolbar span,
    .year-header span {
      margin-top: 14px;
    }

    .planned-grid,
    .book-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
