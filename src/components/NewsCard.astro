---
import type { CollectionEntry } from 'astro:content';
import { getVisibleNewsTags } from '../utils/newsTags';

interface Props {
  entry: CollectionEntry<'news'>;
  level?: 'h2' | 'h3';
}

const { entry, level = 'h2' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const date = entry.data.date.toLocaleDateString('uk-UA', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
});
const TitleTag = level;
const visibleTags = getVisibleNewsTags(entry);
const localUrl = withBase(`/news/${entry.id}/`);
---

<article class="news-card">
  <time class="news-date" datetime={entry.data.date.toISOString()}>{date}</time>
  <div>
    <TitleTag>
      {entry.data.externalUrl ? (
        <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">{entry.data.title}</a>
      ) : (
        <a href={localUrl}>{entry.data.title}</a>
      )}
    </TitleTag>
    <p>{entry.data.description}</p>
    <div class="tags">
      {visibleTags.map((tag) => (
        <a class="tag" href={withBase(`/news/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
      ))}
    </div>
    {entry.data.externalUrl ? (
      <a class="card-link news-more-link" href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">
        Перейти до матеріалу →
      </a>
    ) : (
      <a class="card-link news-more-link" href={localUrl}>Читати повністю →</a>
    )}
  </div>
</article>
