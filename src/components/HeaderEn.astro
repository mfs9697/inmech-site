---
import { siteEn } from '../data/site-en';

interface Props {
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { activePage = 'home' } = Astro.props;
const isActive = (page: Props['activePage']) => activePage === page ? 'active' : '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const englishSlugs = new Set([
  'history',
  'regulations',
  'strategy',
  'scientific-cooperation',
  'tender',
  'management',
  'departments',
  'scientific-council',
  'specialized-councils',
  'young-scientists',
  'services',
  'education',
  'postgraduate',
  'doctoral',
  'dissertations',
  'license-and-regulations',
  'trust-box',
  'nmr',
  'news',
  'library',
  'search',
  'sitemap',
  'accessibility',
  'site-administration'
]);

const enToUkFallbacks: Record<string, string> = {
  '/en/': '/'
};

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

function normalizePath(pathname: string) {
  let path = pathname;

  if (base && path === base) {
    path = '/';
  } else if (base && path.startsWith(`${base}/`)) {
    path = path.slice(base.length);
  }

  if (!path.startsWith('/')) {
    path = `/${path}`;
  }

  path = path.replace(/\/index\.html$/, '/');

  if (!path.endsWith('/')) {
    path = `${path}/`;
  }

  return path;
}

function getUkrainianPath(pathname: string) {
  const path = normalizePath(pathname);

  if (enToUkFallbacks[path]) {
    return enToUkFallbacks[path];
  }

  if (/^\/en\/departments\/[^/]+\/$/.test(path) || /^\/en\/people\/[^/]+\/$/.test(path)) {
    return path.replace(/^\/en/, '');
  }

  if (!path.startsWith('/en/')) {
    return '/';
  }

  const slug = path.replace(/^\/en\//, '').replace(/\/$/, '');

  if (englishSlugs.has(slug)) {
    return `/${slug}/`;
  }

  return '/';
}

const currentPath = normalizePath(Astro.url.pathname);
const ukrainianPath = getUkrainianPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="topbar">
    <div class="container">
      <span>{siteEn.officialLabel}</span>
      <div class="lang-switch" aria-label="Language selection">
        <a href={withBase(ukrainianPath)}>Українська</a>
        <a class="active" href={withBase(currentPath)} aria-current="page">English</a>
      </div>
    </div>
  </div>

  <div class="container header-main brand-main">
    <a class="brand" href={withBase('/en/')} aria-label="Home page">
      <img src={withBase('/assets/img/ImechLogo.svg?v=20260615-png-final')} alt="Logo of the Institute of Mechanics" />
      <span class="brand-text">
        <strong class="brand-title">{siteEn.name}</strong>
        <span class="brand-subtitle">{siteEn.subtitle}</span>
      </span>
    </a>
  </div>
</header>

<div class="nav-shell">
  <div class="container nav-row">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      Menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Main menu">
      <ul>
        <li><a class={isActive('home')} href={withBase('/en/')}>Home</a></li>

        <li>
          <span class={`nav-label ${isActive('about')}`}>About the Institute ▾</span>
          <ul class="submenu">
            <li><a class={isActive('about')} href={withBase('/en/history/')}>History and mission</a></li>
            <li><a class={isActive('about')} href={withBase('/en/regulations/')}>Statute</a></li>
            <li><a class={isActive('about')} href={withBase('/en/strategy/')}>Development strategy</a></li>
            <li><a class={isActive('about')} href={withBase('/en/scientific-cooperation/')}>Scientific cooperation</a></li>
            <li><a class={isActive('about')} href={withBase('/en/tender/')}>Procurement and tenders</a></li>
          </ul>
        </li>

        <li>
          <span class={`nav-label ${isActive('departments')}`}>Structure ▾</span>
          <ul class="submenu">
            <li><a class={isActive('departments')} href={withBase('/en/management/')}>Management</a></li>
            <li><a class={isActive('departments')} href={withBase('/en/departments/')}>Research departments</a></li>
            <li><a class={isActive('departments')} href={withBase('/en/scientific-council/')}>Scientific Council</a></li>
            <li><a class={isActive('departments')} href={withBase('/en/specialized-councils/')}>Specialized Academic Councils</a></li>
            <li><a class={isActive('departments')} href={withBase('/en/young-scientists/')}>Council of Young Scientists</a></li>
            <li><a class={isActive('departments')} href={withBase('/en/services/')}>Institute services</a></li>
          </ul>
        </li>

        <li>
          <span class={`nav-label ${isActive('education')}`}>Education and research training ▾</span>
          <ul class="submenu">
            <li><a class={isActive('education')} href={withBase('/en/education/')}>Section overview</a></li>
            <li><a class={isActive('education')} href={withBase('/en/postgraduate/')}>Postgraduate studies</a></li>
            <li><a class={isActive('education')} href={withBase('/en/doctoral/')}>Doctoral studies</a></li>
            <li><a class={isActive('education')} href={withBase('/en/dissertations/')}>Dissertation defences</a></li>
            <li><a class={isActive('education')} href={withBase('/en/license-and-regulations/')}>Licences and regulations</a></li>
            <li><a class={isActive('education')} href={withBase('/en/trust-box/')}>Trust box</a></li>
            <li><a class={isActive('education')} href={withBase('/en/nmr/')}>Scientific and Methodological Council</a></li>
          </ul>
        </li>

        <li><a class={isActive('news')} href={withBase('/en/news/')}>News</a></li>
        <li><a href={withBase('/en/#contacts')}>Contacts</a></li>
        <li><a class="search-nav-link" href={withBase('/en/search/')} aria-label="Search the website">Search</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: #0f1f34;
    border-bottom: 0;
    color: #fff;
    backdrop-filter: none;
  }

  .topbar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.84);
  }

  .lang-switch a,
  .lang-switch .active {
    color: #ffffff;
  }

  .header-main.brand-main {
    justify-content: flex-start;
    align-items: center;
  }

  .site-header .brand-title {
    color: #ffffff;
  }

  .site-header .brand-subtitle {
    color: rgba(255, 255, 255, 0.86);
  }

  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 28px rgba(15, 31, 52, 0.08);
    backdrop-filter: blur(12px);
  }

  .nav-row {
    min-height: 54px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    position: relative;
  }

  .primary-nav .submenu {
    z-index: 1100;
  }

  @media (max-width: 940px) {
    .nav-row {
      justify-content: flex-start;
      padding: 8px 0;
    }

    .primary-nav {
      z-index: 1100;
    }
  }
</style>
