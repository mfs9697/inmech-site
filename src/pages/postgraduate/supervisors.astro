---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const requiredCourseTeachers = [
  {
    code: 'ОК1',
    course: 'Філософія науки і культури',
    teachers: 'Вільчинська С. В., кандидат філософських наук, доцент; Літус І. І., кандидат філософських наук'
  },
  {
    code: 'ОК2',
    course: 'Іноземна мова професійного спрямування для підготовки аспірантів до рівня С1',
    teachers: 'Рубашова Л. М., кандидат філологічних наук'
  },
  {
    code: 'ОК3',
    course: 'Методологія, організація та технологія наукових досліджень в механіці',
    teachers: 'Жук Я. О., доктор фізико-математичних наук, член-кореспондент НАН України; Васильєва Н. В., кандидат фізико-математичних наук'
  },
  {
    code: 'ОК4',
    course: 'Поглиблений курс теоретичної механіки',
    teachers: 'Іванов І. Л., кандидат фізико-математичних наук'
  },
  {
    code: 'ОК5',
    course: 'Механіка деформівного твердого тіла',
    teachers: 'Селіванов М. Ф., доктор фізико-математичних наук, член-кореспондент НАН України'
  },
  {
    code: 'ОК6',
    course: 'Чисельні методи розв’язання задач прикладної математики',
    teachers: 'Янчевський І. В., доктор фізико-математичних наук'
  },
  {
    code: 'ОК7',
    course: 'Педагогіка і методика викладання прикладної математики',
    teachers: 'Борисенко М. Ю., доктор технічних наук'
  },
  {
    code: 'ОК8',
    course: 'Педагогічна практика',
    teachers: 'Борисенко М. Ю., доктор технічних наук'
  }
];

const electiveCourseTeachers = [
  ['ВК1', 'Нелінійна теорія оболонок з отворами', 'Сторожук Є. А., доктор фізико-математичних наук, професор, член-кореспондент НАН України; Максимюк В. А., доктор фізико-математичних наук'],
  ['ВК2', 'Аналітично-чисельне дослідження стійкості та руйнування матеріалів з тонким покриттям та армованих композитних матеріалів із застосуванням високопродуктивних обчислень', 'Декрет В. А., доктор фізико-математичних наук; Кіпніс О. Л., кандидат фізико-математичних наук'],
  ['ВК3', 'Поширення хвиль з врахуванням структурних рівнів матеріалів та базових властивостей деформування матеріалів', 'Юрчук В. М., доктор фізико-математичних наук'],
  ['ВК4', 'Механіка руйнування в’язкопружних матеріалів', 'Чорноіван Ю. О., кандидат фізико-математичних наук'],
  ['ВК5', 'Математичні моделі термомеханіки суцільних середовищ', 'Жук Я. О., доктор фізико-математичних наук, член-кореспондент НАН України'],
  ['ВК6', 'Динаміка структурно неоднорідних оболонок', 'Колядюк А. С., кандидат технічних наук'],
