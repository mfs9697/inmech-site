---
import { render, type CollectionEntry } from 'astro:content';
import { getVisibleNewsTags } from '../utils/newsTags';

interface Props {
  entry: CollectionEntry<'news'>;
  level?: 'h2' | 'h3';
}

const { entry, level = 'h2' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const date = entry.data.date.toLocaleDateString('uk-UA', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
});
const TitleTag = level;
const visibleTags = getVisibleNewsTags(entry);
const hasLocalBody = !entry.data.externalUrl && Boolean(entry.body?.trim());
const renderedEntry = hasLocalBody ? await render(entry) : null;
const Content = renderedEntry?.Content;
---

<article class="news-card">
  <time class="news-date" datetime={entry.data.date.toISOString()}>{date}</time>
  <div>
    <TitleTag>
      {entry.data.externalUrl ? (
        <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">{entry.data.title}</a>
      ) : (
        entry.data.title
      )}
    </TitleTag>
    <p>{entry.data.description}</p>
    <div class="tags">
      {visibleTags.map((tag) => (
        <a class="tag" href={withBase(`/news/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
      ))}
    </div>

    {Content && (
      <details class="news-inline-body">
        <summary>Повний текст</summary>
        <div class="content-body news-card-content">
          <Content />
        </div>
      </details>
    )}

    {entry.data.externalUrl && (
      <a class="card-link news-more-link" href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">
        Перейти до матеріалу →
      </a>
    )}
  </div>
</article>

<style>
  .news-inline-body {
    margin-top: 14px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .news-inline-body summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 750;
  }

  .news-card-content {
    color: var(--text);
    line-height: 1.72;
    margin-top: 12px;
  }

  .news-card-content :global(p) {
    margin: 0 0 1rem;
  }

  .news-more-link {
    display: inline-flex;
    margin-top: 14px;
  }
</style>
