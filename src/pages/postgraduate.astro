        </div>
      </div>

      <div class="quality-grid">
        <article class="postgraduate-panel">
          <h3>Відгуки та пропозиції стейкхолдерів</h3>
          <div class="feedback-year-grid">
            {feedbackLinks.map((group) => (
              <div class="feedback-year-card">
                <strong>{group.year}</strong>
                <div class="pill-link-grid small">
                  {group.links.map(([label, href]) => (
                    <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </article>

        <article class="postgraduate-panel">
          <h3>Результати опитувань</h3>
          <div class="survey-list">
            {surveyResults.map(([title, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer">{title}</a>
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

