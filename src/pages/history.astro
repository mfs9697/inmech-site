---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import HistoryOrigins from '../components/history/HistoryOrigins.astro';
import HistoryMilestones from '../components/history/HistoryMilestones.astro';
import HistoryScientificSchools from '../components/history/HistoryScientificSchools.astro';
import HistoryWartime from '../components/history/HistoryWartime.astro';
import HistoryAchievements from '../components/history/HistoryAchievements.astro';
import HistoryDirectors from '../components/history/HistoryDirectors.astro';
import HistoryModernInstitute from '../components/history/HistoryModernInstitute.astro';
import HistoryEducation from '../components/history/HistoryEducation.astro';
import HistoryPublications from '../components/history/HistoryPublications.astro';
import HistoryPublicationLegacy from '../components/history/HistoryPublicationLegacy.astro';
import HistoryCooperation from '../components/history/HistoryCooperation.astro';
import HistorySources from '../components/history/HistorySources.astro';
---

<BaseLayout
  title={`Історія і сучасність | ${site.name}`}
  description="Заснування, зміни назви, наукові школи та сучасна діяльність Інституту механіки ім. С.П. Тимошенка НАН України."
  activePage="about"
>
  <section class="page-hero history-hero">
    <div class="container history-page-container">
      <div class="panel history-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>Інститут механіки ім. С.П. Тимошенка: історія і сучасність</h1>
        <p class="lead">
          Заснований 30 листопада 1918 року як перша установа технічного профілю
          Української академії наук, Інститут упродовж понад століття розвиває
          фундаментальні й прикладні дослідження в галузі механіки.
        </p>
      </div>
    </div>
  </section>

  <div class="history-page-content">
    <HistoryOrigins />
    <HistoryMilestones />
    <HistoryScientificSchools />
    <HistoryWartime />
    <HistoryAchievements />
    <HistoryDirectors />
    <HistoryModernInstitute />
    <HistoryEducation />
    <HistoryPublications />
    <HistoryPublicationLegacy />
    <HistoryCooperation />
    <HistorySources />
  </div>
</BaseLayout>

<style is:global>
  .history-page-container {
    width: min(100% - 32px, var(--max));
    margin-inline: auto;
  }

  .history-hero-panel {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding: clamp(28px, 4vw, 50px);
  }

  .history-inline-link {
    font-weight: 800;
  }

  .history-content-section + .history-content-section {
    border-top: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .history-page-container {
      width: min(100% - 24px, var(--max));
    }

    .history-hero-panel {
      padding: 24px;
    }
  }
</style>
