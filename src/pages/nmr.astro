---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const activityCards = [
  {
    title: 'Методичне забезпечення ОНП',
    icon: '📚',
    text: 'Координація освітніх компонентів, силабусів, робочих програм, навчальних планів і методичних матеріалів.'
  },
  {
    title: 'Якість освітнього процесу',
    icon: '✓',
    text: 'Участь у моніторингу якості викладання, аналізі результатів опитувань і врахуванні пропозицій стейкхолдерів.'
  },
  {
    title: 'Рейтингування викладачів',
    icon: '★',
    text: 'Супровід процедур рейтингування науково-педагогічних працівників Інституту.'
  },
  {
    title: 'Добір викладацького складу',
    icon: '◎',
    text: 'Методичний супровід процедур відбору наукових працівників до викладацького складу.'
  }
];

const documentGroups = [
  {
    title: 'Склад ради',
    description: 'Документ із персональним складом Науково-методичної ради Інституту.',
    documents: [
      {
        title: 'Склад НМР',
        href: '/documents/postgraduate/nmr/nmr-members.docx',
        type: 'DOCX'
      }
    ]
  },
  {
    title: 'Рейтингування викладачів',
    description: 'Порядок рейтингування та результати рейтингу науково-педагогічних працівників.',
    documents: [
      {
        title: 'Порядок рейтингування науково-педагогічних працівників Інституту механіки ім. С. П. Тимошенка НАН України',
        href: '/documents/postgraduate/nmr/teacher-rating-rules.pdf',
        type: 'PDF'
      },
      {
        title: 'Рейтинг викладачів 2024–2025',
        href: '/documents/postgraduate/nmr/teacher-rating-2024-2025.pdf',
        type: 'PDF'
      }
    ]
  },
  {
    title: 'Добір викладацького складу',
    description: 'Документ, що регламентує відбір або добір наукових працівників до викладацького складу.',
    documents: [
      {
        title: 'Порядок відбору / добору наукових працівників Інституту механіки ім. С. П. Тимошенка НАН України до викладацького складу',
        href: '/documents/postgraduate/nmr/teacher-selection-procedure.pdf',
        type: 'PDF'
      }
    ]
  }
];

const relatedLinks = [
  ['Аспірантура', '/postgraduate/'],
  ['Докторантура', '/doctoral/'],
  ['Ліцензії та Положення', '/license-and-regulations/'],
  ['Освітньо-наукова діяльність', '/education/']
];
---

<BaseLayout
  title={`Науково-методична рада | ${site.shortName}`}
  description="Науково-методична рада Інституту механіки ім. С. П. Тимошенка НАН України: методичне забезпечення освітньо-наукової діяльності, рейтингування викладачів, добір викладацького складу та документи."
  activePage="education"
>
  <section class="nmr-hero">
    <div class="container nmr-hero-grid">
      <div class="nmr-hero-panel">
        <p class="eyebrow">Освітньо-наукова діяльність</p>
        <h1>Науково-методична рада</h1>
        <p class="lead">
          Науково-методична рада Інституту механіки ім. С. П. Тимошенка НАН України
          координує методичне забезпечення освітньо-наукової діяльності, питання якості
          освітнього процесу, рейтингування викладачів, добір наукових працівників до
          викладацького складу та підготовку документів, пов’язаних із реалізацією
          освітньо-наукової програми.
        </p>
        <div class="nmr-hero-actions">
          <a class="button primary" href="#documents">Документи НМР</a>
          <a class="button secondary" href="#activities">Напрями діяльності</a>
        </div>
      </div>

      <aside class="nmr-mark-card">
        <span>НМР</span>
        <h2>Методична координація</h2>
        <p>
          Підтримка якості освітньо-наукової програми, прозорих процедур і методичного
          супроводу підготовки здобувачів.
        </p>
      </aside>
    </div>
  </section>

  <section class="section nmr-summary-section">
    <div class="container nmr-summary-grid">
      <article class="nmr-summary-card">
        <span>ОНП</span>
        <p>методичне забезпечення освітньо-наукової програми</p>
      </article>
      <article class="nmr-summary-card">
        <span>Якість</span>
        <p>моніторинг і підтримка якості освітнього процесу</p>
      </article>
      <article class="nmr-summary-card">
        <span>Рейтинг</span>
        <p>процедури рейтингування викладачів</p>
      </article>
    </div>
  </section>

  <section class="section" id="activities">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Сфера відповідальності</p>
          <h2>Основні напрями діяльності</h2>
        </div>
        <p>
          НМР забезпечує методичну узгодженість освітньо-наукової діяльності та підтримує
          прозорі процедури, пов’язані з якістю освітнього процесу й викладацьким складом.
        </p>
      </div>

      <div class="nmr-activity-grid">
        {activityCards.map((card) => (
          <article class="nmr-activity-card">
            <span>{card.icon}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="composition">
    <div class="container">
      <div class="nmr-composition-panel">
        <div>
          <p class="eyebrow">Склад ради</p>
          <h2>Склад Науково-методичної ради</h2>
          <p>
            Актуальний склад Науково-методичної ради подано в окремому документі.
          </p>
        </div>
        <a class="button primary" href="/documents/postgraduate/nmr/nmr-members.docx" target="_blank" rel="noopener noreferrer">
          Завантажити склад НМР
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="documents">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Документи</p>
          <h2>Документи НМР</h2>
        </div>
        <p>
          Основні матеріали згруповано за призначенням: склад ради, рейтингування викладачів
          і добір наукових працівників до викладацького складу.
        </p>
      </div>

      <div class="nmr-document-group-grid">
        {documentGroups.map((group) => (
          <article class="nmr-document-group-card">
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <div class="nmr-document-list">
              {group.documents.map((document) => (
                <a href={document.href} target="_blank" rel="noopener noreferrer">
                  <span>{document.type}</span>
                  <strong>{document.title}</strong>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="related-panel">
        <div>
          <p class="eyebrow">Пов’язані розділи</p>
          <h2>Освітньо-наукова діяльність</h2>
        </div>
        <div class="related-link-grid">
          {relatedLinks.map(([title, href]) => (
            <a href={withBase(href)}>{title} →</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nmr-hero {
    padding: 52px 0 18px;
  }

  .nmr-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }
</style>
