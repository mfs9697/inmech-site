---
interface Props {
  activeYear?: number;
}

const { activeYear = new Date().getFullYear() } = Astro.props;
const currentYear = new Date().getFullYear();
---

<nav class="year-nav" aria-label="Архів за роками">
  <a class={currentYear === activeYear ? 'active' : ''} href="#">{currentYear}</a>
</nav>
