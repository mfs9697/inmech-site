---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}
---

<footer class="site-footer" id="contacts">
  <div class="container footer-grid">
    <section>
      <h2>{site.name}</h2>
      <p>{site.address}</p>
      <p>Тел.: <a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a><br />E-mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </section>
    <section>
      <h3>Розділи</h3>
      <ul class="footer-links">
        <li><a href={withBase('/news/')}>Новини</a></li>
        <li><a href={withBase('/departments/')}>Наукові відділи</a></li>
        <li><a href={withBase('/postgraduate/')}>Аспірантура</a></li>
        <li><a href="https://applied-mechanics.inmech.kyiv.ua/" target="_blank" rel="noopener noreferrer">Журнал «Прикладна механіка»</a></li>
      </ul>
    </section>
    <section>
      <h3>Службові посилання</h3>
      <ul class="footer-links">
        <li><a href={withBase('/sitemap/')}>Карта сайту</a></li>
        <li><a href={withBase('/accessibility/')}>Політика доступності</a></li>
        <li><a href={withBase('/site-administration/')}>Адміністрація сайту</a></li>
      </ul>
    </section>
  </div>
  <div class="container copyright">
    © {new Date().getFullYear()} Інститут механіки ім. С.П. Тимошенка НАН України.
  </div>
</footer>
