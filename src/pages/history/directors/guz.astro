---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../data/site';
import {
  guzStats,
  guzTimeline,
  guzResearchAreas,
  guzEffects,
  guzAwards,
  guzOtherRecognition,
  guzMultivolumeWorks,
  guzSelectedWorks,
  guzGallery,
  guzExternalLinks,
  guzPrimarySource
} from '../../../data/guzDirector';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (/^(https?:)?\/\//.test(path) || path.startsWith('mailto:') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const galleryItems = guzGallery.slice(2);
---

<BaseLayout
  title={`Олександр Миколайович Гузь | ${site.name}`}
  description="Олександр Миколайович Гузь — академік НАН України, видатний учений-механік і директор Інституту механіки у 1976–2022 роках."
  activePage="about"
>
  <section class="guz-page">
    <div class="container guz-container">
      <nav class="guz-breadcrumb" aria-label="Навігація">
        <a href={withBase('/')}>Головна</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/history/')}>Історія і сучасність</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/history/#directors')}>Директори Інституту</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">О.М. Гузь</span>
      </nav>

      <header class="guz-hero" data-block-tone="heritage">
        <div class="guz-hero-copy">
          <p class="eyebrow">Про інститут · Історія · Директори Інституту</p>
          <h1>Олександр Миколайович Гузь</h1>
          <p class="guz-hero-role">Академік НАН України. Директор Інституту механіки у 1976–2022 роках</p>
          <p class="lead">
            Олександр Миколайович Гузь — видатний український учений-механік і організатор науки,
            засновник наукової школи в галузі лінеаризованої механіки деформівних тіл і суміжних
            напрямів. Упродовж 1976–2022 років він очолював Інститут механіки, поєднуючи керівництво
            однією з провідних академічних установ України з інтенсивною власною науковою діяльністю.
          </p>
        </div>

        <figure class="guz-hero-portrait">
          <img
            src={withBase('/assets/img/history/guz/guz-portrait.webp')}
            alt="Олександр Миколайович Гузь"
            loading="eager"
            width="296"
            height="405"
          />
          <figcaption>
            <strong>46 років</strong>
            <span>на чолі Інституту механіки</span>
          </figcaption>
        </figure>
      </header>

      <section class="guz-stats" aria-label="Ключові факти">
        {guzStats.map((item) => (
          <article class="guz-stat panel">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            <small>{item.detail}</small>
          </article>
        ))}
      </section>

      <section class="guz-section panel">
        <div class="guz-section-heading">
          <p class="eyebrow">Біографічні віхи</p>
          <h2>Науковий і професійний шлях</h2>
          <p>
            Олександр Миколайович Гузь народився 29 січня 1939 року в місті Ічня Чернігівської
            області. У 1956 році вступив на механіко-математичний факультет Київського державного
            університету ім. Т.Г. Шевченка, який закінчив з відзнакою у 1961 році. Ще у студентські
            роки розпочав дослідницьку роботу в Інституті механіки АН УРСР і відтоді пов’язав з
            Інститутом усе своє наукове життя.
          </p>
        </div>

        <ol class="guz-timeline">
          {guzTimeline.map((item) => (
            <li>
              <div class="guz-timeline-year">{item.year}</div>
              <div class="guz-timeline-copy">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="guz-section guz-directorate-section" data-block-tone="heritage">
        <div class="guz-directorate-copy">
          <p class="eyebrow">Інститут механіки</p>
          <h2>46 років на чолі Інституту</h2>
          <p>
            У 1976 році 37-річного О.М. Гузя було затверджено директором Інституту механіки АН УРСР.
            На той час Інститут був найбільшим у СРСР науковим інститутом у галузі механіки. У 1980
            році його штат налічував понад 1500 співробітників, серед яких було 60 докторів і 150
            кандидатів наук.
          </p>
          <p>
            За керівництва О.М. Гузя змінилися організація наукової діяльності Інституту та форми
            представлення її результатів. Підсумки фундаментальних досліджень почали системно
            оформлювати у вигляді багатотомних монографічних видань, а прикладні роботи ставали
            комплекснішими і виконувалися у тісній взаємодії із замовниками.
          </p>
          <p>
            Одним із перших масштабних результатів такого підходу стала п’ятитомна серія «Методы
            расчета оболочек», видана у 1980–1982 роках за загальною редакцією О.М. Гузя. Серію
            невдовзі переклали англійською мовою у США як допоміжні технічні тексти для NASA.
            Надалі підготовка фундаментальних багатотомних видань з актуальних проблем механіки
            стала в Інституті системною практикою.
          </p>
          <p>
            Важливим напрямом діяльності Інституту стала також комплексна співпраця з іншими
            науковими установами та конструкторськими організаціями. У статті окремо відзначено
            багаторічні спільні роботи з Інститутом електрозварювання ім. Є.О. Патона в галузі
            ультразвукових неруйнівних методів визначення напружень, співпрацю з КБ «Південне»,
            а також дослідження з механіки гірничих порід.
          </p>
        </div>

        <div class="guz-directorate-figures">
          <figure>
            <img
              src={withBase(guzGallery[0].src)}
              alt={guzGallery[0].alt}
              loading="lazy"
              width="461"
              height="519"
            />
            <figcaption>{guzGallery[0].caption}</figcaption>
          </figure>
          <figure>
            <img
              src={withBase(guzGallery[1].src)}
              alt={guzGallery[1].alt}
              loading="lazy"
              width="461"
              height="341"
            />
            <figcaption>{guzGallery[1].caption}</figcaption>
          </figure>
        </div>
      </section>

      <section class="guz-section panel">
        <div class="guz-section-heading">
          <p class="eyebrow">Наукова спадщина</p>
          <h2>Науковий внесок</h2>
          <p>
            Центральне місце у науковій творчості О.М. Гузя посідає лінеаризована механіка
            деформівного твердого тіла. У ювілейній статті Моріса Біо і Олександра Гузя названо
            основоположниками цього напряму: започатковані М. Біо ідеї набули у працях О.М. Гузя
            системного розвитку в широкому колі задач механіки деформівних тіл.
          </p>
          <p>
            Результати досліджень О.М. Гузя охоплюють тривимірну теорію стійкості деформівних тіл,
            теорію стійкості гірничих виробок, поширення пружних хвиль у тілах із початковими
            напруженнями, некласичні проблеми механіки руйнування, контактні задачі для тіл із
            початковими напруженнями та задачі динаміки тіл у стисливій в’язкій рідині.
          </p>
        </div>

        <div class="guz-research-grid">
          {guzResearchAreas.map((item) => (
            <article class="guz-research-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <details class="guz-details">
          <summary>Основні встановлені механічні ефекти</summary>
          <div class="guz-details-body">
            <p>
              У працях О.М. Гузя та його учнів теоретично виявлено і досліджено низку нових
              механічних ефектів. Серед них:
            </p>
            <ul>
              {guzEffects.map((item) => <li>{item}</li>)}
            </ul>
            <p>
              Повний перелік у статті структуровано за дванадцятьма напрямами механіки.
              <a href={guzPrimarySource.href} target="_blank" rel="noopener"> Докладніше у статті →</a>
            </p>
          </div>
        </details>
      </section>

      <section class="guz-section guz-school-section" data-block-tone="information">
        <div class="guz-section-heading">
          <p class="eyebrow">Наукова спадкоємність</p>
          <h2>Наукова школа О.М. Гузя</h2>
          <p>
            О.М. Гузь створив одну з найбільших наукових шкіл України в галузі механіки. Під його
            керівництвом захищено 40 докторських і понад 100 кандидатських дисертацій.
          </p>
        </div>

        <div class="guz-school-numbers" aria-label="Підготовка наукових кадрів">
          <div><strong>40</strong><span>докторів наук</span></div>
          <div><strong>100+</strong><span>кандидатів наук</span></div>
        </div>

        <p class="guz-school-people">
          Серед його учнів — академіки НАН України <strong>Вячеслав Богданов</strong>,
          <strong>Веніамін Кубенко</strong>, <strong>Володимир Назаренко</strong>, академік НАН
          Азербайджану Г.Г. Кулієв, члени-кореспонденти НАН України Ю.М. Неміш, І.С. Чернишенко,
          М.О. Шульга та член-кореспондент НАН Азербайджану С.Д. Акбаров.
        </p>
        <p class="guz-school-people">
          Наукова школа О.М. Гузя стала важливою складовою спадкоємності досліджень Інституту
          механіки: започатковані ним напрями й сьогодні розвиваються його учнями та наступними
          поколіннями науковців.
        </p>
      </section>

      <section class="guz-section panel guz-recognition-section">
        <div class="guz-recognition-copy">
          <p class="eyebrow">Визнання</p>
          <h2>Міжнародне визнання та нагороди</h2>
          <p>
            Наукові та науково-організаційні здобутки О.М. Гузя відзначено численними вітчизняними
            і міжнародними нагородами. Він є лауреатом найвищої наукової відзнаки НАН України —
            Золотої медалі імені В.І. Вернадського, Державної премії СРСР, двох Державних премій
            України в галузі науки і техніки, а також низки іменних премій НАН України.
          </p>
          <p>
            У 2008 році Європейська академія наук присудила О.М. Гузю Медаль Блеза Паскаля. Він був
            обраний членом Academia Europaea та Європейської академії наук, а у 1995 році — членом
            Генеральної асамблеї Міжнародного союзу з теоретичної та прикладної механіки (IUTAM).
          </p>

          <div class="guz-awards-grid">
            {guzAwards.map((item) => (
              <article>
                <strong>{item.year}</strong>
                <span>{item.title}</span>
              </article>
            ))}
          </div>

          <details class="guz-details compact">
            <summary>Інші відзнаки та академічні членства</summary>
            <div class="guz-details-body">
              <ul>
                {guzOtherRecognition.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </details>
        </div>

        <figure class="guz-medal-figure">
          <img
            src={withBase('/assets/img/history/guz/guz-vernadskyi-medal-2014.webp')}
            alt="Президент НАН України Б.Є. Патон вручає О.М. Гузю Золоту медаль імені В.І. Вернадського"
            loading="lazy"
            width="653"
            height="458"
          />
          <figcaption>
            Президент НАН України Б.Є. Патон вручає О.М. Гузю Золоту медаль імені В.І. Вернадського
            НАН України. Травень 2014 року.
          </figcaption>
        </figure>
      </section>

      <section class="guz-section panel">
        <div class="guz-section-heading">
          <p class="eyebrow">Архівні світлини</p>
          <h2>Фотолітопис</h2>
          <p>
            Фотографії з ювілейної статті відображають різні періоди діяльності О.М. Гузя в
            Інституті механіки та Національній академії наук України.
          </p>
        </div>

        <div class="guz-gallery">
          {galleryItems.map((item) => (
            <figure>
              <img src={withBase(item.src)} alt={item.alt} loading="lazy" />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="guz-section panel">
        <div class="guz-section-heading">
          <p class="eyebrow">Наукові видання</p>
          <h2>Вибрані праці та фундаментальні видання</h2>
          <p>
            О.М. Гузь є автором 76 монографій, з яких 22 написано без співавторів, і близько 1000
            наукових публікацій. Значна частина його фундаментальних результатів представлена у
            монографічних виданнях, опублікованих в Україні та за кордоном.
          </p>
        </div>

        <div class="guz-works-grid">
          <section>
            <h3>Фундаментальні багатотомні серії</h3>
            <ul>
              {guzMultivolumeWorks.map((item) => <li>{item}</li>)}
            </ul>
          </section>
          <section>
            <h3>Вибрані пізні праці</h3>
            <ol>
              {guzSelectedWorks.map((item) => <li>{item}</li>)}
            </ol>
          </section>
        </div>
      </section>

      <section class="guz-section guz-sources-section" data-block-tone="neutral">
        <div class="guz-section-heading">
          <p class="eyebrow">Джерела</p>
          <h2>Про О.М. Гузя в зовнішніх ресурсах</h2>
          <p>
            Докладні біографічні, бібліографічні та наукометричні відомості про О.М. Гузя
            представлено також у зовнішніх академічних та довідкових ресурсах.
          </p>
        </div>

        <div class="guz-external-links">
          {guzExternalLinks.map((item) => (
            <a
              href={withBase(item.href)}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener' : undefined}
            >
              {item.label} →
            </a>
          ))}
        </div>

        <article class="guz-primary-source">
          <p class="eyebrow">Основне джерело цієї сторінки</p>
          <h3>{guzPrimarySource.title}</h3>
          <p><strong>{guzPrimarySource.authors}</strong></p>
          <p>{guzPrimarySource.journal}</p>
          <a href={guzPrimarySource.href} target="_blank" rel="noopener">
            DOI: {guzPrimarySource.doi} →
          </a>
          <small>
            Текст і фотографії сторінки підготовлено за матеріалами цієї публікації.
          </small>
        </article>
      </section>

      <nav class="guz-footer-nav" aria-label="Пов’язані сторінки">
        <a href={withBase('/history/')}>
          <span>← Історія і сучасність</span>
          <small>Повернутися до історії Інституту та переліку директорів</small>
        </a>
        <a href={withBase('/people/guz/')}>
          <span>Науковий профіль О.М. Гузя →</span>
          <small>Наукові напрями, підрозділ і бібліографічні профілі</small>
        </a>
        <a href={withBase('/departments/01-dynamics-stability/')}>
          <span>Відділ динаміки та стійкості →</span>
          <small>Підрозділ, створений О.М. Гузем у 1967 році</small>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .guz-page {
    padding: 34px 0 76px;
  }

  .guz-container {
    width: min(100% - 32px, 1120px);
  }

  .guz-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .guz-breadcrumb a {
    color: var(--accent-dark);
    font-weight: 750;
  }

  .guz-hero,
  .guz-section {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .guz-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(240px, 0.62fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding: clamp(30px, 5vw, 58px);
  }

  .guz-hero h1 {
    max-width: 760px;
    margin: 0 0 14px;
    font-size: clamp(2.55rem, 6vw, 5rem);
    line-height: 0.99;
    letter-spacing: -0.045em;
  }

  .guz-hero-role {
    max-width: 720px;
    margin: 0 0 20px;
    color: var(--accent-dark);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    font-weight: 850;
    line-height: 1.45;
  }

  .guz-hero .lead {
    max-width: 760px;
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .guz-hero-portrait {
    margin: 0;
  }

  .guz-hero-portrait img {
    display: block;
    width: min(100%, 296px);
    height: auto;
    margin: 0 auto;
    border-radius: 16px;
    border: 1px solid rgba(125, 92, 34, 0.2);
    box-shadow: 0 18px 38px rgba(20, 33, 61, 0.14);
  }

  .guz-hero-portrait figcaption {
    display: grid;
    gap: 2px;
    width: min(100%, 296px);
    margin: 12px auto 0;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.74);
    text-align: center;
  }

  .guz-hero-portrait figcaption strong {
    color: var(--heading);
    font-size: 1.45rem;
    line-height: 1.1;
  }

  .guz-hero-portrait figcaption span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .guz-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }

  .guz-stat {
    display: grid;
    align-content: start;
    gap: 5px;
    min-height: 150px;
    padding: 22px;
  }

  .guz-stat strong {
    color: var(--accent-dark);
    font-size: clamp(1.7rem, 3vw, 2.25rem);
    line-height: 1.05;
  }

  .guz-stat span {
    color: var(--heading);
    font-weight: 800;
    line-height: 1.35;
  }

  .guz-stat small {
    margin-top: auto;
    color: var(--muted);
    line-height: 1.4;
  }

