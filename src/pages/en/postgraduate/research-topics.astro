---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  const cleanPath = path.replace(/^\/inmech-site(?=\/)/, '');
  return `${base}${cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`}`;
}

const topicGroups = [
  {
    year: '2025',
    rows: [
      {
        student: 'O. A. Proshchenko',
        studyYears: 'admission 2025',
        topic: 'Plane fracture problems for materials compressed along parallel cracks with centres shifted in the compression direction',
        supervisor: 'Volodymyr M. Nazarenko, Academician of the NAS of Ukraine, Acting Director of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine'
      },
      {
        student: 'R. Yu. Hrysevych',
        studyYears: 'admission 2025',
        topic: 'Theoretical and experimental modelling of deformation of hand prosthesis elements under static, quasi-static and dynamic loading',
        supervisor: 'V. A. Maksymyuk, Doctor of Physical and Mathematical Sciences, Leading Researcher'
      },
      {
        student: 'Yu. O. Nazarchuk',
        studyYears: 'admission 2025',
        topic: 'Modelling fracture of road pavements and mixture interfaces using cohesive models and viscoelasticity',
        supervisor: 'Mykhailo F. Selivanov, Corresponding Member of the NAS of Ukraine, Doctor of Physical and Mathematical Sciences, Deputy Director for Scientific Work'
      },
      {
        student: 'O. I. Syniavskyi',
        studyYears: 'admission 2025',
        topic: 'Compression of thin-film systems along the interface between a film and a substrate of finite thickness',
        supervisor: 'Volodymyr M. Nazarenko, Academician of the NAS of Ukraine, Acting Director of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine'
      }
    ]
  },
  {
    year: '2024',
    rows: [
      {
        student: 'R. V. Serafymovych',
        studyYears: 'admission 2024',
        topic: 'Physically nonlinear problems for a three-layer cylindrical shell with openings',
        supervisor: 'Yevhen A. Storozhuk, Corresponding Member of the NAS of Ukraine, Doctor of Physical and Mathematical Sciences, Professor, Deputy Head of Department'
      },
      {
        student: 'Ye. Fil',
        studyYears: 'admission 2024',
        topic: 'Numerical analysis of the stress-strain state of shallow orthotropic shells with non-rectangular planform',
        supervisor: 'Oleksandr Ya. Grygorenko, Head of the Department of Computational Methods, Academician of the NAS of Ukraine, Doctor of Physical and Mathematical Sciences, Professor'
      },
      {
        student: 'V. O. Usov',
        studyYears: 'admission 2024',
        topic: 'Numerical modelling of thermomechanical processes in layer-by-layer printing of bodies of revolution made of viscoplastic material',
        supervisor: 'Ihor K. Senchenkov, Doctor of Physical and Mathematical Sciences, Chief Researcher'
      }
    ]
  },
  {
    year: '2023',
    rows: [
      {
        student: 'Yu. V. Horskyi',
        studyYears: 'admission 2023',
        topic: 'Generation of cross-shaped surface waves in water in a cylindrical container with vibrating walls under acoustic radiation',
        supervisor: 'Yaroslav O. Zhuk, Doctor of Physical and Mathematical Sciences, Corresponding Member of the NAS of Ukraine, Professor'
      },
      {
        student: 'P. Yu. Kobzar',
        studyYears: 'admission 2023',
        topic: 'Modelling stress distribution in a piezoelectric body near rigid flat inclusions and circular or elliptical cracks',
        supervisor: 'Vitalii S. Kyryliuk, Leading Researcher, Doctor of Physical and Mathematical Sciences'
      },
      {
        student: 'O. I. Lesyk',
        studyYears: 'admission 2023',
        topic: 'Plane fracture mechanics problems for materials with interacting cracks under forces directed along the cracks',
        supervisor: 'Viacheslav L. Bogdanov, Doctor of Physical and Mathematical Sciences, Academician of the NAS of Ukraine, Head of Department'
      },
      {
        student: 'A. S. Olkhovskyi',
        studyYears: 'admission 2023',
        topic: 'Mathematical modelling of the influence of local damage and operational loads on vibration stresses in last-stage blades of an NPP steam turbine',
        supervisor: 'Ihor K. Senchenkov, Doctor of Physical and Mathematical Sciences, Chief Researcher'
      },
      {
        student: 'D. M. Selivanov',
        studyYears: 'admission 2023',
        topic: 'Application of the cohesive-zone model to delayed fracture problems for bodies with mixed-mode cracks',
        supervisor: 'Viacheslav L. Bogdanov, Doctor of Physical and Mathematical Sciences, Academician of the NAS of Ukraine, Head of Department'
      }
    ]
  }
];
---

<BaseLayoutEn
  title={`Alignment of postgraduate research topics | ${siteEn.shortName}`}
  description="Alignment of postgraduate dissertation topics with the research activities of their supervisors at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/en/postgraduate/')}>Postgraduate studies</a>
      <span>›</span>
      <span>Research topics</span>
    </nav>

    <section class="page-hero">
      <p class="eyebrow">PhD training quality</p>
      <h1>Alignment of dissertation topics with supervisors’ research activities</h1>
      <p class="lead">
        The table presents the correspondence between postgraduate dissertation topics and the research activities of their supervisors:
        postgraduate student and years of study, dissertation topic, and research supervisor with position.
      </p>
      <p><a href={withBase('/postgraduate/research-topics/')}>Ukrainian version</a></p>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Summary table</p>
          <h2>Dissertation topics and supervisors’ research activities</h2>
        </div>
        <p>The table is presented without publication lists, in accordance with the letter format.</p>
      </div>

      <div class="table-panel">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Postgraduate student, years of study</th>
                <th>Dissertation topic 2025</th>
                <th>Research supervisor, position 2025</th>
              </tr>
            </thead>
            <tbody>
              {topicGroups.map((group) => (
                <>
                  <tr class="year-row"><td colspan="3">{group.year}</td></tr>
                  {group.rows.map((row) => (
                    <tr>
                      <td><strong>{row.student}</strong><span>{row.studyYears}</span></td>
                      <td>{row.topic}</td>
                      <td>{row.supervisor}</td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-block note-card">
      <p class="eyebrow">Note</p>
      <h2>Table format</h2>
      <p>
        This page contains only summarised information on the correspondence between postgraduate dissertation topics and the research activities of their supervisors.
        Individual publication lists are provided on the relevant student or supervisor pages.
      </p>
      <div class="links-row">
        <a href={withBase('/en/postgraduate/students/')}>Students →</a>
        <a href={withBase('/en/postgraduate/supervisors/')}>Supervisors →</a>
      </div>
    </section>
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page { max-width: 1240px; margin: 0 auto; padding: 46px 20px 72px; }
  .breadcrumbs { display: flex; gap: 10px; align-items: center; margin-bottom: 22px; color: var(--muted); font-weight: 750; }
  .page-hero, .table-panel, .note-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .page-hero { padding: clamp(28px, 5vw, 52px); }
  .page-hero h1 { margin: 0 0 18px; font-size: clamp(2.05rem, 4.5vw, 4.1rem); line-height: 1.04; letter-spacing: -0.04em; }
  .lead { max-width: 940px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .section-block { margin-top: 34px; }
  .table-panel { overflow: hidden; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; min-width: 980px; border-collapse: collapse; }
  th, td { padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  th { background: var(--accent-dark); color: #fff; font-size: 0.88rem; }
  td { color: var(--muted); line-height: 1.55; }
  td:first-child { color: var(--text); min-width: 170px; }
  td:first-child span { display: block; margin-top: 8px; color: var(--accent-dark); font-size: 0.82rem; font-weight: 850; }
  .year-row td { background: var(--accent-soft); color: var(--accent-dark); font-weight: 900; text-align: center; letter-spacing: 0.04em; }
  .note-card { padding: 26px; }
  .note-card h2 { margin-top: 0; }
  .note-card p { max-width: 920px; color: var(--muted); line-height: 1.7; }
  .links-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .links-row a { padding: 8px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-dark); font-weight: 850; text-decoration: none; }
  .links-row a:hover { text-decoration: none; background: rgba(29, 79, 145, 0.16); }
</style>
