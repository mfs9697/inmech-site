---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}/${path.replace(/^\/+/, '')}`;
}

const infoCards = [
  {
    label: 'Training level',
    value: 'DSc',
    text: 'training for applicants seeking the Doctor of Sciences degree'
  },
  {
    label: 'Research profile',
    value: 'Mechanics',
    text: 'research in solid mechanics and related areas of applied mathematics'
  },
  {
    label: 'Methodological support',
    value: 'SMC',
    text: 'coordination of educational, scientific and methodological issues'
  }
];

const doctoralStudents = [
  {
    name: 'Serhii V. Babenko',
    department: 'Department of Stability of Processes',
    profileHref: '/en/people/babenko-serhii/',
    topic: 'Multi-agent mechanical systems on time scales: variational modeling and control synthesis to ensure consolidated motion',
    consultant: 'Anatolii A. Martyniuk',
    consultantHref: '/en/people/martyniuk-anatolii/',
    videoHref: 'https://www.youtube.com/watch?v=mhghDKpHSdg'
  },
  {
    name: 'Yaroslav V. Pavliuk',
    department: 'Department of Mechanics of Creep',
    profileHref: '/en/people/pavliuk/',
    topic: 'Hereditary creep of linear and nonlinear hereditary viscoelastic materials under complex stress states',
    consultant: 'Ihor K. Senchenkov',
    consultantHref: '/en/people/senchenkov/',
    videoHref: 'https://www.youtube.com/watch?v=_ep5iTj9_IY'
  }
];

const relatedLinks = [
  {
    title: 'Scientific and Methodological Council',
    href: '/en/nmr/'
  },
  {
    title: 'Licences and regulations',
    href: '/en/license-and-regulations/'
  },
  {
    title: 'Dissertation defences',
    href: '/en/dissertations/'
  }
];
---

<BaseLayoutEn
  title={`Doctoral studies | ${siteEn.shortName}`}
  description="Doctoral studies at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine: admission rules, documents, methodological support and useful links."
  activePage="education"
>
  <section class="doctoral-hero">
    <div class="container doctoral-hero-grid">
      <div class="doctoral-hero-panel">
        <p class="eyebrow">Education and research training</p>
        <h1>Doctoral studies</h1>
        <p class="lead">
          Doctoral studies at the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine are aimed at
          training Doctors of Sciences, developing independent research, and strengthening the Institute’s
          scientific schools in mechanics and applied mathematics.
        </p>
        <div class="doctoral-hero-actions">
          <a class="button primary" href="#documents">Admission information</a>
          <a class="button secondary" href={withBase('/en/education/')}>Education and research training</a>
        </div>
      </div>

      <aside class="doctoral-mark-card" aria-label="Doctoral studies">
        <span>DSc</span>
        <h2>Training of Doctors of Sciences</h2>
        <p>A research trajectory for scholars with significant results and a well-developed research topic.</p>
      </aside>
    </div>
  </section>

  <section class="section doctoral-info-section">
    <div class="container">
      <div class="doctoral-info-grid">
        {infoCards.map((card) => (
          <article class="doctoral-info-card">
            <p>{card.label}</p>
            <span>{card.value}</span>
            <strong>{card.text}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section doctoral-cohort-section" id="doctoral-students-2026">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">2026 intake</p>
          <h2>Doctoral researchers</h2>
        </div>
        <p>Date of admission to doctoral studies: <strong>1 September 2026</strong>.</p>
      </div>

      <p class="doctoral-provisional-note">
        <strong>Provisional information:</strong> the dissertation topics and proposed academic
        supervisors (scientific consultants) shown below have not yet been formally approved
        by the Institute's Scientific Council.
      </p>

      <div class="doctoral-students-grid">
        {doctoralStudents.map((student) => (
          <article class="doctoral-student-card">
            <h3><a href={withBase(student.profileHref)}>{student.name}</a></h3>
            <p class="doctoral-student-department">{student.department}</p>
            <p><strong>Proposed dissertation topic:</strong> {student.topic}</p>
            <p>
              <strong>Proposed scientific consultant:</strong>{' '}
              <a href={withBase(student.consultantHref)}>{student.consultant}</a>
            </p>
            <a class="button secondary" href={student.videoHref} target="_blank" rel="noopener noreferrer">
              Watch the research seminar recording ↗
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>


  <section class="section" id="documents">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Information for applicants</p>
          <h2>Admission to doctoral studies</h2>
        </div>
        <p>
          General admission requirements, required documents and application review.
          Application deadlines and available places are announced separately.
        </p>
      </div>

      <div class="doctoral-rules-grid">
        <article class="doctoral-rule-card">
          <h3>General provisions</h3>
          <p>
            The S. P. Timoshenko Institute of Mechanics of the NAS of Ukraine provides training
            for the Doctor of Sciences degree under NAS of Ukraine Presidium Directive No. 448
            and applicable legislation. The Institute's research profile covers solid mechanics,
            theoretical mechanics and related areas of applied mathematics.
            Admission is available for the scientific specialties in which doctoral studies have been established.
          </p>
          <p>
            Training is <strong>full-time</strong> and normally lasts <strong>two years</strong>.
            Funding may be provided through state-funded places or by individuals or legal entities,
            subject to the applicable requirements.
          </p>
        </article>

        <article class="doctoral-rule-card">
          <h3>Eligibility</h3>
          <ul>
            <li>A Doctor of Philosophy degree or the Ukrainian Candidate of Sciences degree.</li>
            <li>Scientific achievements requiring completion or preparation as a doctoral dissertation or scientific report.</li>
            <li>Research publications related to the proposed topic amounting to at least half the number required by the Ministry of Education and Science for the Doctor of Sciences degree.</li>
            <li>A proposed research area aligned with the Institute's research profile and the relevant scientific specialty.</li>
          </ul>
        </article>

        <article class="doctoral-rule-card doctoral-rule-card-wide">
          <h3>Application documents</h3>
          <p>Applicants should prepare the following for their application and personal file:</p>
          <ul class="doctoral-documents-list">
            <li>An application addressed to the Director of the Institute.</li>
            <li>A personal personnel record form.</li>
            <li>Identity documents and a taxpayer identification number, where applicable.</li>
            <li>Copies of higher education and Doctor of Philosophy (Candidate of Sciences) diplomas.</li>
            <li>A copy of an academic title certificate, if held.</li>
            <li>A list of publications, scientific works and inventions, together with <strong>copies of publications relevant to the proposed dissertation</strong>.</li>
            <li>A detailed research proposal outlining the plan and work needed to prepare the research results for defence.</li>
            <li>An assessment of the applicant's scientific work prepared by an Institute researcher holding the Doctor of Sciences degree, including a proposal for scientific consultation.</li>
            <li>Documentation of a name change, if applicable, and photographs for the personal file.</li>
          </ul>
          <p>
            Original identity and degree documents must be presented for verification.
            Degrees obtained abroad are subject to applicable recognition rules.
            Applicants should confirm the final document checklist and submission method with
            the Institute before applying.
          </p>
        </article>

        <article class="doctoral-rule-card">
          <h3>Review and admission</h3>
          <ol>
            <li>The applicant's documents are considered by the relevant research department, which reviews them and hears a research presentation within one month of registration of the application.</li>
            <li>The department submits its conclusion to the Scientific Council and, if favourable, proposes a scientific consultant.</li>
            <li>At its next meeting, the Scientific Council reviews the department's conclusion, approves the dissertation topic, makes an admission decision and appoints a scientific consultant.</li>
            <li>Admission is formalised by an order of the Institute's Director.</li>
          </ol>
        </article>

        <article class="doctoral-rule-card">
          <h3>Schedule and research plan</h3>
          <p>
            The application period, review schedule and availability of places are determined
            separately for each admission cycle.{' '}
            <strong>Doctoral training begins on 1 September.</strong>
          </p>
          <p>
            After admission, the doctoral researcher agrees an individual research plan with
            their scientific consultant. The Scientific Council approves the plan{' '}
            <strong>within two months of admission</strong>.{' '}
            Research then follows the approved plan.
          </p>
          <p>
            Stipends for state-funded doctoral researchers, repeat state-funded admission,
            contractual terms and accommodation are governed by applicable legislation
            and the Institute's actual capacity.
          </p>
        </article>
      </div>

      <div class="doctoral-rules-source">
        <strong>Regulatory basis:</strong>{' '}
        <a href="https://zakon.rada.gov.ua/laws/show/261-2016-%D0%BF" target="_blank" rel="noopener noreferrer">
          Procedure for the training of Doctors of Philosophy and Doctors of Sciences (Cabinet of Ministers Resolution No. 261)
        </a>.{' '}
        This is information for applicants based on the Institute's previous admission rules and
        applicable regulations; it does not replace formally approved rules for a particular admission cycle.
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="related-panel">
        <div>
          <p class="eyebrow">Useful links</p>
          <h2>Related sections</h2>
        </div>
        <div class="related-link-grid">
          {relatedLinks.map((link) => (
            <a href={withBase(link.href)}>{link.title} →</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayoutEn>

<style>

  .doctoral-cohort-section {
    padding-top: 16px;
  }

  .doctoral-provisional-note {
    margin: 0 0 20px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--text);
    line-height: 1.6;
  }

  .doctoral-students-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .doctoral-student-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: clamp(22px, 3vw, 34px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .doctoral-student-card h3 {
    margin: 0;
    font-size: clamp(1.24rem, 2.1vw, 1.55rem);
  }

  .doctoral-student-card p {
    margin: 0;
    line-height: 1.55;
  }

  .doctoral-student-department {
    color: var(--muted);
  }

  .doctoral-student-card .button {
    margin-top: auto;
  }


  .doctoral-rules-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .doctoral-rule-card,
  .doctoral-rules-source {
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .doctoral-rule-card-wide {
    grid-column: 1 / -1;
  }

  .doctoral-rule-card h3 {
    margin: 0 0 16px;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .doctoral-rule-card p {
    margin: 0 0 14px;
    line-height: 1.65;
  }

  .doctoral-rule-card p:last-child {
    margin-bottom: 0;
  }

  .doctoral-rule-card ul,
  .doctoral-rule-card ol {
    margin: 0;
    padding-left: 22px;
  }

  .doctoral-rule-card li {
    margin-bottom: 10px;
    line-height: 1.6;
  }

  .doctoral-documents-list {
    columns: 2;
    column-gap: 38px;
  }

  .doctoral-documents-list li {
    break-inside: avoid;
  }

  .doctoral-rules-source {
    margin-top: 16px;
    background: var(--surface-soft);
    line-height: 1.6;
  }

  .doctoral-hero {
    padding: 52px 0 18px;
  }

  .doctoral-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }

  .doctoral-hero-panel,
  .doctoral-mark-card,
  .doctoral-info-card,
  .related-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .doctoral-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .doctoral-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.17), rgba(29, 79, 145, 0));
  }

  .doctoral-hero-panel h1,
  .doctoral-hero-panel .lead,
  .doctoral-hero-panel .eyebrow,
  .doctoral-hero-actions {
    position: relative;
    z-index: 1;
  }

  .doctoral-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .doctoral-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .doctoral-mark-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .doctoral-mark-card span {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 2rem;
    font-weight: 950;
  }

  .doctoral-mark-card h2 {
    margin: 0 0 12px;
    font-size: 1.7rem;
    line-height: 1.15;
  }

  .doctoral-mark-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .doctoral-info-section {
    padding-top: 16px;
  }

  .doctoral-info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .doctoral-info-card {
    padding: clamp(20px, 3vw, 30px);
  }

  .doctoral-info-card p {
    margin: 0 0 10px;
    color: var(--muted);
    font-weight: 750;
  }

  .doctoral-info-card span {
    display: block;
    margin-bottom: 12px;
    color: var(--accent-dark);
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    font-weight: 950;
    letter-spacing: -0.04em;
  }

  .doctoral-info-card strong {
    display: block;
    color: var(--text);
    line-height: 1.35;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 540px;
    margin: 0;
    color: var(--muted);
  }

  .related-panel {
    padding: clamp(22px, 3vw, 34px);
  }

  .related-panel h2 {
    margin-top: 0;
    font-size: clamp(1.45rem, 2.3vw, 2.1rem);
  }

  .related-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 22px;
    align-items: center;
  }

  .related-link-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .related-link-grid a {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--accent-dark);
    font-weight: 850;
  }

  .related-link-grid a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .doctoral-hero-grid,
    .doctoral-info-grid,
    .doctoral-rules-grid,
    .doctoral-students-grid,
    .related-panel,
    .related-link-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      display: block;
    }

    .section-heading p:last-child {
      margin-top: 10px;
    }
  }

  @media (max-width: 560px) {
    .doctoral-rule-card-wide {
      grid-column: auto;
    }

    .doctoral-documents-list {
      columns: 1;
    }

  }
</style>
