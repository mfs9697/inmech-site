---
import { getCollection } from 'astro:content';
import YearArchive from '../../../components/YearArchive.astro';
import { getInstituteNews, getInstituteNewsYears } from '../../../utils/newsArchive';
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import NewsCardEn from '../../../components/NewsCardEn.astro';
import { siteEn } from '../../../data/site-en';
import { allowedNewsTagsEn, getVisibleNewsTagsEn } from '../../../utils/newsTags';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const allNews = await getCollection('news');
const news = getInstituteNews(allNews);
const years = getInstituteNewsYears(allNews);

const tags = allowedNewsTagsEn.filter((tag) => news.some((entry) => getVisibleNewsTagsEn(entry).includes(tag)));
---

<BaseLayoutEn
  title={`News | ${siteEn.name}`}
  description="News and announcements of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine across all available years."
  activePage="news"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">News</p>
        <h1>Institute news</h1>
        <p class="lead">
          All published Institute news across available years. Select a year or browse by tag.
        </p>

        <YearArchive years={years} lang="en" />

        {tags.length > 0 && (
          <nav class="tag-nav" aria-label="Filter news by tags">
            <a class="tag-filter active" href={withBase('/en/news/')}>All news</a>
            {tags.map((tag) => (
              <a class="tag-filter" href={withBase(`/en/news/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
            ))}
          </nav>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {news.length > 0 ? (
        <div class="news-list">
          {news.map((entry) => <NewsCardEn entry={entry} />)}
        </div>
      ) : (
        <div class="empty-news-panel">
          <h2>No Institute news has been added yet</h2>
        </div>
      )}
    </div>
  </section>
</BaseLayoutEn>

<style>
  .tag-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .tag-filter {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 750;
    text-decoration: none;
  }

  .tag-filter:hover,
  .tag-filter.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    text-decoration: none;
  }

  .empty-news-panel {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .empty-news-panel h2 {
    margin-top: 0;
  }
</style>
