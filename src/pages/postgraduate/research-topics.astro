---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const topicGroups = [
  {
    year: '2025',
    rows: [
      {
        student: 'Прощенко О. А.',
        studyYears: 'вступ 2025',
        topic: 'Плоскі задачі руйнування матеріалів при стиску вздовж паралельних тріщин зі зміщеними в напрямку стиску центрами',
        supervisor: 'Назаренко Володимир Михайлович, академік НАН України, в.о. директора Інституту механіки ім. С. П. Тимошенка НАН України'
      },
      {
        student: 'Грисевич Р. Ю.',
        studyYears: 'вступ 2025',
        topic: 'Теоретико-експериментальне моделювання деформування елементів протеза кисті руки при статичних, квазістатичних та динамічних навантаженнях',
        supervisor: 'Максимюк В. А., доктор фізико-математичних наук, провідний науковий співробітник'
      },
      {
        student: 'Назарчук Ю. О.',
        studyYears: 'вступ 2025',
        topic: 'Моделювання руйнування дорожніх покриттів та інтерфейсів сумішей із використанням когезійних моделей і в’язкопружності',
        supervisor: 'Селіванов Михайло Федорович, член-кореспондент НАН України, доктор фізико-математичних наук, заступник директора з наукової роботи'
      },
      {
        student: 'Синявський О. І.',
        studyYears: 'вступ 2025',
        topic: 'Стиск тонкоплівкових систем вздовж межі поділу плівки і підкладки обмеженої товщини',
        supervisor: 'Назаренко Володимир Михайлович, академік НАН України, в.о. директора Інституту механіки ім. С. П. Тимошенка НАН України'
      }
    ]
  },
  {
    year: '2024',
    rows: [
      {
        student: 'Серафимович Р. В.',
        studyYears: 'вступ 2024',
        topic: 'Фізично нелінійні задачі для тришарової циліндричної оболонки з отворами',
        supervisor: 'Сторожук Євген Анатолійович, член-кореспондент НАН України, доктор фізико-математичних наук, професор, заступник завідувача відділу'
      },
      {
        student: 'Філь Є.',
        studyYears: 'вступ 2024',
        topic: 'Чисельний аналіз напружено-деформованого стану пологих ортотропних оболонок непрямокутних в плані',
        supervisor: 'Григоренко Олександр Ярославович, завідувач відділу обчислювальних методів, академік НАН України, доктор фізико-математичних наук, професор'
      },
      {
        student: 'Усов В. О.',
        studyYears: 'вступ 2024',
        topic: 'Чисельне моделювання термомеханічних процесів друку тіл обертання шарами в’язкопластичного матеріалу',
        supervisor: 'Сенченков Ігор Константинович, доктор фізико-математичних наук, головний науковий співробітник'
      }
    ]
  },
  {
    year: '2023',
    rows: [
      {
        student: 'Горський Ю. В.',
        studyYears: 'вступ 2023',
        topic: 'Генерування хрестоподібних поверхневих хвиль у воді в циліндричній ємності з вібруючими стінками при випромінюванні звуку',
        supervisor: 'Жук Ярослав Олександрович, доктор фізико-математичних наук, член-кореспондент НАН України, професор'
      },
      {
        student: 'Кобзар П. Ю.',
        studyYears: 'вступ 2023',
