---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const docHref = (href: string) => href.startsWith('/documents/') ? withBase(href) : href;

const chair = {
  name: 'Остос Олександр Хосейович',
  role: 'Голова Ради молодих вчених',
  degree: 'доктор філософії за спеціальністю 113 «Прикладна математика»',
  email: 'ostos.alexander1994@gmail.com',
  photo: '/people/ostos.png'
};

const members = [
  { name: 'Кіпніс Олександр Леонідович', role: 'старший науковий співробітник', degree: 'доктор фізико-математичних наук', photo: '/people/kipnis.png' },
  { name: 'Орленко Сергій Петрович', role: 'старший науковий співробітник', degree: 'Ph.D. (доктор філософії) за спеціальністю 113 «Прикладна математика»', photo: '/people/orlenko.png' },
  { name: 'Юрчук Василь Миколайович', role: 'заступник завідувача відділу', degree: 'доктор фізико-математичних наук', photo: '/people/yurchuk.png' },
  { name: 'Назарчук Юрій Олександрович', role: 'аспірант', degree: '', photo: '/people/nazarchuk.png' },
  { name: 'Остос Олександр Хосейович', role: 'старший науковий співробітник', degree: 'Ph.D. (доктор філософії) за спеціальністю 113 «Прикладна математика»', photo: '/people/ostos.png', accent: 'Голова Ради' },
  { name: 'Гусак Віталій Олександрович', role: 'старший науковий співробітник', degree: 'Ph.D. (доктор філософії) за спеціальністю 113 «Прикладна математика»' },
  { name: 'Борисенко Максим Юрійович', role: 'старший науковий співробітник', degree: 'доктор технічних наук', photo: '/people/borysenko.png' },
  { name: 'Лисенко Анна Володимирівна', role: 'молодший науковий співробітник', degree: '' },
  { name: 'Селіванов Данило Михайлович', role: 'аспірант', degree: '', photo: '/people/selivanovd.png' },
  { name: 'Лесик Олексій Іванович', role: 'аспірант', degree: '', photo: '/people/lesyk.png' },
  { name: 'Кобзарь Петро Юрійович', role: 'аспірант', degree: '', photo: '/people/kobzar.png' },
  { name: 'Ольховський Антон Стефанович', role: 'аспірант', degree: '', photo: '/people/olkhovskyi.png' },
  { name: 'Прощенко Олександр Анатолійович', role: 'аспірант', degree: '', photo: '/people/proshchenko.png' }
];

const directions = [
  'Підтримка наукової діяльності, професійного розвитку та кар’єрного зростання молодих учених.',
  'Інформаційна підтримка щодо грантів, стипендій, конференцій, шкіл, конкурсів та інших можливостей.',
  'Сприяння участі молодих науковців у конференціях, семінарах, школах та науково-освітніх заходах.',
  'Представлення інтересів молодих учених у межах Інституту, НАН України та ширшої наукової спільноти.'
];

const documents = [
  { title: 'Положення про Раду молодих вчених НАН України', href: '/documents/young-scientists/regulations/nasu-young-scientists-council-regulation.pdf' },
  { title: 'Положення про Раду молодих вчених Інституту механіки ім. С. П. Тимошенка НАН України', href: '/documents/young-scientists/regulations/institute-young-scientists-council-regulation.pdf' },
  { title: 'Закон України «Про наукову і науково-технічну діяльність»', href: '/documents/young-scientists/regulations/scientific-and-technical-activity-law.pdf' }
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}
function initials(name: string) {
  return name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
}
---

<BaseLayout
  title={`Рада молодих вчених | ${site.shortName}`}
  description="Рада молодих вчених Інституту механіки ім. С. П. Тимошенка НАН України: керівництво, склад, напрями діяльності та документи."
  activePage="departments"
>
  <section class="young-hero">
    <div class="container young-hero-grid">
      <div class="young-hero-card">
        <p class="eyebrow">Структура Інституту</p><h1>Рада молодих вчених</h1>
        <p class="lead">Рада молодих вчених Інституту механіки ім. С. П. Тимошенка НАН України сприяє професійному розвитку молодих науковців, аспірантів і докторів філософії, підтримує їхню участь у науковій, освітній та організаційній діяльності Інституту.</p>
      </div>
      <aside class="young-chair-card" aria-labelledby="young-chair-title">
        <div class="young-chair-photo-frame"><img src={withBase(chair.photo)} alt={`Фото: ${chair.name}`} class="young-chair-photo" loading="lazy" /></div>
        <div><p class="management-accent">Голова Ради</p><h2 id="young-chair-title">{chair.name}</h2><p class="young-chair-degree">{chair.degree}</p><p class="young-chair-email"><span>E-mail:</span><a href={`mailto:${chair.email}`}>{chair.email}</a></p></div>
      </aside>
    </div>
  </section>

  <section class="young-section">
    <div class="container young-layout">
      <article class="young-panel">
        <h2>Основні напрями діяльності</h2><p>Рада сприяє залученню молодих учених до активної дослідницької роботи, розвитку професійних контактів, поширенню інформації про наукові події, гранти, конкурси, стипендії та можливості для академічного зростання.</p>
        <div class="direction-grid">{directions.map((item) => (<div class="direction-card">{item}</div>))}</div>
      </article>

      <article class="young-panel">
        <div class="section-heading-row"><div><h2>Склад Ради</h2><p class="section-note">Станом на січень 2026 р. до складу Ради входять 13 осіб.</p></div></div>
        <div class="management-grid young-members-grid">
          {members.map((person) => (
            <article class={`management-card young-member-card ${person.accent ? 'young-chair-member' : ''}`}>
              <div class="management-avatar-frame">
                {person.photo && (<img src={withBase(person.photo)} alt={`Фото: ${person.name}`} class="management-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />)}
                <div class={`management-avatar ${person.photo ? 'avatar-fallback' : ''}`} aria-hidden="true">{initials(person.name)}</div>
              </div>
              <div class="management-body">{person.accent && <p class="management-accent">{person.accent}</p>}<h2>{person.name}</h2><p class="management-role">{person.role}</p>{person.degree && <p class="management-degree">{person.degree}</p>}</div>
            </article>
          ))}
        </div>
      </article>

      <article class="young-panel"><h2>Нормативна основа діяльності</h2><p>Рада у своїй діяльності керується чинним законодавством України, Статутом НАН України та Інституту, постановами і розпорядженнями Президії НАН України, наказами директора та рішеннями Вченої ради, Положенням про Раду молодих вчених НАН України і Положенням про Раду молодих вчених Інституту.</p></article>

      <article class="young-panel"><h2>Документи</h2><ul class="document-list">{documents.map((document) => (<li><a href={docHref(document.href)} target="_blank" rel="noopener noreferrer">{document.title}</a></li>))}</ul></article>
    </div>
  </section>
</BaseLayout>

<style>
  .young-hero{padding:52px 0 26px}.young-hero-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(340px,.75fr);gap:24px;align-items:stretch}.young-hero-card,.young-chair-card,.young-panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.young-hero-card{padding:clamp(28px,4vw,46px)}.young-hero-card h1{margin:0 0 18px;font-size:clamp(2.05rem,4vw,3.5rem);line-height:1.05;letter-spacing:-.035em}.young-chair-card{display:grid;grid-template-columns:118px minmax(0,1fr);gap:22px;align-items:start;padding:clamp(22px,3vw,30px)}.young-chair-card>div:last-child{min-width:0}.young-chair-photo-frame,.young-chair-photo{width:118px;height:140px;border-radius:24px}.young-chair-photo-frame{border:1px solid var(--line);overflow:hidden;background:var(--surface-soft)}.young-chair-photo{display:block;object-fit:cover}.young-chair-card h2{margin:0 0 10px;font-size:1.28rem;line-height:1.25}.young-chair-degree{margin:0 0 14px;color:var(--muted);font-weight:700}.young-chair-email{display:flex;flex-wrap:wrap;gap:4px 6px;align-items:baseline;margin:0}.young-chair-email span{flex:0 0 auto;margin-right:0;font-weight:850;white-space:nowrap}.young-chair-email a{min-width:0;max-width:100%;overflow-wrap:anywhere;word-break:break-word}.young-section{padding:22px 0 64px}.young-layout{display:grid;gap:22px}.young-panel{padding:clamp(22px,3vw,32px)}.young-panel h2{margin:0 0 14px;font-size:clamp(1.35rem,2vw,1.8rem);letter-spacing:-.02em}.young-panel p{margin:0;color:var(--muted)}.direction-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:22px}.direction-card{min-height:100%;padding:16px 18px;border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:14px;background:var(--surface-soft);color:var(--text);font-weight:600}.section-heading-row{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:18px}.section-note{margin-top:4px!important}.young-member-card{min-height:100%}.young-chair-member{border-color:rgba(184,135,47,.45)}.document-list{list-style:none;padding:0;margin:0;display:grid;gap:12px}.document-list a{display:block;padding:15px 18px;border:1px solid var(--line);border-radius:14px;background:var(--surface-soft);font-weight:750}.document-list a:hover{text-decoration:none;background:var(--accent-soft)}@media(max-width:900px){.young-hero-grid,.direction-grid{grid-template-columns:1fr}}@media(max-width:560px){.young-chair-card{grid-template-columns:1fr}}
</style>
