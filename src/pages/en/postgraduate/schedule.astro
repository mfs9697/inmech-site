---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import PostgraduateSchedule from '../../../components/PostgraduateSchedule.astro';
import { siteEn } from '../../../data/site-en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayoutEn
  title={`Postgraduate class schedule 2026–2027 | ${siteEn.shortName}`}
  description="Postgraduate class schedule for years 1, 2 and 3, academic year 2026–2027: dates, times, courses and instructors."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={base + '/en/postgraduate/'}>Postgraduate studies</a><span>›</span><span>Class schedule</span>
    </nav>
    <header class="page-hero">
      <p class="eyebrow">Postgraduate studies</p>
      <h1>Class schedule 2026–2027</h1>
      <p class="lead">Choose the year of study and month to find class dates and times. Each card shows the instructor's full name and a link to their profile.</p>
    </header>
    <PostgraduateSchedule lang="en" />
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page { max-width: 1180px; margin: 0 auto; padding: 46px 20px 72px; }
  .breadcrumbs { display: flex; gap: 10px; align-items: center; margin-bottom: 22px; color: var(--muted); font-weight: 750; }
  .page-hero { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); padding: clamp(26px, 5vw, 48px); }
  .page-hero h1 { margin: 0 0 15px; font-size: clamp(2rem, 4.5vw, 3.8rem); line-height: 1.09; letter-spacing: -.035em; }
  .lead { max-width: 860px; color: var(--muted); font-size: 1.06rem; line-height: 1.65; margin-bottom: 0; }
  @media (max-width: 540px) { .postgraduate-page { padding: 24px 14px 55px; } }
</style>
