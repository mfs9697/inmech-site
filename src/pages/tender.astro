---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const edrpou = '05417070';
const prozorroSearchUrl = `https://prozorro.gov.ua/uk/search/tender?text=${edrpou}`;
---

<BaseLayout
  title={`Закупівлі та тендери | ${site.name}`}
  description="Закупівлі та тендери Інституту механіки ім. С.П. Тимошенка НАН України. Інформація з електронної системи публічних закупівель Prozorro."
  activePage="about"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel tender-hero-panel">
        <p class="eyebrow">Про інститут</p>
        <h1>Закупівлі та тендери</h1>
        <p class="lead">
          На цій сторінці подано інформацію про закупівлі Інституту механіки
          ім. С. П. Тимошенка НАН України з електронної системи публічних закупівель Prozorro.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel tender-widget-panel">
        <div class="section-header compact-header">
          <div>
            <p class="eyebrow">Prozorro</p>
            <h2 class="section-title">Закупівлі установи</h2>
            <p class="section-text">
              Віджет налаштовано за кодом ЄДРПОУ Інституту: <strong>{edrpou}</strong>.
              Якщо віджет не завантажився, скористайтеся кнопкою переходу до Prozorro.
            </p>
          </div>
          <a class="button secondary" href={prozorroSearchUrl} target="_blank" rel="noopener">
            Відкрити в Prozorro
          </a>
        </div>

        <div class="tender-widget-frame" id="prom_state_purchase"></div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="panel tender-note">
        <p class="eyebrow">Примітка</p>
        <h2>Джерело даних</h2>
        <p>
          Дані відображаються через зовнішній віджет системи публічних закупівель.
          У разі потреби можна перейти до Prozorro й уточнити пошук за кодом ЄДРПОУ,
          роком, статусом закупівлі або ключовими словами.
        </p>
      </article>
    </div>
  </section>

  <script is:inline>
    var _zk_uaprom = window._zk_uaprom || [];
    window._zk_uaprom = _zk_uaprom;

    _zk_uaprom.push(
      ['APP_ID', '42fce870-4490-41e0-a744-f14cdaa0d393'],
      ['CONTAINER_ID', 'prom_state_purchase'],
      ['LOCALE', 'uk'],
      ['ENTITYTYPE', 0],
      ['SRN', ['05417070']]
    );

    (function (d, tag, id) {
      if (d.getElementById(id)) return;
      var script = d.createElement(tag);
      script.id = id;
      script.type = 'text/javascript';
      script.src = 'https://zk-cabinet.c.prom.st/js/build/zakupki_widget_init_v2/zakupki_widget_init_v2_wp.d7ecb.js';
      script.async = true;
      var firstScript = d.getElementsByTagName(tag)[0];
      firstScript.parentNode.insertBefore(script, firstScript);
    })(document, 'script', 'zakupki_uaprom_id');
  </script>
</BaseLayout>
