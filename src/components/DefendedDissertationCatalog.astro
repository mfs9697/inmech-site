---
import { defendedDissertationsA } from '../data/defendedDissertationsA';
import { defendedDissertationsB } from '../data/defendedDissertationsB';
import { defendedDissertationsV } from '../data/defendedDissertationsV';
import { defendedDissertationsG } from '../data/defendedDissertationsG';
import { defendedDissertationsD } from '../data/defendedDissertationsD';
import { defendedDissertationsE } from '../data/defendedDissertationsE';
import { defendedDissertationsZh } from '../data/defendedDissertationsZh';
import { defendedDissertationsZ } from '../data/defendedDissertationsZ';
import { defendedDissertationsI } from '../data/defendedDissertationsI';
import { defendedDissertationsK } from '../data/defendedDissertationsK';
import { defendedDissertationsL } from '../data/defendedDissertationsL';
import { defendedDissertationsM } from '../data/defendedDissertationsM';
import { defendedDissertationsN } from '../data/defendedDissertationsN';
import { defendedDissertationsO } from '../data/defendedDissertationsO';
import { defendedDissertationsP } from '../data/defendedDissertationsP';
import { defendedDissertationsR } from '../data/defendedDissertationsR';
import { defendedDissertationsS1 } from '../data/defendedDissertationsS1';
import { defendedDissertationsS2 } from '../data/defendedDissertationsS2';
import { defendedDissertationsT } from '../data/defendedDissertationsT';
import { defendedDissertationsU } from '../data/defendedDissertationsU';
import { defendedDissertationsF } from '../data/defendedDissertationsF';
import { defendedDissertationsKh } from '../data/defendedDissertationsKh';
import { defendedDissertationsTs } from '../data/defendedDissertationsTs';
import { defendedDissertationsCh } from '../data/defendedDissertationsCh';
import { defendedDissertationsSh } from '../data/defendedDissertationsSh';
import { defendedDissertationsShch } from '../data/defendedDissertationsShch';
import { defendedDissertationsEe } from '../data/defendedDissertationsEe';
import { defendedDissertationsYu } from '../data/defendedDissertationsYu';
import { defendedDissertationsYa } from '../data/defendedDissertationsYa';
import { defendedDissertationArchiveAdditionsUk } from '../data/defendedDissertationArchiveAdditions';
import {
  defendedDissertationTopics,
  defendedDissertationTopicLimit,
  matchDefendedDissertationTopics
} from '../data/defendedDissertationTopics';

const defendedDissertationsS = [...defendedDissertationsS1, ...defendedDissertationsS2];

const baseCatalog = [
  { letter: 'А', items: defendedDissertationsA },
  { letter: 'Б', items: defendedDissertationsB },
  { letter: 'В', items: defendedDissertationsV },
  { letter: 'Г', items: defendedDissertationsG },
  { letter: 'Д', items: defendedDissertationsD },
  { letter: 'Е', items: defendedDissertationsE },
  { letter: 'Ж', items: defendedDissertationsZh },
  { letter: 'З', items: defendedDissertationsZ },
  { letter: 'И', items: defendedDissertationsI },
  { letter: 'К', items: defendedDissertationsK },
  { letter: 'Л', items: defendedDissertationsL },
  { letter: 'М', items: defendedDissertationsM },
  { letter: 'Н', items: defendedDissertationsN },
  { letter: 'О', items: defendedDissertationsO },
  { letter: 'П', items: defendedDissertationsP },
  { letter: 'Р', items: defendedDissertationsR },
  { letter: 'С', items: defendedDissertationsS },
  { letter: 'Т', items: defendedDissertationsT },
  { letter: 'У', items: defendedDissertationsU },
  { letter: 'Ф', items: defendedDissertationsF },
  { letter: 'Х', items: defendedDissertationsKh },
  { letter: 'Ц', items: defendedDissertationsTs },
  { letter: 'Ч', items: defendedDissertationsCh },
  { letter: 'Ш', items: defendedDissertationsSh },
  { letter: 'Щ', items: defendedDissertationsShch },
  { letter: 'Э', items: defendedDissertationsEe },
  { letter: 'Ю', items: defendedDissertationsYu },
  { letter: 'Я', items: defendedDissertationsYa }
];

const catalog = baseCatalog.map((group) => ({
  ...group,
  items: [
    ...group.items,
    ...defendedDissertationArchiveAdditionsUk.filter((item) => item.name.startsWith(group.letter))
  ].sort((a, b) => a.name.localeCompare(b.name, 'uk', { sensitivity: 'base' }))
}));

const allCatalogItems = catalog.flatMap((group) => group.items);
const totalItems = allCatalogItems.length;
const candidateDegreePattern = /к\.ф\.-?м\.н\.|к\.т\.н\./i;
const doctoralDegreePattern = /д\.ф\.-?м\.н\.|д\.т\.н\./i;
const candidateCount = allCatalogItems.filter((item) => candidateDegreePattern.test(item.details)).length;
const doctoralCount = allCatalogItems.filter((item) => doctoralDegreePattern.test(item.details)).length;
const otherCount = Math.max(totalItems - candidateCount - doctoralCount, 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

function normalizeDefenceDate(value: string) {
  const parts = value.split('.');
  if (parts.length !== 3 || parts[2].length !== 2) return value;

  const shortYear = Number(parts[2]);
  const fullYear = shortYear < 30 ? 2000 + shortYear : 1900 + shortYear;
  return `${parts[0]}.${parts[1]}.${fullYear}`;
}

function dissertationCardMeta(item: { title: string; details: string }) {
  const source = `${item.title} ${item.details}`;
  const isoDefenceMatch = source.match(/(?:дата\s+)?захисту?\s+(\d{4})-(\d{2})-(\d{2})/i);
  const legacyDefenceMatch = source.match(/(?:Захист|Защита)\s+(\d{1,2}\.\d{1,2}\.\d{2,4}|\d{4})/i);
  const defenceDate = isoDefenceMatch
    ? `${isoDefenceMatch[3]}.${isoDefenceMatch[2]}.${isoDefenceMatch[1]}`
    : legacyDefenceMatch
      ? normalizeDefenceDate(legacyDefenceMatch[1])
      : null;
  const yearFromDefence = defenceDate?.match(/\b(19|20)\d{2}\b/)?.[0] ?? null;
  const allYears = Array.from(source.matchAll(/\b(19|20)\d{2}\b/g), (match) => match[0]);
  const year = yearFromDefence ?? allYears.at(-1) ?? null;

  const degree =
    /доктора\s+філософії/i.test(source)
      ? 'доктор філософії'
      : /д\.\s*ф\.-?\s*м\.н\./i.test(source)
      ? 'доктор фізико-математичних наук'
      : /д\.\s*т\.н\./i.test(source)
        ? 'доктор технічних наук'
        : /к\.\s*ф\.-?\s*м\.н\./i.test(source)
          ? 'кандидат фізико-математичних наук'
          : /к\.\s*т\.н\./i.test(source)
            ? 'кандидат технічних наук'
            : null;

  const specialty =
    source.match(/[кд]\.\s*(?:ф\.-?\s*м|т)\.н\.\s+(\d{2}\.\d{2}\.\d{2})/i)?.[1] ??
    source.match(/спеціальн(?:ість|ості)\s+(\d{3})/i)?.[1] ??
    null;
  const pagesMatch = source.match(/[–—-]\s*(\d+)\s*([сл])\./i);
  const pages = pagesMatch ? `${pagesMatch[1]} ${pagesMatch[2]}.` : null;

  return { defenceDate, degree, specialty, pages, year };
}

const topicOptions = defendedDissertationTopics
  .slice(0, defendedDissertationTopicLimit)
  .sort((a, b) => a.uk.localeCompare(b.uk, 'uk', { sensitivity: 'base' }));
const topicLabelById = new Map(defendedDissertationTopics.map((topic) => [topic.id, topic.uk]));
const catalogRecords = catalog.flatMap((group) =>
  group.items.map((item) => ({
    item,
    letter: group.letter,
    meta: dissertationCardMeta(item),
    topicIds: matchDefendedDissertationTopics(`${item.title} ${item.details}`)
  }))
);
const recordsByYear = new Map<string, typeof catalogRecords>();

catalogRecords.forEach((record) => {
  const year = record.meta.year ?? 'Рік не визначено';
  const records = recordsByYear.get(year) ?? [];
  records.push(record);
  recordsByYear.set(year, records);
});

const yearGroups = Array.from(recordsByYear, ([year, records]) => ({ year, records })).sort((a, b) => {
  const aYear = Number(a.year);
  const bYear = Number(b.year);
  if (Number.isNaN(aYear)) return 1;
  if (Number.isNaN(bYear)) return -1;
  return bYear - aYear;
});
---

<section class="section" id="defended-catalog">
  <div class="container">
    <div class="section-heading compact-header">
      <div>
        <p class="eyebrow">Каталог</p>
        <h2>Захищені дисертації</h2>
      </div>
      <p>
        Каталог містить {totalItems} бібліографічних записів, згрупованих за першою літерою
        прізвища здобувача. Для швидкого переходу скористайтеся алфавітною навігацією.
      </p>
    </div>

    <div class="catalog-summary-grid" aria-label="Стислий підсумок каталогу захищених дисертацій">
      <article class="catalog-stat-card">
        <span>{totalItems}</span>
        <strong>бібліографічних записів</strong>
        <p>У повному каталозі зібрано історичні записи про захищені дисертації.</p>
      </article>
      <article class="catalog-stat-card">
        <span>{candidateCount}</span>
        <strong>кандидатських дисертацій</strong>
        <p>Записи, у яких у бібліографічних даних зазначено ступінь кандидата наук.</p>
      </article>
      <article class="catalog-stat-card">
        <span>{doctoralCount}</span>
        <strong>докторських дисертацій</strong>
        <p>Записи, у яких у бібліографічних даних зазначено ступінь доктора наук.</p>
      </article>
      <article class="catalog-stat-card">
        <span>{otherCount}</span>
        <strong>інших записів</strong>
        <p>Матеріали або записи, для яких ступінь не визначено автоматично.</p>
      </article>
    </div>

    <div class="catalog-controls-panel" aria-labelledby="catalog-controls-heading">
      <div class="catalog-controls-heading">
        <div>
          <p class="eyebrow">Перегляд каталогу</p>
          <h3 id="catalog-controls-heading">Групування та тематика</h3>
        </div>
        <p>Оберіть спосіб групування та одну з 40 основних тем досліджень.</p>
      </div>
      <div class="catalog-controls">
        <fieldset class="view-switch">
          <legend>Групування</legend>
          <div class="segmented-control">
            <button type="button" class="is-active" data-view-button="surname" aria-pressed="true">За прізвищем</button>
            <button type="button" data-view-button="year" aria-pressed="false">За роком</button>
          </div>
        </fieldset>
        <label class="topic-filter" for="uk-topic-filter">
          Тема дослідження
          <select id="uk-topic-filter" data-topic-filter>
            <option value="__all__">Усі 40 тем</option>
            {topicOptions.map((topic) => <option value={topic.id}>{topic.uk}</option>)}
          </select>
        </label>
      </div>
      <p class="catalog-filter-status" data-filter-status>{totalItems} записів · за прізвищем</p>
    </div>

    <nav class="diss-alpha-nav" data-surname-navigation aria-label="Алфавітна навігація каталогу захищених дисертацій">
      {catalog.map((group) => (
        <a href={`#catalog-${group.letter}`}>{group.letter}</a>
      ))}
    </nav>

    <div class="diss-note">
      <strong>Навігація.</strong> У цьому розділі подано бібліографічний каталог захищених дисертацій.
      Матеріали окремих захистів — дисертації, автореферати, відгуки та відеозаписи — розміщено
      на сторінці <a href={withBase('/dissertations/')}>«Захист дисертацій»</a>.
    </div>

    <div class="diss-groups" data-catalog-view="surname">
      {catalog.map((group) => (
        <section class="diss-letter-group" id={`catalog-${group.letter}`} data-catalog-group>
          <div class="diss-letter-header">
            <h3>{group.letter}</h3>
            <span data-group-count>{group.items.length} записів</span>
          </div>

          <div class="diss-card-grid">
            {group.items.map((item) => {
              const meta = dissertationCardMeta(item);
              const topicIds = matchDefendedDissertationTopics(`${item.title} ${item.details}`);

              return (
                <article class="catalog-entry-card" data-entry-card data-entry-topics={topicIds.join('|')}>
                  <div class="entry-header">
                    <div>
                      <h4>{item.name}</h4>
                      <p class="entry-title">{item.title}</p>
                    </div>
                    {meta.year && <span class="entry-year">{meta.year}</span>}
                  </div>

                  <dl class="entry-meta-grid">
                    {meta.defenceDate && (
                      <div>
                        <dt>Дата захисту</dt>
                        <dd>{meta.defenceDate}</dd>
                      </div>
                    )}
                    {meta.degree && (
                      <div>
                        <dt>Ступінь</dt>
                        <dd>{meta.degree}</dd>
                      </div>
                    )}
                    {meta.specialty && (
                      <div>
                        <dt>Спеціальність</dt>
                        <dd>{meta.specialty}</dd>
                      </div>
                    )}
                    {meta.pages && (
                      <div>
                        <dt>Обсяг</dt>
                        <dd>{meta.pages}</dd>
                      </div>
                    )}
                  </dl>

                  {topicIds.length > 0 && (
                    <div class="tag-list" aria-label="Ключові слова">
                      {topicIds.map((topicId) => <span>{topicLabelById.get(topicId)}</span>)}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <div class="diss-groups" data-catalog-view="year" hidden>
      {yearGroups.map((group) => (
        <section class="diss-letter-group" data-catalog-group>
          <div class="diss-letter-header">
            <h3>{group.year}</h3>
            <span data-group-count>{group.records.length} записів</span>
          </div>

          <div class="diss-card-grid">
            {group.records.map(({ item, meta, topicIds }) => (
              <article class="catalog-entry-card" data-entry-card data-entry-topics={topicIds.join('|')}>
                <div class="entry-header">
                  <div>
                    <h4>{item.name}</h4>
                    <p class="entry-title">{item.title}</p>
                  </div>
                  {meta.year && <span class="entry-year">{meta.year}</span>}
                </div>

                <dl class="entry-meta-grid">
                  {meta.defenceDate && (
                    <div>
                      <dt>Дата захисту</dt>
                      <dd>{meta.defenceDate}</dd>
                    </div>
                  )}
                  {meta.degree && (
                    <div>
                      <dt>Ступінь</dt>
                      <dd>{meta.degree}</dd>
                    </div>
                  )}
                  {meta.specialty && (
                    <div>
                      <dt>Спеціальність</dt>
                      <dd>{meta.specialty}</dd>
                    </div>
                  )}
                  {meta.pages && (
                    <div>
                      <dt>Обсяг</dt>
                      <dd>{meta.pages}</dd>
                    </div>
                  )}
                </dl>

                {topicIds.length > 0 && (
                  <div class="tag-list" aria-label="Ключові слова">
                    {topicIds.map((topicId) => <span>{topicLabelById.get(topicId)}</span>)}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  const viewButtons = Array.from(document.querySelectorAll('[data-view-button]'));
  const catalogueViews = Array.from(document.querySelectorAll('[data-catalog-view]'));
  const topicFilter = document.querySelector('[data-topic-filter]');
  const filterStatus = document.querySelector('[data-filter-status]');
  const surnameNavigation = document.querySelector('[data-surname-navigation]');
  const allTopicsValue = '__all__';
  let activeView = 'surname';
  let selectedTopic = allTopicsValue;

  function recordLabel(count) {
    const mod100 = count % 100;
    const mod10 = count % 10;
    const noun = mod100 >= 11 && mod100 <= 14 ? 'записів' : mod10 === 1 ? 'запис' : mod10 >= 2 && mod10 <= 4 ? 'записи' : 'записів';
    return `${count} ${noun}`;
  }

  function applyCatalogueState() {
    let visibleTotal = 0;

    catalogueViews.forEach((view) => {
      const isActive = view.dataset.catalogView === activeView;
      view.hidden = !isActive;
      if (!isActive) return;

      view.querySelectorAll('[data-entry-card]').forEach((card) => {
        const topics = (card.dataset.entryTopics || '').split('|').filter(Boolean);
        const isVisible = selectedTopic === allTopicsValue || topics.includes(selectedTopic);
        card.hidden = !isVisible;
        if (isVisible) visibleTotal += 1;
      });

      view.querySelectorAll('[data-catalog-group]').forEach((group) => {
        const visibleCards = Array.from(group.querySelectorAll('[data-entry-card]')).filter((card) => !card.hidden).length;
        const count = group.querySelector('[data-group-count]');
        group.hidden = visibleCards === 0;
        if (count) count.textContent = recordLabel(visibleCards);
      });
    });

    viewButtons.forEach((button) => {
      const isActive = button.dataset.viewButton === activeView;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });

    if (surnameNavigation) surnameNavigation.hidden = activeView !== 'surname';

    if (filterStatus) {
      const topicLabel = topicFilter?.selectedOptions?.[0]?.textContent;
      const groupingLabel = activeView === 'year' ? 'за роком' : 'за прізвищем';
      filterStatus.textContent =
        selectedTopic === allTopicsValue
          ? `${recordLabel(visibleTotal)} · ${groupingLabel}`
          : `${recordLabel(visibleTotal)} · ${topicLabel} · ${groupingLabel}`;
    }
  }

  viewButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeView = button.dataset.viewButton || 'surname';
      applyCatalogueState();
    });
  });

  topicFilter?.addEventListener('change', (event) => {
    selectedTopic = event.target.value || allTopicsValue;
    applyCatalogueState();
  });

  applyCatalogueState();
</script>

<style>
  .catalog-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
  }

  .catalog-stat-card {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .catalog-stat-card span {
    display: block;
    margin-bottom: 8px;
    color: var(--accent);
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .catalog-stat-card strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 1.02rem;
  }

  .catalog-stat-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .catalog-controls-panel {
    display: grid;
    gap: 18px;
    margin: 24px 0 18px;
    padding: clamp(20px, 3vw, 28px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .catalog-controls-heading {
    display: grid;
    grid-template-columns: minmax(220px, 0.55fr) minmax(0, 1fr);
    gap: 18px;
    align-items: end;
  }

  .catalog-controls-heading h3,
  .catalog-controls-heading p,
  .catalog-filter-status {
    margin: 0;
  }

  .catalog-controls-heading h3 {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
  }

  .catalog-controls-heading > p,
  .catalog-filter-status {
    color: var(--muted);
  }

  .catalog-controls {
    display: grid;
    grid-template-columns: minmax(260px, 0.65fr) minmax(240px, 1fr);
    gap: 18px;
    align-items: end;
  }

  .view-switch {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .view-switch legend,
  .topic-filter {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 850;
  }

  .view-switch legend {
    margin-bottom: 8px;
  }

  .segmented-control {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-soft);
  }

  .segmented-control button {
    min-height: 40px;
    padding: 8px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }

  .segmented-control button.is-active {
    background: var(--surface);
    color: var(--accent-dark);
    box-shadow: 0 1px 4px rgba(15, 31, 50, 0.12);
  }

  .segmented-control button:focus-visible,
  .topic-filter select:focus-visible {
    outline: 3px solid var(--accent-soft);
    outline-offset: 2px;
  }

  .topic-filter {
    display: grid;
    gap: 8px;
  }

  .topic-filter select {
    width: 100%;
    min-height: 48px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-soft);
    color: var(--text);
    font: inherit;
    font-weight: 750;
  }

  .catalog-filter-status {
    font-size: 0.92rem;
    font-weight: 750;
  }

  .diss-alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }

  .diss-alpha-nav[hidden],
  .diss-groups[hidden] {
    display: none;
  }

  .diss-alpha-nav a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--accent-dark);
    font-weight: 950;
    box-shadow: var(--shadow);
  }

  .diss-alpha-nav a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  .diss-note {
    margin-bottom: 18px;
    padding: 16px 18px;
    border-left: 5px solid var(--accent);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--muted);
  }

  .diss-note a {
    color: var(--accent-dark);
    font-weight: 850;
  }

  .diss-groups {
    display: grid;
    gap: 18px;
  }

  .diss-letter-group,
  .catalog-entry-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .diss-letter-group {
    padding: clamp(18px, 3vw, 28px);
  }

  .diss-letter-header {
