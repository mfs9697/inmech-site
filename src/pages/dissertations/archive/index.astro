---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DissertationArchiveGallery from '../../../components/DissertationArchiveGallery.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (url: string) => `${base}/${url.replace(/^\/+/, '')}`;
const years = [2021, 2020, 2019, 2018, 2017, 2016, 2015];
---

<BaseLayout
  title="Історичний архів дисертацій — картки наукових робіт | Інститут механіки"
  description="Історичний архів дисертацій (2015–2021): здобувачі, теми, наукові ступені та оригінальні документи з примітками."
  activePage="education"
>
  <div class="archive-page">
    <div class="archive-container">
      <nav class="archive-breadcrumbs" aria-label="Навігаційний шлях">
        <a href={withBase('/dissertations/')}>Захист дисертацій</a>
        <span aria-hidden="true">›</span>
        <span>Історичний архів</span>
      </nav>
      <header class="archive-hero">
        <p class="archive-eyebrow">Науковий архів · оригінальні документи</p>
        <h1>Історичний архів дисертацій</h1>
        <p class="archive-lead">Архів містить 26 карток: 23 дисертаційні роботи, авторів і назви яких встановлено за доступними оригіналами, та три комплекти документів без підтвердженого авторства й назви. Для ідентифікованих робіт наведено здобувача, оригінальну назву, ступінь, на здобуття якого подано дисертацію, спеціальність та документи.</p>
        <p class="archive-note">Роки нижче означають архівні папки попереднього сайту, а не самостійно підтверджені дати захисту. Частину DOC/RAR/ZIP збережено, проте не відкрито для завантаження до завершення перевірки безпеки.</p>
        <nav class="year-jump" aria-label="Перехід за роком архівної папки">
          {years.map((year) => <a href={`#year-${year}`}>{year}</a>)}
        </nav>
      </header>
      <DissertationArchiveGallery lang="uk" />
      <p class="return-link"><a href={withBase('/dissertations/')}>← Повернутися до захистів дисертацій</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .archive-page { padding: 34px 0 72px; }
  .archive-container { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }
  .archive-breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--muted); font-size: .9rem; margin-bottom: 24px; }
  .archive-hero { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(25px, 4.5vw, 48px); margin-bottom: 32px; box-shadow: var(--shadow); }
  .archive-eyebrow { color: var(--accent-dark); font-weight: 900; text-transform: uppercase; letter-spacing: .07em; font-size: .78rem; }
  .archive-hero h1 { font-size: clamp(2rem, 4vw, 3.3rem); line-height: 1.1; letter-spacing: -.03em; margin: 10px 0 18px; }
  .archive-hero p { max-width: 86ch; line-height: 1.65; color: var(--muted); }
  .archive-lead { font-size: 1.06rem; }
  .archive-note { font-size: .9rem; }
  .year-jump { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .year-jump a { display: inline-flex; min-width: 54px; min-height: 40px; justify-content: center; align-items: center; border: 1px solid var(--accent); border-radius: 999px; padding: 7px 13px; text-decoration: none; font-weight: 850; color: var(--accent-dark); background: var(--surface-soft); }
  .year-jump a:hover { background: var(--accent-soft); text-decoration: none; }
  .return-link { margin-top: 32px; font-weight: 800; }
</style>
