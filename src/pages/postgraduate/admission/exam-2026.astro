---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../data/site';

const mediaBase = '/media/postgraduate/exam-2026';

const cameras = [
  {
    title: 'Камера 1',
    note: 'Основний ракурс. Усі три фрагменти містять звук.',
    recordings: [
      { label: 'Фрагмент 1', duration: '1 хв 49 с', audio: 'зі звуком', file: '20260915_133100_4209_ACCC8EE1BDEA.mp4' },
      { label: 'Фрагмент 2', duration: '40 хв 30 с', audio: 'зі звуком', file: '20260915_135832_3198_ACCC8EE1BDEA.mp4' },
      { label: 'Фрагмент 3', duration: '3 хв 40 с', audio: 'зі звуком', file: '20260915_144336_843F_ACCC8EE1BDEA.mp4' }
    ]
  },
  {
    title: 'Камера 2',
    note: 'Додатковий ракурс. Для двох фрагментів доступне лише відео; третій містить звук.',
    recordings: [
      { label: 'Фрагмент 1', duration: '49 хв 03 с', audio: 'без звуку', file: '192.168.0.13_2026915114033_2026915122933.mp4' },
      { label: 'Фрагмент 2', duration: '41 хв 20 с', audio: 'без звуку', file: '192.168.0.13_2026915131124_2026915135241.mp4' },
      { label: 'Фрагмент 3', duration: '40 хв 32 с', audio: 'зі звуком', file: '192.168.0.13_2026-09-15_135912.mp4' }
    ]
  }
];
---

<BaseLayout
  title={`Відеозаписи вступного іспиту 2026 | ${site.shortName}`}
  description="Відеозаписи вступного іспиту до аспірантури Інституту механіки ім. С. П. Тимошенка НАН України від 15 вересня 2026 року."
  activePage="education"
>
  <main class="exam-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/postgraduate/">Аспірантура</a>
      <span>›</span>
      <a href="/postgraduate/admission/">Вступникам</a>
      <span>›</span>
      <span>Відеозаписи іспиту</span>
    </nav>

    <section class="page-hero">
      <p class="eyebrow">Вступ до аспірантури · 2026</p>
      <h1>Відеозаписи вступного іспиту</h1>
      <p class="lead">
        Записи вступного іспиту до аспірантури Інституту механіки ім. С. П. Тимошенка НАН України,
        проведеного 15 вересня 2026 року. Для зручності матеріали подано окремо для двох камер.
      </p>
    </section>

    <section class="notice" aria-label="Інформація про відтворення">
      <strong>Примітка.</strong> Відео завантажується під час відтворення. Якщо запис не починається миттєво,
      зачекайте кілька секунд або скористайтеся прямим посиланням на MP4.
    </section>

    {cameras.map((camera) => (
      <section class="camera-section">
        <div class="section-heading compact-header">
          <div>
            <p class="eyebrow">Відеозапис</p>
            <h2>{camera.title}</h2>
            <p class="camera-note">{camera.note}</p>
          </div>
        </div>

        <div class="recording-list">
          {camera.recordings.map((recording, index) => {
            const src = `${mediaBase}/${recording.file}`;
            return (
              <details class="recording-card" open={camera.title === 'Камера 1' && index === 1}>
                <summary>
                  <span class="recording-title">{recording.label}</span>
                  <span class="recording-meta">{recording.duration} · {recording.audio}</span>
                </summary>
                <div class="recording-body">
                  <video controls preload="metadata" playsinline>
                    <source src={src} type="video/mp4" />
                    Ваш браузер не підтримує відтворення відео HTML5.
                  </video>
                  <a class="direct-link" href={src} target="_blank" rel="noopener noreferrer">Відкрити MP4 окремо ↗</a>
                </div>
              </details>
            );
          })}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .exam-page { max-width: 1120px; margin: 0 auto; padding: 46px 20px 72px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 22px; color: var(--muted); font-weight: 750; }
  .page-hero, .recording-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .page-hero { padding: clamp(28px, 5vw, 52px); }
  .page-hero h1 { margin: 0 0 18px; font-size: clamp(2.15rem, 4.5vw, 4rem); line-height: 1.04; letter-spacing: -0.04em; }
  .lead { max-width: 880px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .notice { margin-top: 22px; padding: 17px 20px; border-left: 5px solid var(--accent); border-radius: 16px; background: var(--accent-soft); line-height: 1.65; }
  .camera-section { margin-top: 38px; }
  .camera-note { max-width: 760px; margin: 8px 0 0; color: var(--muted); line-height: 1.6; }
  .recording-list { display: grid; gap: 16px; }
  .recording-card { overflow: hidden; }
  .recording-card summary { display: flex; justify-content: space-between; gap: 18px; align-items: center; padding: 20px 22px; cursor: pointer; list-style-position: inside; }
  .recording-title { font-weight: 850; }
  .recording-meta { color: var(--muted); font-size: 0.94rem; font-weight: 700; text-align: right; }
  .recording-body { padding: 0 22px 22px; }
  video { display: block; width: 100%; max-height: 70vh; border-radius: 14px; background: #111; }
  .direct-link { display: inline-block; margin-top: 12px; font-weight: 800; }
  @media (max-width: 680px) {
    .recording-card summary { align-items: flex-start; flex-direction: column; }
    .recording-meta { text-align: left; }
  }
</style>
