---
import { site } from '../data/site';
import { getEnglishPath, normalizeSitePath } from '../data/routes';

interface Props {
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { activePage = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const currentPath = normalizeSitePath(Astro.url.pathname, base);
const englishPath = getEnglishPath(Astro.url.pathname, base);
const isSectionActive = (page: Props['activePage']) => activePage === page ? 'active' : '';
const isCurrentPath = (path: string) => currentPath === normalizeSitePath(path);
const isCurrentPathPrefix = (path: string) => currentPath.startsWith(normalizeSitePath(path));
const isPathActive = (path: string) => isCurrentPath(path) ? 'active' : '';
const isPathPrefixActive = (path: string) => isCurrentPathPrefix(path) ? 'active' : '';
const ariaCurrentPage = (path: string) => isCurrentPath(path) ? 'page' : undefined;
const ariaCurrentPrefix = (path: string) => isCurrentPath(path) ? 'page' : isCurrentPathPrefix(path) ? 'location' : undefined;
const ariaCurrentNews = () => {
  if (activePage !== 'news') {
    return undefined;
  }

  return isCurrentPath('/news/') ? 'page' : 'location';
};
---

<header class="site-header">
  <div class="container header-main brand-main">
    <a class="brand" href={withBase('/')} aria-label="Головна сторінка">
      <img src={withBase('/assets/img/ImechLogo.svg?v=20260615-png-final')} alt="Логотип Інституту механіки" />
      <span class="brand-text">
        <span class="brand-official">{site.officialLabel}</span>
        <strong class="brand-title">{site.name}</strong>
        <span class="brand-subtitle">{site.subtitle}</span>
      </span>
    </a>
  </div>
</header>

<div class="nav-shell">
  <div class="container nav-row">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      Меню
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Головне меню">
      <ul>
        <li><a class={isPathActive('/')} href={withBase('/')} aria-current={ariaCurrentPage('/')}>Головна</a></li>

        <li>
          <button class={`nav-label ${isSectionActive('about')}`} type="button" aria-expanded="false" aria-controls="submenu-about">
            <span>Про інститут</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-about">
            <li><a class={isPathActive('/history/')} href={withBase('/history/')} aria-current={ariaCurrentPage('/history/')}>Історія і сучасність</a></li>
            <li><a class={isPathActive('/founder/')} href={withBase('/founder/')} aria-current={ariaCurrentPage('/founder/')}>Засновник інституту</a></li>
            <li><a class={isPathActive('/regulations/')} href={withBase('/regulations/')} aria-current={ariaCurrentPage('/regulations/')}>Статут</a></li>
            <li><a class={isPathActive('/strategy/')} href={withBase('/strategy/')} aria-current={ariaCurrentPage('/strategy/')}>Стратегія розвитку</a></li>
            <li><a class={isPathActive('/scientific-cooperation/')} href={withBase('/scientific-cooperation/')} aria-current={ariaCurrentPage('/scientific-cooperation/')}>Наукова співпраця</a></li>
            <li><a class={isPathActive('/tender/')} href={withBase('/tender/')} aria-current={ariaCurrentPage('/tender/')}>Закупівлі та тендери</a></li>
            <li><a class={isPathActive('/vacancies/')} href={withBase('/vacancies/')} aria-current={ariaCurrentPage('/vacancies/')}>Вакансії</a></li>
          </ul>
        </li>

        <li>
          <button class={`nav-label ${isSectionActive('departments')}`} type="button" aria-expanded="false" aria-controls="submenu-structure">
            <span>Структура</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-structure">
            <li><a class={isPathActive('/management/')} href={withBase('/management/')} aria-current={ariaCurrentPage('/management/')}>Дирекція</a></li>
            <li><a class={isPathActive('/departments/')} href={withBase('/departments/')} aria-current={ariaCurrentPage('/departments/')}>Наукові відділи</a></li>
            <li><a class={isPathActive('/scientific-council/')} href={withBase('/scientific-council/')} aria-current={ariaCurrentPage('/scientific-council/')}>Вчена рада</a></li>
            <li><a class={isPathActive('/specialized-councils/')} href={withBase('/specialized-councils/')} aria-current={ariaCurrentPage('/specialized-councils/')}>Спеціалізовані ради</a></li>
            <li><a class={isPathActive('/young-scientists/')} href={withBase('/young-scientists/')} aria-current={ariaCurrentPage('/young-scientists/')}>Рада молодих вчених</a></li>
            <li><a class={isPathActive('/services/')} href={withBase('/services/')} aria-current={ariaCurrentPage('/services/')}>Служби інституту</a></li>
          </ul>
        </li>

        <li>
          <button class={`nav-label ${isSectionActive('education')}`} type="button" aria-expanded="false" aria-controls="submenu-education">
            <span>Освітньо-наукова діяльність</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-education">
            <li><a class={isPathActive('/education/')} href={withBase('/education/')} aria-current={ariaCurrentPage('/education/')}>Огляд розділу</a></li>
            <li><a class={isPathActive('/postgraduate/')} href={withBase('/postgraduate/')} aria-current={ariaCurrentPage('/postgraduate/')}>Аспірантура</a></li>
            <li><a class={isPathActive('/doctoral/')} href={withBase('/doctoral/')} aria-current={ariaCurrentPage('/doctoral/')}>Докторантура</a></li>
            <li><a class={isPathActive('/dissertations/')} href={withBase('/dissertations/')} aria-current={ariaCurrentPage('/dissertations/')}>Захист дисертацій</a></li>
            <li><a class={isPathActive('/license-and-regulations/')} href={withBase('/license-and-regulations/')} aria-current={ariaCurrentPage('/license-and-regulations/')}>Ліцензії та Положення</a></li>
            <li><a class={isPathActive('/trust-box/')} href={withBase('/trust-box/')} aria-current={ariaCurrentPage('/trust-box/')}>Скринька довіри</a></li>
            <li><a class={isPathActive('/nmr/')} href={withBase('/nmr/')} aria-current={ariaCurrentPage('/nmr/')}>Науково-методична рада</a></li>
          </ul>
        </li>

        <li><a class={isPathPrefixActive('/library/')} href={withBase('/library/')} aria-current={ariaCurrentPrefix('/library/')}>Бібліотека</a></li>
        <li><a class={isSectionActive('news')} href={withBase('/news/')} aria-current={ariaCurrentNews()}>Новини</a></li>
        <li><a href={withBase('/#contacts')}>Контакти</a></li>
        <li><a class={`search-nav-link ${isPathActive('/search/')}`} href={withBase('/search/')} aria-label="Пошук по сайту" aria-current={ariaCurrentPage('/search/')}>Пошук</a></li>
      </ul>
    </nav>

    <div class="lang-switch nav-lang-switch" aria-label="Вибір мови">
      <span class="active" aria-current="page">Українська</span>
      <a href={withBase(englishPath)} data-language-switch>English</a>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: #0f1f34;
    border-bottom: 0;
    color: #fff;
    backdrop-filter: none;
  }

  .header-main.brand-main {
    justify-content: flex-start;
    align-items: center;
  }

  .site-header .brand-title {
    color: #ffffff;
  }

  .site-header .brand-official {
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .site-header .brand-subtitle {
    color: rgba(255, 255, 255, 0.86);
  }

  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 28px rgba(15, 31, 52, 0.08);
    backdrop-filter: blur(12px);
  }

  .nav-row {
    min-height: 54px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  .nav-lang-switch {
    flex: 0 0 auto;
    gap: 4px;
    margin-left: 8px;
    padding-left: 10px;
    border-left: 1px solid var(--line);
  }

  .nav-lang-switch a,
  .nav-lang-switch span {
    display: inline-flex;
    align-items: center;
    padding: 6px 8px;
    border-radius: 10px;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .nav-lang-switch a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  .nav-lang-switch .active {
    background: var(--accent);
    color: #ffffff;
    cursor: default;
  }

  .primary-nav .submenu {
    z-index: 1100;
  }

  @media (max-width: 1120px) {
    .primary-nav {
      top: calc(100% + 8px);
    }
  }

  @media (max-width: 560px) {
    .brand {
      align-items: flex-start;
    }

    .nav-row {
      gap: 8px;
    }

    .nav-lang-switch {
      margin-left: auto;
      padding-left: 8px;
    }

    .nav-lang-switch a,
    .nav-lang-switch span {
      padding: 6px 7px;
      font-size: 0.84rem;
    }
  }
</style>
