---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}
---

<BaseLayoutEn
  title={`${siteEn.name}`}
  description="The English homepage of the S.P. Timoshenko Institute of Mechanics of the National Academy of Sciences of Ukraine: research in mechanics of deformable solids, dynamics, stability, thermomechanics, creep, fracture and composite materials."
  activePage="home"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card hero-card-visual">
        <div class="hero-text">
          <p class="eyebrow">National Academy of Sciences of Ukraine</p>
          <h1>S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine</h1>
          <p class="lead">
            A leading Ukrainian research institution in theoretical and applied mechanics,
            combining fundamental research, computational modelling, experimental studies
            and engineering-oriented analysis of materials, structures and mechanical processes.
          </p>
        </div>

        <figure class="hero-image-card">
          <img src={withBase('/assets/img/logo-jacket.png?v=20260615-2')} alt="Badge of the S.P. Timoshenko Institute of Mechanics" loading="eager" />
          <div class="hero-actions hero-image-actions">
            <a class="button primary" href={withBase('/en/departments/')}>Research departments</a>
            <a class="button secondary" href={withBase('/en/education/')}>Academic training</a>
          </div>
        </figure>
      </div>

      <aside class="aside-card" aria-labelledby="visitor-links-title">
        <h2 id="visitor-links-title">For international visitors</h2>
        <p>
          Key English-language entry points to the Institute’s research, academic training,
          publications and institutional information.
        </p>
        <ul class="aside-list">
          <li><a href={withBase('/en/departments/')}>Research departments</a></li>
          <li><a href={withBase('/en/education/')}>Postgraduate and doctoral studies</a></li>
          <li>
            <a href="https://applied-mechanics.inmech.kyiv.ua/" target="_blank" rel="noopener">
              Journal “Applied Mechanics”
            </a>
          </li>
          <li><a href={withBase('/en/contacts/')}>Contacts</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">About the Institute</p>
          <h2 class="section-title">Mechanics as a foundation for science and engineering</h2>
          <p class="section-text">
            The Institute develops analytical, numerical and experimental approaches for studying
            the behaviour of materials, structural elements and mechanical systems. Its work covers
            both fundamental problems of continuum mechanics and applied tasks related to strength,
            durability, reliability and safe operation of engineering structures.
          </p>
        </div>
      </div>

      <div class="cards-grid">
        <article class="card">
          <h3>Fundamental research</h3>
          <p>
            Development of theories, models and methods in mechanics of deformable solids,
            dynamics, stability, thermomechanics, creep and fracture.
          </p>
          <a class="card-link" href={withBase('/en/history/')}>History and mission →</a>
        </article>

        <article class="card">
          <h3>Computational and experimental methods</h3>
          <p>
            Mathematical modelling, finite-element analysis, experimental mechanics and validation
            of models for materials, structures and coupled mechanical processes.
          </p>
          <a class="card-link" href={withBase('/en/departments/')}>View departments →</a>
        </article>

        <article class="card">
          <h3>Engineering applications</h3>
          <p>
            Research aimed at strength assessment, durability prediction, structural reliability,
            advanced materials, composite systems and modern engineering technologies.
          </p>
          <a class="card-link" href={withBase('/en/contacts/')}>Contact the Institute →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="research">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Research profile</p>
          <h2 class="section-title">Main scientific areas</h2>
          <p class="section-text">
            The Institute’s departments cover a broad spectrum of modern theoretical and applied mechanics,
            from classical problems of solid mechanics to advanced modelling of materials, structures and processes.
          </p>
        </div>
        <a class="button secondary" href={withBase('/en/departments/')}>All departments</a>
      </div>

      <div class="cards-grid">
        <article class="card">
          <h3>Mechanics of deformable solids</h3>
          <p>
            Stress, strain, stability, damage and long-term behaviour of solids, plates, shells,
            structural elements and engineering systems.
          </p>
        </article>

        <article class="card">
          <h3>Dynamics, stability and vibrations</h3>
          <p>
            Dynamic processes, wave propagation, oscillations, stability loss and response of
            structures under static, cyclic and time-dependent loads.
          </p>
        </article>

        <article class="card">
          <h3>Thermomechanics, creep and fracture</h3>
          <p>
            Thermoelasticity, thermoplasticity, hereditary material behaviour, creep, fatigue,
            fracture mechanics and durability of materials and structures.
          </p>
        </article>

        <article class="card">
          <h3>Composite and advanced materials</h3>
          <p>
            Mechanics of composite materials, layered and thin-walled systems, metamaterial-inspired
            structures and computational approaches for modern material design.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="academic-life">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Academic life</p>
          <h2 class="section-title">Research training, councils and scientific communication</h2>
          <p class="section-text">
            The Institute provides postgraduate and doctoral training, supports scientific seminars,
            participates in academic councils and contributes to the development of the Ukrainian
            and international mechanics community.
          </p>
        </div>
      </div>

      <div class="cards-grid">
        <article class="card">
          <h3>Postgraduate and doctoral studies</h3>
          <p>
            Training of early-career researchers through postgraduate programmes, doctoral studies,
            research supervision and participation in scientific projects.
          </p>
          <a class="card-link" href={withBase('/en/education/')}>Academic training →</a>
        </article>

        <article class="card">
          <h3>Scientific and specialised councils</h3>
          <p>
            Institutional bodies that support research coordination, expert evaluation and academic
            certification in the field of mechanics.
          </p>
          <div class="card-links-stack">
            <a class="card-link" href={withBase('/en/scientific-council/')}>Scientific Council →</a>
            <a class="card-link" href={withBase('/en/specialized-councils/')}>Specialised councils →</a>
          </div>
        </article>

        <article class="card">
          <h3>Publications and library resources</h3>
          <p>
            Dissemination of research results through journals, conferences, monographs,
            institutional publications and library collections.
          </p>
          <div class="card-links-stack">
            <a class="card-link" href="https://applied-mechanics.inmech.kyiv.ua/" target="_blank" rel="noopener">Applied Mechanics journal →</a>
            <a class="card-link" href={withBase('/en/library/')}>Library →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="information">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Information</p>
          <h2 class="section-title">News, announcements and contacts</h2>
          <p class="section-text">
            The English news archive is being prepared. Current institutional announcements are
            available in the Ukrainian version of the website; contact information and main
            institutional links are available in English.
          </p>
        </div>
      </div>

      <div class="cards-grid">
        <article class="card">
          <h3>News and announcements</h3>
          <p>
            Follow current institutional updates in the Ukrainian news archive while the English
            news section is being prepared.
          </p>
          <a class="card-link" href={withBase('/news/')}>Ukrainian news archive →</a>
        </article>

        <article class="card">
          <h3>Contact the Institute</h3>
          <p>
            Address, telephone numbers, e-mail and general contact information for institutional
            communication and cooperation requests.
          </p>
          <a class="card-link" href={withBase('/en/contacts/')}>Contacts →</a>
        </article>

        <article class="card">
          <h3>Institute websites</h3>
          <p>
            Additional resources for specialised projects, academic organisations, events and
            institutional announcements connected with the Institute.
          </p>
          <div class="card-links-stack">
            <a class="card-link" href="https://natcommmech.inmech.kyiv.ua/" target="_blank" rel="noopener">National Committee of Ukraine for Mechanics →</a>
            <a class="card-link" href="https://election.inmech.kyiv.ua/" target="_blank" rel="noopener">Director election website →</a>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayoutEn>
