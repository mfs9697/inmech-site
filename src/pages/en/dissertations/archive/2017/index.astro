---
import BaseLayoutEn from '../../../../../layouts/BaseLayoutEn.astro';
import DissertationArchiveGallery from '../../../../../components/DissertationArchiveGallery.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (url: string) => `${base}/${url.replace(/^\/+/, '')}`;
---

<BaseLayoutEn
  title="Dissertations from the 2017 archive | Institute of Mechanics"
  description="Source-documented dissertation cards from the 2017 historical archive folder, with original files, authors, titles and declared degree where verified."
  activePage="education"
>
  <div class="archive-page">
    <div class="archive-container">
      <nav class="archive-breadcrumbs" aria-label="Breadcrumbs">
        <a href={withBase('/en/dissertations/')}>Dissertation defences</a>
        <span aria-hidden="true">›</span>
        <a href={withBase('/en/dissertations/archive/')}>Historical archive</a>
        <span aria-hidden="true">›</span>
        <span>2017</span>
      </nav>
      <header class="archive-hero">
        <p class="archive-eyebrow">Historical dissertation archive</p>
        <h1>Research cards — archive folder 2017</h1>
        <p>Names, original titles, degrees and specialties are transcribed from the title pages of available original documents. The archive-folder year is not automatically a confirmed defence date.</p>
        <p class="archive-disclaimer">Where an original could not be safely inspected or its identification remains uncertain, the card explicitly says so. Withheld legacy DOC, ZIP and RAR files have no download link.</p>
      </header>
      <DissertationArchiveGallery lang="en" archiveYear={2017} />
      <p class="return-link"><a href={withBase('/en/dissertations/archive/')}>← View all historical dissertation cards</a></p>
    </div>
  </div>
</BaseLayoutEn>

<style>
  .archive-page { padding: 34px 0 72px; }
  .archive-container { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }
  .archive-breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--muted); font-size: .9rem; margin-bottom: 24px; }
  .archive-hero { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(25px, 4.5vw, 48px); margin-bottom: 26px; box-shadow: var(--shadow); }
  .archive-eyebrow { color: var(--accent-dark); font-weight: 900; text-transform: uppercase; letter-spacing: .07em; font-size: .78rem; }
  .archive-hero h1 { font-size: clamp(2rem, 4vw, 3.3rem); line-height: 1.1; letter-spacing: -.03em; margin: 10px 0 18px; }
  .archive-hero p { max-width: 83ch; line-height: 1.65; color: var(--muted); }
  .archive-hero .archive-disclaimer { font-size: .9rem; }
  .return-link { margin-top: 28px; font-weight: 800; }
</style>
