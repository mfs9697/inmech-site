---
import { getCollection } from 'astro:content';

interface Props {
  language?: 'uk' | 'en';
  type?: 'meeting' | 'conference' | 'initiative' | 'international';
}

const { language = 'uk', type } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const activities = (await getCollection('ncutamActivities'))
  .filter((entry) => !type || entry.data.type === type)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const typeLabels = {
  meeting: { uk: 'Загальні збори', en: 'General Meeting' },
  conference: { uk: 'Конференція', en: 'Conference' },
  initiative: { uk: 'Ініціатива', en: 'Initiative' },
  international: { uk: 'Міжнародна діяльність', en: 'International activity' }
} as const;

const dateFormatter = new Intl.DateTimeFormat(language === 'uk' ? 'uk-UA' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

{activities.length > 0 ? (
  <div class="activity-grid">
    {activities.map((entry) => (
      <article class="panel activity-card">
        <div class="activity-card-meta">
          <span>{typeLabels[entry.data.type][language]}</span>
          <time datetime={entry.data.date.toISOString()}>{dateFormatter.format(entry.data.date)}</time>
        </div>
        <h2>
          <a href={withBase(`${language === 'uk' ? '' : '/en'}/ncutam/activity/${entry.id}/`)}>
            {language === 'uk' ? entry.data.title : entry.data.titleEn}
          </a>
        </h2>
        <p>{language === 'uk' ? entry.data.summary : entry.data.summaryEn}</p>
      </article>
    ))}
  </div>
) : (
  <div class="panel">
    <p>{language === 'uk' ? 'У цьому архіві поки що немає записів.' : 'There are currently no records in this archive.'}</p>
  </div>
)}

<style>
  .activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }

  .activity-card {
    min-width: 0;
  }

  .activity-card h2 {
    margin: 10px 0 8px;
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }

  .activity-card h2 a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .activity-card p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .activity-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 750;
  }

  @media (max-width: 560px) {
    .activity-grid { grid-template-columns: 1fr; }
  }
</style>
