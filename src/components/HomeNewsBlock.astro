---
import type { CollectionEntry } from 'astro:content';
import { getVisibleNewsTags } from '../utils/newsTags';

type NewsEntry = CollectionEntry<'news'>;
type Lang = 'uk' | 'en';

interface Props {
  entries: NewsEntry[];
  archiveHref?: string;
  lang?: Lang;
}

const { entries, archiveHref, lang = 'uk' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const archiveUrl = archiveHref ?? (lang === 'en' ? '/en/news/' : '/news/');
const [featured, ...compactEntries] = entries;
const featuredTags = featured ? getEntryTags(featured).slice(0, 3) : [];
const layoutClass = compactEntries.length > 0 ? 'home-news-layout' : 'home-news-layout home-news-layout-single';
const featuredImage = featured ? getEntryImage(featured) : undefined;
const featuredImageAlt = featured ? getEntryImageAlt(featured) : '';

const text = {
  uk: {
    readMore: 'Читати далі →',
    allNews: 'Усі новини →',
    tagsLabel: 'Теги новини',
    compactLabel: 'Інші останні повідомлення',
    emptyTitle: 'Новини поки що не додано',
    emptyText: 'Після додавання першого повідомлення воно з’явиться на головній сторінці.'
  },
  en: {
    readMore: 'Read more →',
    allNews: 'All news →',
    tagsLabel: 'News tags',
    compactLabel: 'Other recent announcements',
    emptyTitle: 'No news has been added yet',
    emptyText: 'The first announcement will appear on the homepage after it is added.'
  }
}[lang];

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

function getNewsHref(entry: NewsEntry) {
  return entry.data.externalUrl ?? withBase(`/news/${entry.id}/`);
}

function isExternal(entry: NewsEntry) {
  return Boolean(entry.data.externalUrl);
}

function getEntryTitle(entry: NewsEntry) {
  return lang === 'en' ? entry.data.titleEn ?? entry.data.title : entry.data.title;
}

function getEntryDescription(entry: NewsEntry) {
  return lang === 'en' ? entry.data.descriptionEn ?? entry.data.description : entry.data.description;
}

function getEntryCategory(entry: NewsEntry) {
  return lang === 'en' ? entry.data.categoryEn ?? entry.data.category : entry.data.category;
}

function getEntryTags(entry: NewsEntry) {
  if (lang === 'en') {
    return entry.data.tagsEn ?? [];
  }

  return getVisibleNewsTags(entry);
}

function getEntryImage(entry: NewsEntry) {
  return entry.data.image ? withBase(entry.data.image) : undefined;
}

function getEntryImageAlt(entry: NewsEntry) {
  return lang === 'en' ? entry.data.imageAltEn ?? entry.data.imageAlt ?? '' : entry.data.imageAlt ?? '';
}

function formatDate(date: Date, variant: 'short' | 'long' = 'short') {
  return date.toLocaleDateString(lang === 'en' ? 'en-GB' : 'uk-UA', {
    day: '2-digit',
    month: variant === 'long' ? 'long' : '2-digit',
    year: 'numeric'
  });
}
---

{featured ? (
  <div class="home-news-block" data-lang={lang}>
    <div class={layoutClass}>
      <article class:list={["home-news-featured", { "has-image": Boolean(featuredImage) }]} aria-labelledby="home-featured-news-title">
        {featuredImage && (
          <a
            class="home-news-featured-image"
            href={getNewsHref(featured)}
            target={isExternal(featured) ? '_blank' : undefined}
            rel={isExternal(featured) ? 'noopener noreferrer' : undefined}
            aria-label={getEntryTitle(featured)}
          >
            <img src={featuredImage} alt={featuredImageAlt} loading="eager" decoding="async" />
          </a>
        )}

        <div class="home-news-featured-content">
          <div class="home-news-meta">
            <span class="home-news-category">{getEntryCategory(featured)}</span>
            <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date, 'long')}</time>
          </div>

          <h3 id="home-featured-news-title">
            <a
              href={getNewsHref(featured)}
              target={isExternal(featured) ? '_blank' : undefined}
              rel={isExternal(featured) ? 'noopener noreferrer' : undefined}
            >
              {getEntryTitle(featured)}
            </a>
          </h3>

          <p>{getEntryDescription(featured)}</p>

          {featuredTags.length > 0 && (
            <div class="home-news-tags" aria-label={text.tagsLabel}>
              {featuredTags.map((tag) => (
                lang === 'uk' ? (
                  <a class="home-news-tag" href={withBase(`/news/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
                ) : (
                  <span class="home-news-tag">{tag}</span>
                )
              ))}
            </div>
          )}

          <a
            class="home-news-read-more"
            href={getNewsHref(featured)}
            target={isExternal(featured) ? '_blank' : undefined}
            rel={isExternal(featured) ? 'noopener noreferrer' : undefined}
          >
            {text.readMore}
          </a>
        </div>
      </article>

      {compactEntries.length > 0 && (
        <div class="home-news-compact-list" aria-label={text.compactLabel}>
          {compactEntries.map((entry) => {
            const compactImage = getEntryImage(entry);
            const compactImageAlt = getEntryImageAlt(entry);

            return (
              <article class:list={["home-news-compact", { "has-image": Boolean(compactImage) }]}>
                {compactImage && (
                  <a
                    class="home-news-compact-image"
                    href={getNewsHref(entry)}
                    target={isExternal(entry) ? '_blank' : undefined}
                    rel={isExternal(entry) ? 'noopener noreferrer' : undefined}
                    aria-label={getEntryTitle(entry)}
                  >
                    <img src={compactImage} alt={compactImageAlt} loading="lazy" decoding="async" />
                  </a>
                )}
                <div class="home-news-compact-content">
                  <div class="home-news-compact-meta">
                    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                    <span>{getEntryCategory(entry)}</span>
                  </div>
                  <h3>
                    <a
                      href={getNewsHref(entry)}
                      target={isExternal(entry) ? '_blank' : undefined}
                      rel={isExternal(entry) ? 'noopener noreferrer' : undefined}
                    >
                      {getEntryTitle(entry)}
                    </a>
                  </h3>
                  <p>{getEntryDescription(entry)}</p>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>

    <div class="home-news-footer">
      <a class="button secondary" href={withBase(archiveUrl)}>{text.allNews}</a>
    </div>
  </div>
) : (
  <div class="home-news-empty">
    <h3>{text.emptyTitle}</h3>
    <p>{text.emptyText}</p>
  </div>
)}

<style>
  .home-news-block {
    display: grid;
    gap: 16px;
  }

  .home-news-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    gap: 16px;
    align-items: stretch;
  }

  .home-news-layout-single {
    grid-template-columns: 1fr;
  }

  .home-news-featured,
  .home-news-compact,
  .home-news-empty {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .home-news-featured {
    position: relative;
    overflow: hidden;
    min-height: 316px;
    display: flex;
    flex-direction: column;
  }

  .home-news-featured::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -90px;
    top: -90px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.14), rgba(29, 79, 145, 0));
    pointer-events: none;
  }

  .home-news-featured.has-image::after {
    top: auto;
    bottom: -115px;
  }

  .home-news-featured-image {
    display: block;
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .home-news-featured-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7.2;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .home-news-featured-image:hover img {
    transform: scale(1.025);
  }

  .home-news-featured-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 34px);
  }

  .home-news-meta,
  .home-news-compact-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .home-news-category {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 5px 9px;
    border-radius: 999px;
    background: rgba(184, 135, 47, 0.12);
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: 0.76rem;
    font-weight: 850;
  }

  .home-news-featured h3 {
    margin: 18px 0 12px;
    max-width: 760px;
    font-size: clamp(1.45rem, 2.8vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .home-news-featured h3 a,
  .home-news-compact h3 a {
    color: var(--text);
  }

  .home-news-featured h3 a:hover,
  .home-news-compact h3 a:hover {
    color: var(--accent);
  }

  .home-news-featured p {
    margin: 0;
    max-width: 720px;
    color: var(--muted);
    font-size: 1.03rem;
  }

  .home-news-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .home-news-tag {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 9px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .home-news-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .home-news-read-more {
    width: fit-content;
    margin-top: auto;
    padding-top: 24px;
    font-weight: 850;
  }

  .home-news-compact-list {
    display: grid;
    gap: 12px;
  }

  .home-news-compact {
    padding: 18px;
    box-shadow: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .home-news-compact.has-image {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 14px;
    padding: 12px;
  }

  .home-news-compact:hover {
    transform: translateY(-2px);
    border-color: rgba(29, 79, 145, 0.28);
    box-shadow: 0 14px 32px rgba(20, 33, 61, 0.08);
  }

  .home-news-compact-image {
    display: block;
    overflow: hidden;
    border-radius: 14px;
    min-height: 96px;
  }

  .home-news-compact-image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 96px;
    object-fit: cover;
  }

  .home-news-compact-content {
    min-width: 0;
  }

  .home-news-compact-meta span {
    color: var(--gold);
  }

  .home-news-compact h3 {
    margin: 9px 0 7px;
    font-size: 1.06rem;
    line-height: 1.28;
  }

  .home-news-compact p {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .home-news-footer {
    display: flex;
    justify-content: flex-end;
  }

  .home-news-empty {
    padding: 24px;
  }

  .home-news-empty h3 {
    margin: 0 0 8px;
  }

  .home-news-empty p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 940px) {
    .home-news-layout {
      grid-template-columns: 1fr;
    }

    .home-news-featured {
      min-height: 0;
    }
  }

  @media (max-width: 680px) {
    .home-news-featured-image img {
      aspect-ratio: 16 / 9;
    }

    .home-news-compact.has-image {
      grid-template-columns: 1fr;
    }

    .home-news-compact-image img {
      aspect-ratio: 16 / 9;
      height: auto;
    }

    .home-news-footer {
      justify-content: flex-start;
    }
  }
</style>
