---
import { siteEn } from '../data/site-en';
import { getUkrainianPath, normalizeSitePath } from '../data/routes';

interface Props {
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { activePage = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const currentPath = normalizeSitePath(Astro.url.pathname, base);
const ukrainianPath = getUkrainianPath(Astro.url.pathname, base);
const isSectionActive = (page: Props['activePage']) => activePage === page ? 'active' : '';
const isCurrentPath = (path: string) => currentPath === normalizeSitePath(path);
const isCurrentPathPrefix = (path: string) => currentPath.startsWith(normalizeSitePath(path));
const isPathActive = (path: string) => isCurrentPath(path) ? 'active' : '';
const isPathPrefixActive = (path: string) => isCurrentPathPrefix(path) ? 'active' : '';
const ariaCurrentPage = (path: string) => isCurrentPath(path) ? 'page' : undefined;
const ariaCurrentPrefix = (path: string) => isCurrentPath(path) ? 'page' : isCurrentPathPrefix(path) ? 'location' : undefined;
const ariaCurrentNews = () => {
  if (activePage !== 'news') {
    return undefined;
  }

  return isCurrentPath('/en/news/') ? 'page' : 'location';
};
---

<header class="site-header">
  <div class="container header-main brand-main">
    <a class="brand" href={withBase('/en/')} aria-label="Home page">
      <img src={withBase('/assets/img/ImechLogo.svg?v=20260615-png-final')} alt="Logo of the Institute of Mechanics" />
      <span class="brand-text">
        <span class="brand-official">{siteEn.officialLabel}</span>
        <strong class="brand-title">{siteEn.name}</strong>
        <span class="brand-subtitle">{siteEn.subtitle}</span>
      </span>
    </a>
  </div>
</header>

<div class="nav-shell">
  <div class="container nav-row">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      Menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Main menu">
      <ul>
        <li><a class={isPathActive('/en/')} href={withBase('/en/')} aria-current={ariaCurrentPage('/en/')}>Home</a></li>
        <li>
          <button class={`nav-label ${isSectionActive('about')}`} type="button" aria-expanded="false" aria-controls="submenu-about">
            <span>About the Institute</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-about">
            <li><a class={isPathActive('/en/history/')} href={withBase('/en/history/')} aria-current={ariaCurrentPage('/en/history/')}>History and present</a></li>
            <li><a class={isPathActive('/en/founder/')} href={withBase('/en/founder/')} aria-current={ariaCurrentPage('/en/founder/')}>Founder of the Institute</a></li>
            <li><a class={isPathActive('/en/regulations/')} href={withBase('/en/regulations/')} aria-current={ariaCurrentPage('/en/regulations/')}>Statute</a></li>
            <li><a class={isPathActive('/en/strategy/')} href={withBase('/en/strategy/')} aria-current={ariaCurrentPage('/en/strategy/')}>Development strategy</a></li>
            <li><a class={isPathActive('/en/scientific-cooperation/')} href={withBase('/en/scientific-cooperation/')} aria-current={ariaCurrentPage('/en/scientific-cooperation/')}>Scientific cooperation</a></li>
            <li><a class={isPathActive('/en/tender/')} href={withBase('/en/tender/')} aria-current={ariaCurrentPage('/en/tender/')}>Procurement and tenders</a></li>
            <li><a class={isPathActive('/en/vacancies/')} href={withBase('/en/vacancies/')} aria-current={ariaCurrentPage('/en/vacancies/')}>Vacancies</a></li>
          </ul>
        </li>
        <li>
          <button class={`nav-label ${isSectionActive('departments')}`} type="button" aria-expanded="false" aria-controls="submenu-structure">
            <span>Structure</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-structure">
            <li><a class={isPathActive('/en/management/')} href={withBase('/en/management/')} aria-current={ariaCurrentPage('/en/management/')}>Management</a></li>
            <li><a class={isPathActive('/en/departments/')} href={withBase('/en/departments/')} aria-current={ariaCurrentPage('/en/departments/')}>Research departments</a></li>
            <li><a class={isPathActive('/en/scientific-council/')} href={withBase('/en/scientific-council/')} aria-current={ariaCurrentPage('/en/scientific-council/')}>Scientific Council</a></li>
            <li><a class={isPathActive('/en/specialized-councils/')} href={withBase('/en/specialized-councils/')} aria-current={ariaCurrentPage('/en/specialized-councils/')}>Specialized Academic Councils</a></li>
            <li><a class={isPathActive('/en/young-scientists/')} href={withBase('/en/young-scientists/')} aria-current={ariaCurrentPage('/en/young-scientists/')}>Council of Young Scientists</a></li>
            <li><a class={isPathActive('/en/services/')} href={withBase('/en/services/')} aria-current={ariaCurrentPage('/en/services/')}>Institute services</a></li>
          </ul>
        </li>
        <li>
          <button class={`nav-label ${isSectionActive('education')}`} type="button" aria-expanded="false" aria-controls="submenu-education">
            <span>Education and research training</span>
            <span class="submenu-indicator" aria-hidden="true">▾</span>
          </button>
          <ul class="submenu" id="submenu-education">
            <li><a class={isPathActive('/en/education/')} href={withBase('/en/education/')} aria-current={ariaCurrentPage('/en/education/')}>Section overview</a></li>
            <li><a class={isPathActive('/en/postgraduate/')} href={withBase('/en/postgraduate/')} aria-current={ariaCurrentPage('/en/postgraduate/')}>Postgraduate studies</a></li>
            <li><a class={isPathActive('/en/doctoral/')} href={withBase('/en/doctoral/')} aria-current={ariaCurrentPage('/en/doctoral/')}>Doctoral studies</a></li>
            <li><a class={isPathActive('/en/dissertations/')} href={withBase('/en/dissertations/')} aria-current={ariaCurrentPage('/en/dissertations/')}>Dissertation defences</a></li>
            <li><a class={isPathActive('/en/license-and-regulations/')} href={withBase('/en/license-and-regulations/')} aria-current={ariaCurrentPage('/en/license-and-regulations/')}>Licences and regulations</a></li>
            <li><a class={isPathActive('/en/trust-box/')} href={withBase('/en/trust-box/')} aria-current={ariaCurrentPage('/en/trust-box/')}>Trust box</a></li>
            <li><a class={isPathActive('/en/nmr/')} href={withBase('/en/nmr/')} aria-current={ariaCurrentPage('/en/nmr/')}>Scientific and Methodological Council</a></li>
          </ul>
        </li>
        <li><a class={isPathPrefixActive('/en/library/')} href={withBase('/en/library/')} aria-current={ariaCurrentPrefix('/en/library/')}>Library</a></li>
        <li><a class={isSectionActive('news')} href={withBase('/en/news/')} aria-current={ariaCurrentNews()}>News</a></li>
        <li><a href={withBase('/en/#contacts')}>Contacts</a></li>
        <li><a class={`search-nav-link ${isPathActive('/en/search/')}`} href={withBase('/en/search/')} aria-label="Search the website" aria-current={ariaCurrentPage('/en/search/')}>Search</a></li>
      </ul>
    </nav>

    <div class="lang-switch nav-lang-switch" aria-label="Language selection">
      <a href={withBase(ukrainianPath)} data-language-switch>Українська</a>
      <span class="active" aria-current="page">English</span>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: #0f1f34;
    border-bottom: 0;
    color: #fff;
    backdrop-filter: none;
  }

  .header-main.brand-main {
    justify-content: flex-start;
    align-items: center;
  }

  .site-header .brand-title {
    color: #ffffff;
  }

  .site-header .brand-official {
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .site-header .brand-subtitle {
    color: rgba(255, 255, 255, 0.86);
  }

  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 28px rgba(15, 31, 52, 0.08);
    backdrop-filter: blur(12px);
  }

  .nav-row {
    min-height: 54px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  .nav-lang-switch {
    flex: 0 0 auto;
    gap: 4px;
    margin-left: 8px;
    padding-left: 10px;
    border-left: 1px solid var(--line);
  }

  .nav-lang-switch a,
  .nav-lang-switch span {
    display: inline-flex;
    align-items: center;
    padding: 6px 8px;
    border-radius: 10px;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .nav-lang-switch a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  .nav-lang-switch .active {
    background: var(--accent);
    color: #ffffff;
    cursor: default;
  }

  .primary-nav .submenu {
    z-index: 1100;
  }

  @media (max-width: 1120px) {
    .primary-nav {
      top: calc(100% + 8px);
    }
  }

  @media (max-width: 560px) {
    .brand {
      align-items: flex-start;
    }

    .nav-row {
      gap: 8px;
    }

    .nav-lang-switch {
      margin-left: auto;
      padding-left: 8px;
    }

    .nav-lang-switch a,
    .nav-lang-switch span {
      padding: 6px 7px;
      font-size: 0.84rem;
    }
  }
</style>
