---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

type ActivePage = 'home' | 'news' | 'departments' | 'about' | 'education';
type LinkItem = { title: string; href: string; external?: boolean };
type CardItem = { title: string; text: string; href?: string };
type PageData = {
  title: string;
  description: string;
  activePage: ActivePage;
  eyebrow: string;
  heading: string;
  lead: string;
  sections?: Array<{ title: string; paragraphs: string[] }>;
  cards?: CardItem[];
  links?: LinkItem[];
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

export function getStaticPaths() {
  const genericPages: Record<string, PageData> = {
    news: {
      title: 'News',
      description: 'News and announcements of the Institute.',
      activePage: 'news',
      eyebrow: 'News',
      heading: 'News and announcements',
      lead: 'The English news archive is being prepared. Current institutional announcements are available in the Ukrainian version of the website.',
      links: [{ title: 'Open Ukrainian news archive', href: '/news/' }]
    },
    library: {
      title: 'Library',
      description: 'Library resources and publications of the Institute.',
      activePage: 'about',
      eyebrow: 'Publications',
      heading: 'Library',
      lead: 'The library section contains information on monographs, textbooks, scientific publications and archival materials of the Institute.',
      links: [{ title: 'Ukrainian library page', href: '/library/' }]
    },
    search: {
      title: 'Search',
      description: 'Search page of the English section.',
      activePage: 'home',
      eyebrow: 'Search',
      heading: 'Search the website',
      lead: 'The English search page is being prepared. You may use the Ukrainian search page to search the current site content.',
      links: [{ title: 'Open Ukrainian search', href: '/search/' }]
    },
    sitemap: {
      title: 'Sitemap',
      description: 'Sitemap of the English section.',
      activePage: 'home',
      eyebrow: 'Service links',
      heading: 'Sitemap',
      lead: 'Main pages of the English section are listed below.',
      links: [
        { title: 'Home', href: '/en/' },
        { title: 'History and mission', href: '/en/history/' },
        { title: 'Research departments', href: '/en/departments/' },
        { title: 'Education and research training', href: '/en/education/' },
        { title: 'News', href: '/en/news/' },
        { title: 'Contacts', href: '/en/#contacts' }
      ]
    },
    accessibility: {
      title: 'Accessibility policy',
      description: 'Accessibility policy of the website.',
      activePage: 'home',
      eyebrow: 'Service links',
      heading: 'Accessibility policy',
      lead: 'The website is being developed with attention to clear structure, readable content and keyboard-accessible navigation.',
      links: [{ title: 'Ukrainian version', href: '/accessibility/' }]
    },
    'site-administration': {
      title: 'Site administration',
      description: 'Website administration information.',
      activePage: 'home',
      eyebrow: 'Service links',
      heading: 'Site administration',
      lead: 'This page provides basic information about the administration and maintenance of the website.',
      links: [{ title: 'Ukrainian version', href: '/site-administration/' }]
    }
  };

  return Object.entries(genericPages).map(([slug, page]) => ({ params: { slug }, props: { page } }));
}

const { page } = Astro.props as { page: PageData };
---

<BaseLayoutEn title={`${page.title} | ${siteEn.shortName}`} description={page.description} activePage={page.activePage}>
  <section class="section page-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">{page.eyebrow}</p>
          <h1 class="section-title">{page.heading}</h1>
          <p class="section-text">{page.lead}</p>
        </div>
      </div>

      {page.sections?.map((section) => (
        <article class="card prose-card">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </article>
      ))}

      {page.cards && (
        <div class="cards-grid">
          {page.cards.map((card) => (
            <article class="card">
              <h2>{card.title}</h2>
              <p>{card.text}</p>
              {card.href && <a class="card-link" href={withBase(card.href)}>Open section →</a>}
            </article>
          ))}
        </div>
      )}

      {page.links && (
        <div class="card prose-card">
          <h2>Links</h2>
          <ul>
            {page.links.map((link) => (
              <li>
                <a href={withBase(link.href)} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayoutEn>
