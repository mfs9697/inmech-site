---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path: string) {
  if (/^(https?:)?\/\//.test(path) || path.startsWith('mailto:') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const staticPages = [
  ['Головна', '/', 'Головна сторінка Інституту механіки ім. С. П. Тимошенка НАН України.'],
  ['Новини', '/news/', 'Новини та оголошення Інституту.'],
  ['Наукові відділи', '/departments/', 'Структура наукових відділів Інституту.'],
  ['Бібліотека', '/library/', 'Монографії, навчальні видання, історичні матеріали та каталоги.'],
  ['Аспірантура', '/postgraduate/', 'Вступ, освітньо-наукова програма, акредитація, аспіранти та керівники.'],
  ['Захист дисертацій', '/dissertations/', 'Матеріали захистів дисертацій поточного та попереднього року.'],
  ['Захищені дисертації', '/defended-dissertations/', 'Алфавітний каталог дисертацій, захищених в Інституті.'],
  ['Вчена рада', '/scientific-council/', 'Вчена рада Інституту механіки.'],
  ['Науково-методична рада', '/nmr/', 'Методичне забезпечення освітньо-наукової діяльності.'],
  ['Докторантура', '/doctoral/', 'Інформація про докторантуру Інституту.'],
  ['Карта сайту', '/sitemap/', 'Структурований перелік основних сторінок сайту.'],
  ['Політика доступності', '/accessibility/', 'Політика доступності вебсайту.']
];

const news = (await getCollection('news')).map((entry) => ({
  title: entry.data.title,
  url: entry.data.externalUrl ?? `/news/${entry.id}/`,
  type: 'Новини',
  description: entry.data.description,
  keywords: [
    entry.data.category,
    ...entry.data.tags,
    String(entry.data.year),
    entry.body
  ].filter(Boolean).join(' ')
}));

const departments = (await getCollection('departments')).map((entry) => ({
  title: entry.data.title,
  url: `/departments/${entry.id}/`,
  type: 'Наукові відділи',
  description: entry.data.summary,
  keywords: [
    entry.data.shortTitle,
    entry.data.group,
    entry.data.head,
    ...entry.data.staff.map((item) => item.name),
    entry.body
  ].filter(Boolean).join(' ')
}));

const people = (await getCollection('people')).map((entry) => ({
  title: entry.data.name,
  url: `/people/${entry.id}/`,
  type: 'Співробітники',
  description: [entry.data.position, entry.data.department, entry.data.degree].filter(Boolean).join(' · '),
  keywords: [
    entry.data.nameEn,
    entry.data.academicTitle,
    entry.data.email,
    ...entry.data.researchAreas,
    entry.body
  ].filter(Boolean).join(' ')
}));

const searchItems = [
  ...staticPages.map(([title, url, description]) => ({ title, url, type: 'Сторінки', description, keywords: '' })),
  ...news,
  ...departments,
  ...people
].map((item) => ({
  ...item,
  url: withBase(item.url),
  haystack: `${item.title} ${item.type} ${item.description} ${item.keywords}`.toLocaleLowerCase('uk-UA')
}));
---

<BaseLayout
  title={`Пошук | ${site.shortName}`}
  description="Пошук по сайту Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="home"
>
  <main class="search-page">
    <section class="search-hero">
      <p class="eyebrow">Навігація</p>
      <h1>Пошук по сайту</h1>
      <p class="lead">
        Введіть прізвище, назву розділу, тему або ключове слово, щоб знайти сторінки, новини,
        наукові відділи та сторінки співробітників.
      </p>
    </section>

    <section class="search-panel" aria-label="Пошук по сайту">
      <label for="site-search">Пошуковий запит</label>
      <div class="search-row">
        <input id="site-search" type="search" placeholder="Наприклад: аспірантура, SCADAS, тензорезистори, Селіванов" autocomplete="off" />
        <button type="button" data-clear-search>Очистити</button>
      </div>
      <p class="search-help">Пошук виконується у браузері за основними сторінками та індексованими матеріалами сайту.</p>
    </section>

    <section class="search-results-section" aria-live="polite">
      <div class="results-heading">
        <h2>Результати</h2>
        <span data-results-count>Почніть вводити запит</span>
      </div>
      <div class="search-results" data-search-results></div>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ searchItems }}>
  const input = document.querySelector('#site-search');
  const clearButton = document.querySelector('[data-clear-search]');
  const results = document.querySelector('[data-search-results]');
  const count = document.querySelector('[data-results-count]');

  function escapeHtml(value) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function renderResults(query) {
    const normalizedQuery = query.trim().toLocaleLowerCase('uk-UA');

    if (!normalizedQuery) {
      results.innerHTML = '';
      count.textContent = 'Почніть вводити запит';
      return;
    }

    const words = normalizedQuery.split(/\s+/).filter(Boolean);
    const found = searchItems
      .map((item) => {
        const score = words.reduce((sum, word) => sum + (item.haystack.includes(word) ? 1 : 0), 0);
        return { ...item, score };
      })
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score || a.title.localeCompare(b.title, 'uk'))
      .slice(0, 50);

    count.textContent = found.length === 1 ? '1 результат' : `${found.length} результатів`;

    if (found.length === 0) {
      results.innerHTML = '<p class="empty-results">За цим запитом нічого не знайдено.</p>';
      return;
    }

    results.innerHTML = found.map((item) => `
      <article class="result-card">
        <span>${escapeHtml(item.type)}</span>
        <h3><a href="${item.url}">${escapeHtml(item.title)}</a></h3>
        ${item.description ? `<p>${escapeHtml(item.description)}</p>` : ''}
      </article>
    `).join('');
  }

  input?.addEventListener('input', () => renderResults(input.value));
  clearButton?.addEventListener('click', () => {
    input.value = '';
    input.focus();
    renderResults('');
  });
</script>

<style>
  .search-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 20px 72px;
  }

  .search-hero,
  .search-panel,
  .result-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .search-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .search-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 900px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .search-panel {
    margin-top: 28px;
    padding: 24px;
  }

  .search-panel label {
    display: block;
    margin-bottom: 10px;
    font-weight: 850;
  }

  .search-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  .search-row input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    font: inherit;
  }

  .search-row button {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--accent-dark);
    color: #fff;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }

  .search-help {
    margin: 12px 0 0;
    color: var(--muted);
  }

  .search-results-section {
    margin-top: 30px;
  }

  .results-heading {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-bottom: 16px;
  }

  .results-heading h2 {
    margin: 0;
  }

  .results-heading span {
    color: var(--muted);
    font-weight: 850;
  }

  .search-results {
    display: grid;
    gap: 12px;
  }

  .result-card {
    padding: 18px 20px;
  }

  .result-card span {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 8px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .result-card h3 {
    margin: 0 0 8px;
    font-size: 1.16rem;
  }

  .result-card p,
  .empty-results {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 680px) {
    .search-row,
    .results-heading {
      display: block;
    }

    .search-row button,
    .results-heading span {
      display: block;
      margin-top: 10px;
    }
  }
</style>
