---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const licenseDocs = [
  {
    title: 'Наказ про ліцензування освітньої діяльності №139 від 21.02.2018',
    href: '/documents/postgraduate/license/license-order-2018.pdf',
    type: 'PDF'
  },
  {
    title: 'Витяг з Єдиної державної електронної бази з питань освіти щодо права провадження освітньої діяльності у сфері вищої освіти',
    href: '/documents/postgraduate/license/edebo-extract.pdf',
    type: 'PDF'
  }
];

const regulationGroups = [
  {
    title: 'Організація освітнього процесу',
    description: 'Базові документи, що регламентують організацію навчання, освітній процес і педагогічну практику.',
    documents: [
      ['Положення про організацію освітнього процесу', '/documents/postgraduate/regulations/educational-process/educational-process-regulation.pdf'],
      ['Положення про педагогічну практику', '/documents/postgraduate/regulations/educational-process/pedagogical-practice-regulation.pdf'],
      ['Положення про дистанційне навчання', '/documents/postgraduate/regulations/educational-process/distance-learning-regulation.pdf'],
      ['Положення про організацію інклюзивного навчання осіб з особливими освітніми потребами', '/documents/postgraduate/regulations/educational-process/inclusive-education-regulation.pdf']
    ]
  },
  {
    title: 'Прийом, вибір дисциплін і академічна мобільність',
    description: 'Документи для організації вступу, вибору освітніх компонентів і реалізації права на академічну мобільність.',
    documents: [
      ['Положення про приймальну комісію', '/documents/postgraduate/regulations/admission/admissions-committee-regulation.pdf'],
      ['Положення про апеляційну комісію', '/documents/postgraduate/regulations/admission/appeal-committee-regulation.pdf'],
      ['Положення про порядок вільного вибору вибіркових дисциплін здобувачами вищої освіти на третьому освітньо-науковому рівні', '/documents/postgraduate/regulations/admission/elective-courses-regulation.pdf'],
      ['Положення про порядок реалізації права на академічну мобільність здобувачів вищої освіти', '/documents/postgraduate/regulations/admission/academic-mobility-regulation.pdf'],
      ['Положення про визнання результатів навчання, набутих у неформальній / інформальній освіті', '/documents/postgraduate/regulations/admission/informal-learning-recognition-regulation.pdf']
    ]
  },
  {
    title: 'Якість освіти та академічна доброчесність',
    description: 'Положення, що підтримують прозорість освітнього процесу, академічну доброчесність і врегулювання конфліктних ситуацій.',
    documents: [
      ['Положення про академічну доброчесність та етику академічних відносин', '/documents/postgraduate/regulations/quality-and-integrity/academic-integrity-regulation.pdf'],
      ['Положення про запобігання та врегулювання конфліктних ситуацій в науково-освітній діяльності', '/documents/postgraduate/regulations/quality-and-integrity/conflict-prevention-regulation.pdf'],
      ['Положення про гаранта освітньо-наукової програми', '/documents/postgraduate/regulations/quality-and-integrity/program-guarantor-regulation.pdf'],
      ['Положення про проєктну групу освітньої програми, робочу групу освітньої діяльності та групу забезпечення спеціальності', '/documents/postgraduate/regulations/quality-and-integrity/project-group-regulation.pdf']
    ]
  },
  {
    title: 'Кадрові та методичні процедури',
    description: 'Документи щодо конкурсних процедур, добору викладачів і діяльності Науково-методичної ради.',
    documents: [
      ['Положення про порядок проведення конкурсу на заміщення вакантних посад наукових працівників в Інституті механіки ім. С. П. Тимошенка НАН України', '/documents/postgraduate/regulations/staff-and-methodology/staff-competition-regulation-2021.pdf'],
      ['Положення про науково-методичну раду', '/documents/postgraduate/regulations/staff-and-methodology/nmr-regulation.pdf']
    ]
  }
];

const usefulLinks = [
  ['Етичний кодекс ученого', 'https://zakon.rada.gov.ua/rada/show/v0002550-09'],
  ['Закон України «Про вищу освіту»', 'https://zakon.rada.gov.ua/laws/show/1556-18'],
  ['Порядок підготовки здобувачів ступеня доктора філософії та доктора наук', 'https://zakon.rada.gov.ua/laws/show/261-2016-%D0%BF'],
  ['Закон України «Про наукову і науково-технічну діяльність»', 'https://zakon.rada.gov.ua/laws/show/848-19#Text'],
  ['Закон України «Про засади запобігання та протидії дискримінації в Україні»', 'https://zakon.rada.gov.ua/laws/show/5207-17#Text'],
  ['Закон України «Про запобігання корупції»', 'https://zakon.rada.gov.ua/laws/show/1700-18#Text'],
  ['Вимоги до оформлення дисертації', 'https://zakon.rada.gov.ua/laws/show/z0155-17#Text'],
  ['Опублікування результатів дисертацій на здобуття наукових ступенів', 'https://zakon.rada.gov.ua/laws/show/z1086-19'],
  ['Форма рішення разової спеціалізованої вченої ради про присудження ступеня доктора філософії', 'https://zakon.rada.gov.ua/laws/show/1556-18#Text'],
  ['Закон України «Про академічну доброчесність»', 'https://zakon.rada.gov.ua/laws/show/4742-20#Text'],
  ['Положення про акредитацію освітніх програм', 'https://naqa.gov.ua/wp-content/uploads/2024/08/%D0%9D%D0%B0%D0%BA%D0%B0%D0%B7_686_%D0%B2%D1%96%D0%B4_15052024_%D0%B4%D0%BE%D0%BE%D0%BF%D1%80%D0%B0%D1%86%D1%8C%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B9_1.pdf'],
  ['Порядок присудження ступеня доктора філософії', 'https://zakon.rada.gov.ua/laws/show/44-2022-%D0%BF#Text']
];

const relatedLinks = [
  ['Аспірантура', '/postgraduate/'],
  ['Докторантура', '/doctoral/'],
  ['Захист дисертацій', '/dissertations/'],
  ['Науково-методична рада', '/nmr/']
];
---

<BaseLayout
  title={`Ліцензії та Положення | ${site.shortName}`}
  description="Ліцензії та положення Інституту механіки ім. С. П. Тимошенка НАН України: ліцензійні документи, нормативні положення, академічна доброчесність і корисні посилання."
  activePage="education"
>
  <section class="license-hero">
    <div class="container license-hero-grid">
      <div class="license-hero-panel">
        <p class="eyebrow">Освітньо-наукова діяльність</p>
        <h1>Ліцензії та Положення</h1>
        <p class="lead">
          У цьому розділі зібрано ліцензійні документи, положення, що регламентують
          освітньо-наукову діяльність Інституту, а також корисні нормативні посилання
          щодо вищої освіти, академічної доброчесності та підготовки здобувачів.
        </p>
        <div class="license-hero-actions">
          <a class="button primary" href="#license-docs">Ліцензійні документи</a>
          <a class="button secondary" href="#regulations">Положення</a>
        </div>
      </div>

      <aside class="license-status-card">
        <span>10</span>
        <h2>ліцензований обсяг</h2>
        <p>Ліцензований обсяг освітньої діяльності становить 10 осіб.</p>
      </aside>
    </div>
  </section>

  <section class="section license-summary-section">
    <div class="container license-summary-grid">
      <article class="license-summary-card">
        <span>Ліцензія</span>
        <p>документи щодо права провадження освітньої діяльності</p>
      </article>
      <article class="license-summary-card">
        <span>Положення</span>
        <p>внутрішні регламенти освітньо-наукового процесу</p>
      </article>
      <article class="license-summary-card">
        <span>Закони</span>
        <p>корисні нормативні акти та зовнішні посилання</p>
      </article>
    </div>
  </section>

  <section class="section" id="license-docs">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Ліцензування</p>
          <h2>Ліцензійні документи</h2>
        </div>
        <p>
          Основні документи, що підтверджують право Інституту провадити освітню діяльність
          у сфері вищої освіти.
        </p>
      </div>

      <div class="license-doc-grid">
        {licenseDocs.map((document) => (
          <a class="license-doc-card" href={document.href} target="_blank" rel="noopener noreferrer">
            <span>{document.type}</span>
            <strong>{document.title}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="regulations">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Нормативна база Інституту</p>
          <h2>Положення</h2>
        </div>
        <p>
          Документи згруповано за змістом, щоб швидше знаходити потрібний регламент:
          освітній процес, вступ, мобільність, доброчесність, кадрові та методичні процедури.
        </p>
      </div>

      <div class="regulation-group-grid">
        {regulationGroups.map((group) => (
          <article class="regulation-group-card">
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <div class="regulation-link-list">
              {group.documents.map(([title, href]) => (
                <a href={href} target="_blank" rel="noopener noreferrer">{title}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="useful-links">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Корисні посилання</p>
          <h2>Зовнішні нормативні ресурси</h2>
        </div>
        <p>
          Посилання на закони, постанови та нормативні документи, що стосуються вищої освіти,
          підготовки здобувачів, академічної доброчесності, акредитації та захисту дисертацій.
        </p>
      </div>

      <div class="useful-link-grid">
        {usefulLinks.map(([title, href]) => (
          <a href={href} target="_blank" rel="noopener noreferrer">{title}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="related-panel">
        <div>
          <p class="eyebrow">Пов’язані розділи</p>
          <h2>Освітньо-наукова діяльність</h2>
        </div>
        <div class="related-link-grid">
          {relatedLinks.map(([title, href]) => (
            <a href={withBase(href)}>{title} →</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .license-hero {
    padding: 52px 0 18px;
  }

  .license-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }

  .license-hero-panel,
  .license-status-card,
  .license-summary-card,
  .license-doc-card,
  .regulation-group-card,
  .related-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .license-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .license-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.17), rgba(29, 79, 145, 0));
  }

  .license-hero-panel h1,
  .license-hero-panel .lead,
  .license-hero-panel .eyebrow,
  .license-hero-actions {
    position: relative;
    z-index: 1;
  }

  .license-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .license-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .license-status-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .license-status-card span {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 2.4rem;
    font-weight: 950;
  }

  .license-status-card h2 {
    margin: 0 0 12px;
    font-size: 1.65rem;
  }

  .license-status-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .license-summary-section {
    padding-top: 16px;
  }

  .license-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .license-summary-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: clamp(20px, 3vw, 30px);
  }

  .license-summary-card span {
    display: grid;
    place-items: center;
    min-width: 110px;
    height: 70px;
    border-radius: 22px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-weight: 950;
  }

  .license-summary-card p {
    margin: 0;
    color: var(--muted);
    font-weight: 750;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
  }

  .license-doc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .license-doc-card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding: clamp(20px, 3vw, 30px);
    color: var(--text);
  }

  .license-doc-card:hover {
    transform: translateY(-4px);
    text-decoration: none;
    border-color: rgba(29, 79, 145, 0.28);
  }

  .license-doc-card span {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 950;
  }

  .regulation-group-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .regulation-group-card {
    padding: clamp(22px, 3vw, 34px);
  }

  .regulation-group-card h3 {
    margin: 0 0 10px;
    font-size: 1.32rem;
  }

  .regulation-group-card p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .regulation-link-list,
  .useful-link-grid,
  .related-link-grid {
    display: grid;
    gap: 10px;
  }

  .regulation-link-list a,
  .useful-link-grid a,
  .related-link-grid a {
    display: block;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-soft);
    color: var(--accent-dark);
    font-weight: 780;
  }

  .regulation-link-list a:hover,
  .useful-link-grid a:hover,
  .related-link-grid a:hover {
    text-decoration: none;
    background: var(--accent-soft);
  }

  .useful-link-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .related-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: center;
    padding: clamp(22px, 3vw, 34px);
  }

  .related-panel h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.4vw, 2.2rem);
  }

  .related-link-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 1020px) {
    .related-link-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .license-hero-grid,
    .license-summary-grid,
    .license-doc-grid,
    .regulation-group-grid,
    .useful-link-grid,
    .related-panel {
      grid-template-columns: 1fr;
    }

    .section-heading {
      display: block;
    }

    .section-heading p:last-child {
      margin-top: 10px;
    }
  }

  @media (max-width: 560px) {
    .license-doc-card,
    .license-summary-card {
      grid-template-columns: 1fr;
      display: grid;
    }

    .related-link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
