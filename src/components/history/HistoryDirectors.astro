---
import { historyDirectors } from '../../data/history';
import gravePhoto from '../../data/director-images/grave.b64?raw';
import syminskiyPhoto from '../../data/director-images/syminskiy.b64?raw';
import serensenPhoto from '../../data/director-images/serensen.b64?raw';
import kornoukhovPhoto from '../../data/director-images/kornoukhov.b64?raw';
import beliankinPhoto from '../../data/director-images/beliankin.b64?raw';
import savinPhoto from '../../data/director-images/savin.b64?raw';
import kovalenkoPhoto from '../../data/director-images/kovalenko.b64?raw';
import kononenkoPhoto from '../../data/director-images/kononenko.b64?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const asJpegDataUri = (content: string) => `data:image/jpeg;base64,${content.replace(/\s+/g, '')}`;

const portraitData: Record<string, string> = {
  grave: asJpegDataUri(gravePhoto),
  syminskiy: asJpegDataUri(syminskiyPhoto),
  serensen: asJpegDataUri(serensenPhoto),
  kornoukhov: asJpegDataUri(kornoukhovPhoto),
  beliankin: asJpegDataUri(beliankinPhoto),
  savin: asJpegDataUri(savinPhoto),
  kovalenko: asJpegDataUri(kovalenkoPhoto),
  kononenko: asJpegDataUri(kononenkoPhoto)
};

const resolvePhoto = (director: (typeof historyDirectors)[number]) => {
  const photoKey = 'photoKey' in director ? director.photoKey : undefined;
  if (photoKey) return portraitData[photoKey];

  const photo = 'photo' in director ? director.photo : undefined;
  return photo ? withBase(photo) : '';
};
---

<section class="section history-content-section history-directors-section">
  <div class="container">
    <div class="section-header history-directors-header">
      <div>
        <p class="eyebrow">Керівники установи</p>
        <h2 class="section-title">Директори Інституту</h2>
        <p class="section-text">
          Від часу заснування Інститут очолювали одинадцять учених. Кожен із них працював
          у своєму історичному періоді, забезпечуючи спадкоємність наукових шкіл,
          розвиток нових напрямів і збереження академічних традицій установи.
        </p>
      </div>
    </div>

    <div class="director-grid history-director-grid">
      {historyDirectors.map((director, index) => (
        <article
          class:list={[
            'director-card',
            'history-director-card',
            director.featured && 'is-featured',
            director.current && 'is-current'
          ]}
        >
          <div class="director-photo-frame">
            <img
              src={resolvePhoto(director)}
              alt={`Портрет ${director.name}`}
              loading="lazy"
              width="240"
              height="320"
            />
          </div>

          <div class="director-card-body">
            <div class="director-card-topline">
              <span class="director-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="director-period">{director.period}</span>
            </div>
            <h3>{director.name}</h3>
            {director.note && <p>{director.note}</p>}
            {director.current && <span class="director-status">Нині очолює Інститут</span>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .history-directors-header {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .history-director-grid {
    gap: 16px;
  }

  .history-director-card {
    display: flex;
    min-height: 0;
    flex-direction: column;
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .history-director-card::after {
    content: '';
    position: absolute;
    inset: auto -36px -42px auto;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: rgba(29, 79, 145, 0.06);
    pointer-events: none;
  }

  .history-director-card.is-featured {
    border-color: rgba(184, 135, 47, 0.34);
  }

  .history-director-card.is-current {
    border-color: rgba(29, 79, 145, 0.38);
    box-shadow: 0 14px 30px rgba(15, 31, 52, 0.09);
  }

  .director-photo-frame {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--surface-soft);
  }

  .director-photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    filter: grayscale(1);
  }

  .director-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 24px 24px;
    position: relative;
    z-index: 1;
  }

  .director-card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .director-index {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .director-period {
    display: inline-flex;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 850;
  }

  .history-director-card.is-featured .director-period {
    background: rgba(184, 135, 47, 0.14);
    color: var(--gold);
  }

  .history-director-card h3 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(1.16rem, 2vw, 1.42rem);
  }

  .history-director-card p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .director-status {
    display: inline-flex;
    width: fit-content;
    margin-top: auto;
    padding-top: 16px;
    color: var(--accent-dark);
    font-size: 0.84rem;
    font-weight: 850;
  }

  @media (max-width: 900px) {
    .history-director-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .history-director-grid {
      grid-template-columns: 1fr;
    }

    .director-photo-frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>
