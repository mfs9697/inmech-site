---
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const reportTopics = [
  {
    title: 'Incorrect or outdated information',
    text: 'Let the editors know if a page contains an inaccurate title, department name, position, date, contact detail or other outdated information.'
  },
  {
    title: 'Broken link or document',
    text: 'Report links that do not open, missing documents, wrong files or materials that should be replaced with a newer version.'
  },
  {
    title: 'Mismatch between language versions',
    text: 'Tell us if the Ukrainian and English pages differ in title, structure, content, links or visible navigation.'
  },
  {
    title: 'Accessibility issue',
    text: 'Report navigation difficulties, unclear text, missing image descriptions or any other issue that makes the website harder to use.'
  }
];

const requestChecklist = [
  'the address of the page where the issue appears;',
  'a short description of what should be corrected or updated;',
  'the proposed correct text, link or document;',
  'the language version involved, if the issue affects only Ukrainian or English;',
  'a contact for clarification when the update needs approval.'
];

const updateSteps = [
  'Editors review the request and identify which pages need to be updated.',
  'Changes are prepared in a local copy of the website or in GitHub, without direct editing of published server files.',
  'For bilingual materials, Ukrainian and English versions are checked against each other.',
  'Before publication, the website passes an automated build and validation checks.',
  'After approval, the generated static version is published through GitHub Actions.'
];

const supportRoles = [
  {
    title: 'Content and structure',
    text: 'Preparation of text, coordination of departmental materials, updates to reference information and consistency between language versions.'
  },
  {
    title: 'Technical support',
    text: 'Maintenance of the website code, local development environment, automated checks, build process and publication of the static version.'
  }
];

const technicalNotes = [
  'The website is a static Astro project: pages are generated in advance and load quickly in the browser.',
  'The website source files are maintained in GitHub; GitHub is the source of truth for changes and validation.',
  'Published files on the server are not edited manually: each deployment replaces them with a generated version from the repository.'
];
---

<BaseLayoutEn
  title={`Site administration | ${siteEn.shortName}`}
  description="How to report an issue on the Institute website, suggest a content update and understand how website changes are reviewed and published."
  activePage="home"
>
  <div class="site-admin-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/en/')}>Home</a>
      <span>›</span>
      <span>Site administration</span>
    </nav>

    <section class="admin-hero">
      <p class="eyebrow">Website support</p>
      <h1>Site administration</h1>
      <p class="lead">
        This page explains who maintains the official Institute website, how visitors can
        report an error or suggest a content update, and how changes are checked before publication.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`mailto:${siteEn.email}`}>Contact the Institute</a>
        <a class="button secondary" href={withBase('/en/accessibility/')}>Accessibility policy</a>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Requests</p>
          <h2>When to contact site administration</h2>
        </div>
      </div>

      <div class="support-grid">
        {reportTopics.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block two-column">
      <article class="info-panel">
        <p class="eyebrow">What to include</p>
        <h2>How to prepare a request</h2>
        <p>
          To help editors verify and process a request quickly, please include a few
          practical details in your message.
        </p>
        <ul class="check-list">
          {requestChecklist.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="info-panel">
        <p class="eyebrow">Workflow</p>
        <h2>How the website is updated</h2>
        <ol class="step-list">
          {updateSteps.map((item) => <li>{item}</li>)}
        </ol>
      </article>
    </section>

    <section class="section-block two-column">
      <article class="info-panel">
        <p class="eyebrow">Responsibility</p>
        <h2>Who maintains the website</h2>
        <div class="role-list">
          {supportRoles.map((role) => (
            <div class="role-card">
              <strong>{role.title}</strong>
              <p>{role.text}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="info-panel">
        <p class="eyebrow">Technical basis</p>
        <h2>How the site is published</h2>
        <ul class="plain-list">
          {technicalNotes.map((note) => <li>{note}</li>)}
        </ul>
      </article>
    </section>
  </div>
</BaseLayoutEn>

<style>
  .site-admin-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 20px 72px;
  }

  .breadcrumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 22px;
    color: var(--muted);
    font-weight: 750;
  }

  .admin-hero,
  .info-card,
  .info-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .admin-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .admin-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 900px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .section-block {
    margin-top: 34px;
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card,
  .info-panel {
    padding: 24px;
  }

  .info-card h3,
  .info-panel h2 {
    margin-top: 0;
  }

  .info-card p,
  .info-panel p,
  .info-panel li {
    color: var(--muted);
    line-height: 1.65;
  }

  .two-column {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 18px;
  }

  .check-list,
  .plain-list,
  .step-list {
    margin: 18px 0 0;
    padding-left: 1.25rem;
  }

  .check-list li + li,
  .plain-list li + li,
  .step-list li + li {
    margin-top: 10px;
  }

  .role-list {
    display: grid;
    gap: 14px;
  }

  .role-card {
    padding: 16px;
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .role-card strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 1.05rem;
  }

  .role-card p {
    margin: 0;
  }

  @media (max-width: 1080px) {
    .support-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .support-grid,
    .two-column {
      grid-template-columns: 1fr;
    }
  }
</style>
