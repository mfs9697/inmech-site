        supervisor: 'Кирилюк Віталій Семенович, провідний науковий співробітник, доктор фізико-математичних наук'
      },
      {
        student: 'Лесик О. І.',
        studyYears: 'вступ 2023',
        topic: 'Плоскі задачі механіки руйнування матеріалів з взаємодіючими тріщинами за дії спрямованих вздовж тріщин зусиль',
        supervisor: 'Богданов В. Л., доктор фізико-математичних наук, академік НАН України, завідувач відділу'
      },
      {
        student: 'Ольховський А. С.',
        studyYears: 'вступ 2023',
        topic: 'Математичне моделювання впливу локальних пошкоджень та експлуатаційних навантажень на вібронапруженість лопаток останньої ступені парової турбіни АЕС',
        supervisor: 'Сенченков Ігор Константинович, доктор фізико-математичних наук, головний науковий співробітник'
      },
      {
        student: 'Селіванов Д. М.',
        studyYears: 'вступ 2023',
        topic: 'Застосування моделі когезійної зони до дослідження задач про відтерміноване руйнування тіл з тріщинами змішаної моди',
        supervisor: 'Богданов В. Л., доктор фізико-математичних наук, академік НАН України, завідувач відділу'
      }
    ]
  }
];
---

<BaseLayout
  title={`Відповідність тем аспірантів | ${site.shortName}`}
  description="Відповідність тем дисертаційних досліджень аспірантів науковій діяльності їхніх керівників."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/postgraduate/')}>Аспірантура</a>
      <span>›</span>
      <span>Відповідність тем</span>
    </nav>

    <section class="page-hero">
      <p class="eyebrow">Якість підготовки PhD</p>
      <h1>Відповідність тем аспірантів науковій діяльності керівників</h1>
      <p class="lead">
        У таблиці подано відповідність тем дисертаційних досліджень аспірантів науковій діяльності їхніх керівників:
        аспірант і роки навчання, тема дисертаційного дослідження, науковий керівник і посада.
      </p>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Зведена таблиця</p>
          <h2>Тематика дисертацій і наукова діяльність керівників</h2>
        </div>
        <p>Таблицю оформлено без списків публікацій, відповідно до формату листа.</p>
      </div>

      <div class="table-panel">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>ПІБ аспіранта, роки навчання</th>
                <th>Тема дисертаційного дослідження 2025</th>
                <th>ПІБ наукового керівника, посада 2025</th>
              </tr>
            </thead>
            <tbody>
              {topicGroups.map((group) => (
                <>
                  <tr class="year-row"><td colspan="3">{group.year}</td></tr>
                  {group.rows.map((item) => (
                    <tr>
                      <td><strong>{item.student}</strong><span>{item.studyYears}</span></td>
                      <td>{item.topic}</td>
                      <td>{item.supervisor}</td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-block note-card">
      <p class="eyebrow">Примітка</p>
      <h2>Формат таблиці</h2>
      <p>
        Ця сторінка містить лише узагальнену інформацію про відповідність тем аспірантів науковій діяльності керівників.
        Персональні списки публікацій подаються на відповідних сторінках аспірантів або керівників.
      </p>
      <div class="links-row">
        <a href={withBase('/postgraduate/students/')}>Аспіранти →</a>
        <a href={withBase('/postgraduate/supervisors/')}>Керівники →</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .postgraduate-page { max-width: 1240px; margin: 0 auto; padding: 46px 20px 72px; }
  .breadcrumbs { display: flex; gap: 10px; align-items: center; margin-bottom: 22px; color: var(--muted); font-weight: 750; }
  .page-hero, .table-panel, .note-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .page-hero { padding: clamp(28px, 5vw, 52px); }
  .page-hero h1 { margin: 0 0 18px; font-size: clamp(2.05rem, 4.5vw, 4.1rem); line-height: 1.04; letter-spacing: -0.04em; }
  .lead { max-width: 940px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .section-block { margin-top: 34px; }
  .table-panel { overflow: hidden; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; min-width: 980px; border-collapse: collapse; }
  th, td { padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  th { background: var(--accent-dark); color: #fff; font-size: 0.88rem; }
  td { color: var(--muted); line-height: 1.55; }
  td:first-child { color: var(--text); min-width: 170px; }
  td:first-child span { display: block; margin-top: 8px; color: var(--accent-dark); font-size: 0.82rem; font-weight: 850; }
  .year-row td { background: var(--accent-soft); color: var(--accent-dark); font-weight: 900; text-align: center; letter-spacing: 0.04em; }
  .note-card { padding: 26px; }
  .note-card h2 { margin-top: 0; }
  .note-card p { max-width: 920px; color: var(--muted); line-height: 1.7; }
  .links-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .links-row a { padding: 8px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-dark); font-weight: 850; text-decoration: none; }
  .links-row a:hover { text-decoration: none; background: rgba(29, 79, 145, 0.16); }
</style>
