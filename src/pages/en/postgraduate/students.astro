---
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import { siteEn } from '../../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) return path;
  const cleanPath = path.replace(/^\/inmech-site(?=\/)/, '');
  return `${base}${cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`}`;
}
const photoBase = '/people/';

const studentGroups = [
  {
    year: 'Admission 2025',
    badge: '1st year',
    students: [
      { name: 'Roman Hrysevych', nameUk: 'Грисевич Роман Юрійович', photo: `${photoBase}hrysevych.png`, topic: 'Theoretical and experimental modelling of deformation of hand prosthesis elements under static, quasi-static and dynamic loading', supervisor: 'Volodymyr A. Maksymyuk, Doctor of Physical and Mathematical Sciences', publications: 0, materials: 1 },
      { name: 'Yurii Nazarchuk', nameUk: 'Назарчук Юрій Олександрович', photo: `${photoBase}nazarchuk.png`, topic: 'Fracture of viscoelastic piecewise-inhomogeneous materials with cohesive interfaces: application to asphalt concrete', supervisor: 'Mykhailo F. Selivanov, Doctor of Physical and Mathematical Sciences, Corresponding Member of the NAS of Ukraine', publications: 1, materials: 1 },
      { name: 'Oleksandr Proshchenko', nameUk: 'Прощенко Олександр Анатолійович', photo: `${photoBase}proshchenko.png`, topic: 'Plane fracture problems for materials compressed along parallel cracks with centres shifted in the compression direction', supervisor: 'Volodymyr M. Nazarenko, Academician of the NAS of Ukraine', publications: 2, materials: 1 },
      { name: 'Oleksii Syniavskyi', nameUk: 'Синявський Олексій Ігорович', photo: `${photoBase}syniavskyi.png`, topic: 'Compression of thin-film systems along the interface between a film and a substrate of finite thickness', supervisor: 'Volodymyr M. Nazarenko, Academician of the NAS of Ukraine', publications: 2, materials: 1 }
    ]
  },
  {
    year: 'Admission 2024',
    badge: '2nd year',
    students: [
      { name: 'Roman Serafymovych', nameUk: 'Серафимович Роман Вікторович', photo: `${photoBase}serafymovych.png`, topic: 'Physically nonlinear problems for a three-layer cylindrical shell with openings', supervisor: 'Yevhen A. Storozhuk, Doctor of Physical and Mathematical Sciences, Professor, Corresponding Member of the NAS of Ukraine', publications: 5, materials: 3 },
      { name: 'Vasyl Usov', nameUk: 'Усов Василь Олександрович', photo: `${photoBase}usov.png`, topic: 'Numerical modelling of thermomechanical processes in layer-by-layer printing of bodies of revolution made of viscoplastic material', supervisor: 'Ihor K. Senchenkov, Doctor of Physical and Mathematical Sciences', publications: 2, materials: 2 },
      { name: 'Yevhen Fil', nameUk: 'Філь Євген Вадимович', photo: `${photoBase}fil.png`, topic: 'Numerical analysis of the stress-strain state of shallow orthotropic shells with non-rectangular planform', supervisor: 'Oleksandr Ya. Grygorenko, Doctor of Physical and Mathematical Sciences, Professor, Academician of the NAS of Ukraine', publications: 3, materials: 1 }
    ]
  },
  {
    year: 'Admission 2023',
    badge: '3rd year',
    students: [
      { name: 'Yurii Horskyi', nameUk: 'Горський Юрій Вікторович', photo: `${photoBase}horskyi.png`, topic: 'Generation of cross-shaped surface waves in water in a cylindrical container with vibrating walls under acoustic radiation', supervisor: 'Yaroslav O. Zhuk, Doctor of Physical and Mathematical Sciences, Corresponding Member of the NAS of Ukraine, Professor', publications: 4, materials: 0 },
      { name: 'Petro Kobzar', nameUk: 'Кобзар Петро Юрійович', photo: `${photoBase}kobzar.png`, topic: 'Modelling stress distribution in a piezoelectric body near rigid flat inclusions and circular or elliptical cracks', supervisor: 'Vitalii S. Kyryliuk, Doctor of Physical and Mathematical Sciences', publications: 4, materials: 0 },
      { name: 'Oleksii Lesyk', nameUk: 'Лесик Олексій Іванович', photo: `${photoBase}lesyk.png`, topic: 'Plane fracture mechanics problems for materials with interacting cracks under forces directed along the cracks', supervisor: 'Viacheslav L. Bogdanov, Academician of the NAS of Ukraine, Doctor of Physical and Mathematical Sciences', publications: 4, materials: 0 },
      { name: 'Anton Olkhovskyi', nameUk: 'Ольховський Антон Стефанович', photo: `${photoBase}olkhovskyi.png`, topic: 'Mathematical modelling of the influence of local damage and operational loads on vibration stresses in last-stage blades of an NPP steam turbine', supervisor: 'Ihor K. Senchenkov, Doctor of Physical and Mathematical Sciences', publications: 10, materials: 0 }
    ]
  }
];

function initials(name: string) {
  return name.split(/\s+/).slice(0, 2).map((part) => part[0]).join('');
}
---

<BaseLayoutEn
  title={`Postgraduate students | ${siteEn.shortName}`}
  description="Postgraduate students of the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine: years of admission, dissertation topics, research supervisors and available materials."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href={withBase('/en/postgraduate/')}>Postgraduate studies</a><span>›</span><span>Students</span></nav>
    <section class="page-hero"><p class="eyebrow">Postgraduate students</p><h1>PhD candidates by year of admission</h1><p class="lead">This page presents postgraduate students, dissertation topics, research supervisors and the number of available publications or learning materials listed in the Ukrainian source section.</p><p><a href={withBase('/postgraduate/students/')}>Ukrainian version with detailed publication links</a></p></section>
    {studentGroups.map((group) => (
      <section class="section-block"><div class="section-heading compact-header"><div><p class="eyebrow">{group.badge}</p><h2>{group.year}</h2></div></div><div class="student-grid">{group.students.map((student) => (<article class="student-card"><div class="student-photo-frame">{student.photo && (<img src={withBase(student.photo)} alt={`Photo: ${student.name}`} loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />)}<div class="avatar avatar-fallback" aria-hidden="true">{initials(student.name)}</div></div><div><h3>{student.name}</h3><p class="uk-name">{student.nameUk}</p><p class="label">Dissertation topic</p><p>{student.topic}</p><p class="label">Research supervisor</p><p>{student.supervisor}</p><div class="meta-row"><span>{student.publications} publication{student.publications === 1 ? '' : 's'}</span><span>{student.materials} material{student.materials === 1 ? '' : 's'}</span></div></div></article>))}</div></section>
    ))}
  </main>
</BaseLayoutEn>

<style>
  .postgraduate-page{max-width:1180px;margin:0 auto;padding:46px 20px 72px}.breadcrumbs{display:flex;gap:10px;align-items:center;margin-bottom:22px;color:var(--muted);font-weight:750}.page-hero,.student-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}.page-hero{padding:clamp(28px,5vw,52px)}.page-hero h1{margin:0 0 18px;font-size:clamp(2.2rem,4.8vw,4.3rem);line-height:1.04;letter-spacing:-.04em}.lead{max-width:920px;color:var(--muted);font-size:1.08rem;line-height:1.7}.section-block{margin-top:34px}.student-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.student-card{display:grid;grid-template-columns:100px 1fr;gap:18px;padding:22px}.student-photo-frame,.student-photo-frame img,.avatar{width:100px;height:120px;border-radius:22px}.student-photo-frame{border:1px solid var(--line);overflow:hidden;background:var(--surface-soft)}.student-photo-frame img{display:block;object-fit:cover}.avatar{display:grid;place-items:center;color:var(--accent-dark);font-weight:850}.avatar-fallback{display:none}.student-card p{color:var(--muted);line-height:1.55}.uk-name{font-size:.92rem}.label{margin:12px 0 4px!important;color:var(--text)!important;font-weight:850}.meta-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.meta-row span{padding:6px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent-dark);font-size:.8rem;font-weight:800}@media(max-width:860px){.student-grid{grid-template-columns:1fr}.student-card{grid-template-columns:1fr}}
</style>
