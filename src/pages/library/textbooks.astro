---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import {
  textbooks,
  textbookCategories,
  textbookYears,
  textbookLibraryOfCongressCount
} from '../../data/textbooks';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}
---

<BaseLayout
  title={`Підручники та навчальні посібники | ${site.shortName}`}
  description="Підручники, навчальні посібники та навчально-наукові матеріали співробітників Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="home"
>
  <section class="textbooks-hero">
    <div class="container textbooks-hero-panel">
      <div>
        <p class="eyebrow">Бібліотека</p>
        <h1>Підручники та навчальні посібники</h1>
        <p class="lead">
          Навчальні видання, курси лекцій і посібники з механіки, математики,
          теорії оболонок, термопружності, стійкості, чисельних методів та суміжних напрямів,
          підготовлені співробітниками Інституту або пов’язані з його науковими школами.
        </p>
      </div>
      <div class="textbooks-stats" aria-label="Статистика навчальних видань">
        <strong>{textbooks.length}</strong>
        <span>видань</span>
        <small>{textbookYears.at(-1)}–{textbookYears[0]}</small>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Каталог</p>
          <h2>Навчальні видання</h2>
        </div>
        <p>
          Записи перенесено зі старого бібліотечного розділу та подано у стислому
          бібліографічному форматі. Позначка «Бібліотека Конгресу» відповідає зірочці
          на старій сторінці бібліотеки.
        </p>
      </div>

      <div class="textbooks-toolbar">
        <a href={withBase('/library/')}>← До бібліотеки</a>
        <span>{textbookCategories.length} тематичних напрямів · {textbookLibraryOfCongressCount} у Бібліотеці Конгресу США</span>
      </div>

      <div class="year-groups">
        {textbookYears.map((year) => {
          const items = textbooks.filter((item) => item.year === year);
          return (
            <section class="year-group" id={`year-${year}`}>
              <div class="year-header">
                <h3>{year}</h3>
                <span>{items.length} {items.length === 1 ? 'видання' : 'видань'}</span>
              </div>

              <div class="textbook-grid">
                {items.map((item) => (
                  <article class="textbook-card">
                    <div class="textbook-card-topline">
                      <span>{item.category}</span>
                      <strong>{item.type}</strong>
                    </div>
                    <h4>{item.title}</h4>
                    <p class="authors">{item.authors}</p>
                    <p class="details">
                      {item.publisher}{item.pages ? `, ${item.pages}` : ''}{'isbn' in item && item.isbn ? `; ISBN ${item.isbn}` : ''}.
                    </p>
                    {item.inLibraryOfCongress && (
                      <p class="loc-badge">Бібліотека Конгресу США</p>
                    )}
                    {item.url && (
                      <a class="card-link" href={item.url} target="_blank" rel="noopener noreferrer">Електронний ресурс →</a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .textbooks-hero {
    padding: 52px 0 18px;
  }

  .textbooks-hero-panel,
  .textbook-card,
  .year-group {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .textbooks-hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 5vw, 54px);
    overflow: hidden;
    position: relative;
  }

  .textbooks-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 300px;
    height: 300px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.14), rgba(29, 79, 145, 0));
  }

  .textbooks-hero-panel > * {
    position: relative;
    z-index: 1;
  }

  .textbooks-hero-panel h1 {
    margin: 0 0 18px;
    max-width: 900px;
    font-size: clamp(2rem, 4.2vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .textbooks-stats {
    display: grid;
    place-items: center;
    min-width: 158px;
    min-height: 158px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(29, 79, 145, 0.10), rgba(184, 135, 47, 0.16));
    border: 1px solid var(--line);
    text-align: center;
  }

  .textbooks-stats strong {
    display: block;
    color: var(--accent-dark);
    font-size: 3rem;
    line-height: 1;
  }

  .textbooks-stats span,
  .textbooks-stats small {
    color: var(--muted);
    font-weight: 850;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 20px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 590px;
    margin: 0;
    color: var(--muted);
  }

  .textbooks-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 18px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface-soft);
  }

  .textbooks-toolbar a {
    color: var(--accent-dark);
    font-weight: 900;
  }

  .textbooks-toolbar span {
    color: var(--muted);
    font-weight: 850;
  }

  .year-groups {
    display: grid;
    gap: 18px;
  }

  .year-group {
    padding: clamp(18px, 3vw, 28px);
  }

  .year-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .year-header h3 {
    margin: 0;
    color: var(--accent-dark);
    font-size: 1.45rem;
  }

  .year-header span {
    color: var(--muted);
    font-weight: 850;
  }

  .textbook-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .textbook-card {
    display: flex;
    flex-direction: column;
    padding: 18px;
    box-shadow: none;
    background: var(--surface-soft);
  }

  .textbook-card-topline {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    margin-bottom: 12px;
  }

  .textbook-card-topline span {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .textbook-card-topline strong {
    color: var(--gold);
    font-size: 0.86rem;
    text-align: right;
  }

  .textbook-card h4 {
    margin: 0 0 10px;
    color: var(--accent-dark);
    font-size: 1.08rem;
    line-height: 1.28;
  }

  .authors {
    margin: 0 0 10px;
    color: var(--text);
    font-weight: 850;
  }

  .details {
    margin: 0 0 14px;
    color: var(--muted);
    line-height: 1.45;
  }

  .loc-badge {
    display: inline-flex;
    width: fit-content;
    margin: 0 0 14px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(184, 135, 47, 0.14);
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .textbook-card .card-link {
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .textbooks-hero-panel,
    .section-heading,
    .textbooks-toolbar,
    .year-header {
      display: block;
    }

    .textbooks-stats,
    .section-heading p:last-child,
    .textbooks-toolbar span,
    .year-header span {
      margin-top: 14px;
    }

    .textbook-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
