---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NcutamNav from '../../../components/NcutamNav.astro';
import NcutamMembers from '../../../components/ncutam/NcutamMembers.astro';
import { ncutamSite } from '../../../data/ncutam/site';
import { site } from '../../../data/site';

const title = 'Світлій пам’яті членів Комітету';
const description = 'Меморіальний реєстр учених, які входили до складу Національного комітету України з теоретичної і прикладної механіки.';
---

<BaseLayout title={`${title} | ${ncutamSite.acronym} | ${site.shortName}`} description={description} activePage="ncutam">
  <NcutamNav language="uk" active="members" />

  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{ncutamSite.acronym}</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <NcutamMembers language="uk" status="in-memoriam" />
    </div>
  </section>
</BaseLayout>
