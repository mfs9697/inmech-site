---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayoutEn from '../../../../layouts/BaseLayoutEn.astro';
import NewsCardEn from '../../../../components/NewsCardEn.astro';
import { siteEn } from '../../../../data/site-en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const currentYear = new Date().getFullYear();
const maxVisibleTags = 10;

type NewsEntry = CollectionEntry<'news'>;
const getEnglishTags = (entry: NewsEntry) => entry.data.tagsEn ?? [];

function getEnglishTagCounts(entries: NewsEntry[]) {
  const tagCounts = new Map<string, number>();

  entries.forEach((entry) => {
    getEnglishTags(entry).forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
  });

  return tagCounts;
}

function getTopEnglishTags(entries: NewsEntry[], limit: number) {
  return [...getEnglishTagCounts(entries).entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'en'))
    .slice(0, limit)
    .map(([tag]) => tag);
}

function getVisibleTags(entries: NewsEntry[], activeTag: string, limit: number) {
  const topTags = getTopEnglishTags(entries, limit);

  if (!activeTag || topTags.includes(activeTag) || topTags.length < limit) {
    return topTags;
  }

  return [...topTags.slice(0, limit - 1), activeTag];
}

const allCurrentNews = (await getCollection('news'))
  .filter((entry) => entry.data.year === currentYear || entry.data.date.getFullYear() === currentYear)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

export async function getStaticPaths() {
  const buildYear = new Date().getFullYear();
  const entries = (await getCollection('news'))
    .filter((entry) => entry.data.year === buildYear || entry.data.date.getFullYear() === buildYear);

  const tags = new Set<string>();

  entries.forEach((entry) => {
    (entry.data.tagsEn ?? []).forEach((tag) => tags.add(tag));
  });

  return [...tags]
    .sort((a, b) => a.localeCompare(b, 'en'))
    .map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const decodedTag = decodeURIComponent(tag ?? '');
const tags = getVisibleTags(allCurrentNews, decodedTag, maxVisibleTags);
const news = allCurrentNews.filter((entry) => getEnglishTags(entry).includes(decodedTag));
---

<BaseLayoutEn
  title={`${decodedTag} | News ${currentYear} | ${siteEn.shortName}`}
  description={`News tagged “${decodedTag}” from the S.P. Timoshenko Institute of Mechanics of the NAS of Ukraine.`}
  activePage="news"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">News tag</p>
        <h1>{decodedTag}</h1>
        <p class="lead">News and announcements for {currentYear} tagged “{decodedTag}”.</p>
        <nav class="tag-nav" aria-label="Filter news by tags">
          <a class="tag-filter" href={withBase('/en/news/')}>All news</a>
          {tags.map((item) => (
            <a class:list={["tag-filter", { active: item === decodedTag }]} href={withBase(`/en/news/tags/${encodeURIComponent(item)}/`)}>{item}</a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {news.length > 0 ? (
        <div class="news-list">
          {news.map((entry) => <NewsCardEn entry={entry} />)}
        </div>
      ) : (
        <div class="empty-news-panel">
          <h2>No news has been found for this tag</h2>
        </div>
      )}
    </div>
  </section>
</BaseLayoutEn>

<style>
  .tag-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .tag-filter {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 750;
    text-decoration: none;
  }

  .tag-filter:hover,
  .tag-filter.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    text-decoration: none;
  }

  .empty-news-panel {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .empty-news-panel h2 {
    margin-top: 0;
  }
</style>
