---
import { historyDirectors } from '../../data/history';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<section class="section history-content-section history-directors-section" id="directors">
  <div class="container">
    <div class="section-header history-directors-header panel">
      <div>
        <p class="eyebrow">Керівники установи</p>
        <h2 class="section-title">Директори Інституту</h2>
        <p class="section-text">
          Від часу заснування Інститут очолювали одинадцять учених. Кожен із них працював
          у своєму історичному періоді, забезпечуючи спадкоємність наукових шкіл,
          розвиток нових напрямів і збереження академічних традицій установи.
        </p>
      </div>
    </div>

    <div class="director-grid history-director-grid">
      {historyDirectors.map((director) => (
        <article
          class:list={[
            'panel',
            'history-director-card',
            director.featured && 'is-featured',
            director.current && 'is-current',
            director.url && 'is-linked'
          ]}
        >
          {director.url ? (
            <a class="history-director-card-link" href={withBase(director.url)} aria-label={`${director.name}: докладніше`}>
              <img
                src={withBase(director.photo)}
                alt={`Портрет ${director.name}`}
                loading="lazy"
                width="120"
                height="160"
              />
              <div class="history-director-caption">
                <strong>{director.name}</strong>
                <span class="director-period">{director.period}</span>
                {director.note && <small>{director.note}</small>}
                <span class="director-more">Докладніше →</span>
              </div>
            </a>
          ) : (
            <>
              <img
                src={withBase(director.photo)}
                alt={`Портрет ${director.name}`}
                loading="lazy"
                width="120"
                height="160"
              />
              <div class="history-director-caption">
                <strong>{director.name}</strong>
                <span class="director-period">{director.period}</span>
                {director.note && <small>{director.note}</small>}
                {director.current && <small class="director-status">Нині очолює Інститут</small>}
              </div>
            </>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .history-directors-header {
    width: 100%;
    max-width: none;
    margin-bottom: 28px;
    padding: clamp(24px, 4vw, 40px);
  }

  .history-directors-header p:last-child {
    margin-bottom: 0;
  }

  .history-director-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .history-director-card {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 18px;
    text-align: center;
  }

  .history-director-card.is-featured {
    border-color: rgba(184, 135, 47, 0.34);
  }

  .history-director-card.is-current {
    border-color: rgba(29, 79, 145, 0.38);
    box-shadow: 0 10px 22px rgba(15, 31, 52, 0.09);
  }

  .history-director-card.is-linked {
    padding: 0;
    overflow: hidden;
  }

  .history-director-card-link {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding: 18px;
    color: inherit;
    text-decoration: none;
  }

  .history-director-card-link:hover {
    background: rgba(184, 135, 47, 0.06);
    text-decoration: none;
  }

  .history-director-card img {
    display: block;
    width: 120px;
    height: 160px;
    object-fit: cover;
    object-position: center 22%;
    border-radius: 12px;
    filter: grayscale(1);
  }

  .history-director-card-link:hover img {
    filter: grayscale(0.35);
  }

  .history-director-caption {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 100%;
    margin-top: 14px;
  }

  .history-director-caption > strong {
    color: var(--heading);
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .director-period {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .history-director-card small {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .director-status {
    color: var(--accent-dark) !important;
    font-weight: 850;
  }

  .director-more {
    margin-top: 2px;
    color: var(--accent-dark);
    font-size: 0.76rem;
    font-weight: 850;
  }

  @media (max-width: 1100px) {
    .history-director-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .history-director-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .history-director-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 400px) {
    .history-director-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
