---
import { getCollection } from 'astro:content';
import BaseLayoutEn from '../../../layouts/BaseLayoutEn.astro';
import NcutamNav from '../../../components/NcutamNav.astro';
import NcutamActivityList from '../../../components/ncutam/NcutamActivityList.astro';
import NcutamEvergreen from '../../../components/ncutam/NcutamEvergreen.astro';
import NcutamGovernance from '../../../components/ncutam/NcutamGovernance.astro';
import NcutamMembers from '../../../components/ncutam/NcutamMembers.astro';
import NewsCardEn from '../../../components/NewsCardEn.astro';
import { ncutamSections, ncutamSite } from '../../../data/ncutam/site';
import { siteEn } from '../../../data/site-en';

export function getStaticPaths() {
  return ncutamSections.map((section) => ({ params: { section: section.id }, props: { section } }));
}

const { section } = Astro.props as { section: (typeof ncutamSections)[number] };
const isNews = section.id === 'news';
const isGovernance = section.id === 'governance';
const isMembers = section.id === 'members';
const isActivity = section.id === 'activity';
const isEvergreen = section.id === 'about' || section.id === 'iutam';
const ncutamNews = isNews
  ? (await getCollection('news'))
      .filter((entry) => entry.data.scopes.includes('ncutam'))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  : [];
---

<BaseLayoutEn title={`${section.titleEn} | ${ncutamSite.acronymEn} | ${siteEn.shortName}`} description={section.descriptionEn} activePage="ncutam">
  <NcutamNav language="en" active={section.id} />

  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{ncutamSite.acronymEn}</p>
        <h1>{section.titleEn}</h1>
        <p class="lead">{section.descriptionEn}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {isNews ? (
        ncutamNews.length > 0 ? (
          <div class="news-list">
            {ncutamNews.map((entry) => <NewsCardEn entry={entry} />)}
          </div>
        ) : (
          <div class="panel ncutam-build-panel"><h2>No NCUTAM news has been added yet</h2></div>
        )
      ) : isGovernance ? (
        <NcutamGovernance language="en" />
      ) : isMembers ? (
        <NcutamMembers language="en" status="active" />
      ) : isActivity ? (
        <NcutamActivityList language="en" />
      ) : isEvergreen ? (
        <NcutamEvergreen pageId={section.id} language="en" />
      ) : (
        <div class="panel ncutam-build-panel">
          <h2>Section ready for content migration</h2>
          <p>Verified content and structured records will be added in the next WP6 content-import batches according to the WP5 migration map.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayoutEn>

<style>
  .ncutam-build-panel { max-width: 900px; }
  .ncutam-build-panel h2 { margin-top: 0; }
  .ncutam-build-panel p { margin-bottom: 0; color: var(--muted); line-height: 1.7; }
</style>
