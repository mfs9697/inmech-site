---

<BaseLayout
  title={`Захист дисертацій | ${site.shortName}`}
  description="Захист дисертацій в Інституті механіки ім. С. П. Тимошенка НАН України: актуальні захисти, матеріали поточного і попереднього року та каталог захищених дисертацій."
  activePage="education"
>
  <section class="defense-hero">
    <div class="container defense-hero-grid">
      <div class="defense-hero-panel">
        <p class="eyebrow">Освітньо-наукова діяльність</p>
        <h1>Захист дисертацій</h1>
        <p class="lead">
          На цій сторінці подано матеріали захистів поточного та попереднього року.
          Старіші записи перенесено до окремого каталогу дисертацій, захищених в Інституті механіки.
        </p>
        <div class="defense-hero-actions">
          <a class="button primary" href="#announcements">Поточний і попередній рік</a>
          <a class="button secondary" href={withBase('/defended-dissertations/')}>Каталог захищених дисертацій</a>
        </div>
      </div>

      <aside class="defense-stat-card">
        <span>{featuredDefenses.length}</span>
        <h2>захисти 2026–2025</h2>
        <p>Детальні картки з документами, опонентами та відеоматеріалами.</p>
      </aside>
    </div>
  </section>

  <section class="section defense-summary-section">
    <div class="container defense-summary-grid">
      <article class="defense-summary-card">
        <span>2026</span>
        <p>матеріали поточного року</p>
      </article>
      <article class="defense-summary-card">
        <span>2025</span>
        <p>матеріали попереднього року</p>
      </article>
      <article class="defense-summary-card">
        <span>Каталог</span>
        <p>повний історичний каталог і старіший архів матеріалів</p>
      </article>
    </div>
  </section>

  <section class="section" id="announcements">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Поточний і попередній рік</p>
          <h2>Матеріали захистів</h2>
        </div>
        <p>
          Для захистів поточного та попереднього року подано повні картки з ключовими
          відомостями, доступними файлами та, за наявності, відгуками офіційних опонентів.
        </p>
      </div>

      <div class="featured-defense-list">
        {featuredDefenses.map((defense) => (
          <article class="featured-defense-card">
            <div class="featured-defense-header">
              <div>
                <span class="defense-status">{defense.status}</span>
                <h3>{defense.name}</h3>
              </div>
              <span class="defense-year">{defense.year}</span>
            </div>

            <p class="defense-title">{defense.title}</p>

            <dl class="defense-meta-grid">
              <div>
                <dt>Дата захисту</dt>
                <dd>{defense.date}</dd>
              </div>
              <div>
                <dt>Місце</dt>
                <dd>{defense.place}</dd>
              </div>
              <div>
                <dt>Науковий ступінь</dt>
                <dd>{defense.degree}</dd>
              </div>
              <div>
                <dt>Спеціальність</dt>
                <dd>{defense.specialty}</dd>
              </div>
            </dl>

            {defense.consultant && (
              <p class="consultant-line"><strong>Науковий консультант:</strong> {defense.consultant}</p>
            )}

            {defense.links.length > 0 && (
              <div class="defense-links">
                {defense.links.map(([label, href]) => (
                  <a href={withBase(href)} target="_blank" rel="noopener noreferrer">{label}</a>
                ))}
              </div>
            )}

            <details class="opponents-details">
              <summary>Офіційні опоненти</summary>
              {defense.opponents.length > 0 ? (
                <div class="opponents-grid">
                  {defense.opponents.map(([name, degree, href]) => (
                    <a class="opponent-card" href={withBase(href)} target="_blank" rel="noopener noreferrer">
                      <strong>{name}</strong>
                      <span>{degree}</span>
                      <em>Переглянути відгук →</em>
                    </a>
                  ))}
                </div>
              ) : (
                <p class="opponents-empty">Відгуки офіційних опонентів буде додано після надходження.</p>
              )}
            </details>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section catalog-cta-section">
    <div class="container">
      <div class="catalog-cta-panel">
        <div>
          <p class="eyebrow">Повний архів</p>
          <h2>Каталог дисертацій, захищених в Інституті механіки</h2>
          <p>
            Старіші матеріали захистів і бібліографічний каталог дисертацій розміщено
            на окремій сторінці. Там зібрано історичні записи, алфавітний каталог і архів
            матеріалів попередніх років.
          </p>
        </div>
        <a class="button primary" href={withBase('/defended-dissertations/')}>Перейти до каталогу</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .defense-hero {
    padding: 52px 0 18px;
  }

  .defense-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }

  .defense-hero-panel,
  .defense-stat-card,
  .defense-summary-card,
  .featured-defense-card,
  .catalog-cta-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .defense-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .defense-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.17), rgba(29, 79, 145, 0));
  }

  .defense-hero-panel h1,
  .defense-hero-panel .lead,
  .defense-hero-panel .eyebrow,
  .defense-hero-actions {
    position: relative;
    z-index: 1;
  }

  .defense-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .defense-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .defense-stat-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .defense-stat-card span {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 2.2rem;
    font-weight: 950;
  }

  .defense-stat-card h2 {
    margin: 0 0 12px;
    font-size: 1.65rem;
  }

  .defense-stat-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .defense-summary-section {
    padding-top: 16px;
  }

  .defense-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .defense-summary-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: clamp(20px, 3vw, 30px);
  }

  .defense-summary-card span {
    display: grid;
    place-items: center;
    min-width: 92px;
    height: 72px;
    border-radius: 22px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-weight: 950;
    font-size: 1.1rem;
  }

  .defense-summary-card p {
    margin: 0;
    color: var(--muted);
    font-weight: 750;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 540px;
    margin: 0;
    color: var(--muted);
  }

  .featured-defense-list {
    display: grid;
    gap: 18px;
  }

  .featured-defense-card {
    padding: clamp(22px, 3.5vw, 36px);
  }

  .featured-defense-header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .defense-status,
  .defense-year {
    display: inline-flex;
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
