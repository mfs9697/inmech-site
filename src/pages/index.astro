---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeNewsBlock from '../components/HomeNewsBlock.astro';
import DepartmentCard from '../components/DepartmentCard.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const departments = (await getCollection('departments'))
  .sort((a, b) => a.data.order - b.data.order);

const groupedDepartments = [...departments.reduce((acc, entry) => {
  const group = entry.data.group;
  if (!acc.has(group)) acc.set(group, []);
  acc.get(group)?.push(entry);
  return acc;
}, new Map<string, typeof departments>())].map(([group, entries], index) => {
  const departmentCount = entries.filter((entry) => entry.id !== 'lms-scadas-mobile-center').length;

  return {
    group,
    entries,
    departmentCount,
    id: `home-department-group-${index + 1}`
  };
});
---

<BaseLayout
  title={`${site.name}`}
  description={site.description}
  activePage="home"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card hero-card-visual" data-block-tone="neutral">
        <div class="hero-text">
          <p class="eyebrow">Національна академія наук України</p>
          <h1>Інститут механіки ім. С.П. Тимошенка НАН України</h1>
          <p class="lead">
            Провідна наукова установа НАН України, що здійснює фундаментальні та прикладні дослідження
            в галузі механіки деформівного твердого тіла, динаміки, стійкості, термопружності,
            повзучості, механіки руйнування та механіки композитних матеріалів.
          </p>
        </div>

        <figure class="hero-image-card">
          <img src={withBase('/assets/img/institute-logo-hero.png')} alt="Логотип Інституту механіки ім. С.П. Тимошенка" loading="eager" />
          <div class="hero-actions hero-image-actions">
            <a class="button primary" href={withBase('/departments/')}>Наукові відділи</a>
            <a class="button secondary" href={withBase('/news/')}>Останні новини</a>
          </div>
        </figure>
      </div>

      <aside class="aside-card" data-block-tone="emphasis" aria-labelledby="institute-sites-title">
        <h2 id="institute-sites-title">Інститутські сайти</h2>
        <p>
          Окремі інформаційні ресурси Інституту для спеціалізованих проєктів, подій та інституційних оголошень.
        </p>
        <ul class="aside-list">
          <li>
            <a href="https://natcommmech.inmech.kyiv.ua/" target="_blank" rel="noopener">
              Національний комітет України з теоретичної і прикладної механіки
            </a>
          </li>
          <li>
            <a href="https://election.inmech.kyiv.ua/" target="_blank" rel="noopener">
              Вибори директора Інституту 2026
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" id="news">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Останні повідомлення</p>
          <h2 class="section-title">Новини Інституту</h2>
          <p class="section-text">
            Актуальна інформація про наукові події, семінари, публікації, оголошення та діяльність Інституту.
          </p>
        </div>
        <div class="lang-switch news-block-switch" aria-label="Перемикання мови блоку новин">
          <a class="active" href={withBase('/#news')} aria-current="page">Українська</a>
          <a href={withBase('/en/#news')}>English</a>
        </div>
      </div>

      <HomeNewsBlock entries={news} archiveHref="/news/" lang="uk" />
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Про інститут</p>
          <h2 class="section-title">Наукова школа, дослідження та інженерні застосування</h2>
          <p class="section-text">
            Інститут механіки ім. С.П. Тимошенка НАН України проводить дослідження у ключових напрямах
            теоретичної та прикладної механіки, поєднуючи розвиток математичних моделей, експериментальні
            дослідження, чисельне моделювання та впровадження результатів у практику.
          </p>
        </div>
      </div>

      <div class="home-about-feature" data-block-tone="heritage">
        <div class="home-about-copy">
          <p class="eyebrow">Засновник і спадкоємність</p>
          <h3>Інститут, що виріс з ідеї поєднання науки і техніки</h3>
          <p>
            С.П. Тимошенко — видатний учений-механік, один із фундаторів Української академії наук,
            засновник і перший директор Інституту механіки. Його ідея зближення фундаментальної науки
            та інженерної практики залишається важливою частиною місії Інституту.
          </p>
          <div class="home-about-actions">
            <a class="button primary" href={withBase('/founder/')}>Засновник Інституту</a>
            <a class="button secondary" href={withBase('/history/')}>Історія і сучасність</a>
          </div>
        </div>

        <figure class="home-about-figure">
          <img src={withBase('/assets/img/institute-main-building-sketch.svg')} alt="Ескіз головної будівлі Інституту механіки ім. С.П. Тимошенка" loading="lazy" />
          <figcaption>Головна будівля Інституту механіки ім. С.П. Тимошенка НАН України.</figcaption>
        </figure>
      </div>

      <div class="cards-grid">
        <article class="card" data-block-tone="neutral">
          <h3>Наукові дослідження</h3>
          <p>
            Розв’язання фундаментальних і прикладних задач механіки суцільного середовища,
            матеріалознавства, міцності, довговічності та надійності конструкцій.
          </p>
          <a class="card-link" href={withBase('/departments/')}>Переглянути напрями →</a>
        </article>

        <article class="card" data-block-tone="neutral">
          <h3>Освітньо-наукова діяльність</h3>
          <p>
            Підготовка наукових кадрів, аспірантура, докторантура, спеціалізовані вчені ради,
            наукові семінари та участь молодих учених у дослідницьких проєктах.
          </p>
          <a class="card-link" href={withBase('/education/')}>Аспірантура та докторантура →</a>
        </article>

        <article class="card" data-block-tone="neutral">
          <h3>Публікації та співпраця</h3>
          <p>
            Видання наукових журналів, міжнародна співпраця, конференції, бібліотечні матеріали
            та поширення результатів досліджень у світовому науковому просторі.
          </p>
          <div class="card-links-stack">
            <a class="card-link" href={withBase('/journal/')}>Журнал «Прикладна механіка» →</a>
            <a class="card-link" href={withBase('/library/')}>Бібліотека →</a>
          </div>
        </article>

        <article class="card" data-block-tone="neutral">
          <h3>Вакансії та конкурси</h3>
          <p>
            Оголошення про конкурси на заміщення вакантних посад, накази про проведення
            конкурсів, учасників і результати.
          </p>
          <a class="card-link" href={withBase('/vacancies/')}>Переглянути вакансії →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Наукова діяльність</p>
          <h2 class="section-title">Наукові напрями та відділи</h2>
          <p class="section-text">
            Основні напрями роботи Інституту подано через групи наукових відділів.
            Такий формат одразу показує, які підрозділи працюють у кожному напрямі.
          </p>
        </div>
        <a class="button secondary" href={withBase('/departments/')}>Усі відділи</a>
      </div>

      <div class="home-department-groups">
        {groupedDepartments.map(({ group, entries, departmentCount, id }) => (
          <section class="home-department-group" data-block-tone="information" aria-labelledby={id}>
            <div class="home-department-group-header">
              <h3 id={id}>{group}</h3>
              <span>{departmentCount} {departmentCount === 1 ? 'відділ' : 'відділи'}</span>
            </div>
            <div class="department-grid">
              {entries.map((entry) => <DepartmentCard entry={entry} />)}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
