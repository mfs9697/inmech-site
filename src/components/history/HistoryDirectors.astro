---
import { historyDirectors } from '../../data/history';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<section class="section history-content-section history-directors-section">
  <div class="container">
    <div class="section-header history-directors-header">
      <div>
        <p class="eyebrow">Керівники установи</p>
        <h2 class="section-title">Директори Інституту</h2>
        <p class="section-text">
          Від часу заснування Інститут очолювали одинадцять учених. Кожен із них працював
          у своєму історичному періоді, забезпечуючи спадкоємність наукових шкіл,
          розвиток нових напрямів і збереження академічних традицій установи.
        </p>
      </div>
    </div>

    <div class="director-grid history-director-grid">
      {historyDirectors.map((director, index) => (
        <article
          class:list={[
            'director-card',
            'history-director-card',
            director.featured && 'is-featured',
            director.current && 'is-current'
          ]}
        >
          <div class="director-photo-frame">
            <img
              src={withBase(director.photo)}
              alt={`Портрет ${director.name}`}
              loading="lazy"
              width="120"
              height="160"
            />
          </div>

          <div class="director-card-body">
            <div class="director-card-topline">
              <span class="director-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="director-period">{director.period}</span>
            </div>
            <h3>{director.name}</h3>
            {director.note && <p>{director.note}</p>}
            {director.current && <span class="director-status">Нині очолює Інститут</span>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .history-directors-header {
    max-width: 900px;
    margin-bottom: 28px;
  }

  .history-director-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .history-director-card {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .history-director-card::after {
    content: '';
    position: absolute;
    inset: auto -30px -34px auto;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: rgba(29, 79, 145, 0.06);
    pointer-events: none;
  }

  .history-director-card.is-featured {
    border-color: rgba(184, 135, 47, 0.34);
  }

  .history-director-card.is-current {
    border-color: rgba(29, 79, 145, 0.38);
    box-shadow: 0 10px 22px rgba(15, 31, 52, 0.09);
  }

  .director-photo-frame {
    width: 120px;
    aspect-ratio: 3 / 4;
    margin: 16px auto 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface-soft);
  }

  .director-photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    filter: grayscale(1);
  }

  .director-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 14px 14px 16px;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .director-card-topline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .director-index {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .director-period {
    display: inline-flex;
    width: fit-content;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.74rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .history-director-card.is-featured .director-period {
    background: rgba(184, 135, 47, 0.14);
    color: var(--gold);
  }

  .history-director-card h3 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.2;
  }

  .history-director-card p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .director-status {
    display: inline-flex;
    justify-content: center;
    margin-top: auto;
    padding-top: 10px;
    color: var(--accent-dark);
    font-size: 0.76rem;
    font-weight: 850;
  }

  @media (max-width: 1100px) {
    .history-director-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .history-director-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .history-director-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 400px) {
    .history-director-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
