---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/overrides.css';
import '../styles/specialized-councils.css';
import '../styles/home-hero.css';
import '../styles/navigation.css';

interface Props {
  title: string;
  description: string;
  activePage?: 'home' | 'news' | 'departments' | 'about' | 'education';
}

const { title, description, activePage = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconPath = `${base}/favicon.png`;
const googleAnalyticsId = 'G-P7K4PTK2TY';

const siteBaseUrl = new URL(`${base || ''}/`, Astro.site).href.replace(/\/$/, '');
const englishPaths = new Set([
  '/en/',
  '/en/history/',
  '/en/regulations/',
  '/en/strategy/',
  '/en/scientific-cooperation/',
  '/en/tender/',
  '/en/management/',
  '/en/departments/',
  '/en/scientific-council/',
  '/en/specialized-councils/',
  '/en/young-scientists/',
  '/en/services/',
  '/en/education/',
  '/en/postgraduate/',
  '/en/postgraduate/students/',
  '/en/postgraduate/research-topics/',
  '/en/doctoral/',
  '/en/dissertations/',
  '/en/defended-dissertations/',
  '/en/license-and-regulations/',
  '/en/trust-box/',
  '/en/nmr/',
  '/en/news/',
  '/en/library/',
  '/en/search/',
  '/en/sitemap/',
  '/en/accessibility/',
  '/en/site-administration/'
]);

function stripBaseFromPath(pathname: string) {
  if (!base) {
    return pathname;
  }

  if (pathname === base) {
    return '/';
  }

  return pathname.startsWith(`${base}/`) ? pathname.slice(base.length) : pathname;
}

function normalizePath(pathname: string) {
  const withoutIndex = (pathname || '/').replace(/\/index\.html$/, '/');
  const withLeadingSlash = withoutIndex.startsWith('/') ? withoutIndex : `/${withoutIndex}`;
  return withLeadingSlash.endsWith('/') ? withLeadingSlash : `${withLeadingSlash}/`;
}

function absoluteUrl(pathname: string) {
  return `${siteBaseUrl}${pathname}`;
}

const currentPath = normalizePath(stripBaseFromPath(Astro.url.pathname));
const canonicalUrl = absoluteUrl(currentPath);
const englishAlternativePath = currentPath === '/' ? '/en/' : `/en${currentPath}`;
const isDepartmentDetailPage = /^\/departments\/[^/]+\/$/.test(currentPath);
const isPersonDetailPage = /^\/people\/[^/]+\/$/.test(currentPath);
const isNewsDetailPage = /^\/news\/(?!tags\/).+\/$/.test(currentPath) && currentPath !== '/news/';
const hasEnglishAlternative = englishPaths.has(englishAlternativePath) || isDepartmentDetailPage || isPersonDetailPage || isNewsDetailPage;
const ukrainianAlternativeUrl = absoluteUrl(currentPath);
const englishAlternativeUrl = absoluteUrl(englishAlternativePath);
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hasEnglishAlternative && <link rel="alternate" hreflang="uk" href={ukrainianAlternativeUrl} />}
    {hasEnglishAlternative && <link rel="alternate" hreflang="en" href={englishAlternativeUrl} />}
    <link rel="sitemap" href={`${siteBaseUrl}/sitemap-index.xml`} />
    <link rel="icon" href={faviconPath} type="image/png" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
    <script is:inline define:vars={{ googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', googleAnalyticsId);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до змісту</a>
    <Header activePage={activePage} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.primary-nav');

      if (menuToggle && nav) {
        menuToggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('open');
          menuToggle.setAttribute('aria-expanded', String(isOpen));
        });
      }

      document.querySelectorAll('.student-info-block').forEach((block) => {
        const label = block.querySelector(':scope > span');
        const publicationList = block.querySelector('.publication-list');

        if (!label || !publicationList || block.querySelector('.publication-details')) {
          return;
        }

        const count = publicationList.querySelectorAll('li').length;
        const details = document.createElement('details');
        details.className = 'publication-details';

        const summary = document.createElement('summary');
        summary.textContent = `Публікації (${count})`;

        details.append(summary, publicationList);
        block.replaceWith(details);
      });
    </script>
    <style is:global>
      .publication-details summary,
      .materials-details summary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        margin-bottom: 10px;
        padding: 6px 10px;
        border: 0;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-dark);
        cursor: pointer;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 850;
        line-height: 1.2;
      }
    </style>
  </body>
</html>
