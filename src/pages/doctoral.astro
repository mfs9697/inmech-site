---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const infoCards = [
  {
    label: 'Рівень підготовки',
    value: 'DSc',
    text: 'підготовка здобувачів наукового ступеня доктора наук'
  },
  {
    label: 'Науковий профіль',
    value: 'Механіка',
    text: 'дослідження в галузі механіки деформівного твердого тіла та суміжних напрямів'
  },
  {
    label: 'Методичний супровід',
    value: 'НМР',
    text: 'координація освітньо-наукових і методичних питань'
  }
];

const doctoralStudents = [
  {
    name: 'Бабенко Сергій Віталійович',
    department: 'Відділ стійкості процесів',
    profileHref: '/people/babenko-serhii/',
    topic: 'Мультиагентні механічні системи на часових шкалах: варіаційне моделювання та синтез керування для забезпечення консолідованого руху',
    consultant: 'Мартинюк Анатолій Андрійович',
    consultantHref: '/people/martyniuk-anatolii/',
    videoHref: 'https://www.youtube.com/watch?v=mhghDKpHSdg'
  },
  {
    name: 'Павлюк Ярослав Вікторович',
    department: 'Відділ механіки повзучості',
    profileHref: '/people/pavliuk/',
    topic: "Спадкова повзучість лінійно- та нелінійно-в'язкопружних спадкових матеріалів за умов складного напруженого стану",
    consultant: 'Сенченков Ігор Костянтинович',
    consultantHref: '/people/senchenkov/',
    videoHref: 'https://www.youtube.com/watch?v=_ep5iTj9_IY'
  }
];

const relatedLinks = [
  {
    title: 'Науково-методична рада',
    href: '/nmr/'
  },
  {
    title: 'Ліцензії та Положення',
    href: '/license-and-regulations/'
  },
  {
    title: 'Захист дисертацій',
    href: '/dissertations/'
  }
];
---

<BaseLayout
  title={`Докторантура | ${site.shortName}`}
  description="Докторантура Інституту механіки ім. С. П. Тимошенка НАН України: правила прийому, документи, науково-методичний супровід і корисні посилання."
  activePage="education"
>
  <section class="doctoral-hero">
    <div class="container doctoral-hero-grid">
      <div class="doctoral-hero-panel">
        <p class="eyebrow">Освітньо-наукова діяльність</p>
        <h1>Докторантура</h1>
        <p class="lead">
          Докторантура Інституту механіки ім. С. П. Тимошенка НАН України спрямована на
          підготовку докторів наук, розвиток самостійних наукових досліджень і поглиблення
          наукових шкіл Інституту в галузі механіки та прикладної математики.
        </p>
        <div class="doctoral-hero-actions">
          <a class="button primary" href="#documents">Правила вступу</a>
          <a class="button secondary" href={withBase('/education/')}>До освітньо-наукового розділу</a>
        </div>
      </div>

      <aside class="doctoral-mark-card" aria-label="Докторантура">
        <span>DSc</span>
        <h2>Підготовка докторів наук</h2>
        <p>Наукова траєкторія для дослідників із вагомими результатами та сформованою тематикою.</p>
      </aside>
    </div>
  </section>

  <section class="section doctoral-info-section">
    <div class="container">
      <div class="doctoral-info-grid">
        {infoCards.map((card) => (
          <article class="doctoral-info-card">
            <p>{card.label}</p>
            <span>{card.value}</span>
            <strong>{card.text}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section doctoral-cohort-section" id="doctoral-students-2026">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Набір 2026 року</p>
          <h2>Докторанти Інституту</h2>
        </div>
        <p>Дата вступу до докторантури — <strong>1 вересня 2026 року</strong>.</p>
      </div>

      <p class="doctoral-provisional-note">
        <strong>Попередня інформація:</strong> наведені теми докторських дисертацій і кандидатури
        наукових консультантів запропоновані та ще не затверджені Вченою радою Інституту.
      </p>

      <div class="doctoral-students-grid">
        {doctoralStudents.map((student) => (
          <article class="doctoral-student-card">
            <h3><a href={withBase(student.profileHref)}>{student.name}</a></h3>
            <p class="doctoral-student-department">{student.department}</p>
            <p><strong>Запропонована тема:</strong> {student.topic}</p>
            <p>
              <strong>Запропонований науковий консультант:</strong>{' '}
              <a href={withBase(student.consultantHref)}>{student.consultant}</a>
            </p>
            <a class="button secondary" href={student.videoHref} target="_blank" rel="noopener noreferrer">
              Дивитися запис наукового семінару ↗
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>


  <section class="section" id="documents">
    <div class="container">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Інформація для вступників</p>
          <h2>Порядок вступу до докторантури</h2>
        </div>
        <p>
          Основні вимоги, перелік документів та процедура розгляду кандидатур.
          Конкретні строки подання заяв і кількість місць оголошують окремо.
        </p>
      </div>

      <div class="doctoral-rules-grid">
        <article class="doctoral-rule-card">
          <h3>Загальні положення</h3>
          <p>
            Інститут механіки ім. С. П. Тимошенка НАН України здійснює підготовку
            докторів наук у докторантурі відповідно до розпорядження Президії НАН України № 448
            та чинного законодавства. Науковий профіль Інституту охоплює механіку
            деформівного твердого тіла, теоретичну механіку та пов’язані напрями прикладної математики.
            Прийом здійснюють за тими науковими спеціальностями, за якими відкрито докторантуру.
          </p>
          <p>
            Форма підготовки — очна (денна), нормативний строк — <strong>два роки</strong>.
            Фінансування можливе за державним замовленням або за кошти фізичних
            чи юридичних осіб відповідно до встановлених умов.
          </p>
        </article>

        <article class="doctoral-rule-card">
          <h3>Вимоги до вступників</h3>
          <ul>
            <li>Науковий ступінь доктора філософії або кандидата наук.</li>
            <li>Наукові здобутки, що потребують завершення чи оформлення у вигляді докторської дисертації або наукової доповіді.</li>
            <li>Наукові публікації за темою майбутнього дослідження в обсязі не менше половини вимог, установлених МОН для здобуття ступеня доктора наук.</li>
            <li>Відповідність запропонованого дослідження науковій спеціальності та профілю Інституту.</li>
          </ul>
        </article>

        <article class="doctoral-rule-card doctoral-rule-card-wide">
          <h3>Документи для вступу</h3>
          <p>Для підготовки заяви та особової справи вступнику слід мати:</p>
          <ul class="doctoral-documents-list">
            <li>Заяву на ім’я директора Інституту.</li>
            <li>Особовий листок з обліку кадрів.</li>
            <li>Документ, що посвідчує особу, та реєстраційний номер облікової картки платника податків (за наявності).</li>
            <li>Копії дипломів про вищу освіту та присудження ступеня доктора філософії (кандидата наук).</li>
            <li>Копію документа про присвоєння вченого звання (за наявності).</li>
            <li>Список наукових праць, публікацій і винаходів та <strong>копії публікацій за темою</strong> майбутньої дисертації.</li>
            <li>Розгорнуту наукову пропозицію з планом досліджень і переліком роботи, необхідної для підготовки результатів до захисту.</li>
            <li>Характеристику наукової діяльності вступника, підготовлену доктором наук із числа наукових працівників Інституту, із пропозицією щодо наукового консультування.</li>
            <li>Документ про зміну прізвища (за потреби) та фотокартки для оформлення особової справи.</li>
          </ul>
          <p>
            Під час подання документів пред’являють оригінали документа, що посвідчує особу,
            і документа про науковий ступінь. Якщо науковий ступінь здобуто за кордоном,
            застосовуються правила його визнання. Остаточний склад і спосіб подання пакета
            необхідно уточнювати в Інституті перед вступом.
          </p>
        </article>

        <article class="doctoral-rule-card">
          <h3>Розгляд кандидатури та зарахування</h3>
          <ol>
            <li>Подані матеріали передають до відповідного наукового відділу; протягом місяця після реєстрації заяви відділ розглядає документи та заслуховує наукову доповідь вступника.</li>
            <li>За результатами обговорення відділ подає висновок Вченій раді та, у разі позитивного рішення, пропонує кандидатуру наукового консультанта.</li>
            <li>Вчена рада на черговому засіданні розглядає висновок, затверджує тему докторського дослідження, ухвалює рішення про зарахування і призначає наукового консультанта.</li>
            <li>Зарахування оформлюється наказом директора Інституту.</li>
          </ol>
        </article>

        <article class="doctoral-rule-card">
          <h3>Строки та організація підготовки</h3>
          <p>
            Дати початку й завершення прийому заяв, строки відбору та наявність місць
            визначаються для кожної вступної кампанії окремо.{' '}
            <strong>Початок перебування в докторантурі — 1 вересня.</strong>
          </p>
          <p>
            Після зарахування докторант погоджує індивідуальний план наукової роботи
            з науковим консультантом. Вчена рада затверджує його{' '}
            <strong>протягом двох місяців від дати зарахування</strong>.{' '}
            Дослідження проводяться відповідно до затвердженого плану.
          </p>
          <p>
            Виплата стипендії за державним замовленням, повторний вступ за державні кошти,
            умови договору та питання проживання регулюються чинним законодавством
            і фактичними можливостями Інституту.
          </p>
        </article>
      </div>

      <div class="doctoral-rules-source">
        <strong>Нормативна основа:</strong>{' '}
        <a href="https://zakon.rada.gov.ua/laws/show/261-2016-%D0%BF" target="_blank" rel="noopener noreferrer">
          Порядок підготовки здобувачів ступеня доктора філософії та доктора наук (постанова КМУ № 261)
        </a>.{' '}
        Цей розділ — інформація для вступників на основі правил Інституту та чинного
        Порядку; він не замінює формально затверджених правил конкретної вступної кампанії.
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="related-panel">
        <div>
          <p class="eyebrow">Корисні переходи</p>
          <h2>Пов’язані розділи</h2>
        </div>
        <div class="related-link-grid">
          {relatedLinks.map((link) => (
            <a href={withBase(link.href)}>{link.title} →</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>

  .doctoral-cohort-section {
    padding-top: 16px;
  }

  .doctoral-provisional-note {
    margin: 0 0 20px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--text);
    line-height: 1.6;
  }

  .doctoral-students-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .doctoral-student-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: clamp(22px, 3vw, 34px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .doctoral-student-card h3 {
    margin: 0;
    font-size: clamp(1.24rem, 2.1vw, 1.55rem);
  }

  .doctoral-student-card p {
    margin: 0;
    line-height: 1.55;
  }

  .doctoral-student-department {
    color: var(--muted);
  }

  .doctoral-student-card .button {
    margin-top: auto;
  }


  .doctoral-rules-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .doctoral-rule-card,
  .doctoral-rules-source {
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .doctoral-rule-card-wide {
    grid-column: 1 / -1;
  }

  .doctoral-rule-card h3 {
    margin: 0 0 16px;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .doctoral-rule-card p {
    margin: 0 0 14px;
    line-height: 1.65;
  }

  .doctoral-rule-card p:last-child {
    margin-bottom: 0;
  }

  .doctoral-rule-card ul,
  .doctoral-rule-card ol {
    margin: 0;
    padding-left: 22px;
  }

  .doctoral-rule-card li {
    margin-bottom: 10px;
    line-height: 1.6;
  }

  .doctoral-documents-list {
    columns: 2;
    column-gap: 38px;
  }

  .doctoral-documents-list li {
    break-inside: avoid;
  }

  .doctoral-rules-source {
    margin-top: 16px;
    background: var(--surface-soft);
    line-height: 1.6;
  }

  .doctoral-hero {
    padding: 52px 0 18px;
  }

  .doctoral-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 24px;
    align-items: stretch;
  }

  .doctoral-hero-panel,
  .doctoral-mark-card,
  .doctoral-info-card,
  .related-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .doctoral-hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 54px);
  }

  .doctoral-hero-panel::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(29, 79, 145, 0.17), rgba(29, 79, 145, 0));
  }

  .doctoral-hero-panel h1,
  .doctoral-hero-panel .lead,
  .doctoral-hero-panel .eyebrow,
  .doctoral-hero-actions {
    position: relative;
    z-index: 1;
  }

  .doctoral-hero-panel h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .doctoral-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .doctoral-mark-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .doctoral-mark-card span {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 2rem;
    font-weight: 950;
  }

  .doctoral-mark-card h2 {
    margin: 0 0 12px;
    font-size: 1.7rem;
    line-height: 1.15;
  }

  .doctoral-mark-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
  }

  .doctoral-info-section {
    padding-top: 16px;
  }

  .doctoral-info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .doctoral-info-card {
    padding: clamp(20px, 3vw, 30px);
  }

  .doctoral-info-card p {
    margin: 0 0 10px;
    color: var(--muted);
    font-weight: 750;
  }

  .doctoral-info-card span {
    display: block;
    margin-bottom: 12px;
    color: var(--accent-dark);
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    font-weight: 950;
    letter-spacing: -0.04em;
  }

  .doctoral-info-card strong {
    display: block;
    color: var(--text);
    line-height: 1.35;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: flex-end;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    max-width: 540px;
    margin: 0;
    color: var(--muted);
  }

  .related-panel {
    padding: clamp(22px, 3vw, 34px);
  }

  .related-panel h2 {
    margin-top: 0;
    font-size: clamp(1.45rem, 2.3vw, 2.1rem);
  }

  .related-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 22px;
    align-items: center;
  }

  .related-link-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .related-link-grid a {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--accent-dark);
    font-weight: 850;
  }

  .related-link-grid a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .doctoral-hero-grid,
    .doctoral-info-grid,
    .doctoral-rules-grid,
    .doctoral-students-grid,
    .related-panel,
    .related-link-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      display: block;
    }

    .section-heading p:last-child {
      margin-top: 10px;
    }
  }

  @media (max-width: 560px) {
    .doctoral-rule-card-wide {
      grid-column: auto;
    }

    .doctoral-documents-list {
      columns: 1;
    }

  }
</style>
