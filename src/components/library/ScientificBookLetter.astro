---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BaseLayoutEn from '../../layouts/BaseLayoutEn.astro';
import ScientificBookCard from './ScientificBookCard.astro';
import { scientificBookGroups } from '../../data/scientificBookPartitions';
import { site } from '../../data/site';
import { siteEn } from '../../data/site-en';
import '../../styles/scientific-book-cards.css';

interface Props {
  group: (typeof scientificBookGroups)[number];
  language: 'uk' | 'en';
}
const { group, language } = Astro.props;
const en = language === 'en';
const Layout = en ? BaseLayoutEn : BaseLayout;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = en ? '/en/library/scientific-books/' : '/library/scientific-books/';
const overview = base + section;
const index = scientificBookGroups.findIndex((item) => item.code === group.code);
const neighbors = [scientificBookGroups[index - 1], scientificBookGroups[index + 1]];
const pageTitle = en ? 'Scientific books by author' : 'Наукові видання за автором';
const countLabel = en ? (group.items.length === 1 ? 'record' : 'records') : 'записів';
const backLabel = en ? 'All letters and topic filters' : 'Усі літери й тематичні фільтри';
---

<Layout
  title={pageTitle + ': ' + group.letter + ' | ' + (en ? siteEn.shortName : site.shortName)}
  description={(en ? 'Bibliographic records for authors beginning with ' : 'Бібліографічні записи за початковою літерою ') + group.letter}
  activePage="home"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel">
        <p class="eyebrow">{en ? 'Library · alphabetical catalogue' : 'Бібліотека · алфавітний каталог'}</p>
        <h1>{pageTitle}: {group.letter}</h1>
        <p class="lead">{group.items.length} {countLabel}</p>
        <nav aria-label={en ? 'Browse the book catalogue' : 'Навігація книжковим каталогом'} class="book-letter-navigation">
          <a href={overview + '#books-' + group.letter}>{backLabel}</a>
          {neighbors[0] && <a href={overview + 'letter/' + neighbors[0].code + '/'}>← {neighbors[0].letter}</a>}
          {neighbors[1] && <a href={overview + 'letter/' + neighbors[1].code + '/'}>{neighbors[1].letter} →</a>}
        </nav>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="book-grid" data-books-letter-list data-letter={group.letter}>
        {group.items.map((item) => <ScientificBookCard item={item} language={language} />)}
      </div>
    </div>
  </section>
</Layout>
<style>
  .book-letter-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 18px;
  }
  .book-letter-navigation a {
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-soft);
    font-weight: 750;
  }
</style>
