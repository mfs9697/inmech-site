---
import { defendedDissertationsA } from '../data/defendedDissertationsA';
import { defendedDissertationsB } from '../data/defendedDissertationsB';
import { defendedDissertationsV } from '../data/defendedDissertationsV';

const catalog = [
  { letter: 'А', items: defendedDissertationsA },
  { letter: 'Б', items: defendedDissertationsB },
  { letter: 'В', items: defendedDissertationsV }
];

const totalItems = catalog.reduce((sum, group) => sum + group.items.length, 0);
---

<section class="section" id="defended-catalog">
  <div class="container">
    <div class="section-heading compact-header">
      <div>
        <p class="eyebrow">Каталог</p>
        <h2>Захищені дисертації</h2>
      </div>
      <p>
        Перший фрагмент каталогу подано для літер А–В. У ньому розміщено {totalItems}
        бібліографічних записів зі старого розділу бібліотеки.
      </p>
    </div>

    <nav class="diss-alpha-nav" aria-label="Алфавітна навігація каталогу захищених дисертацій">
      {catalog.map((group) => (
        <a href={`#catalog-${group.letter}`}>{group.letter}</a>
      ))}
    </nav>

    <div class="diss-note">
      <strong>Примітка.</strong> Це перший перенесений фрагмент повного каталогу. Записи залишено
      максимально близькими до бібліографічного формату старої сторінки; далі за цим самим
      шаблоном можна додати наступні літери.
    </div>

    <div class="diss-groups">
      {catalog.map((group) => (
        <section class="diss-letter-group" id={`catalog-${group.letter}`}>
          <div class="diss-letter-header">
            <h3>{group.letter}</h3>
            <span>{group.items.length} {group.items.length === 1 ? 'запис' : 'записів'}</span>
          </div>

          <div class="diss-card-grid">
            {group.items.map((item) => (
              <article class="diss-card">
                <h4>{item.name}</h4>
                <p class="diss-title">{item.title}</p>
                <p class="diss-details">{item.details}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .diss-alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }

  .diss-alpha-nav a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--accent-dark);
    font-weight: 950;
    box-shadow: var(--shadow);
  }

  .diss-alpha-nav a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }

  .diss-note {
    margin-bottom: 18px;
    padding: 16px 18px;
    border-left: 5px solid var(--accent);
    border-radius: 16px;
    background: var(--surface-soft);
    color: var(--muted);
  }

  .diss-groups {
    display: grid;
    gap: 18px;
  }

  .diss-letter-group,
  .diss-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .diss-letter-group {
    padding: clamp(18px, 3vw, 28px);
  }

  .diss-letter-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .diss-letter-header h3 {
    margin: 0;
    color: var(--accent-dark);
    font-size: 1.42rem;
  }

  .diss-letter-header span {
    color: var(--muted);
    font-weight: 850;
  }

  .diss-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .diss-card {
    padding: 16px 18px;
    box-shadow: none;
    background: var(--surface-soft);
  }

  .diss-card h4 {
    margin: 0 0 10px;
    color: var(--accent-dark);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .diss-title {
    margin: 0 0 12px;
    color: var(--text);
    font-weight: 850;
    line-height: 1.35;
  }

  .diss-details {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .diss-card-grid {
      grid-template-columns: 1fr;
    }

    .diss-letter-header {
      display: block;
    }

    .diss-letter-header span {
      display: block;
      margin-top: 10px;
    }
  }
</style>
