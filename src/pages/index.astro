---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import DepartmentCard from '../components/DepartmentCard.astro';
import { quickLinks, site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path: string) {
  if (path.startsWith('http') || path.startsWith('#')) {
    return path;
  }

  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
}

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const departments = (await getCollection('departments'))
  .sort((a, b) => a.data.order - b.data.order);

const groupedDepartments = [...departments.reduce((acc, entry) => {
  const group = entry.data.group;
  if (!acc.has(group)) acc.set(group, []);
  acc.get(group)?.push(entry);
  return acc;
}, new Map<string, typeof departments>())].map(([group, entries], index) => ({
  group,
  entries,
  id: `home-department-group-${index + 1}`
}));
---

<BaseLayout
  title={`${site.name}`}
  description={site.description}
  activePage="home"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card hero-card-visual">
        <div class="hero-text">
          <p class="eyebrow">Національна академія наук України</p>
          <h1>Інститут механіки ім. С.П.&nbsp;Тимошенка НАН України</h1>
          <p class="lead">
            Провідна наукова установа НАН України, що здійснює фундаментальні та прикладні дослідження
            в галузі механіки деформівного твердого тіла, динаміки, стійкості, термопружності,
            повзучості, механіки руйнування та механіки композитних матеріалів.
          </p>
        </div>

        <figure class="hero-image-card">
          <img src={withBase('/assets/img/logo-jacket-upload.svg?v=20260615-2')} alt="Значок Інституту механіки ім. С. П. Тимошенка" loading="eager" />
          <div class="hero-actions hero-image-actions">
            <a class="button primary" href={withBase('/departments/')}>Наукові відділи</a>
            <a class="button secondary" href={withBase('/news/')}>Останні новини</a>
          </div>
        </figure>
      </div>

      <aside class="aside-card" aria-labelledby="institute-sites-title">
        <h2 id="institute-sites-title">Інститутські сайти</h2>
        <p>
          Окремі інформаційні ресурси Інституту для спеціалізованих проєктів, подій та інституційних оголошень.
        </p>
        <ul class="aside-list">
          <li>
            <a href="https://natcommmech.inmech.kyiv.ua/" target="_blank" rel="noopener">
              Національний комітет України з теоретичної і прикладної механіки
            </a>
          </li>
          <li>
            <a href="https://election.inmech.kyiv.ua/" target="_blank" rel="noopener">
              Вибори директора Інституту 2026
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Про інститут</p>
          <h2 class="section-title">Наукова школа, дослідження та інженерні застосування</h2>
          <p class="section-text">
            Інститут механіки ім. С.П. Тимошенка НАН України проводить дослідження у ключових напрямах
            теоретичної та прикладної механіки, поєднуючи розвиток математичних моделей, експериментальні
            дослідження, чисельне моделювання та впровадження результатів у практику.
          </p>
        </div>
      </div>

      <div class="cards-grid">
        <article class="card">
          <h3>Наукові дослідження</h3>
          <p>
            Розв’язання фундаментальних і прикладних задач механіки суцільного середовища,
            матеріалознавства, міцності, довговічності та надійності конструкцій.
          </p>
          <a class="card-link" href={withBase('/departments/')}>Переглянути напрями →</a>
        </article>

        <article class="card">
          <h3>Освітньо-наукова діяльність</h3>
          <p>
            Підготовка наукових кадрів, аспірантура, докторантура, спеціалізовані вчені ради,
            наукові семінари та участь молодих учених у дослідницьких проєктах.
          </p>
          <a class="card-link" href={withBase('/education/')}>Аспірантура та докторантура →</a>
        </article>

        <article class="card">
          <h3>Публікації та співпраця</h3>
          <p>
            Видання наукових журналів, міжнародна співпраця, конференції, бібліотечні матеріали
            та поширення результатів досліджень у світовому науковому просторі.
          </p>
          <div class="card-links-stack">
            <a class="card-link" href="https://applied-mechanics.inmech.kyiv.ua/" target="_blank" rel="noopener">Журнал «Прикладна механіка» →</a>
            <a class="card-link" href={withBase('/library/')}>Бібліотека →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Наукова діяльність</p>
          <h2 class="section-title">Наукові напрями та відділи</h2>
          <p class="section-text">
            Основні напрями роботи Інституту подано через групи наукових відділів.
            Такий формат одразу показує, які підрозділи працюють у кожному напрямі.
          </p>
        </div>
        <a class="button secondary" href={withBase('/departments/')}>Усі відділи</a>
      </div>

      <div class="home-department-groups">
        {groupedDepartments.map(({ group, entries, id }) => (
          <section class="home-department-group" aria-labelledby={id}>
            <div class="home-department-group-header">
              <h3 id={id}>{group}</h3>
              <span>{entries.length} {entries.length === 1 ? 'відділ' : 'відділи'}</span>
            </div>
            <div class="department-grid">
              {entries.map((entry) => <DepartmentCard entry={entry} />)}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Останні повідомлення</p>
          <h2 class="section-title">Новини та оголошення</h2>
          <p class="section-text">
            На головній сторінці показано кілька найновіших повідомлень; повний архів доступний
            на окремій сторінці новин.
          </p>
        </div>
        <a class="button secondary" href={withBase('/news/')}>Усі новини</a>
      </div>

      <div class="news-list">
        {news.map((entry) => <NewsCard entry={entry} level="h3" />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Швидкий доступ</p>
          <h2 class="section-title">Основні розділи сайту</h2>
          <p class="section-text">
            Ці посилання можна поступово підключати до окремих сторінок у міру наповнення сайту.
          </p>
        </div>
      </div>

      <div class="quick-links">
        {quickLinks.map((link) => <a class="quick-link" href={link.href}>{link.title}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .card-links-stack {
    display: grid;
    gap: 8px;
  }
</style>
