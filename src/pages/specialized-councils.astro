const totalMembers = councils.reduce((sum, council) => sum + council.people.length, 0);
---

<BaseLayout
  title={`Спеціалізовані вчені ради | ${site.name}`}
  description="Спеціалізовані вчені ради Інституту механіки ім. С.П. Тимошенка НАН України."
  activePage="departments"
>
  <section class="page-hero">
    <div class="container">
      <div class="panel specialized-hero-panel">
        <p class="eyebrow">Структура</p>
        <h1>Спеціалізовані вчені ради</h1>
        <p class="lead">
          В Інституті механіки ім. С. П. Тимошенка НАН України утворено спеціалізовані
          вчені ради з присудження наукового ступеня доктора наук за спеціальностями
          у галузі механіки.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="specialized-summary-grid">
        <article class="specialized-summary-card">
          <span>{councils.length}</span>
          <p>спеціалізовані вчені ради</p>
        </article>
        <article class="specialized-summary-card">
          <span>{totalMembers}</span>
          <p>осіб у складі рад</p>
        </article>
      </div>
    </div>
  </section>

  {councils.map((council) => (
    <section class="section">
      <div class="container">
        <article class="specialized-council-panel">
          <div class="specialized-council-header">
            <div>
              <p class="eyebrow">{council.field}</p>
              <h2>{council.code}</h2>
              <p class="specialized-profile"><strong>Профіль ради:</strong> {council.profile}</p>
              <p class="specialized-order">{council.order}</p>
            </div>
          </div>

          <div class="specialized-people-grid">
            {council.people.map((person) => (
              <article class={`specialized-person-card ${person.councilRole ? 'has-role' : ''}`}>
                {person.councilRole && <p class="specialized-role-badge">{person.councilRole}</p>}
                <h3>{person.name}</h3>

                <dl class="specialized-person-details">
                  <div>
                    <dt>Науковий ступінь</dt>
                    <dd>{person.degree}</dd>
                  </div>
                  {person.academicTitle && (
                    <div>
                      <dt>Наукове звання</dt>
                      <dd>{person.academicTitle}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Посада</dt>
                    <dd>{person.position}</dd>
                  </div>
                  {person.institution && (
                    <div>
                      <dt>Установа</dt>
                      <dd>{person.institution}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Спеціальність</dt>
                    <dd>{person.specialty}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>
        </article>
      </div>
    </section>
  ))}
</BaseLayout>
