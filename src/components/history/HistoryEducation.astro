---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const educationLinks = [
  {
    label: 'PhD',
    title: 'Аспірантура',
    text: 'Вступ, освітньо-наукова програма, навчальні плани, аспіранти та наукові керівники.',
    href: '/postgraduate/'
  },
  {
    label: 'DSc',
    title: 'Докторантура',
    text: 'Підготовка докторів наук, правила прийому та науково-методичний супровід.',
    href: '/doctoral/'
  },
  {
    label: 'Захисти',
    title: 'Дисертації',
    text: 'Анонси, матеріали захистів, висновки, відгуки опонентів і архів дисертацій.',
    href: '/dissertations/'
  }
];
---

<section class="section history-content-section history-education-section">
  <div class="container">
    <div class="history-education-intro panel">
      <div class="history-education-year" aria-label="1934 рік">
        <strong>1934</strong>
        <span>початок активного формування аспірантури</span>
      </div>

      <div>
        <p class="eyebrow">Підготовка наукових кадрів</p>
        <h2 class="section-title">Нові покоління дослідників</h2>
        <p>
          Підготовка науковців традиційно була одним із ключових напрямів діяльності Інституту.
          Аспірантура почала активно формуватися у 1934 році, поєднуючи навчання з роботою
          у наукових відділах, участю в семінарах і виконанням фундаментальних та прикладних досліджень.
        </p>
        <p>
          Сьогодні Інститут здійснює підготовку докторів філософії за спеціальністю
          <strong>F1 «Прикладна математика»</strong> / <strong>113 «Прикладна математика»</strong>
          за освітньо-науковою програмою «Механіка деформівного твердого тіла і теоретична механіка»,
          а також підготовку здобувачів наукового ступеня доктора наук у докторантурі.
        </p>
      </div>
    </div>

    <div class="history-education-grid">
      {educationLinks.map((item) => (
        <a class="history-education-card panel" href={withBase(item.href)}>
          <span>{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <strong>Перейти до розділу →</strong>
        </a>
      ))}
    </div>

    <article class="history-councils-card panel">
      <div>
        <p class="eyebrow">Атестація науковців</p>
        <h3>Спеціалізовані ради й захисти дисертацій</h3>
        <p>
          В Інституті діють спеціалізовані вчені ради, а сторінка захистів об’єднує актуальні
          оголошення та архівні матеріали: тексти дисертацій і авторефератів, висновки,
          відгуки офіційних опонентів та відеозаписи засідань, коли вони доступні.
        </p>
      </div>
      <a class="button secondary" href={withBase('/specialized-councils/')}>Спеціалізовані ради</a>
    </article>
  </div>
</section>

<style>
  .history-education-intro {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(24px, 5vw, 54px);
    align-items: center;
    padding: clamp(26px, 4vw, 44px);
    margin-bottom: 24px;
  }

  .history-education-intro h2 {
    margin-top: 0;
  }

  .history-education-intro p:last-child {
    margin-bottom: 0;
  }

  .history-education-year {
    display: grid;
    min-height: 190px;
    place-items: center;
    align-content: center;
    gap: 10px;
    padding: 24px;
    border-radius: 24px;
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
    text-align: center;
  }

  .history-education-year strong {
    font-size: clamp(2.8rem, 6vw, 4.4rem);
    line-height: 1;
  }

  .history-education-year span {
    max-width: 160px;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.88rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .history-education-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .history-education-card {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 26px;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .history-education-card:hover {
    transform: translateY(-4px);
    text-decoration: none;
  }

  .history-education-card > span {
    width: fit-content;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .history-education-card h3,
  .history-councils-card h3 {
    margin: 18px 0 10px;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
  }

  .history-education-card p,
  .history-councils-card p {
    color: var(--muted);
    line-height: 1.55;
  }

  .history-education-card > strong {
    margin-top: auto;
    padding-top: 16px;
    color: var(--accent-dark);
    font-size: 0.88rem;
  }

  .history-councils-card {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: center;
    padding: clamp(24px, 4vw, 38px);
  }

  .history-councils-card > div {
    max-width: 760px;
  }

  .history-councils-card h3 {
    margin-top: 0;
  }

  .history-councils-card p:last-child {
    margin-bottom: 0;
  }

  .history-councils-card .button {
    flex: 0 0 auto;
  }

  @media (max-width: 900px) {
    .history-education-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .history-education-intro {
      grid-template-columns: 1fr;
    }

    .history-education-year {
      min-height: 150px;
    }

    .history-councils-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .history-education-grid {
      grid-template-columns: 1fr;
    }

    .history-education-card {
      min-height: 0;
    }
  }
</style>
