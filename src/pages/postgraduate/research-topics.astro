---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;

const correspondences = [
  {
    student: 'Грисевич Роман Юрійович',
    year: 'Вступ 2025',
    topic: 'Теоретико-експериментальне моделювання деформування елементів протеза кисті руки при статичних, квазістатичних та динамічних навантаженнях',
    supervisor: 'Максимюк Володимир Ананійович',
    supervisorArea: 'механіка деформівного твердого тіла, чисельне та експериментальне моделювання деформування конструктивних елементів, аналіз напружено-деформованого стану складних систем',
    rationale: 'Тема безпосередньо пов’язана з моделюванням деформування конструктивних елементів за різних типів навантаження та потребує поєднання теоретичного, чисельного й експериментального підходів.'
  },
  {
    student: 'Назарчук Юрій Олександрович',
    year: 'Вступ 2025',
    topic: 'Руйнування в’язкопружних кусково-неоднорідних матеріалів із когезійними інтерфейсами: застосування до асфальтобетону',
    supervisor: 'Селіванов Михайло Федорович',
    supervisorArea: 'механіка руйнування, когезійні моделі тріщин, в’язкопружність, чисельне моделювання росту тріщин',
    rationale: 'Тема відповідає науковій діяльності керівника у сфері когезійного моделювання руйнування та задач механіки в’язкопружних тіл із тріщинами.'
  },
  {
    student: 'Прощенко Олександр Анатолійович',
    year: 'Вступ 2025',
    topic: 'Плоскі задачі руйнування матеріалів при стиску вздовж паралельних тріщин зі зміщеними в напрямку стиску центрами',
    supervisor: 'Назаренко Володимир Михайлович',
    supervisorArea: 'механіка руйнування, стійкість деформівних тіл, задачі тріщиноутворення та взаємодії дефектів у матеріалах',
    rationale: 'Тема належить до плоских задач механіки руйнування та стосується взаємодії тріщин під дією стискальних навантажень, що відповідає напряму досліджень керівника.'
  },
  {
    student: 'Синявський Олексій Ігорович',
    year: 'Вступ 2025',
    topic: 'Стиск тонкоплівкових систем вздовж межі поділу плівки та підкладки обмеженої товщини',
    supervisor: 'Назаренко Володимир Михайлович',
    supervisorArea: 'стійкість процесів деформування, механіка тонкоплівкових систем, міжфазні дефекти та локальна втрата стійкості',
    rationale: 'Дисертаційна тема безпосередньо стосується стійкості тонкоплівкових систем і аналізу стиску вздовж межі поділу, що узгоджується з дослідженнями керівника у механіці стійкості та руйнування.'
  },
  {
    student: 'Серафимович Роман Вікторович',
    year: 'Вступ 2024',
    topic: 'Фізично нелінійні задачі для тришарової циліндричної оболонки з отворами',
    supervisor: 'Сторожук Євген Анатолійович',
    supervisorArea: 'нелінійна теорія оболонок, концентрація напружень, оболонкові елементи з отворами, механіка композитних та шаруватих структур',
    rationale: 'Тема є прямим продовженням напряму керівника з нелінійної теорії оболонок і дослідження концентрації напружень у шаруватих оболонкових елементах з отворами.'
  },
  {
    student: 'Усов Василь Олександрович',
    year: 'Вступ 2024',
    topic: 'Чисельне моделювання термомеханічних процесів друку тіл обертання шарами в’язкопластичного матеріалу',
    supervisor: 'Сенченков Ігор Константинович',
    supervisorArea: 'термомеханіка, чисельне моделювання нестаціонарних процесів, в’язкопластичні матеріали, залишковий напружено-деформований стан',
    rationale: 'Тема пов’язана з чисельним моделюванням термомеханічних процесів і залишкових напружень у в’язкопластичних матеріалах, що відповідає науковому профілю керівника.'
  },
  {
    student: 'Філь Євген Вадимович',
    year: 'Вступ 2024',
    topic: 'Чисельний аналіз напружено-деформованого стану пологих ортотропних оболонок непрямокутних в плані',
    supervisor: 'Григоренко Олександр Ярославович',
    supervisorArea: 'механіка оболонок, ортотропні оболонки, чисельний аналіз напружено-деформованого стану, дискретно-континуальні підходи',
    rationale: 'Тема узгоджується з багаторічними дослідженнями керівника у галузі механіки оболонок і чисельного аналізу оболонкових систем складної геометрії.'
  },
  {
    student: 'Горський Юрій Вікторович',
    year: 'Вступ 2023',
    topic: 'Генерування хрестоподібних поверхневих хвиль у воді в циліндричній ємності з вібруючими стінками при випромінюванні звуку',
    supervisor: 'Жук Ярослав Олександрович',
    supervisorArea: 'механіка суцільних середовищ, хвильові процеси, математичне моделювання динамічних процесів у рідинах і деформівних системах',
    rationale: 'Тема пов’язана з моделюванням хвильових процесів у рідині та динамічною взаємодією з коливними межами, що відповідає напряму досліджень керівника.'
  },
  {
    student: 'Кобзар Петро Юрійович',
    year: 'Вступ 2023',
    topic: 'Моделювання розподілу напружень у п’єзоелектричному тілі поблизу жорстких плоских включень і тріщин кругової та еліптичної форми',
    supervisor: 'Кирилюк Віталій Семенович',
    supervisorArea: 'механіка п’єзоелектричних матеріалів, задачі для тіл з включеннями і тріщинами, математичне моделювання електропружних полів',
    rationale: 'Тема відповідає напряму керівника, оскільки зосереджена на моделюванні електропружного стану п’єзоелектричних тіл із дефектами.'
  },
  {
    student: 'Лесик Олексій Іванович',
    year: 'Вступ 2023',
    topic: 'Плоскі задачі механіки руйнування матеріалів з взаємодіючими тріщинами за дії спрямованих вздовж тріщин зусиль',
    supervisor: 'Богданов Вячеслав Леонідович',
    supervisorArea: 'механіка руйнування, попередньо напружені тіла, взаємодія тріщин, аналітичні методи механіки деформівного твердого тіла',
    rationale: 'Тема належить до класу задач механіки руйнування для тіл із тріщинами та узгоджується з науковими працями керівника щодо тріщин у попередньо напружених тілах.'
  },
  {
    student: 'Ольховський Антон Стефанович',
    year: 'Вступ 2023',
    topic: 'Математичне моделювання впливу локальних пошкоджень та експлуатаційних навантажень на вібронапруженість лопаток останньої ступені парової турбіни АЕС',
    supervisor: 'Сенченков Ігор Константинович',
    supervisorArea: 'механіка деформівного твердого тіла, чисельне моделювання напружено-деформованого стану, термомеханіка та оцінювання пошкодженості елементів енергетичного обладнання',
    rationale: 'Тема пов’язана з чисельним аналізом напруженого стану, вібронапруженості та пошкодженості елементів турбомашин, що відповідає напряму досліджень керівника.'
  },
  {
    student: 'Селіванов Данило Михайлович',
    year: 'Вступ 2023',
    topic: 'Застосування моделі когезійної зони до дослідження задач про відтерміноване руйнування тіл з тріщинами змішаної моди',
    supervisor: 'Богданов Вячеслав Леонідович',
    supervisorArea: 'механіка руйнування, тріщини змішаної моди, когезійні підходи, аналітичні та чисельні методи дослідження росту тріщин',
    rationale: 'Тема стосується змішаномодового руйнування і когезійного опису росту тріщин, що узгоджується з напрямом керівника у механіці руйнування деформівних тіл.'
  }
];
---

<BaseLayout
  title={`Відповідність тем аспірантів | ${site.shortName}`}
  description="Відповідність тем дисертацій аспірантів науковій діяльності їхніх керівників в Інституті механіки ім. С. П. Тимошенка НАН України."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/postgraduate/')}>Аспірантура</a>
      <span>›</span>
      <span>Відповідність тем</span>
    </nav>

    <section class="page-hero">
      <p class="eyebrow">Якість підготовки PhD</p>
      <h1>Відповідність тем аспірантів науковій діяльності керівників</h1>
      <p class="lead">
        На сторінці подано узгодження тем дисертаційних досліджень аспірантів із науковими напрямами їхніх керівників.
        Такий формат зручний для самооцінювання освітньо-наукової програми, акредитації та внутрішнього моніторингу якості підготовки.
      </p>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Зведена таблиця</p>
          <h2>Тематика дисертацій і напрями керівників</h2>
        </div>
        <p>Дані згруповано за аспірантами; за потреби можна додати окрему колонку з публікаціями керівників.</p>
      </div>

      <div class="table-panel">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Аспірант</th>
                <th>Тема дисертації</th>
                <th>Науковий керівник</th>
                <th>Напрям наукової діяльності керівника</th>
                <th>Обґрунтування відповідності</th>
              </tr>
            </thead>
            <tbody>
              {correspondences.map((item) => (
                <tr>
                  <td><strong>{item.student}</strong><span>{item.year}</span></td>
                  <td>{item.topic}</td>
                  <td>{item.supervisor}</td>
                  <td>{item.supervisorArea}</td>
                  <td>{item.rationale}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-block card-grid">
      <article class="note-card">
        <p class="eyebrow">Подальше уточнення</p>
        <h2>Публікації керівників</h2>
        <p>
          Для акредитаційної версії сторінки можна додати короткі списки ключових публікацій кожного керівника,
          які безпосередньо підтверджують відповідність темам аспірантів.
        </p>
      </article>
      <article class="note-card">
        <p class="eyebrow">Пов’язані сторінки</p>
        <h2>Аспіранти та керівники</h2>
        <p>
          Детальна інформація про аспірантів і потенційних керівників подана на окремих сторінках розділу аспірантури.
        </p>
        <div class="links-row">
          <a href={withBase('/postgraduate/students/')}>Аспіранти →</a>
          <a href={withBase('/postgraduate/supervisors/')}>Керівники →</a>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .postgraduate-page { max-width: 1220px; margin: 0 auto; padding: 46px 20px 72px; }
  .breadcrumbs { display: flex; gap: 10px; align-items: center; margin-bottom: 22px; color: var(--muted); font-weight: 750; }
  .page-hero, .table-panel, .note-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .page-hero { padding: clamp(28px, 5vw, 52px); }
  .page-hero h1 { margin: 0 0 18px; font-size: clamp(2.05rem, 4.5vw, 4.1rem); line-height: 1.04; letter-spacing: -0.04em; }
  .lead { max-width: 920px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .section-block { margin-top: 34px; }
  .table-panel { overflow: hidden; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; min-width: 1200px; border-collapse: collapse; }
  th, td { padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  th { background: var(--accent-dark); color: #fff; font-size: 0.88rem; }
  td { color: var(--muted); line-height: 1.55; }
  td:first-child { color: var(--text); min-width: 210px; }
  td:first-child span { display: block; margin-top: 8px; color: var(--accent-dark); font-size: 0.82rem; font-weight: 850; }
  .card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .note-card { padding: 26px; }
  .note-card h2 { margin-top: 0; }
  .note-card p { color: var(--muted); line-height: 1.7; }
  .links-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .links-row a { padding: 8px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-dark); font-weight: 850; text-decoration: none; }
  .links-row a:hover { text-decoration: none; background: rgba(29, 79, 145, 0.16); }
  @media (max-width: 920px) { .card-grid { grid-template-columns: 1fr; } }
</style>
