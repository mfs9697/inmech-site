---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
const docHref = (href: string) => href.startsWith('/documents/') ? withBase(href) : href;

const accreditationDocuments = [
  {
    title: 'Сертифікат про акредитацію освітньої програми № 22459',
    description:
      'Сертифікат Національного агентства із забезпечення якості вищої освіти, виданий 23 червня 2026 року. Строк дії — до 1 липня 2031 року.',
    href: '/documents/postgraduate/accreditation/2026/accreditation-certificate-22459.pdf'
  },
  {
    title: 'Програма роботи експертної групи',
    description:
      'Програма роботи експертної групи під час проведення акредитаційної експертизи в Інституті механіки ім. С. П. Тимошенка НАН України у період 6–8 травня 2026 року.',
    href: '/documents/postgraduate/accreditation/2026/expert-group-program-2026.pdf'
  },
  {
    title: 'Відомості про самооцінювання',
    description: 'Самооцінювання освітньо-наукової програми за третім рівнем вищої освіти.',
    href: '/documents/postgraduate/accreditation/2026/self-assessment-2026.pdf'
  }
];
---

<BaseLayout
  title={`Акредитація ОНП | ${site.shortName}`}
  description="Акредитація освітньо-наукової програми аспірантури Інституту механіки ім. С. П. Тимошенка НАН України."
  activePage="education"
>
  <main class="postgraduate-page">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={withBase('/postgraduate/')}>Аспірантура</a>
      <span>›</span>
      <span>Акредитація</span>
    </nav>

    <section class="page-hero">
      <p class="eyebrow">Акредитація</p>
      <h1>Акредитація освітньо-наукової програми</h1>
      <p class="lead">
        Освітньо-наукову програму
        <strong>«Механіка деформівного твердого тіла і теоретична механіка»</strong>
        за спеціальністю <strong>113 Прикладна математика</strong> акредитовано на третьому рівні вищої освіти.
      </p>
    </section>

    <section class="certificate-panel">
      <div>
        <p class="eyebrow">Статус програми</p>
        <h2>Освітньо-наукову програму акредитовано</h2>
        <p>
          Сертифікат про акредитацію освітньої програми <strong>№ 22459</strong>
          видано <strong>23 червня 2026 року</strong>. Строк дії сертифіката —
          <strong>до 1 липня 2031 року</strong>.
        </p>
        <div class="status-meta" aria-label="Основні відомості про сертифікат">
          <span>№ 22459</span>
          <span>23.06.2026</span>
          <span>чинний до 01.07.2031</span>
        </div>
      </div>
      <a
        class="certificate-link"
        href={docHref('/documents/postgraduate/accreditation/2026/accreditation-certificate-22459.pdf')}
        target="_blank"
        rel="noopener noreferrer"
      >
        Переглянути сертифікат →
      </a>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Процедура акредитації</p>
          <h2>Акредитаційна експертиза</h2>
        </div>
      </div>

      <div class="info-grid">
        <article class="info-card accent-card">
          <span>Період проведення</span>
          <h3>6–8 травня 2026 року</h3>
          <p>
            Акредитаційна експертиза проводилася в Інституті механіки ім. С. П. Тимошенка
            НАН України за освітньою програмою з ID ОП у ЄДЕБО 22305.
          </p>
        </article>

        <article class="info-card">
          <span>Освітня програма</span>
          <h3>Механіка деформівного твердого тіла і теоретична механіка</h3>
          <p>
            Третій освітньо-науковий рівень вищої освіти, спеціальність 113 Прикладна математика.
          </p>
        </article>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading compact-header">
        <div>
          <p class="eyebrow">Документи</p>
          <h2>Матеріали акредитації</h2>
        </div>
        <p>Документи відкриваються у новій вкладці з офіційного архіву Інституту.</p>
      </div>

      <div class="document-grid">
        {accreditationDocuments.map((document) => (
          <a class="document-card" href={docHref(document.href)} target="_blank" rel="noopener noreferrer">
            <span>PDF</span>
            <h3>{document.title}</h3>
            <p>{document.description}</p>
            <strong>Відкрити документ →</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="section-block meeting-panel">
      <div>
        <p class="eyebrow">Відкрита зустріч</p>
        <h2>Зустріч з експертною групою</h2>
        <p>
          Відкрита зустріч з експертною групою щодо освітньої програми ЄДЕБО 22305
          відбулася <strong>7 травня 2026 року</strong> з <strong>12:30</strong> до <strong>13:15</strong>.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .postgraduate-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 20px 72px;
  }

  .breadcrumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 22px;
    color: var(--muted);
    font-weight: 750;
  }

  .page-hero,
  .certificate-panel,
  .info-card,
  .document-card,
  .meeting-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .page-hero {
    padding: clamp(28px, 5vw, 52px);
  }

  .page-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(2.2rem, 4.8vw, 4.3rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 920px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .certificate-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    margin-top: 22px;
    padding: clamp(24px, 4vw, 36px);
    border-color: rgba(29, 79, 145, 0.22);
    background: linear-gradient(145deg, var(--surface), var(--accent-soft));
  }

  .certificate-panel h2 {
    margin: 0 0 10px;
  }

  .certificate-panel p:not(.eyebrow) {
    max-width: 820px;
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .status-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .status-meta span {
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 850;
  }

  .certificate-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 18px;
    border-radius: 14px;
    background: var(--accent-dark);
    color: #fff;
    font-weight: 850;
    text-decoration: none;
    white-space: nowrap;
  }

  .certificate-link:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .section-block {
    margin-top: 34px;
  }

  .info-grid,
  .document-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .info-card,
  .document-card {
    padding: 24px;
  }

  .info-card span,
  .document-card span,
  .meeting-panel aside span {
    display: inline-block;
    margin-bottom: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .info-card h3,
  .document-card h3 {
    margin: 0 0 12px;
    font-size: 1.25rem;
  }

  .info-card p,
  .document-card p,
  .meeting-panel p {
    color: var(--muted);
    line-height: 1.65;
  }

  .accent-card {
    background: linear-gradient(145deg, var(--accent-dark), var(--accent));
    color: #fff;
  }

  .accent-card span {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .accent-card p {
    color: rgba(255, 255, 255, 0.86);
  }

  .document-card {
    display: flex;
    min-height: 260px;
    flex-direction: column;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.22s ease;
  }

  .document-card:hover {
    transform: translateY(-4px);
    text-decoration: none;
  }

  .document-card strong {
    margin-top: auto;
    color: var(--accent-dark);
  }

  .meeting-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 24px;
    align-items: center;
    padding: 28px;
  }

  .meeting-panel h2 {
    margin-top: 0;
  }

  .meeting-panel aside {
    padding: 20px;
    border-radius: 22px;
    background: var(--surface-soft);
  }

  @media (max-width: 860px) {
    .certificate-panel,
    .info-grid,
    .document-grid,
    .meeting-panel {
      grid-template-columns: 1fr;
    }

    .certificate-link {
      width: fit-content;
      white-space: normal;
    }
  }
</style>
